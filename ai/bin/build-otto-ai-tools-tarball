#!/usr/bin/env bash
# Package otto-ai-tools into a self-contained tarball for distribution.
#
# Usage: build-otto-ai-tools-tarball [VERSION]
#
# If VERSION is omitted, reads from .github/.release-please-manifest.json.
#
# Produces: otto-ai-tools-<version>.tar.gz in the current directory.
# The tarball contains an otto-ai-tools-<version>/ directory with:
#   bin/          — all executable scripts (dynamically discovered)
#   lib/          — bash modules, Python modules, review-templates/, ui.sh facade
#   agents/       — agent definitions
#   VERSION       — version string
#
# All contents are discovered dynamically via globs — adding a new script,
# module, template, or agent requires no changes to this build script.

set -euo pipefail
shopt -s nullglob

_SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
WORKBENCH_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"
_CLAUDE_DIR="$WORKBENCH_ROOT/ai/claude"
_AI_LIB_DIR="$WORKBENCH_ROOT/ai/lib"

# ─── Constants ────────────────────────────────────────────────────────────

MANIFEST_KEY="ai/claude"

# Bash modules from lib/ that the tarball scripts need at runtime.
# The full ui.sh sources the entire workbench framework; the tarball facade
# sources only these.
BASH_MODULES=(output.sh prompts.sh roots.sh)

# Python modules from lib/ rather than ai/lib/, because a second subsystem
# outside ai/ reads them too. The tarball flattens both directories into one
# lib/, so they land beside the ai/lib modules that import them.
WORKBENCH_PY_MODULES=(git_layout.py gitenv.py git_remote.py)

# Files excluded from bin/ discovery: the workbench's own build and export
# tooling, which ships nothing to a tarball consumer, plus _version.py, whose
# git fallback has no repo to read outside the monorepo.
BIN_EXCLUDE="${0##*/}|_version.py|build-claude-config-tarball|workbench-export"

# Minimum expected file counts — catches silent glob failures
MIN_BIN_SCRIPTS=5
MIN_PYTHON_MODULES=5
MIN_REVIEW_TEMPLATES=4
MIN_AGENTS=1

# ─── Version ─────────────────────────────────────────────────────────────

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "Usage: build-otto-ai-tools-tarball [VERSION]"
  echo "Package otto-ai-tools into a self-contained tarball."
  echo "If VERSION is omitted, reads from .release-please-manifest.json."
  exit 0
fi

# Reject flags and extra arguments. MCP tool discovery probes executables in
# ai/bin with the schema flag; without this, it was accepted as a version
# string and the probe built a stray tarball into the caller's CWD. Naming the
# flag literally here would make this file look like a protocol implementation
# to the source scan in ai/claude/mcps/server.py.
if [[ "${1:-}" == -* ]]; then
  echo "ERROR: unknown option: $1" >&2
  echo "Usage: build-otto-ai-tools-tarball [VERSION]" >&2
  exit 2
fi
if (( $# > 1 )); then
  echo "ERROR: expected at most one argument, got $#" >&2
  echo "Usage: build-otto-ai-tools-tarball [VERSION]" >&2
  exit 2
fi

VERSION="${1:-}"
if [[ -z "$VERSION" ]]; then
  MANIFEST="$WORKBENCH_ROOT/.github/.release-please-manifest.json"
  if [[ ! -f "$MANIFEST" ]]; then
    echo "ERROR: No version argument and $MANIFEST not found" >&2
    exit 1
  fi
  VERSION=$(jq -r ".\"${MANIFEST_KEY}\"" "$MANIFEST")
  if [[ -z "$VERSION" || "$VERSION" == "null" ]]; then
    echo "ERROR: Could not read version from $MANIFEST" >&2
    exit 1
  fi
fi

echo "Building otto-ai-tools tarball v${VERSION}"

# ─── Staging ──────────────────────────────────────────────────────────────

STAGING="$(mktemp -d)"
trap 'rm -rf "$STAGING"' EXIT

DEST="$STAGING/otto-ai-tools-${VERSION}"
mkdir -p "$DEST/bin" "$DEST/lib/review-templates" "$DEST/agents"

# ─── Copy files ───────────────────────────────────────────────────────────

# Binaries — all executable scripts, excluding build tooling and support files
bin_count=0
for bin in "$SCRIPT_DIR"/*; do
  [[ -f "$bin" && -x "$bin" ]] || continue
  name="$(basename "$bin")"
  echo "$name" | grep -qE "^($BIN_EXCLUDE)$" && continue
  cp "$bin" "$DEST/bin/"
  bin_count=$((bin_count + 1))
done
if (( bin_count < MIN_BIN_SCRIPTS )); then
  echo "ERROR: found $bin_count bin scripts, expected >= $MIN_BIN_SCRIPTS" >&2
  exit 1
fi

# No sys.path patching: bin/ and lib/ are siblings under one root in both
# layouts — ai/bin/ beside ai/lib/ in the repo, bin/ beside lib/ in the tarball
# — so a script's own `.parent.parent / "lib"` resolves correctly in each.

# Library files — the layered packages, directories and all. Excluded at the
# copy rather than deleted after: `cp -R` on a package directory brings along
# whatever `__pycache__` a prior interpreter run left beside the source, and a
# delete pass that misses a path (or is itself dropped later) ships it anyway.
for pkg in "$_AI_LIB_DIR"/*/; do
  [[ -f "$pkg/__init__.py" ]] || continue
  rsync -a --exclude='__pycache__' --exclude='*.pyc' "${pkg%/}" "$DEST/lib/"
done

# Library files — bash modules required at runtime
for sh in "${BASH_MODULES[@]}"; do
  cp "$WORKBENCH_ROOT/lib/$sh" "$DEST/lib/"
done

# Library files — the Python modules ai/lib imports from the workbench lib
for py in "${WORKBENCH_PY_MODULES[@]}"; do
  cp "$WORKBENCH_ROOT/lib/$py" "$DEST/lib/"
done

# Templates — all .md files in the templates directory
for tpl in "$_AI_LIB_DIR/review-templates/"*.md; do
  cp "$tpl" "$DEST/lib/review-templates/"
done

# Agents — all .md files in the agents directory
for agent in "$_CLAUDE_DIR/agents/"*.md; do
  cp "$agent" "$DEST/agents/"
done

# Version file
echo "$VERSION" > "$DEST/VERSION"

# ─── Create standalone ui.sh facade ──────────────────────────────────────
# The monorepo's lib/ui.sh sources the full workbench framework. This facade
# sources only the modules copied above.

{
  echo '#!/usr/bin/env bash'
  # Constants that packaged scripts reference (subset of lib/constants.sh).
  # The three roots are not among them — roots.sh is copied in via BASH_MODULES
  # and sourced by the loop below, so the tarball resolves them the same way the
  # monorepo does instead of freezing a literal here.
  # shellcheck disable=SC2016
  echo 'CLAUDE_DIR="$HOME/.claude"'
  # shellcheck disable=SC2016
  echo '_ui_lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"'
  for sh in "$DEST/lib/"*.sh; do
    name="$(basename "$sh")"
    [[ "$name" == "ui.sh" ]] && continue
    echo ". \"\$_ui_lib_dir/$name\""
  done
  echo 'unset _ui_lib_dir'
} > "$DEST/lib/ui.sh"

# ─── Build tarball ────────────────────────────────────────────────────────

TARBALL="otto-ai-tools-${VERSION}.tar.gz"
tar -czf "$TARBALL" -C "$STAGING" "otto-ai-tools-${VERSION}"

# ─── Verify tarball ──────────────────────────────────────────────────────

contents=$(tar -tzf "$TARBALL")
failed=false

for entry in "bin/claude-review" "lib/ui.sh" "VERSION"; do
  if ! echo "$contents" | grep -q "$entry"; then
    echo "ERROR: tarball missing $entry" >&2
    failed=true
  fi
done

bin_tarball_count=$(echo "$contents" | grep -c 'bin/' || true)
py_count=$(echo "$contents" | grep -c '\.py$' || true)
agent_count=$(echo "$contents" | grep -c 'agents/.*\.md$' || true)
tpl_count=$(echo "$contents" | grep -c 'review-templates/.*\.md$' || true)

if (( bin_tarball_count < MIN_BIN_SCRIPTS )); then
  echo "ERROR: tarball has $bin_tarball_count bin scripts, expected >= $MIN_BIN_SCRIPTS" >&2
  failed=true
fi
if (( py_count < MIN_PYTHON_MODULES )); then
  echo "ERROR: tarball has $py_count Python modules, expected >= $MIN_PYTHON_MODULES" >&2
  failed=true
fi
if (( agent_count < MIN_AGENTS )); then
  echo "ERROR: tarball has $agent_count agents, expected >= $MIN_AGENTS" >&2
  failed=true
fi
if (( tpl_count < MIN_REVIEW_TEMPLATES )); then
  echo "ERROR: tarball has $tpl_count templates, expected >= $MIN_REVIEW_TEMPLATES" >&2
  failed=true
fi

if $failed; then exit 1; fi

echo "Created $TARBALL"
echo "SHA256: $(shasum -a 256 "$TARBALL" | cut -d' ' -f1)"
