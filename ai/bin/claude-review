#!/usr/bin/env python3
"""Run Claude's reviewer agent on a PR with local worktree checkout and iterative review support."""

from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from gh import client as gh_client
from git import client as git_client
from core import log
from pr import context as pr_context
from pr import state as pr_state
from pr.review_sync import sync_review_domain
from core import proc
from core import run_lock
from core import timeouts
from core import workbench_paths
from core.tool_parser import handle_value_flags
from core.trail import Trail, add_trail_args
try:
    from _version import version_string
except ImportError:
    def version_string(name):
        vf = Path(__file__).resolve().parent.parent / "VERSION"
        return f"{name} {vf.read_text().strip()}" if vf.is_file() else f"{name} unknown"
from agent.registry import add_phase_skip_flags, phase_skip_argv, phase_skips
from core.phases import Phase
from review.paths import (
    FILENAME_PIPELINE_STATE, FILENAME_POST_SESSION, FILENAME_PRIOR,
    FILENAME_SESSION, REVIEW_EXT, archive_review, review_file_path,
)
from review.summary import build_review_summary, json_summary, print_summary
from core import prompt
from review import issue as review_issue
from review import preflight as review_preflight
from review import recover as review_recover
from review import worktree as review_worktree
from pr.state import PostTracking
from core.serde import load_file as serde_load_file, to_dict as serde_to_dict

BIN_DIR = Path(__file__).resolve().parent
SCRIPT = Path(__file__).name

DEFAULT_MAX_PARALLEL = 1
GITHUB_BASE_URL = "https://github.com"


# ── Helpers ──────────────────────────────────────────────────────────────────

def _is_pr_ref(s: str) -> bool:
    return pr_context.is_pr_ref(s)


def _post_review(repo: str, pr_number: str, review_file: str, submit: bool) -> None:
    """Post a review to GitHub via review-post."""
    post_args = [
        str(BIN_DIR / "review-post"),
        "--pr", pr_number,
        "--review-file", review_file,
    ]
    if submit:
        post_args.append("--submit")
    subprocess.run(post_args, check=False, timeout=timeouts.UNBOUNDED)


def _display_review(path: Path) -> None:
    log.blank()
    log.info("─── Review ───")
    print()
    print(path.read_text())
    print()


def _print_summary(
    repo: str,
    pr_number: str,
    review_file: str,
    session_log: str,
    pr_url: str = "",
    post_session_log: str = "",
    branch_name: str = "",
    wall_clock_ms: int | None = None,
) -> None:
    print_summary(
        build_review_summary(repo, pr_number, review_file),
        session_log,
        pr_url,
        post_session_log,
        branch_name,
        wall_clock_ms,
    )


def _update_pr_state(
    ctx: pr_context.ResolvedContext, review_file: str, *, trail: Trail,
) -> None:
    """Record the review's outcome in the state of the target *ctx* names.

    ``ctx`` is the identity the entry point resolved for this run, threaded down
    rather than derived a second time here. Re-deriving read the *caller's*
    checkout, which on the ``--pr`` path is routinely a different branch than
    the PR's — so the verdict, finding counts, and cost landed with whatever the
    caller happened to be standing on. One identity per run, derived once.
    """
    if not review_file or not os.path.isfile(review_file):
        return
    report = build_review_summary(ctx.repo, str(ctx.pr_number or ""), review_file)
    sync_review_domain(ctx, report, trail=trail)


def _resolve_prior_review(review_file: Path, session_log: str, resume: bool) -> str:
    review_dir = review_file.parent
    if resume:
        prior = review_dir / FILENAME_PRIOR
        if prior.is_file():
            return str(prior)
        return ""
    return archive_review(review_file, session_log)


def _cleanup_prior_review(review_file: Path, prior_path: str) -> None:
    if not prior_path:
        return
    review_dir = review_file.parent
    pipeline_state = review_dir / FILENAME_PIPELINE_STATE
    if not pipeline_state.is_file():
        try:
            os.unlink(prior_path)
        except OSError:
            pass


def _generator_version() -> str:
    try:
        ver = version_string(SCRIPT)
        return ver.splitlines()[-1] if ver else "unknown"
    except Exception:
        return "unknown"


def _submit_pending_review(repo: str, pr_number: str, review_file: str) -> None:
    review_dir = Path(review_file).parent
    post_file = review_dir / FILENAME_POST_SESSION
    if not post_file.is_file():
        log.error(f"No post tracking file found: {post_file}")
        return

    tracking = serde_load_file(PostTracking, post_file)

    if not tracking or not tracking.review_id:
        log.error(f"Could not read review_id from {post_file}")
        return

    log.info(f"Submitting review #{tracking.review_id}...")
    r = gh_client.api(
        f"repos/{repo}/pulls/{pr_number}/reviews/{tracking.review_id}/events",
        method="POST", raw_fields={"event": "COMMENT"}, retry=False,
    )
    if r.ok:
        log.info(f"Review #{tracking.review_id} submitted")
    else:
        log.warn(f"Failed to submit review #{tracking.review_id}")

    try:
        tracking.submitted = True
        post_file.write_text(json.dumps(serde_to_dict(tracking)))
    except Exception:
        pass


def _verify_pr_ownership(pr_number: str, repo: str) -> None:
    author = gh_client.pr_view(pr_number, "author", repo=repo).get("author") or {}
    pr_author = author.get("login", "")
    gh_user = gh_client.login()

    if not pr_author or not gh_user or pr_author == gh_user:
        return

    log.warn(f"PR #{pr_number} is owned by {pr_author}, not {gh_user}")
    if not prompt.confirm("Continue with self-review?"):
        sys.exit(0)


def _fail_orchestration(msg: str, session_log: str) -> None:
    log.error(msg)
    if os.path.isfile(session_log):
        log.dim(f"Session log: {session_log}")
    sys.exit(1)


def _build_orchestrate_args(
    *,
    pr_number: str, repo: str, review_file: Path, wt_path: str,
    session_log: str, prior_review_path: str, issue_link: str,
    issue_context: str, max_parallel: int,
    max_cost: float | None, model: str | None, mode: str = "",
    fix_pass: bool = False, post: bool = False, effort: str | None = None,
    max_groups: int | None = None,
    skip_phases: frozenset[Phase] = frozenset(), disprove: bool | None = None,
    generated: bool = False, recover_sha: str = "",
    target_dir: Path,
) -> list[str]:
    args = [
        str(BIN_DIR / "review-orchestrate"),
        "--repo", repo,
        "--review-file", str(review_file),
        "--repo-dir", wt_path,
        "--target-dir", str(target_dir),
        "--session-log", session_log,
    ]
    if pr_number:
        args += ["--pr", pr_number]
    if mode:
        args += ["--mode", mode]
    if prior_review_path and os.path.isfile(prior_review_path):
        args += ["--prior-review", prior_review_path]
    if issue_link:
        args += ["--issue", issue_link]
    if issue_context:
        args += ["--issue-context", issue_context]
    args += ["--max-parallel", str(max_parallel)]
    args += ["--generator-version", _generator_version()]
    if fix_pass:
        args.append("--fix")
    # The publishing gate is process-wide and the fix pass runs in there, so the
    # only way it learns this run may publish is to be told on its own argv.
    if post:
        args.append("--post")
    if max_cost:
        args += ["--max-cost", str(max_cost)]
    if model:
        args += ["--model", model]
    # Forwarded only when asked for: an absent flag lets review-orchestrate
    # fall through to review.effort in config.yml.
    if effort:
        args += ["--effort", effort]
    if max_groups is not None:
        args += ["--max-groups", str(max_groups)]
    args += phase_skip_argv(skip_phases)
    if disprove is True:
        args.append("--disprove")
    if generated:
        args.append("--generated")
    if recover_sha:
        args += ["--recover-sha", recover_sha]
    return args


def _run_review_body(
    pr_number, repo, review_file, review_dir, wt_path,
    session_log, prior_review_path, issue_link, issue_context,
    max_parallel, max_cost, model, no_post, auto_post,
    auto_submit, pr_url, effort=None, max_groups=None,
    skip_phases=frozenset(), disprove=None, generated=False, recover_sha="",
    *, target_dir,
) -> None:
    orchestrate_args = _build_orchestrate_args(
        pr_number=pr_number, repo=repo, review_file=review_file,
        wt_path=wt_path, session_log=session_log,
        prior_review_path=prior_review_path, issue_link=issue_link,
        issue_context=issue_context, max_parallel=max_parallel,
        max_cost=max_cost, model=model,
        effort=effort, max_groups=max_groups,
        skip_phases=skip_phases, disprove=disprove, generated=generated,
        recover_sha=recover_sha, target_dir=target_dir,
    )
    wall_start = time.monotonic()
    rc = subprocess.run(orchestrate_args, timeout=timeouts.UNBOUNDED).returncode
    wall_ms = int((time.monotonic() - wall_start) * 1000)
    if rc != 0:
        _fail_orchestration("Review orchestration failed", session_log)
    if not review_file.is_file():
        _fail_orchestration("Review orchestration completed but produced no review file", session_log)

    _cleanup_prior_review(review_file, prior_review_path)
    _display_review(review_file)

    if no_post:
        _print_summary(repo, pr_number, str(review_file), session_log, pr_url, wall_clock_ms=wall_ms)
        log.dim("Post to GitHub:  pr review --post")
        return

    if auto_post:
        _post_review(repo, pr_number, str(review_file), auto_submit)
        post_session_log = str(review_dir / FILENAME_POST_SESSION)
        _print_summary(repo, pr_number, str(review_file), session_log, pr_url, post_session_log, wall_clock_ms=wall_ms)
        return

    if not prompt.confirm("Satisfied with the review?"):
        _print_summary(repo, pr_number, str(review_file), session_log, pr_url, wall_clock_ms=wall_ms)
        log.dim("Edit the review:  $EDITOR " + str(review_file))
        log.dim("Post to GitHub:   pr review --post")
        sys.exit(0)

    if not prompt.confirm("Post review to GitHub?"):
        _print_summary(repo, pr_number, str(review_file), session_log, pr_url, wall_clock_ms=wall_ms)
        log.dim("Post to GitHub:  pr review --post")
        return

    _post_review(repo, pr_number, str(review_file), False)
    post_session_log = str(review_dir / FILENAME_POST_SESSION)

    if prompt.confirm("Submit review now?"):
        _submit_pending_review(repo, pr_number, str(review_file))

    _print_summary(repo, pr_number, str(review_file), session_log, pr_url, post_session_log, wall_clock_ms=wall_ms)


# ── Main flows ───────────────────────────────────────────────────────────────

def _run_review_pr(
    trail, ctx, pr_number, repo, review_dir, review_file,
    issue_link, no_post, auto_post, auto_submit,
    force, repo_dir, max_parallel, max_cost, model,
    effort=None, max_groups=None,
    skip_phases=frozenset(), disprove=None, generated=False,
    recover=False, supersession_override=False,
) -> None:
    trail.info("resolve_context", f"resolved PR #{pr_number} in {repo}",
               data={"pr": pr_number, "repo": repo, "branch": ctx.branch})

    # Resolved before the issue lookup below, not with the worktree setup it
    # feeds further down: the repo's own .workbench.yml is what says which
    # tracker to read, and looking it up without one resolves to nothing.
    repo_root = review_worktree.find_repo_root(repo, repo_dir)
    if not repo_root:
        trail.error("setup_worktree", f"cannot find local clone of {repo}")
        log.error(f"Cannot find local clone of {repo}. Clone it first and re-run from within the repo.")
        sys.exit(1)

    # Issue detection
    pr_meta = gh_client.pr_view(pr_number, "headRefName", "body", repo=repo)
    pr_head = pr_meta.get("headRefName", "")
    pr_body = pr_meta.get("body", "")

    issue_context = ""
    detected_link = ""
    if not issue_link:
        provider_info = review_issue.load_issue_provider(repo_root)
        issue_id = review_issue.extract_issue_id(provider_info.name, pr_head, pr_body)
        issue_result = review_issue.fetch_issue_context(
            provider_info.name, issue_id, repo, provider_info.options,
        )
        detected_link = issue_result.link
        issue_context = issue_result.context
        if detected_link:
            issue_link = detected_link

        if not no_post and not auto_post and not issue_link and not issue_context:
            issue_link = prompt.ask("Issue link (optional, Enter to skip): ")

    if issue_link or issue_context:
        trail.info("issue_context", "issue context available",
                   data={"issue_link": issue_link, "has_context": bool(issue_context)})

    pr_url = f"{GITHUB_BASE_URL}/{repo}/pull/{pr_number}"

    if recover:
        recover_sha = review_recover.resolve_recover_sha(
            review_dir, review_recover.get_pr_head_sha(repo, pr_number))
        has_pipeline_state = True
        force = True
    else:
        recover_sha = ""
        has_pipeline_state = (review_dir / FILENAME_PIPELINE_STATE).is_file()

    if has_pipeline_state and review_file.exists():
        review_recover.should_auto_recover(repo, pr_number, review_file)

    if not has_pipeline_state:
        review_preflight.check_stale_review(repo, pr_number, review_file, force)
    trail.decision(
        "review_freshness",
        "resume" if has_pipeline_state else "fresh review",
        reason="pipeline state found" if has_pipeline_state else "no pipeline state",
        data={"has_pipeline_state": has_pipeline_state},
    )

    review_preflight.check_pending_review(repo, pr_number, force)

    # Worktree setup
    trail.info("setup_worktree", f"setting up PR worktree",
               data={"repo_root": repo_root, "pr_head": pr_head})

    wt_result = review_worktree.setup_pr_worktree(repo, pr_number, repo_root, pr_head)

    # pin_recover_worktree can exit, so it runs under the same finally as the
    # review itself — otherwise a fallback PR worktree would be left on disk.
    pinned_wt = None
    try:
        wt_path, pinned_wt = review_recover.pin_recover_worktree(
            recover_sha, wt_result.path, repo_root, f"recover-pr-{pr_number}",
        )

        # Inside the try, so a refusal still cleans up the worktree it read.
        # Its own flag rather than the `force` above, which by here has
        # absorbed --post/--no-post — see review_preflight.supersession_override.
        review_preflight.refuse_if_superseded(
            wt_path, repo, ctx.target_dir, ctx.branch,
            override=supersession_override, trail=trail,
        )

        session_log = str(review_dir / FILENAME_SESSION)
        prior_review_path = _resolve_prior_review(review_file, session_log, has_pipeline_state)

        trail.info("delegate_orchestrate", "delegating to review-orchestrate",
                   data={"wt_path": wt_path, "max_parallel": max_parallel,
                         "skipped": sorted(str(p) for p in skip_phases),
                         "max_cost": max_cost, "model": model})

        _run_review_body(
            pr_number, repo, review_file, review_dir, wt_path,
            session_log, prior_review_path, issue_link, issue_context,
            max_parallel, max_cost, model, no_post, auto_post,
            auto_submit, pr_url, effort=effort, max_groups=max_groups,
            skip_phases=skip_phases, disprove=disprove, generated=generated,
            recover_sha=recover_sha, target_dir=ctx.target_dir,
        )
    finally:
        review_worktree.cleanup_worktree(pinned_wt, repo_root)
        review_worktree.cleanup_worktree(wt_result, repo_root)


def _run_review(args, ctx: pr_context.ResolvedContext) -> None:
    """Review the PR *ctx* names.

    ``ctx`` comes from ``main()``, which resolved it to take the run lock.
    Resolving it again from the same inputs cost a ``gh`` round trip per review
    and left two independently derived copies of the one value this branch
    exists to derive once.
    """
    no_post = args.no_post
    auto_post = args.post
    auto_submit = args.submit
    issue_link = args.issue or ""
    max_parallel = args.max_parallel
    force = args.force
    skip_phases = phase_skips(args)
    disprove = args.disprove
    max_cost = args.max_cost
    model = args.model
    repo_dir = args.repo_dir or ""
    effort = args.effort
    max_groups = args.max_groups
    generated = args.generated
    recover = getattr(args, "recover", False)

    if no_post or auto_post:
        force = True

    pr_number = str(ctx.pr_number)
    repo = ctx.repo

    review_file = review_file_path(repo, pr_number)
    review_dir = review_file.parent
    review_dir.mkdir(parents=True, exist_ok=True)

    trail = Trail.start(
        script=SCRIPT,
        context={"repo": repo, "pr": pr_number, "branch": ctx.branch, "mode": "pr"},
        debug=getattr(args, "debug", False),
    )

    try:
        _run_review_pr(
            trail, ctx, pr_number, repo, review_dir, review_file,
            issue_link, no_post, auto_post, auto_submit,
            force, repo_dir, max_parallel, max_cost, model,
            effort=effort, max_groups=max_groups,
            skip_phases=skip_phases, disprove=disprove, generated=generated,
            recover=recover,
            supersession_override=review_preflight.supersession_override(args.force, recover),
        )
        # Inside the trail's scope, so a failed write has somewhere to report.
        _update_pr_state(ctx, str(review_file), trail=trail)
    except Exception as exc:
        trail.error("unexpected_error", str(exc))
        raise
    finally:
        trail.finish()


def _run_self_review_body(
    repo, pr_number, wt_path, issue_link, max_parallel,
    max_cost, model, fix_pass, args,
    self_review_dir, branch_name, effort=None, max_groups=None,
    skip_phases=frozenset(), disprove=None, generated=False,
    recover=False, head_sha="", *, ctx: pr_context.ResolvedContext, trail: Trail,
) -> None:
    review_file = self_review_dir / f"review{REVIEW_EXT}"
    session_log = str(self_review_dir / FILENAME_SESSION)

    # First thing in the body, ahead of the issue-context fetch below: this is
    # the cheapest point at which the run can still cost nothing.
    review_preflight.refuse_if_superseded(
        wt_path, repo, ctx.target_dir, branch_name,
        override=review_preflight.supersession_override(args.force, recover), trail=trail,
    )

    if recover:
        recover_sha = review_recover.resolve_recover_sha(self_review_dir, head_sha)
        has_pipeline_state = True
    else:
        recover_sha = ""
        has_pipeline_state = (self_review_dir / FILENAME_PIPELINE_STATE).is_file()
    prior_review_path = _resolve_prior_review(review_file, session_log, has_pipeline_state)

    issue_context = ""
    if not issue_link:
        provider_info = review_issue.load_issue_provider(wt_path)
        issue_id = review_issue.extract_issue_id(provider_info.name, branch_name)
        issue_result = review_issue.fetch_issue_context(
            provider_info.name, issue_id, repo, provider_info.options,
        )
        detected_link = issue_result.link
        issue_context = issue_result.context
        if detected_link:
            issue_link = detected_link

    if fix_pass and review_recover.recover_drifted(recover_sha, wt_path):
        log.error(
            f"--fix cannot run on a review recovered at {git_client.abbrev(recover_sha)} — HEAD has "
            f"moved, so the edits would land in a throwaway checkout. Recover without "
            f"--fix, then run `pr review --self --fix`."
        )
        sys.exit(1)

    review_wt_path, pinned_wt = review_recover.pin_recover_worktree(
        recover_sha, wt_path, wt_path, f"recover-{branch_name}",
    )
    orchestrate_args = _build_orchestrate_args(
        pr_number=pr_number, repo=repo, review_file=review_file,
        wt_path=review_wt_path, session_log=session_log,
        prior_review_path=prior_review_path, issue_link=issue_link,
        issue_context=issue_context, max_parallel=max_parallel,
        max_cost=max_cost, model=model,
        mode="self", fix_pass=fix_pass, post=args.post or args.push,
        effort=effort, max_groups=max_groups,
        skip_phases=skip_phases, disprove=disprove, generated=generated,
        recover_sha=recover_sha, target_dir=ctx.target_dir,
    )

    wall_start = time.monotonic()
    try:
        rc = subprocess.run(orchestrate_args, timeout=timeouts.UNBOUNDED).returncode
    finally:
        review_worktree.cleanup_worktree(pinned_wt, wt_path)
    wall_ms = int((time.monotonic() - wall_start) * 1000)
    if rc != 0:
        _fail_orchestration("Review orchestration failed", session_log)
    if not review_file.is_file():
        _fail_orchestration("Review orchestration completed but produced no review file", session_log)

    _cleanup_prior_review(review_file, prior_review_path)
    _display_review(review_file)

    pr_url = f"{GITHUB_BASE_URL}/{repo}/pull/{pr_number}" if pr_number else ""
    _print_summary(repo, pr_number, str(review_file), session_log, pr_url, "", branch_name, wall_clock_ms=wall_ms)

    _update_pr_state(ctx, str(review_file), trail=trail)

    json_stdout = getattr(args, "_json_stdout", None)
    if json_stdout is not None:
        summary = json_summary(repo, pr_number, str(review_file))
        os.write(json_stdout, (summary + "\n").encode())


def _run_self_review(args) -> None:
    pr_input = args.positional[0] if args.positional else ""
    issue_link = args.issue or ""
    max_parallel = args.max_parallel
    skip_user_verification = args.skip_user_verification
    force = args.force
    skip_phases = phase_skips(args)
    disprove = args.disprove
    max_cost = args.max_cost
    model = args.model
    repo_dir = args.repo_dir or ""
    fix_pass = args.fix
    effort = args.effort
    max_groups = args.max_groups
    generated = args.generated
    recover = getattr(args, "recover", False)

    is_pr = False
    is_branch = False
    if pr_input:
        if _is_pr_ref(pr_input):
            is_pr = True
        else:
            is_branch = True

    if is_branch:
        pr_input = review_worktree.resolve_branch_input(pr_input, repo_dir)

    # Only a branch name is a worktree target — passing a PR ref here would have
    # the resolver create a worktree on a branch named after the PR number.
    wt_path = review_worktree.resolve_wt_path(repo_dir, pr_input if is_branch else "")

    ctx = pr_context.resolve(
        pr=pr_input if is_pr else None,
        branch=pr_input if is_branch else None,
        repo_dir=wt_path,
    )
    repo = ctx.repo
    pr_number = str(ctx.pr_number) if ctx.pr_number else ""

    # Before the checkout is switched or a --fix pass edits it: two `--self`
    # runs on one branch are two processes committing to it. A no-op when `pr`
    # launched us — we resolve the same target and find its key already in
    # WORKBENCH_RUN_LOCK.
    run_lock.claim_for_process(
        ctx.target_dir,
        command=" ".join(["claude-review"] + sys.argv[1:]),
        started=pr_state.now_iso(),
    )

    wt_cleanup: review_worktree.WorktreeResult | None = None

    if is_pr:
        if not skip_user_verification:
            _verify_pr_ownership(pr_number, repo)
        wt_cleanup = review_worktree.switch_to_pr_branch(pr_number, repo, wt_path)
        if wt_cleanup:
            wt_path = wt_cleanup.path
    elif is_branch:
        wt_cleanup = review_worktree.switch_to_branch(pr_input, wt_path)
        if wt_cleanup:
            wt_path = wt_cleanup.path

    # Read HEAD after the switch — checking out a PR hard-resets the worktree to
    # the remote head, so ctx.head_sha can predate the commit the pipeline recorded.
    recover_head_sha = pr_context.head_sha(wt_path) if recover else ""

    repo_name = repo.split("/")[-1]
    branch_sanitized = (ctx.branch or "").replace("/", "-")
    self_review_dir = workbench_paths.reviews_dir() / f"{repo_name}-self-{branch_sanitized}"
    self_review_dir.mkdir(parents=True, exist_ok=True)

    trail = Trail.start(
        script=SCRIPT,
        context={"repo": repo, "pr": pr_number, "branch": ctx.branch, "mode": "self"},
        debug=getattr(args, "debug", False),
    )

    try:
        trail.info("resolve_context", f"self-review in {repo}",
                   data={"pr": pr_number, "repo": repo, "branch": ctx.branch, "wt_path": wt_path})
        _run_self_review_body(
            repo, pr_number, wt_path, issue_link, max_parallel,
            max_cost, model, fix_pass, args,
            self_review_dir=self_review_dir,
            branch_name=ctx.branch or "",
            effort=effort, max_groups=max_groups,
            skip_phases=skip_phases, disprove=disprove, generated=generated,
            recover=recover, head_sha=recover_head_sha,
            ctx=ctx, trail=trail,
        )
    except Exception as exc:
        trail.error("unexpected_error", str(exc))
        raise
    finally:
        trail.finish()
        if wt_cleanup:
            review_worktree.cleanup_self_review_worktree(wt_cleanup, repo_dir)


# ── Main ─────────────────────────────────────────────────────────────────────

def main() -> None:
    signal.signal(
        signal.SIGINT,
        lambda *_: (log.blank(), log.info("Interrupted"),
                    sys.exit(proc.INTERRUPT_RETURNCODE)))

    parser = argparse.ArgumentParser(
        prog=SCRIPT,
        description="Run Claude's reviewer agent on a PR",
        add_help=True,
    )
    parser.add_argument("--no-post", action="store_true")
    parser.add_argument("--post", action="store_true")
    parser.add_argument("--submit", action="store_true")
    parser.add_argument("--self", action="store_true", dest="self_review")
    parser.add_argument("--fix", action="store_true")
    parser.add_argument("--push", action="store_true")
    parser.add_argument("--skip-user-verification", action="store_true")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--recover", action="store_true")
    add_phase_skip_flags(parser)
    parser.add_argument("--disprove", action="store_true", default=None)
    parser.add_argument("--json-summary", action="store_true")
    parser.add_argument("--issue")
    parser.add_argument("--max-parallel", type=int, default=DEFAULT_MAX_PARALLEL)
    parser.add_argument("--max-cost", type=float)
    parser.add_argument("--model")
    parser.add_argument("--effort", choices=["low", "medium", "high"], default=None,
                        help="Effort preset (default: review.effort in config.yml, else medium)")
    parser.add_argument("--max-groups", type=int, default=None)
    parser.add_argument("--generated", action="store_true")
    parser.add_argument("--repo-dir", "--worktree", dest="repo_dir")
    parser.add_argument("--branch")
    parser.add_argument("--pr")
    parser.add_argument("-V", "--version", action="store_true")
    parser.add_argument("args", nargs="*")
    add_trail_args(parser)
    handle_value_flags(parser)

    parsed = parser.parse_args()

    if parsed.version:
        print(version_string(SCRIPT))
        sys.exit(0)

    # JSON summary: save real stdout, redirect stdout to stderr
    _json_stdout_fd = None
    if parsed.json_summary:
        _json_stdout_fd = os.dup(sys.stdout.fileno())
        os.dup2(sys.stderr.fileno(), sys.stdout.fileno())
        sys.stdout = os.fdopen(sys.stdout.fileno(), "w", closefd=False)

    if not parsed.repo_dir and os.environ.get("REPO_DIR"):
        parsed.repo_dir = os.environ["REPO_DIR"]

    # Flatten positional args, incorporating --pr and --branch from dispatcher
    parsed.positional = list(parsed.args)
    if parsed.pr and not parsed.positional:
        parsed.positional = [parsed.pr]

    workbench_paths.reviews_dir().mkdir(parents=True, exist_ok=True)

    if parsed.fix and not parsed.self_review:
        log.error("--fix requires --self")
        sys.exit(1)

    if parsed.push and not parsed.fix:
        log.error("--push requires --fix")
        sys.exit(1)

    if parsed.recover and parsed.force:
        log.error("--recover and --force are mutually exclusive")
        sys.exit(1)

    if parsed.self_review:
        parsed._json_stdout = _json_stdout_fd
        _run_self_review(parsed)
        if _json_stdout_fd is not None:
            os.close(_json_stdout_fd)
        return

    if parsed.no_post and parsed.post:
        log.error("--no-post and --post are mutually exclusive")
        sys.exit(1)

    command = parsed.positional[0] if parsed.positional else ""
    if not command:
        parser.print_help()
        sys.exit(1)

    _REMOVED = {"gc": "pr gc", "post": "pr review --post", "rebuild": "pr review --repair",
                "summary": "pr review --summary", "threads": "pr comments"}
    if command in _REMOVED:
        log.error(f"'{command}' subcommand removed. Use: {_REMOVED[command]}")
        sys.exit(1)

    pr_arg, branch_arg = pr_context.classify_target(command)
    ctx = pr_context.resolve(pr=pr_arg, branch=branch_arg, repo_dir=parsed.repo_dir)
    pr_num = str(ctx.pr_number)
    review_file = review_file_path(ctx.repo, pr_num)
    # A no-op when pr launched us — we resolve the same target and find its key
    # already in WORKBENCH_RUN_LOCK.
    run_lock.claim_for_process(
        ctx.target_dir,
        command=" ".join([SCRIPT] + sys.argv[1:]),
        started=pr_state.now_iso(),
    )
    _run_review(parsed, ctx)
    if _json_stdout_fd is not None:
        summary = json_summary(ctx.repo, pr_num, str(review_file))
        os.write(_json_stdout_fd, (summary + "\n").encode())
        os.close(_json_stdout_fd)


if __name__ == "__main__":
    main()
