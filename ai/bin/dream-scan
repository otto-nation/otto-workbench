#!/usr/bin/env python3
"""Scan session transcripts and memory state for dream consolidation.

Replaces Phases 1+2 of the dream skill (Orient + Gather Signal).
Outputs a structured markdown report to stdout.

Sessions come from ``core.sessions``, which owns what a session is and where
one lives across every harness on the machine. This script used to answer that
itself, with Claude Code's directory layout and its record shape: interactive
work moved to Pi and the scan went blind to most of the corpus while reporting
nothing amiss. The report header now prints a per-harness count, so a harness
that has stopped being discovered reads as a zero rather than as a corpus that
quietly halved.

Usage:
  dream-scan [--days N] [--home DIR] [--list-transcripts] [--memory-dir REPO]

The two exit-early flags answer "where does the corpus live" for callers that
need the paths rather than the report: ``--list-transcripts`` prints every
transcript in the window, one per line, and ``--memory-dir`` prints the memory
directory for one repo. Skills use them instead of globbing a harness's tree.
"""

from __future__ import annotations

import argparse
import os
import re
import sys
from collections import Counter
from datetime import datetime, timedelta
from pathlib import Path

# ai/lib, from WORKBENCH_AI_LIB_DIR's checkout when that is set — see ai/bin/_libdir.py
_AI_LIB_DIR = Path(__file__).resolve().parent.parent / "lib"
if os.environ.get("WORKBENCH_AI_LIB_DIR"):
    sys.path.insert(0, str(_AI_LIB_DIR.parent / "bin"))
    from _libdir import pinned_ai_lib_dir
    del sys.path[0]
    _AI_LIB_DIR = pinned_ai_lib_dir()
sys.path.insert(0, str(_AI_LIB_DIR))
# Deliberately unpinned: _version is this entry point's own, not the checked-out
# ai/lib's, so it always comes from this file's own ai/bin regardless of the pin.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from _version import version_string as _version_string  # noqa: E402
from core.trail import Trail, add_trail_args  # noqa: E402


# ── Constants ────────────────────────────────────────────────────────────────

SCRIPT = Path(__file__).name
MAX_TEXT_LENGTH = 500
TEXT_PREVIEW_LENGTH = 200
DEFAULT_DAYS = 7

FRONTMATTER_DELIMITER = "---"
MEMORY_INDEX = "MEMORY.md"
LAST_DREAM_FILE = ".last-dream"
TOPIC_GLOB = "*.md"

DATE_FMT = "%Y-%m-%d"
DATETIME_FMT = "%Y-%m-%d %H:%M"

SIGNAL_PATTERNS: dict[str, re.Pattern] = {
    "correction": re.compile(
        r"\b(?:actually|wrong|incorrect|not right|stop doing|don't do"
        r"|I said|I meant|that's not|correction)\b"
        r"|(?:^|\W)no,",
        re.IGNORECASE,
    ),
    "preference": re.compile(
        r"\b(?:I prefer|always use|never use|I like|I don't like|I want"
        r"|from now on|going forward|remember that|keep in mind"
        r"|make sure to|default to)\b",
        re.IGNORECASE,
    ),
    "decision": re.compile(
        r"\b(?:let's go with|I decided|we're using|the plan is"
        r"|switch to|move to|chosen|picked|decision|we agreed)\b",
        re.IGNORECASE,
    ),
    "pattern": re.compile(
        r"\b(?:every time|keep forgetting|as usual|same as before"
        r"|like last time|we always|the usual)\b"
        r"|(?:^|\W)again\b",
        re.IGNORECASE,
    ),
    "review_feedback": re.compile(
        r"\b(?:accepted|rejected|won't-fix|false positive|not applying)\b",
        re.IGNORECASE,
    ),
}

SIGNAL_PRIORITY = ["correction", "preference", "decision", "pattern", "review_feedback"]

STALE_DAYS = 90


from core import log, sessions


# ── Core functions ───────────────────────────────────────────────────────────


def classify_signal(text: str) -> str | None:
    for category in SIGNAL_PRIORITY:
        if SIGNAL_PATTERNS[category].search(text):
            return category
    return None


def parse_frontmatter(path: str | Path) -> dict:
    path = Path(path)
    if not path.exists():
        return {}
    lines = path.read_text().splitlines()
    return _parse_frontmatter_lines(lines)


def _parse_frontmatter_lines(lines: list[str]) -> dict:
    try:
        start = lines.index(FRONTMATTER_DELIMITER) + 1
        end = lines.index(FRONTMATTER_DELIMITER, start)
    except ValueError:
        return {}
    result: dict[str, str] = {}
    for line in lines[start:end]:
        if line.startswith(" ") or ":" not in line:
            continue
        key, _, value = line.partition(":")
        result[key.strip()] = value.strip()
    return result


# ── Scanning ─────────────────────────────────────────────────────────────────


def _read_last_dream(memory_dir: Path) -> str | None:
    stamp = memory_dir / LAST_DREAM_FILE
    if not stamp.exists():
        return None
    try:
        ts = int(stamp.read_text().strip())
        return datetime.fromtimestamp(ts).strftime(DATETIME_FMT)
    except (ValueError, OSError):
        return None


def _scan_topic_file(f: Path, now: datetime) -> dict:
    fm = parse_frontmatter(f)
    mtime = datetime.fromtimestamp(f.stat().st_mtime)
    age_days = (now - mtime).days
    return {
        "filename": f.name,
        "name": fm.get("name", ""),
        "description": fm.get("description", ""),
        "type": fm.get("type", ""),
        "size": f.stat().st_size,
        "modified": mtime.strftime(DATE_FMT),
        "stale": age_days > STALE_DAYS,
        "age_days": age_days,
    }


def scan_memory_state(home: Path) -> list[dict]:
    now = datetime.now()
    states = []
    for memory_dir in sessions.memory_dirs(home):
        memory_md = memory_dir / MEMORY_INDEX
        if not memory_md.exists():
            continue
        topic_files = [
            _scan_topic_file(f, now)
            for f in sorted(memory_dir.glob(TOPIC_GLOB))
            if f.name != MEMORY_INDEX
        ]
        states.append({
            "project_id": memory_dir.parent.name,
            "line_count": len(memory_md.read_text().splitlines()),
            "last_dream": _read_last_dream(memory_dir),
            "topic_files": topic_files,
        })
    return states


def _signals_in(session: sessions.Session) -> list[dict]:
    """Every classified human turn in one transcript.

    Each signal is dated from its own record rather than from the file, which
    is what makes "how many distinct dates mention this" — how dream weighs a
    signal — mean anything. Dating by mtime gave every turn in a session the
    date the session last ended, so a week of work in one long-running session
    counted once.
    """
    signals = []
    for message in sessions.iter_user_messages(session):
        category = classify_signal(message.text)
        if category is None:
            continue
        signals.append({
            "category": category,
            "text": message.text[:MAX_TEXT_LENGTH],
            "project_id": _project_id_of(message),
            "session_date": message.date,
        })
    return signals


def _project_id_of(message: sessions.UserMessage) -> str:
    """What to file a signal under.

    The canonical slug of the cwd the session recorded, which is stable across
    harnesses — the same repo worked in from Claude and from Pi files under one
    id rather than two, because the harnesses' own directory names encode
    differently. A transcript that never stated a cwd is filed under its
    harness, which is all that is known about it.
    """
    if message.project_path is None:
        return message.harness
    return sessions.canonical_slug(message.project_path)


def scan_sessions(discovered: list[sessions.Session]) -> list[dict]:
    signals = []
    for session in discovered:
        signals.extend(_signals_in(session))
    return signals


# ── Report ───────────────────────────────────────────────────────────────────


def _format_memory_state(state: dict) -> list[str]:
    lines = [f"### {state['project_id']}"]
    lines.append(f"MEMORY.md: {state['line_count']} lines")
    if state["last_dream"]:
        lines.append(f"Last dream: {state['last_dream']}")
    lines.append("")

    if not state["topic_files"]:
        return lines

    lines.append("| File | Name | Description | Type | Modified | Age |")
    lines.append("|------|------|-------------|------|----------|-----|")
    for tf in state["topic_files"]:
        stale_marker = " **STALE**" if tf["stale"] else ""
        lines.append(
            f"| {tf['filename']} | {tf['name']} | {tf['description']} "
            f"| {tf['type']} | {tf['modified']} | {tf['age_days']}d{stale_marker} |"
        )
    lines.append("")

    stale_files = [tf for tf in state["topic_files"] if tf["stale"]]
    if stale_files:
        lines.append(f"**Stale entries (>90 days):** {', '.join(tf['filename'] for tf in stale_files)}")
        lines.append("")
    return lines


def _format_signal_category(category: str, cat_signals: list[dict]) -> list[str]:
    lines = [f"### {category} ({len(cat_signals)})\n"]
    for sig in cat_signals:
        lines.append(f"- **[{sig['session_date']}]** `{sig['project_id']}`")
        text_preview = sig["text"].replace("\n", " ")[:TEXT_PREVIEW_LENGTH]
        lines.append(f"  > {text_preview}")
        lines.append("")
    return lines


def format_report(
    memory_states: list[dict],
    signals: list[dict],
    counts: dict[str, int] | None = None,
) -> str:
    lines: list[str] = []
    if counts is not None:
        lines.extend(_format_counts(counts))
    lines.append("## Memory State\n")
    lines.extend(_format_memory_section(memory_states))
    lines.append("## Session Signals\n")
    lines.extend(_format_signals_section(signals))
    return "\n".join(lines)


def _format_counts(counts: dict[str, int]) -> list[str]:
    """Transcripts scanned, per harness.

    Stated because it is the only thing that makes a harness going undiscovered
    visible: the failure is silent otherwise, and was — a scan of Claude alone
    reported a full-looking corpus for months while most sessions were Pi's.
    A zero here is the signal to check the layout table in core/sessions.py.
    """
    total = sum(counts.values())
    per = ", ".join(f"{name} {n}" for name, n in sorted(counts.items()))
    return ["## Sessions Scanned\n", f"{total} transcripts — {per}\n"]


def _format_memory_section(states: list[dict]) -> list[str]:
    if not states:
        return ["No memory directories found.\n"]
    lines: list[str] = []
    for state in states:
        lines.extend(_format_memory_state(state))
    return lines


def _format_signals_section(signals: list[dict]) -> list[str]:
    if not signals:
        return ["No signals found in recent sessions.\n"]
    lines: list[str] = []
    for category in SIGNAL_PRIORITY:
        cat_signals = [s for s in signals if s["category"] == category]
        if not cat_signals:
            continue
        lines.extend(_format_signal_category(category, cat_signals))
    return lines


# ── Main ─────────────────────────────────────────────────────────────────────


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Scan session transcripts and memory state for dream consolidation.",
        usage=f"{SCRIPT} [--days N] [--home DIR] [--list-transcripts] [--memory-dir]",
    )
    parser.add_argument("-V", "--version", action="store_true", help="print version and exit")
    parser.add_argument("--days", type=int, default=DEFAULT_DAYS, help=f"scan sessions from last N days (default: {DEFAULT_DAYS})")
    parser.add_argument("--home", type=str, default=os.environ.get("HOME", ""), help="home directory override (for testing)")
    parser.add_argument(
        "--list-transcripts",
        action="store_true",
        help="print transcript paths for the window, one per line, and exit",
    )
    parser.add_argument(
        "--memory-dir",
        metavar="REPO",
        help="print the memory directory for the repo at REPO, and exit",
    )
    add_trail_args(parser)
    args = parser.parse_args()

    if args.version:
        print(_version_string(SCRIPT))
        raise SystemExit(0)

    home = Path(args.home)

    # Phases 5 and 5b of the dream skill grep the corpus for architectural and
    # machine-level facts, which needs the file list rather than the report.
    # Printing it here keeps one answer to "where are the sessions": a skill
    # globbing a harness directory itself is what went blind when work moved to
    # Pi.
    if args.list_transcripts:
        cutoff = datetime.now() - timedelta(days=args.days)
        for session in sessions.discover_sessions(home, since=cutoff):
            print(session.path)
        raise SystemExit(0)

    # The architecture skill reads a repo's memory before proposing changes, and
    # was building the directory name with a transform of its own that did not
    # match Claude's — so it resolved to nothing for any repo whose path holds a
    # `_` or a `.`. Same reasoning as the branch above: the script that owns the
    # location answers, rather than each skill deriving it again.
    if args.memory_dir is not None:
        print(sessions.claude_memory_dir(home, args.memory_dir))
        raise SystemExit(0)

    trail = Trail.start(
        script=SCRIPT,
        context={"days": args.days},
        debug=args.debug,
    )

    try:
        log.info(f"Scanning sessions from last {args.days} days")
        log.info(f"Home: {home}")

        memory_states = scan_memory_state(home)
        log.info(f"Found {len(memory_states)} project(s) with memory")
        trail.info("scan_memories", f"found {len(memory_states)} memory files across {sum(len(s.get('topic_files', [])) for s in memory_states)} topics")

        cutoff = datetime.now() - timedelta(days=args.days)
        discovered = sessions.discover_sessions(home, since=cutoff)
        # Tallied off the list already in hand, not by a second discovery pass:
        # every Session carries the harness that wrote it. Seeded from HARNESSES
        # first so a harness that went undiscovered reports `pi 0` rather than
        # dropping out of the header — the silent failure _format_counts exists
        # to make visible, and what tests/dream_scan.bats asserts end to end.
        counts = {h.name: 0 for h in sessions.HARNESSES}
        counts.update(Counter(s.harness for s in discovered))
        log.info(f"Sessions: {counts}")

        signals = scan_sessions(discovered)
        log.info(f"Found {len(signals)} signal(s)")
        trail.info(
            "scan_sessions",
            f"scanned {sum(counts.values())} transcripts ({counts}) from last "
            f"{args.days} days, found {len(signals)} signals",
        )

        report = format_report(memory_states, signals, counts)
        trail.info("generate_report", f"report generated, {len(report)} chars")
        print(report)
    except Exception as exc:
        trail.error("unexpected_error", str(exc))
        raise
    finally:
        trail.finish()


if __name__ == "__main__":
    main()
