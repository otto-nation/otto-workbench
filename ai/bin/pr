#!/usr/bin/env python3
"""Unified PR lifecycle CLI — creation, CI, code review, comments, rebasing, and push state.

`pr [global flags] <command> [flags]`. The global flags work in any position and
name which worktree, branch, or PR a command acts on; omit them and all three
are resolved from the current directory. `pr <command> --help` prints that
command's own flags, and `--tool-schema` prints a JSON document describing the
tool (or, after a command, that command) and exits.

The flag tables below are rendered from the parsers `pr` parses with. How each
command behaves — phases, review modes, comment settlement, rebase conflict
handling — is in [AI Automation](ai-automation.md), and each module's own account
is in [AI Libraries](ai-libraries.md).
"""

# `--tool-schema` is answered in cli.pr before context resolution; see
# ai/lib/core/tool_parser.py for the protocol. The MCP server imports
# cli.schema.tool_schema directly rather than spawning this binary.

import os
import sys
from pathlib import Path

BIN_DIR = Path(__file__).resolve().parent
# ai/lib, from WORKBENCH_AI_LIB_DIR's checkout when that is set — see ai/bin/_libdir.py
_AI_LIB_DIR = BIN_DIR.parent / "lib"
if os.environ.get("WORKBENCH_AI_LIB_DIR"):
    sys.path.insert(0, str(_AI_LIB_DIR.parent / "bin"))
    from _libdir import pinned_ai_lib_dir
    del sys.path[0]
    _AI_LIB_DIR = pinned_ai_lib_dir()
sys.path.insert(0, str(_AI_LIB_DIR))

from cli.pr import main  # noqa: E402

# Why bin_dir is passed rather than derived by cli/pr.py itself: see that
# module's docstring.
sys.exit(main(sys.argv[1:], bin_dir=BIN_DIR))
