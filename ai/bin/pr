#!/usr/bin/env python3
"""Unified PR lifecycle CLI — CI, code review, comments, rebasing, and push state.

```
pr [global flags] <command> [flags]
pr status
pr ci [--fix] [--post]
pr review [--self] [--fix] [--push] [--post] [--repair] [--summary]
pr comments [--triage] [--fix] [--finish] [--post]
pr fix
pr rebase [--fix] [--push] [--abort] [--onto <ref>]
pr describe [--force] [--dry-run] [--post]
pr gc
```

Global flags (`--repo-dir`, `--branch`, `--pr`) apply to every command; omit them
and the worktree, branch, and PR are resolved from the current directory.
`--tool-schema` prints a JSON document describing the tool (or, after a
subcommand, that command) and exits.

Deeper behaviour — phases, review modes, comment settlement, rebase conflict
handling — is in docs/ai-automation.md and the modules in docs/ai-libraries.md.
"""

# `--tool-schema` is answered in cli.pr before context resolution; see
# ai/lib/core/tool_parser.py for the protocol. The MCP server imports
# cli.schema.tool_schema directly rather than spawning this binary.

import os
import sys
from pathlib import Path

BIN_DIR = Path(__file__).resolve().parent
# ai/lib, from WORKBENCH_AI_LIB_DIR's checkout when that is set — see ai/bin/_libdir.py
_AI_LIB_DIR = BIN_DIR.parent / "lib"
if os.environ.get("WORKBENCH_AI_LIB_DIR"):
    sys.path.insert(0, str(_AI_LIB_DIR.parent / "bin"))
    from _libdir import pinned_ai_lib_dir
    del sys.path[0]
    _AI_LIB_DIR = pinned_ai_lib_dir()
sys.path.insert(0, str(_AI_LIB_DIR))

from cli.pr import main  # noqa: E402

# Why bin_dir is passed rather than derived by cli/pr.py itself: see that
# module's docstring.
sys.exit(main(sys.argv[1:], bin_dir=BIN_DIR))
