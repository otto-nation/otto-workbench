#!/usr/bin/env bash
# PreToolUse guard for the Bash tool.
#
# Reads a hook payload on stdin and exits 2 with an explanation when the command
# matches a shape that triggers a permission prompt no allow-list rule can
# suppress. Exits 0 otherwise.
#
# The message each rule blocks with comes from ai/claude/bin/bash-guard.rules.yml,
# which also generates the matching section of ai/guidelines/rules/ — a rule with
# no entry there has no documented alternative, so Claude gets blocked without
# being told what to do instead. Add the entry, then run
# bin/local/generate-bash-guard. Enforced by tests/claude_settings.bats.
#
# Usage: claude-bash-guard        (stdin: {"tool_input":{"command":"..."}})

set -e

# >>> generated: block messages — edit bash-guard.rules.yml, not this table
GUARD_MSG_gh_pr_create="The repo PR template is skipped when gh pr create is called directly. Use task pr:create instead. See git-operations.md."
GUARD_MSG_bin_local="Permission rules match the first word of the command, so an absolute path prompts again in every worktree. Use relative path '{match}' instead. See bash.md."
GUARD_MSG_cmd_substitution="Claude Code's static analyzer cannot resolve the substitution, triggering a \"cannot be statically analyzed\" permission prompt. Run the inner command first, then use the result in the next call. See bash-tool.md."
GUARD_MSG_compound_cd="Compound commands containing cd trigger an unsuppressible security prompt in Claude Code. Use these alternatives instead. See bash-tool.md."
GUARD_MSG_env_chdir="The analyzer reports \"env with -C flag cannot be statically analyzed\", which no permission rule can suppress; env -C is not an escape hatch from the compound-cd rule, it is a second unsuppressible prompt. Use a bare cd <dir> first, per § Avoid Compound cd Commands. See bash-tool.md."
GUARD_MSG_func_def="Both name() { ...; } and function name { ...; } make the parser classify the whole command as too complex to analyze (\"Contains function_definition\"), which skips the allow list entirely so no permission rule can match it. Write the command directly with absolute paths. See bash-tool.md."
GUARD_MSG_sysbin="The permission allow list keys on the bare command name (Bash(cat:*)), so the /bin and /usr/bin forms never match it and prompt every time. Use '{match}' instead of its absolute path. See bash-tool.md."
GUARD_MSG_env_var_prefix="Claude Code's permission matcher sees VAR=value as the command name, triggering a prompt every time. Use tool-native flags instead (task --global REPO_DIR=..., mise -C ..., go env -w ...). See bash-tool.md."
GUARD_MSG_brace_expansion="Claude Code flags it with an unsuppressible \"Brace expansion\" permission prompt. List files individually or use a glob (*.go) instead. See bash-tool.md."
GUARD_MSG_find_exec="Claude Code blocks -exec even with Bash(find:*) allowed because -exec can run arbitrary commands. Use find ... -print0 | xargs -0 <command> instead. See bash-tool.md."
# <<< generated

usage() {
  cat <<EOF
Usage: claude-bash-guard

PreToolUse hook for the Bash tool. Reads a hook payload on stdin and exits 2
with an explanation when the command would trigger a permission prompt that no
allow-list rule can suppress.

The rules are documented for humans in ai/guidelines/rules/bash-tool.md.
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

# block MESSAGE — refuse the tool call and name the alternative.
# Exit 2 is the only status Claude Code treats as blocking, and stderr is the
# only stream it feeds back, so both are load-bearing.
block() {
  echo "BLOCKED: $1" >&2
  exit 2
}

# Fail open: a malformed payload must not block every Bash call.
cmd=$(jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
[[ -n "$cmd" ]] || exit 0

# ── Whole-command rules ──────────────────────────────────────────────────────
# These scan the command as written. Order is by specificity: the first rule to
# match is the message Claude sees, so a narrow rule earns its place above a
# broad one.

if [[ "$cmd" == *"gh pr create"* ]]; then
  block "$GUARD_MSG_gh_pr_create"
fi

re_binlocal='^/[^[:space:]]*/((git/)?bin/local/[^[:space:]]*)'
if [[ "$cmd" =~ $re_binlocal ]]; then
  block "${GUARD_MSG_bin_local//\{match\}/${BASH_REMATCH[1]}}"
fi

if [[ "$cmd" == *"-exec "* || "$cmd" == *'-exec"'* ]]; then
  block "$GUARD_MSG_find_exec"
fi

# ── Statement-anchored rules ─────────────────────────────────────────────────
# These match at the start of any statement, not just the start of the command —
# a leading no-op token must not be a way around them. They scope to the first
# line so a heredoc body being written to a file is not scanned as if it were
# the command itself, and to a quote-stripped copy so a pattern inside a quoted
# argument is not read as an invocation.
#
# ceiling: quoted spans are stripped with two sed passes, which mis-handle
# escaped quotes and embedded apostrophes, in both directions. An unpaired
# apostrophe re-pairs with a later quote, so `echo it's; cd /x && ls 'q'` strips
# the real cd away and is not blocked; an escaped quote ends a span early, so
# `echo "say \"{a,b}\" now"` strips to `echo {a,b}\` and is blocked as brace
# expansion. Both outcomes cost at most one permission prompt — these rules
# steer command style, they are not a security boundary. Upgrade to a real
# tokenizer if either misfire shows up on a command worth running.

first_line=$(printf '%s\n' "$cmd" | head -1)
stripped=$(printf '%s' "$first_line" | sed -e "s/'[^']*'//g" -e 's/"[^"]*"//g')

re_func='(^|[;&|][[:space:]]*)([A-Za-z_][A-Za-z0-9_-]*[[:space:]]*\(\)|function[[:space:]])'
if [[ "$stripped" =~ $re_func ]]; then
  block "$GUARD_MSG_func_def"
fi

re_var='(^|[;&|][[:space:]]*)[A-Z_][A-Z0-9_]*='
if [[ "$stripped" =~ $re_var ]]; then
  block "$GUARD_MSG_env_var_prefix"
fi

re_cd='(^|[;&|][[:space:]]*)cd[[:space:]]'
if [[ "$stripped" =~ $re_cd ]] && [[ "$stripped" == *'&&'* || "$stripped" == *';'* ]]; then
  block "$GUARD_MSG_compound_cd"
fi

re_env='(^|[;&|][[:space:]]*)env[[:space:]]+(-C|--chdir)([[:space:]]|=)'
if [[ "$stripped" =~ $re_env ]]; then
  block "$GUARD_MSG_env_chdir"
fi

re_brace='\{[^{}]*[a-zA-Z_][^{}]*,[^{}]*\}'
if [[ "$stripped" =~ $re_brace ]]; then
  block "$GUARD_MSG_brace_expansion"
fi

# The allow list keys on the bare command name, so Bash(cat:*) never matches
# /bin/cat — the absolute form prompts on every call.
re_sysbin='(^|[;&|][[:space:]])/(usr/)?bin/([A-Za-z0-9_.-]+)'
if [[ "$stripped" =~ $re_sysbin ]]; then
  block "${GUARD_MSG_sysbin//\{match\}/${BASH_REMATCH[3]}}"
fi

# ── Catch-all ────────────────────────────────────────────────────────────────
# Last, because it matches the widest range of commands — anything the rules
# above can name more precisely should be blocked with their message instead.

# shellcheck disable=SC2016  # the literal $( is the pattern being matched
if [[ "$cmd" == *'$('* ]]; then
  block "$GUARD_MSG_cmd_substitution"
fi

exit 0
