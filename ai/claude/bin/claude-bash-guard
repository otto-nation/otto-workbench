#!/usr/bin/env bash
# PreToolUse guard for the Bash tool.
#
# Reads a hook payload on stdin and exits 2 with an explanation when the command
# matches a shape that triggers a permission prompt no allow-list rule can
# suppress. Exits 0 otherwise.
#
# Every block message names the alternative, then cites the rules section that
# holds the rest: `See <file>.md § <Section>`. The citation is the contract —
# a rule whose section is missing blocks Claude without telling it what to do
# instead. tests/claude_settings_writes.bats enforces that every block call carries one
# and that every cited section exists.
#
# Usage: claude-bash-guard        (stdin: {"tool_input":{"command":"..."}})

set -e

usage() {
  cat <<EOF
Usage: claude-bash-guard

PreToolUse hook for the Bash tool. Reads a hook payload on stdin and exits 2
with an explanation when the command would trigger a permission prompt that no
allow-list rule can suppress.

The rules are documented for humans in ai/guidelines/rules/bash-tool.md.
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

# block MESSAGE — refuse the tool call and name the alternative.
# Exit 2 is the only status Claude Code treats as blocking, and stderr is the
# only stream it feeds back, so both are load-bearing.
block() {
  echo "BLOCKED: $1" >&2
  exit 2
}

# Where a `sleep` stops being a pipeline step and starts being a wait for something
# that reports itself. Kept in step with the Pi guard's own constant —
# ai/pi/extensions/sleep-guard/detect.ts enforces the same rule for the harness this
# hook does not run in, and tests/pi_extensions_tokenize.bats holds the two to one value.
SLEEP_WAIT_THRESHOLD_SECONDS=10

# _branch_review_has_open_findings — true when a self-review for the current
# branch is sitting on unticked findings.
#
# The directory name is the one ai/lib/cli/review_entry.py builds:
# <repo>-self-<branch with / replaced by ->. Spelled out rather than sourced
# because this hook runs per Bash call and cannot afford a Python start-up; a
# rename there makes this find nothing, which fails open.
#
# Fails open throughout. No git, no review, no file, or a review whose findings
# are all ticked all mean silence: a guard that blocked on its own inability to
# answer would be worse than the mistake it prevents.
_branch_review_has_open_findings() {
  local origin branch repo_name review_file
  # The repo half of the name comes from the remote, not from the directory:
  # every worktree of one repo has its own basename and they all review into
  # the same <repo>-self-<branch> name.
  origin="$(git remote get-url origin 2>/dev/null)" || return 1
  repo_name="${origin##*/}"
  repo_name="${repo_name%.git}"
  [[ -n "$repo_name" ]] || return 1
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 1
  [[ -n "$branch" && "$branch" != "HEAD" ]] || return 1

  # REVIEWS_DIR from lib/constants.sh, spelled out for the same reason the
  # directory name is: this hook sources nothing, so it cannot read the
  # constant. tests/claude_settings_sync.bats holds the two spellings together.
  review_file="${WORKBENCH_STATE_DIR:-$HOME/.local/state/workbench}/reviews/${repo_name}-self-${branch//\//-}/review.md"
  [[ -f "$review_file" ]] || return 1

  grep -q '^- \[ \]' "$review_file" 2>/dev/null
}

# The commands whose exit status is the thing a caller is reading, and the
# filters that discard it. Kept in step with TEST_RUNNERS in
# ai/pi/extensions/test-pipe-guard/detect.ts — tests/pi_extensions_testpipe.bats holds the
# two lists to one set, so adding a runner here alone fails the suite rather
# than letting the harnesses disagree about a given command.
TEST_RUNNERS='pytest|bats|run-tests|validate-all|go|cargo|npm|pnpm|yarn|jest|vitest'

# The runners above that are general-purpose build tools too — `go build`,
# `npm run dev` — where the output is often the point and piping one is
# ordinary. For these, bare invocation isn't enough: the test subcommand
# itself has to be present. Kept in step with SUBCOMMAND_REQUIRED in the same
# Pi file.
BUILD_STYLE_RUNNERS='go|cargo|npm|pnpm|yarn'

STATUS_FILTERS='tail|head|grep|egrep|rg|sed|awk|wc|tee|cut|sort|uniq'

# stage_command_name STAGE_TOKEN — set _STAGE_NAME to the command a token
# names, with surrounding quotes and any leading path removed.
#
# Quoting a command name does not stop it being the command: `'pytest' tests/`
# runs pytest. Stripping the quotes is what keeps this in step with basename()
# in ai/pi/extensions/test-pipe-guard/detect.ts, which reads the token the same
# way — the two disagreed about exactly this shape.
#
# Assigns to a global for the reason _scan_operator_at does: a command
# substitution is a subshell, and this runs per pipeline stage on a hook that
# runs on every Bash call.
stage_command_name() {
  local token="$1"
  token="${token#[\'\"]}"
  token="${token%[\'\"]}"
  _STAGE_NAME="${token##*/}"
}

# stage_invokes_runner STAGE — true when STAGE runs one of TEST_RUNNERS with
# the subcommand that makes it a test run rather than a build/format/lint:
# `go test`/`cargo test` directly, and `npm`/`pnpm`/`yarn` also via
# `run test`/`run-script test`. The runner has to be the command being run
# rather than an argument to something else, so `grep pytest notes.md` names
# one and invokes nothing. A leading `VAR=x` assignment is skipped so an env
# prefix is not a way around the rule.
stage_invokes_runner() {
  local stage="$1" tok name t
  local -a tokens rest nonflag
  read -ra tokens <<<"$stage"
  local i=0
  while (( i < ${#tokens[@]} )) && [[ "${tokens[$i]}" == *=* ]]; do
    ((i++))
  done
  (( i < ${#tokens[@]} )) || return 1
  tok="${tokens[$i]}"
  stage_command_name "$tok"
  name="$_STAGE_NAME"
  [[ "|$TEST_RUNNERS|" == *"|$name|"* ]] || return 1
  [[ "|$BUILD_STYLE_RUNNERS|" == *"|$name|"* ]] || return 0
  rest=("${tokens[@]:$((i + 1))}")
  nonflag=()
  for t in "${rest[@]}"; do
    [[ "$t" == -* ]] && continue
    nonflag+=("$t")
  done
  (( ${#nonflag[@]} > 0 )) || return 1
  [[ "${nonflag[0]}" == "test" ]] && return 0
  if [[ "$name" == npm || "$name" == pnpm || "$name" == yarn ]] &&
     [[ "${nonflag[0]}" == "run" || "${nonflag[0]}" == "run-script" ]] &&
     [[ "${nonflag[1]:-}" == "test" ]]; then
    return 0
  fi
  return 1
}

# pipeline_pipes_a_test FIRST LAST — true when the stages SCAN_STATEMENTS[FIRST]
# through [LAST] form a pipeline whose last stage is a filter and whose earlier
# stages include a test runner.
#
# Any earlier stage, not only the one before the first pipe: that is what
# catches `cat f | pytest tests/ | tail -5`, where the runner is not leading,
# and `pytest tests/ | jq . | tail -5`, where the filter is not the segment
# right after the runner.
#
# Takes indices into the scan rather than a string to re-split. Splitting a
# statement on `|` here would split one inside quotes too, and
# `pytest tests/ | grep -q 'a|b'` would read as a pipeline ending in `b'`
# rather than in `grep` — a runner piped into a filter, passed.
pipeline_pipes_a_test() {
  local -i first="$1" last="$2" k
  (( last > first )) || return 1
  stage_is_filter "${SCAN_STATEMENTS[$last]}" || return 1
  for ((k = first; k < last; k++)); do
    if stage_invokes_runner "${SCAN_STATEMENTS[$k]}"; then
      return 0
    fi
  done
  return 1
}

# any_pipeline_pipes_a_test — true when any pipeline in the scan pipes a test
# runner into a filter.
#
# SCAN_PIPED says which statements feed the next one, so a run of them is one
# pipeline. `||` is a fallback rather than a pipe — `pytest ... || echo failed`
# reports the suite's own status — and it ends a run here like `;` and `&&` do.
any_pipeline_pipes_a_test() {
  local -i idx start=0
  for ((idx = 0; idx < ${#SCAN_STATEMENTS[@]}; idx++)); do
    (( SCAN_PIPED[idx] )) && continue
    if pipeline_pipes_a_test "$start" "$idx"; then
      return 0
    fi
    start=$((idx + 1))
  done
  return 1
}

# stage_is_filter STAGE — true when STAGE's own command is one of
# STATUS_FILTERS, matched on its last path segment so a filter reached by path
# still counts.
stage_is_filter() {
  local stage="$1" name
  local -a tokens
  read -ra tokens <<<"$stage"
  (( ${#tokens[@]} > 0 )) || return 1
  stage_command_name "${tokens[0]}"
  [[ "|$STATUS_FILTERS|" == *"|$_STAGE_NAME|"* ]]
}

# The one fork left on the hot path, and it stays.
#
# A bash-native extractor was measured at 0.27 ms against jq's 5.7 ms, and
# refused: pulling `.tool_input.command` out of the payload is JSON string
# decoding, not a pattern match. It has to find `command` under `tool_input`
# rather than the first `command` anywhere in the payload, respect a `\\`
# before a `\"`, and unescape `\n \t \" \\ \/ \uXXXX`. The obvious tool for the
# last part is `printf '%b'`, and it is wrong in a way that changes verdicts: a
# command holding the two literal characters `\` and `n` — `grep '\n' file` —
# arrives here as `\\n`, and a `%b` pass turns it into a real newline, splitting
# one statement into two and changing which rules match. A vector table cannot
# cover a decoder's input space, and the failure direction is silent.
#
# Not a ceiling: there is no threshold at which the substitution becomes sound,
# and 5.7 ms does not buy a decoder.
#
# Fail open: a malformed payload must not block every Bash call.
cmd=$(jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
[[ -n "$cmd" ]] || exit 0

# ── Normalize the command for scanning ───────────────────────────────────────
# Every rule below reads one of these instead of $cmd directly.
#
# Every line is scanned, because a multi-line command is several commands and
# the second one prompts just as loudly as the first. Heredoc bodies are the
# exception: they are content being written to a file, not commands, so a
# `cd /x && ls` inside one is not an invocation. Surviving lines are joined with
# `; ` so the statement-anchored rules below treat a new line as the new
# statement it is — and so a lone `cd <dir>`, the sanctioned form, still has no
# separator to match on.
#
# One walk produces all four results, in process. What it replaced was three
# `sed` passes over the whole command plus a `sed -E` and a `tr` inside two
# separate loops — six forks on a hook that runs on every Bash call, and two
# different answers to what a statement is.
#
# The scan is the bash counterpart of ai/pi/extensions/_shared/tokenize.ts and
# _shared/statements.ts, and it is a port rather than a parallel invention:
# tests/pi_extensions_testpipe.bats runs a command corpus through both and requires the
# same statements out of each. Quoting is the whole reason it exists. A `;`
# inside quotes is an argument and a `>` inside quotes is a filename, and the
# sed passes could see neither — `bash -c 'rm -rf x; echo done'` was cut into
# fragments that matched no rule at all.

# Longest match first, so `>>` is not read as two `>` and `&&` is not read as
# two `&`. Redirects lead because `&>` has to win over the bare `&`.
_SCAN_OPERATORS=('>>' '&>>' '&>' '>|' '>' '<<<' '<<' '<' ';;' '&&' '||' '|&' ';' '|' '&' '(' ')')

# A single literal backslash, named so the comparisons below read as comparisons
# rather than as an escape someone has to decode.
_SCAN_BACKSLASH=$'\\'

# The operators that end a statement, as the scan spells them. Kept in step
# with STATEMENT_SEPARATORS in ai/pi/extensions/_shared/statements.ts.
# `|&` is a pipe like `|`, not a backgrounding `&`: it pipes stdout and stderr
# both, and bash documents it as shorthand for `2>&1 |`. Neither harness listed
# it, so `pytest tests/ |& tail` read as having no pipe at all.
_scan_is_separator() {
  case "$1" in
    ';' | '&&' | '||' | '|' | '|&' | '&' | ';;') return 0 ;;
  esac
  return 1
}

# Sets _SCAN_OP to the operator at the head of $1, or returns 1.
#
# Assigns to a global rather than printing its answer: a command substitution
# here is a subshell fork per character scanned, which costs an order of
# magnitude more than the five forks this whole scan removes.
_scan_operator_at() {
  local scan_rest="$1" candidate
  for candidate in "${_SCAN_OPERATORS[@]}"; do
    if [[ "$scan_rest" == "$candidate"* ]]; then
      _SCAN_OP="$candidate"
      return 0
    fi
  done
  return 1
}

# Scan one line, appending to the three text accumulators and to
# SCAN_STATEMENTS.
#
# Runs of ordinary characters are consumed with a single parameter expansion
# rather than a character at a time. Bash indexes a string by walking it, so a
# per-character loop is quadratic in the command length: stepping cost 137 ms on
# an 812-character command, and chunking holds it flat at ~3 ms.
# _scan_take_single REST — consume a single-quoted span at the head of REST.
#
# Single quotes take no escapes, so the first following quote closes. An
# unterminated one takes the rest of the line as content, which is what stops
# the apostrophe in `echo it's` from re-pairing with a later quote and deleting
# the real command between them.
_scan_take_single() {
  local scan_rest="$1" content
  if [[ "${scan_rest:1}" != *"'"* ]]; then
    # An unbalanced quote means the command's real shape is unknown. Taking the
    # remainder as inert content would hide a real operator inside it —
    # `echo it's; npm run dev &` does background a shell — so the text is kept
    # in the scanned copies and only the statement split stops here. Reported
    # the way tokenize.ts reports it, via Token.unparsed.
    _SCAN_LINE_UNPARSED=1
    _scan_st+="$scan_rest"
    _scan_sq+="$scan_rest"
    _scan_ph+="$scan_rest"
    _scan_stmt+="$scan_rest"
    _SCAN_TAKEN=${#scan_rest}
    return 0
  fi
  content="${scan_rest:1}"
  content="${content%%\'*}"
  _scan_ph+="QUOTEDARG"
  _scan_stmt+="'$content'"
  _SCAN_TAKEN=$((${#content} + 2))
}

# _scan_double_close REST — set _SCAN_CLOSE to the index of the quote closing
# the double quote at the head of REST, or -1.
#
# A plain search stops at the first quote, which inside double quotes is wrong:
# `"a\"b"` ends at the last one, not at the escaped one in the middle.
_scan_double_close() {
  local scan_rest="$1"
  local -i probe=1
  _SCAN_CLOSE=-1
  while ((probe < ${#scan_rest})); do
    if [[ "${scan_rest:$probe:1}" == "$_SCAN_BACKSLASH" ]]; then
      ((probe += 2))
      continue
    fi
    if [[ "${scan_rest:$probe:1}" == '"' ]]; then
      _SCAN_CLOSE=$probe
      return 0
    fi
    ((probe++))
  done
}

# _scan_take_double REST — consume a double-quoted span at the head of REST.
#
# The span survives into sq_stripped: a `$VAR` expands inside double quotes, so
# the expansion rule has to see in here. Every other rule wants it gone.
_scan_take_double() {
  local scan_rest="$1" content
  _scan_double_close "$scan_rest"
  if ((_SCAN_CLOSE == -1)); then
    # Unbalanced, as in _scan_take_single: keep the text rather than blanking a
    # span whose end this scan cannot find.
    _SCAN_LINE_UNPARSED=1
    _scan_st+="$scan_rest"
    _scan_sq+="$scan_rest"
    _scan_ph+="$scan_rest"
    _scan_stmt+="$scan_rest"
    _SCAN_TAKEN=${#scan_rest}
    return 0
  fi
  content="${scan_rest:0:$((_SCAN_CLOSE + 1))}"
  _scan_sq+="$content"
  _scan_ph+="QUOTEDARG"
  _scan_stmt+="$content"
  _SCAN_TAKEN=$((_SCAN_CLOSE + 1))
}

# _scan_take_escape REST — consume a backslash escape at the head of REST.
# An escaped character is content, including an escaped quote.
_scan_take_escape() {
  local scan_rest="$1" content
  if ((${#scan_rest} == 1)); then
    _scan_st+="$_SCAN_BACKSLASH"
    _scan_sq+="$_SCAN_BACKSLASH"
    _scan_ph+="$_SCAN_BACKSLASH"
    _scan_stmt+="$_SCAN_BACKSLASH"
    _SCAN_TAKEN=1
    return 0
  fi
  content="${scan_rest:1:1}"
  _scan_st+="$content"
  _scan_sq+="${scan_rest:0:2}"
  _scan_ph+="$content"
  _scan_stmt+="${scan_rest:0:2}"
  _SCAN_TAKEN=2
}

# _scan_take_operator OP PREV_OP — consume the operator OP, ending the current
# statement when it separates one.
_scan_take_operator() {
  local op="$1" prev_op="$2"
  if _scan_is_separator "$op" && ! { [[ "$op" == '&' ]] && [[ "$prev_op" == *'>'* ]]; }; then
    # An `&` belonging to a redirect is not a separator: `2>&1` would otherwise
    # shatter the statement it sits inside into fragments.
    SCAN_STATEMENTS+=("$_scan_stmt")
    # Whether this statement feeds the next one. `|` is a statement separator
    # like the others, so a pipeline arrives here as several statements; this is
    # what lets the test-pipe rule put one back together without splitting on a
    # `|` that sits inside quotes.
    if [[ "$op" == '|' || "$op" == '|&' ]]; then
      SCAN_PIPED+=(1)
    else
      SCAN_PIPED+=(0)
    fi
    _scan_stmt=""
  else
    _scan_stmt+="$op"
  fi
  _scan_st+="$op"
  _scan_sq+="$op"
  _scan_ph+="$op"
  _SCAN_TAKEN=${#op}
}

_scan_line() {
  local scan_rest="$1"
  local prev_op="" head ch
  local -i line_first=${#SCAN_STATEMENTS[@]}
  _scan_stmt=""

  while [[ -n "$scan_rest" ]]; do
    # Everything up to the next character that could mean something is content.
    head="${scan_rest%%[\'\"\\;\&\|\<\>\(\)]*}"
    if [[ -n "$head" ]]; then
      _scan_st+="$head"
      _scan_sq+="$head"
      _scan_ph+="$head"
      _scan_stmt+="$head"
      scan_rest="${scan_rest:${#head}}"
      # A redirect's `&` is only attached across whitespace-free text, so any
      # non-space content between the two clears the pairing.
      [[ "$head" == *[![:space:]]* ]] && prev_op=""
      [[ -n "$scan_rest" ]] || break
    fi

    ch="${scan_rest:0:1}"
    case "$ch" in
      "'") _scan_take_single "$scan_rest"; prev_op="" ;;
      '"') _scan_take_double "$scan_rest"; prev_op="" ;;
      "$_SCAN_BACKSLASH") _scan_take_escape "$scan_rest"; prev_op="" ;;
      *)
        if _scan_operator_at "$scan_rest"; then
          _scan_take_operator "$_SCAN_OP" "$prev_op"
          prev_op="$_SCAN_OP"
        else
          _scan_st+="$ch"
          _scan_sq+="$ch"
          _scan_ph+="$ch"
          _scan_stmt+="$ch"
          _SCAN_TAKEN=1
        fi ;;
    esac
    scan_rest="${scan_rest:$_SCAN_TAKEN}"
  done

  SCAN_STATEMENTS+=("$_scan_stmt")
  SCAN_PIPED+=(0)

  (( _SCAN_LINE_UNPARSED )) || return 0
  # An unterminated quote means the scan could not find where the span ends, so
  # everything after it was taken as one word and any separator inside it was
  # never seen. Treating that as a single statement is how a guard silently
  # stops working: `echo it's; npm run dev &` really does background a shell,
  # and one apostrophe earlier in the line would hide it. Falling back to a
  # split on the separator characters over-splits a genuine quoted argument,
  # which costs at most one refusal of a command that was already unparseable.
  #
  # Mirrors the same fallback in ai/pi/extensions/_shared/statements.ts, and the
  # corpus test in tests/pi_extensions_testpipe.bats requires the two to agree.
  SCAN_STATEMENTS=("${SCAN_STATEMENTS[@]:0:$line_first}")
  SCAN_PIPED=("${SCAN_PIPED[@]:0:$line_first}")
  # Walked rather than split on IFS, because the separator run has to be read as
  # well as cut on: a run holding `|` is a pipe, and dropping that made
  # `pytest tests/ | grep 'it's'` — a suite piped into a filter, with an
  # apostrophe in the pattern — read as two unrelated statements and pass.
  local fallback_rest="$1" piece run
  while [[ -n "$fallback_rest" ]]; do
    piece="${fallback_rest%%[;\&\|]*}"
    fallback_rest="${fallback_rest:${#piece}}"
    run=""
    while [[ -n "$fallback_rest" && "${fallback_rest:0:1}" == [\;\&\|] ]]; do
      run+="${fallback_rest:0:1}"
      fallback_rest="${fallback_rest:1}"
    done
    SCAN_STATEMENTS+=("$piece")
    if [[ "$run" == *'|'* ]]; then
      SCAN_PIPED+=(1)
    else
      SCAN_PIPED+=(0)
    fi
  done
}

# _scan COMMAND — set stripped / sq_stripped / placeheld / SCAN_STATEMENTS.
_scan() {
  local line marker="" marker_re="" first=1
  local re_heredoc="<<(-?)[[:space:]]*['\"]?([A-Za-z_][A-Za-z0-9_]*)"
  _scan_st=""
  _scan_sq=""
  _scan_ph=""
  SCAN_STATEMENTS=()
  SCAN_PIPED=()

  while IFS= read -r line; do
    if [[ -n "$marker" && "$line" =~ $marker_re ]]; then
      marker=""
      continue
    fi
    [[ -n "$marker" ]] && continue

    if ((first)); then
      first=0
    else
      _scan_st+="; "
      _scan_sq+="; "
      _scan_ph+="; "
    fi
    _SCAN_LINE_UNPARSED=0
    _scan_line "$line"

    if [[ "$line" =~ $re_heredoc ]]; then
      # Only `<<-` lets the terminator be indented. Accepting indentation for a
      # plain `<<` would end the heredoc early on a body line that happens to be
      # the marker word, and scan the rest of the body as commands.
      marker="${BASH_REMATCH[2]}"
      marker_re="^${BASH_REMATCH[1]:+[[:space:]]*}${marker}[[:space:]]*$"
    fi
  done < <(printf '%s\n' "$1")

  stripped="$_scan_st"
  sq_stripped="$_scan_sq"
  placeheld="$_scan_ph"
}

_scan "$cmd"

# ── Whole-command rules ──────────────────────────────────────────────────────
# These scan the command as written. Order is by specificity: the first rule to
# match is the message Claude sees, so a narrow rule earns its place above a
# broad one.

# Unlike most rules in this file, this one is not about a permission prompt:
# `pr create` resolves the repo's PR template and checks the body against
# its sections, appends a closing ref per --closes, assigns the PR, and pushes
# first. That is coding policy and it holds under any harness, so Pi enforces it
# too — ai/pi/extensions/pr-create-guard/ is the same rule, and
# tests/pi_extensions_testpipe.bats holds the two to one set of answers.
#
# Statement-anchored rather than a substring of $cmd. Matching the raw command
# refused `echo gh pr create` and any grep whose pattern contained the phrase,
# neither of which opens a PR.
re_pr_create='(^|[;&|][[:space:]]*)gh[[:space:]]+pr[[:space:]]+create([[:space:]]|$)'
if [[ "$stripped" =~ $re_pr_create ]]; then
  block 'Use pr create instead of gh pr create — it auto-loads the repo PR template. See git-operations.md § PR Creation.'
fi

# Filing an issue while this branch's self-review still has open findings is a
# deferral of one of them, and deferring needs agreement. It does not read like
# one from the inside — filing feels like diligence — so the block is the thing
# that makes it visible. Narrow on purpose: no review, or none with open
# findings, and this says nothing. Unrelated filing during a review costs one
# explanation to the operator, which is the trade for catching the case where
# the fix pass is committing the same finding as you write the issue.
# Statement-anchored, so `echo gh issue create` and a grep over a script that
# mentions the phrase are not matched. Reads $stripped rather than $cmd — a
# bare `^` does not cross a literal newline, so a `cd`-then-filing command
# spanning two lines (the sanctioned form for a compound cd; see bash-tool.md
# § Avoid Compound `cd` Commands) would otherwise slip past on a raw scan of
# $cmd, which $stripped's `; `-joining exists to prevent. Kept in step with
# ISSUE_CREATE in ai/pi/extensions/issue-defer-guard/detect.ts —
# tests/pi_extensions_issues.bats holds the two to one set of answers.
re_issue_create='(^|[;&|][[:space:]]*)gh[[:space:]]+issue[[:space:]]+create([[:space:]]|$)'
if [[ "$stripped" =~ $re_issue_create ]] && _branch_review_has_open_findings; then
  block "This branch's self-review has open findings, and filing an issue for one is a deferral that needs my agreement first — read what the fix pass did before acting on any finding yourself. If this issue is unrelated to the review, say so and file it. See general.md § Code Quality."
fi

if [[ "$cmd" == *"-exec "* || "$cmd" == *'-exec"'* ]]; then
  block 'find -exec triggers an unsuppressible permission prompt. Use find ... -print0 | xargs -0 <command> instead. See bash-tool.md § Avoid find -exec.'
fi

# A test suite piped into a filter reports the filter's status, not its own:
# `false | tail -1` exits 0, so a failing run reads as a pass and a `$?` taken
# after the pipe is the filter's. `set -o pipefail` is the one spelling that
# keeps the suite's status, so a command setting it is left alone.
#
# Reads $stripped — heredoc-stripped, lines joined with `; `, quotes gone — so
# a runner on a later line is seen the same way the statement-anchored rules
# below see it. A bare `$cmd` scan misses that: bash's `^`/`$` anchor the whole
# string, not each line, so `echo start\npytest tests/ | tail -6` would read as
# having no statement boundary before `pytest` at all.
#
# Mirrors pipedRunner() in ai/pi/extensions/test-pipe-guard/detect.ts stage for
# stage: split into statements on `;`/`&&`/`||`, split each statement into
# pipeline stages on a single `|`, and block when the last stage is a filter
# and any earlier stage invokes a runner — not only the stage right before the
# first pipe. That is what catches `cat f | pytest tests/ | tail -5` (the
# runner is a non-leading stage) and `pytest tests/ | jq . | tail -5` (the
# filter is not the segment right after the runner).
if ! [[ "$stripped" =~ set[[:space:]]+-[a-zA-Z]*o[[:space:]]+pipefail ]]; then
  if any_pipeline_pipes_a_test; then
    block 'Piping a test suite into a filter reports the filter'"'"'s exit status, not the suite'"'"'s — false | tail -1 exits 0, so a failing run reads as a pass and a $? read after the pipe is the filter status. Redirect to a file and read the status, then grep the file: pytest ... > /tmp/out.txt 2>&1; echo $?. set -o pipefail is accepted where a pipe is genuinely wanted. See testing.md § Reading a Suite Result.'
  fi
fi

# ── Statement-anchored rules ─────────────────────────────────────────────────
# These match at the start of any statement, not just the start of the command —
# a leading no-op token must not be a way around them. They scan the
# quote-stripped, heredoc-stripped copies computed above so a pattern inside a
# quoted argument or a heredoc body is not read as an invocation.

# Ahead of every rule below: a `-c` wrapper hides its payload from all of them,
# and from the analyzer, so whatever is inside can only be judged once unwrapped.
# The optional path prefix keeps `/bin/sh -c "..."` on this message rather than
# the PATH-binary one below — the wrapper is the real problem, not the path.
re_dashc='(^|[;&|][[:space:]]*)([^[:space:];&|]*/)?(sh|bash|zsh|dash)[[:space:]]+-[A-Za-z]*c([[:space:]]|$)'
if [[ "$stripped" =~ $re_dashc ]]; then
  block "A ${BASH_REMATCH[3]} -c \"...\" wrapper hides the real command, so the whole quoted string needs approval and no allow-list entry can match what is inside. Run the command directly, with a bare cd <dir> as its own call instead of embedding one. See bash-tool.md § Avoid Wrapping Commands in sh -c."
fi

re_func='(^|[;&|][[:space:]]*)([A-Za-z_][A-Za-z0-9_-]*[[:space:]]*\(\)|function[[:space:]])'
if [[ "$stripped" =~ $re_func ]]; then
  block 'A shell function definition makes the whole command too complex to analyze ("Contains function_definition"), skipping the allow list entirely. Write the command directly with absolute paths. See bash-tool.md § Avoid Shell Function Definitions.'
fi

re_var='(^|[;&|][[:space:]]*)[A-Z_][A-Z0-9_]*='
if [[ "$stripped" =~ $re_var ]]; then
  block 'A VAR=value prefix is read as the command name and prompts every time. Use tool-native flags instead (task --global REPO_DIR=..., mise -C ...). See bash-tool.md § Avoid Env-Var Prefix Syntax.'
fi

re_cd='(^|[;&|][[:space:]]*)cd[[:space:]]'
if [[ "$stripped" =~ $re_cd ]] && [[ "$stripped" == *'&&'* || "$stripped" == *';'* ]]; then
  block 'Compound cd commands (cd path && ...) trigger unsuppressible permission prompts. Use absolute paths, git -C <path>, or a bare cd <dir> as its own call. See bash-tool.md § Avoid Compound cd Commands.'
fi

# ceiling: flags carrying a separate argument are not skipped, so `env -u FOO -C
# /x` slips through. Upgrade to a real option parser if that form shows up.
re_env='(^|[;&|][[:space:]]*)env([[:space:]]+-[A-Za-z0-9]+)*[[:space:]]+(-[A-Za-z0-9]*C|--chdir)([[:space:]/=]|$)'
if [[ "$stripped" =~ $re_env ]]; then
  block 'env -C cannot be statically analyzed, and it is not an escape hatch from the compound-cd rule — it is a second unsuppressible prompt. Run a bare cd <dir> as its own call first. See bash-tool.md § Avoid env -C.'
fi

re_brace='\{[^{}]*[a-zA-Z_][^{}]*,[^{}]*\}'
if [[ "$stripped" =~ $re_brace ]]; then
  block 'Brace expansion triggers an unsuppressible permission prompt. List files individually or use a glob (*.go) instead. See bash-tool.md § Avoid Brace Expansion.'
fi

# Unlike the rules above, the prompt this one avoids is a file-access gate rather
# than a static-analysis failure: Claude Code asks per write path for a Bash
# redirect, while the Edit and Write tools are allow-listed outright. Only echo
# and printf are matched — they emit literal content the Edit tool can place
# directly. A redirect capturing another command's output has no tool equivalent.
#
# ceiling: the exempt list is the scratch dirs a redirect legitimately targets.
# A write to a state or log file outside them still gets blocked, and the answer
# there is the Write tool. Upgrade to reading the session's working directories
# if a real logging use shows up.
re_write='(^|[;&|][[:space:]]*)(echo|printf)[[:space:]][^;&|]*>>?[[:space:]]*([^[:space:];&|]+)'
if [[ "$placeheld" =~ $re_write ]]; then
  target="${BASH_REMATCH[3]}"
  # A quoted destination reads as the placeholder, so name it generically rather
  # than echoing a token the caller never wrote.
  if [[ "$target" == QUOTEDARG ]]; then
    target="a quoted path"
  fi
  case "$target" in
    /dev/null | /tmp/* | /private/tmp/* | /var/folders/*) ;;
    *)
      block "Redirecting echo/printf into $target prompts for access to that path. Use the Write tool for a new file or the Edit tool to append to an existing one — both are allow-listed and show a diff. See bash-tool.md § Avoid Shell Redirects That Write Files."
      ;;
  esac
fi

# Also a consequence rather than a static-analysis failure: a shell backgrounded
# with `&` outlives the call, and the only way left to stop it is pkill, which is
# not on the allow list. The tool's own run_in_background parameter keeps the
# shell reachable, so nothing has to be hunted down by pattern later.
#
# `&` is only the background operator when it stands alone: `&&` is a conjunction,
# `2>&1` and `&>` are redirects, `|&` is a pipe, and `;&`/`;;&` fall through to
# the next branch of a case. Each is excluded by the character on one side of the
# match, which is why both sides are tested.
re_background='(^|[^&>|;])&([^&>]|$)'
re_nohup='(^|[;&|][[:space:]]*)nohup[[:space:]]'
if [[ "$stripped" =~ $re_background || "$stripped" =~ $re_nohup ]]; then
  block 'Backgrounding with & or nohup leaves a shell the tool cannot see, so stopping it later takes a pkill that prompts every time. Pass run_in_background instead, and make the request against it in a separate call. See bash-tool.md § Avoid Backgrounding with &.'
fi

# Not a permission prompt either — this one costs wall-clock rather than a click.
# A `sleep 295` in front of work that reports its own completion buys nothing: the
# report arrives when it arrives, and the agent has spent the five minutes either
# way.
#
# Only a bare `sleep <n>` at the head of a statement counts, so `some-cmd --sleep 5`
# and a `sleep` inside a script being read are left alone. The threshold is what
# separates the two uses: a second or two letting a server bind its port is a real
# pipeline step, while anything at this scale is a wait for something that will
# announce itself. A fractional duration is under the threshold by definition and
# never matches.
#
# ceiling: the duration is read as a plain integer, so a suffixed `sleep 5m` — a GNU
# and BSD extension, not POSIX — does not match and passes. Upgrade to parsing the
# suffix if one shows up; the shape being steered is `sleep <seconds>`, which is what
# an agent writes.
#
# Every statement is tested, not just the first match. `=~` returns the leftmost
# match only, so testing the command as a whole let `sleep 2 && sleep 300` through
# on the strength of its short first sleep — a one-token prefix that defeated the
# rule entirely. Splitting on the separators and checking each piece is what closes
# that; `&&` and `||` become two empty pieces, which match nothing and cost nothing.
#
# The 10# prefix forces base ten. Bash reads a leading zero as octal, so `sleep 08`
# would otherwise abort the arithmetic with "value too great for base" and let the
# command through on an error message rather than a decision.
re_sleep='^[[:space:]]*sleep[[:space:]]+([0-9]+)([[:space:]]|$)'
for statement in "${SCAN_STATEMENTS[@]}"; do
  [[ "$statement" =~ $re_sleep ]] || continue
  (( 10#${BASH_REMATCH[1]} >= SLEEP_WAIT_THRESHOLD_SECONDS )) || continue
  block "A sleep of ${BASH_REMATCH[1]}s is a wait for something that reports its own completion. A background job reports when it finishes and CI is reported when it lands — do nothing and wait, or do other work in the meantime. Start long-running work with run_in_background and read its output when it is done, rather than sleeping beside it. See general.md § Waiting on Background Work."
done

# Below the rules above because it matches a wider range of commands than any of
# them — a `$VAR` in a compound cd or an env -C should get that rule's message.
# Reads sq_stripped, not stripped: `"$f"` expands, so double-quoted spans have
# to stay. `$(` is command substitution, which the catch-all names more
# precisely, so the character class excludes it.
re_expand='\$[A-Za-z_{]'
if [[ "$sq_stripped" =~ $re_expand ]]; then
  # shellcheck disable=SC2016  # the literal $VAR and $f are the shapes being named
  block 'A $VAR reference is flagged as "simple_expansion" and prompts every time. Use printenv VAR to read an env var, and name the values directly instead of looping over them — `tail -n +1 f1 f2 f3` prints each file under its own header, with no for/$f. See bash-tool.md § Avoid Shell Variable Expansion.'
fi

# The directories otto-workbench's tracked .claude/settings.json grants, longest
# first so `ai/claude/bin/claude-bash-guard` is named as itself rather than as the
# `ai/bin` or the `bin/` inside it. A rule there is written repo-root-relative,
# which is the only form it can match — a `./` prefix and an absolute worktree
# path both miss it and earn a one-off settings.local.json entry that dies with
# the worktree.
#
# ceiling: matching on path text alone rather than on a resolved repo root costs
# two things. An absolute path whose tail happens to read `git/bin/` or
# `ai/claude/bin/` is claimed whatever tree it belongs to, and gets a suggestion
# that will not resolve there; and an absolute path into a top-level `bin/` is
# left alone entirely, because a virtualenv ships one too and so does any repo
# that builds its binaries into it.
# Upgrade to resolving the repo root once either shows up in a settings.local.json
# again.
REPO_SCRIPT_DIRS=(ai/claude/bin ai/bin git/bin bin/local bin)

# Ahead of the PATH-binary rule below: a repo path ending in bin/local/ is the
# narrower match, and the two would otherwise both fire on a repo rooted at /bin.
re_reposcript='(^|[;&|][[:space:]]*)(\.?/[^[:space:]]*)'
if [[ "$stripped" =~ $re_reposcript ]]; then
  path="${BASH_REMATCH[2]}"
  for dir in "${REPO_SCRIPT_DIRS[@]}"; do
    # A `./` prefix names the repo root, so there a granted directory counts
    # only at the start of what follows: matching it anywhere reads the `bin/`
    # in `./ai/serena/bin/x` as the top-level one and names a script that does
    # not exist — the repo also ships ai/serena/bin and docker/bin, neither of
    # them granted. Absolutely spelled there is no root to
    # anchor to, which is the ceiling above, and a bare `bin` says too little to
    # claim a path in whatever tree it belongs to (`/tmp/venv/bin/pip`), so only
    # the multi-component entries match loosely.
    [[ "$path" == ./"$dir"/* || ( "$path" != ./* && "$dir" != bin && "$path" == */"$dir"/* ) ]] || continue
    block "Use relative path '$dir/${path##*/"$dir"/}' instead of '$path' — the allow list keys on the repo-root-relative form, so a ./ prefix or an absolute path prompts again in every worktree. See bash-tool.md § Invoke Repo Scripts by Relative Path."
  done
fi

# The directory list is every bin/ on the default PATH that ships tools Claude
# calls: the system ones, Homebrew, and the per-user ~/.local/bin the workbench
# installs into. A binary reached through one of these resolves identically from
# its bare name, which is the only form the allow list can match.
#
# A version manager's dirs are here too: its shims are on PATH, and its install
# bins are where an agent lands after resolving a shim by hand. Both reach the
# same binary the bare name does.
#
# ceiling-permanent: the list is static, so a tool installed somewhere else on
# PATH costs one prompt per call — a Homebrew formula's own bin
# (/opt/homebrew/opt/node/bin) is the remaining known gap. Resolving the
# basename against PATH at hook time would end the list, but the hook's PATH is
# not the session's, so it would trade these misses for wrong suggestions. There
# is no condition under which the dynamic version becomes the better trade; a
# new gap is a new entry here.
re_pathbin='(^|[;&|][[:space:]]*)(/opt/homebrew/s?bin|/usr/local/bin|/usr/bin|/bin|/[^[:space:]]*/(\.local/bin|\.local/share/mise/shims|\.local/share/mise/installs/[^[:space:]]*/bin|\.asdf/shims|\.asdf/installs/[^[:space:]]*/bin))/([A-Za-z0-9_.-]+)'
if [[ "$stripped" =~ $re_pathbin ]]; then
  block "Use '${BASH_REMATCH[4]}' instead of its absolute path — the allow list keys on the bare command name, so a ${BASH_REMATCH[2]}/ path prompts every time. See bash-tool.md § Avoid Absolute Paths to PATH Binaries."
fi

# ── Catch-all ────────────────────────────────────────────────────────────────
# Last, because it matches the widest range of commands — anything the rules
# above can name more precisely should be blocked with their message instead.

# shellcheck disable=SC2016  # the literal $( is the pattern being matched
if [[ "$cmd" == *'$('* ]]; then
  block 'Command substitution cannot be statically analyzed. Run the inner command first, then use the result in the next call. See bash-tool.md § Avoid Command Substitution in Arguments.'
fi

exit 0
