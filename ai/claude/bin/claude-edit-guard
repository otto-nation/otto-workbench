#!/usr/bin/env bash
# PreToolUse guard for the Edit and Write tools.
#
# Reads a hook payload on stdin and exits 2 with an explanation when the edit
# would land on main/master (unless the path is gitignored), or when a
# validator currently holds the tree the file lives in. Exits 0 otherwise.
#
# The lock half has a twin: ai/pi/extensions/tree-lock-guard reads the same
# lock for Pi. Both go through `with-tree-lock --check`, which is
# tree_lock.is_locked(), so one fact answers both harnesses.
#
# Usage: claude-edit-guard        (stdin: {"tool_input":{"file_path":"..."}})

set -e

usage() {
  cat <<EOF
Usage: claude-edit-guard

PreToolUse hook for the Edit and Write tools. Reads a hook payload on stdin
and exits 2 when either:

  - the target file is in a main or master worktree and is not gitignored; or
  - a validator holds the tree-validation lock on the file's worktree.

The rules are documented for humans in ai/guidelines/rules/git-operations.md
§ Worktree-First Development, and the lock in ai/lib/core/tree_lock.py.
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

# block MESSAGE — refuse the tool call. Exit 2 is the only status Claude Code
# treats as blocking, and stderr is the only stream it feeds back.
block() {
  echo "BLOCKED: $1" >&2
  exit 2
}

# Fail open: a malformed payload must not block every Edit/Write.
file_path=$(jq -r '.tool_input.file_path // empty' 2>/dev/null) || exit 0
[[ -z "$file_path" ]] && exit 0

# GIT_DIR and friends are stripped before any git below. Git skips discovery
# when GIT_DIR is set, so one inherited from a calling hook would answer about
# that repository instead of the edited file's — a wrong answer arriving as a
# success.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

parent=$(dirname "$file_path")
repo_dir=$(cd "$parent" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || exit 0

# The lock is checked before the branch rule, and without the gitignore
# exemption: a suite reads ignored build output too, and rewriting it under a
# running gate invalidates the same run. No pid is named — holders() can be
# empty while the lock is held, so it is not a detail this can stand behind.
_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
_with_tree_lock="$_repo_root/bin/local/with-tree-lock"

if [[ -x "$_with_tree_lock" ]] \
  && "$_with_tree_lock" --check "$repo_dir" >/dev/null 2>&1; then
  block "A validator holds this tree — a suite or a gate is reading the files you are about to change. Editing now invalidates that run: it reports against a tree that no longer exists, and a green result would be exactly as green. Wait for it to finish, or make the edit in another worktree."
fi

branch=$(git -C "$repo_dir" branch --show-current 2>/dev/null) || exit 0
[[ -z "$branch" ]] && exit 0

if [[ "$branch" == "main" || "$branch" == "master" ]]; then
  git -C "$repo_dir" check-ignore -q "$file_path" 2>/dev/null && exit 0
  block "Cannot edit files on $branch. Create a worktree first: wt switch -c <branch>"
fi
