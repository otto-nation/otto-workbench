#!/usr/bin/env bash
# PreToolUse guard for the Edit and Write tools.
#
# Reads a hook payload on stdin and exits 2 with an explanation when the edit
# would land on main/master (unless the path is gitignored), when a validator
# currently holds the tree the file lives in, or when it is a plan or spec
# being written inside a worktree instead of the repository's workspace.
# Exits 0 otherwise.
#
# Two of the three have Pi twins: ai/pi/extensions/tree-lock-guard reads the
# same lock, and ai/pi/extensions/workspace-guard applies the same workspace
# rule. Both go through the same underlying command as this does —
# `with-tree-lock --check` and `resolve-workspace` — so one fact answers both
# harnesses rather than two implementations drifting.
#
# Usage: claude-edit-guard        (stdin: {"tool_input":{"file_path":"..."}})

set -e

usage() {
  cat <<EOF
Usage: claude-edit-guard

PreToolUse hook for the Edit and Write tools. Reads a hook payload on stdin
and exits 2 when either:

  - the target file is in a main or master worktree and is not gitignored; or
  - a validator holds the tree-validation lock on the file's worktree.

The rules are documented for humans in ai/guidelines/rules/git-operations.md
§ Worktree-First Development, and the lock in ai/lib/core/tree_lock.py.
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

# block MESSAGE — refuse the tool call. Exit 2 is the only status Claude Code
# treats as blocking, and stderr is the only stream it feeds back.
block() {
  echo "BLOCKED: $1" >&2
  exit 2
}

# Fail open: a malformed payload must not block every Edit/Write.
file_path=$(jq -r '.tool_input.file_path // empty' 2>/dev/null) || exit 0
[[ -z "$file_path" ]] && exit 0

# GIT_DIR and friends are stripped before any git below. Git skips discovery
# when GIT_DIR is set, so one inherited from a calling hook would answer about
# that repository instead of the edited file's — a wrong answer arriving as a
# success. GIT_COMMON_DIR goes with them: it redirects the shared storage a
# linked worktree reads, and the Pi twin in detect.ts strips the same four.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR

# _nearest_dir PATH — the closest ancestor of PATH that exists.
#
# A Write creating a file in a directory that is not there yet is the ordinary
# case, not an edge one: the first spec a repo gets creates `specs/` with it.
# Resolving the repository by `cd`-ing into the file's own parent fails for
# every such write, and the guard then exits 0 — failing open on precisely the
# writes it exists to catch. Walking up is what makes a new file in a new
# directory visible to all three checks below.
_nearest_dir() {
  local d="$1"
  while [[ -n "$d" && "$d" != "/" && ! -d "$d" ]]; do d=$(dirname "$d"); done
  printf '%s' "$d"
}

case "$file_path" in
  /*) _abs="$file_path" ;;
  *)  _abs="$PWD/$file_path" ;;
esac
parent=$(_nearest_dir "$(dirname "$_abs")")
repo_dir=$(cd "$parent" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || exit 0

# The lock is checked before the branch rule, and without the gitignore
# exemption: a suite reads ignored build output too, and rewriting it under a
# running gate invalidates the same run. No pid is named — holders() can be
# empty while the lock is held, so it is not a detail this can stand behind.
#
# The symlink is followed before the traversal. sync_component_bin installs
# this as ~/.local/bin/claude-edit-guard, and settings.json runs it by that
# path: without the readlink, ../../.. climbs out of ~/.local/bin to a user
# directory, the -x test fails, and the lock half is silently skipped on every
# real invocation while the tests — which call the repo copy — stay green.
_SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_repo_root="$(cd "$(dirname "$_SELF")/../../.." && pwd)"
_with_tree_lock="$_repo_root/bin/local/with-tree-lock"

# Exit 3 is a probe that could not answer — git hung, or the lock file would
# not open. The edit goes through, as for a free tree, but the reason is passed
# on to stderr rather than discarded so a silent guard can be told from a free
# tree. Any other non-zero is not-held, as before.
_lock_rc=1
if [[ -x "$_with_tree_lock" ]]; then
  _lock_err=$("$_with_tree_lock" --check "$repo_dir" 2>&1 >/dev/null) && _lock_rc=0 || _lock_rc=$?
fi
if [[ "$_lock_rc" -eq 3 ]]; then
  echo "claude-edit-guard: $_lock_err" >&2
fi
if [[ "$_lock_rc" -eq 0 ]]; then
  block "A validator holds this tree — a suite or a gate is reading the files you are about to change. Editing now invalidates that run: it reports against a tree that no longer exists, and a green result would be exactly as green. Wait for it to finish, or make the edit in another worktree."
fi

# ── Plans and specs belong at the container, not in a checkout ───────────────
#
# Checked against the path relative to the worktree, and on whole segments: a
# `case` glob on the bare string would match `my-workspace/` and `ignore/`
# anywhere in a longer name. The three shapes are the new home written in the
# wrong place, the old `ignore/` convention, and the directory the
# brainstorming skill defaults to — that last one is why this guard exists at
# all, since the skill names it in prose the rule can only ask it to override.
#
# Both sides go through `pwd -P` before they are compared. On macOS a path
# under /tmp or /var canonicalises to /private/..., and `--show-toplevel`
# already returns that form — so comparing it against a raw payload path would
# never match, and the guard would pass everything under those roots.
_rest="${_abs#"$parent"/}"
_top=$(cd "$repo_dir" && pwd -P)
_rel="$(cd "$parent" && pwd -P)/$_rest"
_rel="${_rel#"$_top"/}"

_resolve_workspace="$_repo_root/bin/resolve-workspace"

case "$_rel" in
  workspace/*|ignore/plans/*|ignore/specs/*|docs/superpowers/*)
    # The suggestion is the resolver's own answer, never a path built here —
    # two spellings of one location is what the resolver exists to prevent.
    if _ws=$("$_resolve_workspace" "$repo_dir" 2>/dev/null); then
      block "A plan or spec belongs to the repository, not to this branch. Written here it is duplicated across every sibling worktree, invisible from them, and deleted by the \`wt remove\` that retires the branch — while the work it explains lives on in main. Write it under $_ws instead (plans/ or specs/), which is outside every checkout."
    fi
    block "A plan or spec belongs at the repository's container, and this is an ordinary clone — it has no container, so there is nowhere correct to put one. Convert the repo with \`wt-init\`, then write it under the path \`resolve-workspace\` prints. Writing it inside the checkout is the arrangement this refuses."
    ;;
esac

branch=$(git -C "$repo_dir" branch --show-current 2>/dev/null) || exit 0
[[ -z "$branch" ]] && exit 0

if [[ "$branch" == "main" || "$branch" == "master" ]]; then
  git -C "$repo_dir" check-ignore -q "$file_path" 2>/dev/null && exit 0
  block "Cannot edit files on $branch. Create a worktree first: wt switch -c <branch>"
fi
