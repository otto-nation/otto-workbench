# ── Startup migrations ──────────────────────────────────────────────────────

def _migrate_legacy_reviews() -> None:
    if not LEGACY_REVIEWS_DIR.is_dir():
        return
    reviews = workbench_paths.reviews_dir()
    files = [f for p in ("*.md", "*.jsonl") for f in LEGACY_REVIEWS_DIR.glob(p)]
    for f in files:
        dest = reviews / f.name
        if not dest.exists():
            shutil.move(str(f), str(dest))


def _migrate_one_flat_review(reviews: Path, flat_review: Path, dir_name: str) -> None:
    review_dir = reviews / dir_name
    review_dir.mkdir(parents=True, exist_ok=True)
    shutil.move(str(flat_review), str(review_dir / f"review{REVIEW_EXT}"))

    suffix_map = {
        ".session.jsonl": "session.jsonl",
        ".meta.json": "meta.json",
        ".post.jsonl": "post.jsonl",
        ".pipeline.json": "pipeline.json",
        ".prior.md": "prior.md",
    }
    for suffix, new_name in suffix_map.items():
        flat_file = reviews / f"{dir_name}{suffix}"
        if flat_file.is_file():
            shutil.move(str(flat_file), str(review_dir / new_name))

    # Literal, unlike review_gc's derived list: these name the historical flat
    # layout, not the current convention. A phase added to the enum tomorrow
    # never wrote a file here, so deriving these from Phase would claim
    # otherwise.
    intermediate_patterns = (
        f"{dir_name}.group-*.md", f"{dir_name}.group-*.jsonl",
        f"{dir_name}.holistic.md", f"{dir_name}.holistic.jsonl",
        f"{dir_name}.synthesis.jsonl",
    )
    intermediates = [f for p in intermediate_patterns for f in reviews.glob(p)]
    for intermediate in intermediates:
        fname = intermediate.name.removeprefix(f"{dir_name}.")
        shutil.move(str(intermediate), str(review_dir / fname))

    archive_dir = review_dir / "archives"
    archive_patterns = (f"{dir_name}.2*.md", f"{dir_name}.session.2*.jsonl", f"{dir_name}.post.2*.jsonl")
    archives = [f for p in archive_patterns for f in reviews.glob(p)]
    for archive in archives:
        archive_dir.mkdir(exist_ok=True)
        fname = archive.name.removeprefix(f"{dir_name}.")
        shutil.move(str(archive), str(archive_dir / fname))


def _migrate_flat_reviews() -> None:
    reviews = workbench_paths.reviews_dir()
    migrated = 0
    for flat_review in reviews.glob(f"*{REVIEW_EXT}"):
        if not flat_review.is_file():
            continue
        dir_name = flat_review.stem
        review_dir = reviews / dir_name
        if review_dir.is_dir():
            continue
        _migrate_one_flat_review(reviews, flat_review, dir_name)
        migrated += 1

    if migrated > 0:
        log.info(f"Migrated {migrated} reviews to folder layout")


# ── Helpers ──────────────────────────────────────────────────────────────────

def _is_pr_ref(s: str) -> bool:
    return pr_context.is_pr_ref(s)


def _post_review(repo: str, pr_number: str, review_file: str, submit: bool) -> None:
    """Post a review to GitHub via review-post."""
    post_args = [
        str(BIN_DIR / "review-post"),
        "--pr", pr_number,
        "--review-file", review_file,
    ]
    if submit:
        post_args.append("--submit")
    subprocess.run(post_args, check=False, timeout=timeouts.UNBOUNDED)


def _display_review(path: Path) -> None:
    log.blank()
    log.info("─── Review ───")
    print()
    print(path.read_text())
    print()


def _format_usage(*log_paths: str, wall_clock_ms: int | None = None) -> str:
    logs = [p for p in log_paths if p and os.path.isfile(p)]
    if not logs:
        return ""

    usages = [parse_session_log(p) for p in logs]
    cost = sum(u.cost for u in usages)
    total = sum(u.total_tokens for u in usages)
    cached = sum(u.cache_read_tokens for u in usages)
    duration_ms = wall_clock_ms if wall_clock_ms is not None else sum(u.duration_ms for u in usages)

    if cost == 0.0 and total == 0 and duration_ms == 0:
        return ""

    tokens_part = f"{format_tokens(total)} tokens"
    if cached > 0:
        tokens_part += f" ({format_tokens(cached)} cached)"

    duration_s = duration_ms // 1000
    mins, secs = divmod(duration_s, 60)
    duration_fmt = f"{mins}m {secs}s" if mins > 0 else f"{secs}s"
    cost_fmt = f"${cost:.2f}"

    return f"  Usage:           {cost_fmt} · {tokens_part} · {duration_fmt}"


def _format_findings_line(review_file: str) -> str:
    review_path = Path(review_file) if review_file else None
    if not review_path or not review_path.is_file():
        return ""
    counts = count_severities(review_path)
    parts = [
        f"{counts[sev.key]} {sev.section.lower()}"
        for sev in SEVERITIES if counts[sev.key] > 0
    ]
    return ", ".join(parts)


def _format_verdict(review_file: str) -> str:
    verdict = resolve_review_verdict(Path(review_file) if review_file else None)
    return verdict.prose if verdict else ""


def _print_summary(
    review_file: str,
    session_log: str,
    pr_url: str = "",
    post_session_log: str = "",
    branch_name: str = "",
    wall_clock_ms: int | None = None,
) -> None:
    log.blank()
    log.info("─── Summary ───")

    findings = _format_findings_line(review_file)
    if findings:
        log.dim(f"Findings:        {findings}")

    verdict = _format_verdict(review_file)
    if verdict:
        log.dim(f"Verdict:         {verdict}")

    review_dir = Path(review_file).parent if review_file else None
    warnings = read_pipeline_warnings(review_dir)
    if warnings:
        log.warn(f"Incomplete:    {', '.join(warnings)}")

    log.dim(f"Review:          {review_file}")
    log.dim(f"Session log:     {session_log}")
    if post_session_log and os.path.isfile(post_session_log):
        log.dim(f"Post session:    {post_session_log}")
    if pr_url:
        log.dim(f"PR:              {pr_url}")
    elif branch_name:
        log.dim(f"Branch:          {branch_name}")
    usage_line = _format_usage(session_log, post_session_log, wall_clock_ms=wall_clock_ms)
    if usage_line:
        log.dim(usage_line.strip())
    log.blank()


def _update_pr_state(
    ctx: pr_context.ResolvedContext, review_file: str, mode: Mode, *, trail: Trail,
) -> None:
    """Record the review's outcome in the state of the target *ctx* names.

    ``ctx`` is the identity the entry point resolved for this run, threaded down
    rather than derived a second time here. Re-deriving read the *caller's*
    checkout, which on the ``--pr`` path is routinely a different branch than
    the PR's — so the verdict, finding counts, and cost landed with whatever the
    caller happened to be standing on. One identity per run, derived once.
    """
    if not review_file or not os.path.isfile(review_file):
        return

    review_path = Path(review_file)
    review_dir = review_path.parent

    by_key = count_severities(review_path)
    finding_counts = {s.json_key: by_key[s.key] for s in SEVERITIES if by_key[s.key]}

    meta = read_review_meta(review_dir)
    # Mode, not review type. A self-review has no PR to approve or block; how
    # much of the branch it covered is a separate question, and both are recorded.
    resolved = resolve_review_verdict(
        review_path, counts=by_key, self_review=mode is Mode.SELF,
    )
    verdict = resolved.value if resolved else ""
    usage = aggregate_session_usage(review_dir)

    status = read_pipeline_status(review_dir)

    summary = pr_domains.ReviewSummary(
        review_file=review_file,
        review_type=meta.review_type or ReviewType.FULL,
        head_sha=meta.head_sha,
        finding_counts=finding_counts,
        verdict=verdict,
        status=status,
        failure_detail=build_failure_detail(review_dir),
        cost_usd=usage.cost,
        total_tokens=usage.total_tokens,
        updated_at=pr_state.now_iso(),
    )

    try:
        pr_state.apply_state_update(
            target_dir=ctx.target_dir,
            repo=ctx.repo,
            branch=ctx.branch,
            pr_number=ctx.pr_number,
            head_sha=ctx.head_sha,
            worktree_root=str(ctx.worktree_root) if ctx.worktree_root else "",
            domain="review",
            data=_serde_to_dict(summary),
        )
    except Exception as exc:
        # state.json is a cache and the review itself succeeded, so a failed
        # write must not abort the run — but it must not vanish either, which
        # is why both channels report it, as ci-check and review-threads do.
        trail.error("state_update", f"state update failed: {exc}")
        log.error(f"claude-review: state update failed: {exc}")


def _archive_review(review_file: Path, session_log: str) -> str:
    review_dir = review_file.parent
    archive_dir = review_dir / "archives"
    prior_path = ""

    if review_file.is_file():
        prior_path = str(review_dir / FILENAME_PRIOR)
        shutil.copy2(str(review_file), prior_path)

        archive_dir.mkdir(exist_ok=True)
        ts = datetime.now().strftime(ARCHIVE_TIMESTAMP_FMT)
        shutil.move(str(review_file), str(archive_dir / f"{ts}{REVIEW_EXT}"))
        log.info(f"Archived prior review to archives/{ts}{REVIEW_EXT}")

    if os.path.isfile(session_log):
        archive_dir.mkdir(exist_ok=True)
        ts = datetime.now().strftime(ARCHIVE_TIMESTAMP_FMT)
        shutil.move(session_log, str(archive_dir / f"{ts}.session.jsonl"))

    post_log = str(review_dir / FILENAME_POST_SESSION)
    if os.path.isfile(post_log):
        archive_dir.mkdir(exist_ok=True)
        ts = datetime.now().strftime(ARCHIVE_TIMESTAMP_FMT)
        shutil.move(post_log, str(archive_dir / f"{ts}.post.jsonl"))

    # Prune old archives
    for suffix in (REVIEW_EXT, ".session.jsonl", ".post.jsonl"):
        pattern = f"2*{suffix}"
        archives = sorted(archive_dir.glob(pattern), reverse=True) if archive_dir.is_dir() else []
        for old in archives[ARCHIVE_KEEP_COUNT:]:
            old.unlink(missing_ok=True)

    return prior_path


def _resolve_prior_review(review_file: Path, session_log: str, resume: bool) -> str:
    review_dir = review_file.parent
    if resume:
        prior = review_dir / FILENAME_PRIOR
        if prior.is_file():
            return str(prior)
        return ""
    return _archive_review(review_file, session_log)


def _cleanup_prior_review(review_file: Path, prior_path: str) -> None:
    if not prior_path:
        return
    review_dir = review_file.parent
    pipeline_state = review_dir / FILENAME_PIPELINE_STATE
    if not pipeline_state.is_file():
        try:
            os.unlink(prior_path)
        except OSError:
            pass


def _check_pending_review(repo: str, pr_number: str, force: bool) -> None:
    if force:
        return

    gh_user = gh_client.login()
    pending = gh_client.api_json(
        f"repos/{repo}/pulls/{pr_number}/reviews",
        jq=f'[.[] | select(.user.login == "{gh_user}" and .state == "PENDING")] | first // empty',
    )
    # `first // empty` prints nothing when no review matches, so gh's stdout is
    # empty and `api_json` falls back to its default. Anything other than a dict
    # therefore means "no pending review", not a review with no id.
    pending_id = pending.get("id") if isinstance(pending, dict) else None
    if pending_id is None:
        return

    comment_count = gh_client.api(
        f"repos/{repo}/pulls/{pr_number}/reviews/{pending_id}/comments", jq="length",
    ).stdout.strip() or "0"

    log.warn(f"PENDING review exists with {comment_count} comments (not yet submitted)")
    if not prompt.confirm("Delete the pending review before re-reviewing?"):
        log.info("Keeping pending review — new review will replace it at post time")
        return

    deleted = gh_client.api(
        f"repos/{repo}/pulls/{pr_number}/reviews/{pending_id}", method="DELETE",
    )
    if deleted.ok:
        log.info("Deleted pending review")
    else:
        log.warn("Could not delete the pending review — it will be replaced at post time")


def _read_review_sha(review_file: Path) -> str:
    try:
        text = review_file.read_text()
    except OSError:
        return ""
    m = re.search(r"<!-- head_sha: ([a-f0-9]+) -->", text)
    return m.group(1) if m else ""


def _get_pr_head_sha(repo: str, pr_number: str) -> str:
    return gh_client.pr_view(pr_number, "headRefOid", repo=repo).get("headRefOid", "")


def _resolve_recover_sha(review_dir: Path, head_sha: str) -> str:
    """Return the commit a --recover run must complete against. Exits on failure.

    ``head_sha`` is the current HEAD — the PR head for PR reviews, the local
    worktree HEAD for self-reviews. The returned SHA is the one the failed run
    recorded in its pipeline state, so recovery finishes the analysis it started
    even when the branch has moved on. An empty return means no pinning: either
    HEAD could not be determined or the state predates SHA tracking.
    """
    pipeline_path = review_dir / FILENAME_PIPELINE_STATE
    if not pipeline_path.is_file():
        log.error("No pipeline state found — nothing to recover")
        sys.exit(1)
    if read_pipeline_status(review_dir) == "completed":
        log.info("Nothing to recover — review is complete")
        sys.exit(0)
    try:
        pipeline_data = json.loads(pipeline_path.read_text())
    except (json.JSONDecodeError, OSError):
        log.error(f"Corrupt pipeline state: {review_dir}")
        sys.exit(1)
    recorded_sha = pipeline_data.get("head_sha", "")
    if not recorded_sha:
        return ""
    if head_sha and recorded_sha != head_sha:
        log.warn(
            f"HEAD has moved since the failed review "
            f"({git_client.abbrev(recorded_sha)} → {git_client.abbrev(head_sha)}); "
            f"completing the run at {git_client.abbrev(recorded_sha)} — "
            f"run `pr review` to review the new commits"
        )
    return recorded_sha


def _recover_drifted(recover_sha: str, wt_path: str) -> bool:
    """True when the commit being recovered is behind the worktree's HEAD."""
    return bool(recover_sha) and recover_sha != pr_context.head_sha(wt_path)


def _pin_recover_worktree(
    recover_sha: str, wt_path: str, repo_dir: str, label: str,
) -> tuple[str, review_worktree.WorktreeResult | None]:
    """Check the recovered commit out into a throwaway worktree when HEAD moved.

    Returns the path the review should run against and the worktree to clean up
    afterwards (None when no pinning was needed).
    """
    if not _recover_drifted(recover_sha, wt_path):
        return wt_path, None

    pinned = review_worktree.detached_worktree_at(recover_sha, repo_dir, label)
    if pinned is None:
        log.error(
            f"Commit {git_client.abbrev(recover_sha)} from the failed review is no longer "
            f"available — run `pr review` for a fresh review"
        )
        sys.exit(1)

    return pinned.path, pinned


def _should_auto_recover(repo: str, pr_number: str, review_file: Path) -> None:
    """Log recovery intent when HEAD unchanged and prior review had failures."""
    review_sha = _read_review_sha(review_file)
    if not review_sha:
        return
    pr_head_sha = _get_pr_head_sha(repo, pr_number)
    if not pr_head_sha or review_sha != pr_head_sha:
        return
    pipeline_status = read_pipeline_status(review_file.parent)
    if pipeline_status in (pr_domains.ReviewStatus.PARTIAL.value, pr_domains.ReviewStatus.ERROR.value):
        log.info(
            f"Recovering failed review agents (HEAD unchanged at {git_client.abbrev(review_sha)})")


def _check_stale_review(repo: str, pr_number: str, review_file: Path, force: bool) -> None:
    if force:
        return
    if not review_file.is_file():
        return

    review_sha = _read_review_sha(review_file)
    if not review_sha:
        return
    pr_head_sha = _get_pr_head_sha(repo, pr_number)
    if not pr_head_sha:
        return

    if review_sha == pr_head_sha:
        review_dir = review_file.parent
        pipeline_status = read_pipeline_status(review_dir)
        if pipeline_status in ("partial", "error"):
            log.info(
                "Recovering failed review agents "
                f"(HEAD unchanged at {git_client.abbrev(pr_head_sha)})")
            return

        log.warn(
            f"No new commits since the last review (HEAD {git_client.abbrev(pr_head_sha)})")
        if not prompt.confirm("Re-review anyway?"):
            sys.exit(0)
    else:
        log.info(
            "Incremental review: new commits since last review "
            f"({git_client.abbrev(review_sha)}..{git_client.abbrev(pr_head_sha)})")


def _generator_version() -> str:
    try:
        ver = version_string(SCRIPT)
        return ver.splitlines()[-1] if ver else "unknown"
    except Exception:
        return "unknown"


def _submit_pending_review(repo: str, pr_number: str, review_file: str) -> None:
    review_dir = Path(review_file).parent
    post_file = review_dir / FILENAME_POST_SESSION
    if not post_file.is_file():
        log.error(f"No post tracking file found: {post_file}")
        return

    tracking = serde_load_file(PostTracking, post_file)

    if not tracking or not tracking.review_id:
        log.error(f"Could not read review_id from {post_file}")
        return

    log.info(f"Submitting review #{tracking.review_id}...")
    r = gh_client.api(
        f"repos/{repo}/pulls/{pr_number}/reviews/{tracking.review_id}/events",
        method="POST", raw_fields={"event": "COMMENT"}, retry=False,
    )
    if r.ok:
        log.info(f"Review #{tracking.review_id} submitted")
    else:
        log.warn(f"Failed to submit review #{tracking.review_id}")

    try:
        tracking.submitted = True
        post_file.write_text(json.dumps(serde_to_dict(tracking)))
    except Exception:
        pass


def _verify_pr_ownership(pr_number: str, repo: str) -> None:
    author = gh_client.pr_view(pr_number, "author", repo=repo).get("author") or {}
    pr_author = author.get("login", "")
    gh_user = gh_client.login()

    if not pr_author or not gh_user or pr_author == gh_user:
        return

    log.warn(f"PR #{pr_number} is owned by {pr_author}, not {gh_user}")
    if not prompt.confirm("Continue with self-review?"):
        sys.exit(0)


def _find_repo_root(repo: str, explicit_dir: str = "") -> str:
    repo_name = repo.split("/")[-1]

    if explicit_dir:
        if os.path.isdir(explicit_dir):
            return explicit_dir
        return ""

    # An unusable git has to fall through to the gh and find lookups below,
    # which are guarded the same way — a non-zero exit already does, but an
    # absent binary raises out of subprocess. Caught broadly as OSError (not
    # just FileNotFoundError, as retro-scan and reuse-session-start do for the
    # same call) because a permissions error on the git binary should fall
    # through here too, not surface as an unhandled exception.
    try:
        git_toplevel = git_client.out("rev-parse", "--show-toplevel")
    except OSError:
        git_toplevel = ""

    if git_toplevel:
        if os.path.basename(git_toplevel) == repo_name:
            return git_toplevel
        parent_dir = os.path.dirname(git_toplevel)
        if os.path.basename(parent_dir) == repo_name:
            return parent_dir

    name = gh_client.out("repo", "view", repo, "--json", "name", "--jq", ".name")
    if not name:
        return ""

    home_git = os.path.expanduser("~/git")
    try:
        r2 = subprocess.run(
            ["find", home_git, "-maxdepth", "2", "-name", name, "-type", "d"],
            capture_output=True, text=True, timeout=timeouts.LOCAL,
        )
        found = r2.stdout.strip().splitlines()
    except Exception:
        found = []
    return found[0] if found else ""


def _resolve_bare_repo_worktree(branch: str = "") -> str:
    wt = pr_context.resolve_bare_repo_worktree(None, branch or None)
    if wt:
        return str(wt)
    display_branch = branch or pr_context.default_branch()
    log.error(f"Bare repository — no worktree found for {display_branch}. Pass --repo-dir to specify a worktree")
    sys.exit(1)


def _fail_orchestration(msg: str, session_log: str) -> None:
    log.error(msg)
    if os.path.isfile(session_log):
        log.dim(f"Session log: {session_log}")
    sys.exit(1)


# ── Supersession preflight ──────────────────────────────────────────────────


def _supersession_override(user_force: bool, recover: bool) -> bool:
    """Whether this run is exempt from the supersession refusal, and why.

    `user_force` is the raw `--force` flag, deliberately not the `force` local
    the confirmation prompts use. That one also absorbs `--post` and
    `--no-post` as "nobody is here to answer a prompt", and an unattended run
    is the one this refusal most has to survive: there is no operator to notice
    that the findings describe deleted code before they are posted to the PR.

    `--recover` is exempt, on both entry points. It finishes a run whose spend
    has already been made, so refusing it saves nothing and strands the
    artifacts of the run it was asked to complete.
    """
    return bool(user_force or recover)


def _refuse_if_superseded(
    wt_path: str, repo: str, target_dir: Path, branch: str, *,
    override: bool, trail: Trail,
) -> None:
    """Stop before the review spends anything on a branch that may be superseded.

    A refusal rather than the hold `pr comments` places, because of where the
    money is. A review is the largest model spend in the repo and this runs
    before the first agent call, so refusing costs nothing and saves all of it;
    holding the posting at the end would save nothing that had not already been
    spent. That is the behavioural difference between the two callers, and it
    is deliberate.

    Findings about code the default branch has already deleted are worse than
    no findings: they read as ordinary review comments, so acting on them
    means fixing code that no longer exists.
    """
    if override:
        return
    verdict = supersession.detect_cached(
        Path(wt_path), repo, target_dir, trail=trail,
    )
    supersession.report(verdict)
    if not verdict.superseded:
        return

    log.error(f"Refusing to review {branch} — it may already be superseded.")
    log.dim("Reviewing a branch that re-adds code the default branch removed "
            "produces findings about code that should not exist.")
    log.dim(f"Pass {supersession.OVERRIDE_FLAG} to review it anyway.")
    trail.decision(
        "supersession_refusal",
        f"refused review — {len(verdict.holding)} supersession signal(s)",
        reason="reviewing code the default branch has already removed asserts it should exist",
        data={"signals": [s.kind for s in verdict.holding]},
    )
    json.dump({
        "branch": branch,
        "status": "superseded",
        "signals": [
            {"kind": s.kind, "detail": s.detail, "holds": s.holds}
            for s in verdict.signals
        ],
        "override": supersession.OVERRIDE_FLAG,
    }, sys.stdout, indent=2)
    print()
    sys.exit(supersession.EXIT_SUPERSEDED)


def _build_orchestrate_args(
    *,
    pr_number: str, repo: str, review_file: Path, wt_path: str,
    session_log: str, prior_review_path: str, issue_link: str,
    issue_context: str, max_parallel: int, no_holistic: bool,
    max_cost: float | None, model: str | None, mode: str = "",
    fix_pass: bool = False, post: bool = False, effort: str | None = None,
    max_groups: int | None = None,
    no_scout: bool = False, disprove: bool | None = None,
    generated: bool = False, recover_sha: str = "",
    target_dir: Path,
) -> list[str]:
    args = [
        str(BIN_DIR / "review-orchestrate"),
        "--repo", repo,
        "--review-file", str(review_file),
        "--repo-dir", wt_path,
        "--target-dir", str(target_dir),
        "--session-log", session_log,
    ]
    if pr_number:
        args += ["--pr", pr_number]
    if mode:
        args += ["--mode", mode]
    if prior_review_path and os.path.isfile(prior_review_path):
        args += ["--prior-review", prior_review_path]
    if issue_link:
        args += ["--issue", issue_link]
    if issue_context:
        args += ["--issue-context", issue_context]
    args += ["--max-parallel", str(max_parallel)]
    args += ["--generator-version", _generator_version()]
    if fix_pass:
        args.append("--fix")
    # The publishing gate is process-wide and the fix pass runs in there, so the
    # only way it learns this run may publish is to be told on its own argv.
    if post:
        args.append("--post")
    if no_holistic:
        args.append("--no-holistic")
    if max_cost:
        args += ["--max-cost", str(max_cost)]
    if model:
        args += ["--model", model]
    # Forwarded only when asked for: an absent flag lets review-orchestrate
    # fall through to review.effort in config.yml.
    if effort:
        args += ["--effort", effort]
    if max_groups is not None:
        args += ["--max-groups", str(max_groups)]
    if no_scout:
        args.append("--no-scout")
    if disprove is True:
        args.append("--disprove")
    elif disprove is False:
        args.append("--no-disprove")
    if generated:
        args.append("--generated")
    if recover_sha:
        args += ["--recover-sha", recover_sha]
    return args


def _run_review_body(
    pr_number, repo, review_file, review_dir, wt_path,
    session_log, prior_review_path, issue_link, issue_context,
    max_parallel, no_holistic, max_cost, model, no_post, auto_post,
    auto_submit, pr_url, effort=None, max_groups=None,
    no_scout=False, disprove=None, generated=False, recover_sha="",
    *, target_dir,
) -> None:
    orchestrate_args = _build_orchestrate_args(
        pr_number=pr_number, repo=repo, review_file=review_file,
        wt_path=wt_path, session_log=session_log,
        prior_review_path=prior_review_path, issue_link=issue_link,
        issue_context=issue_context, max_parallel=max_parallel,
        no_holistic=no_holistic, max_cost=max_cost, model=model,
        effort=effort, max_groups=max_groups,
        no_scout=no_scout, disprove=disprove, generated=generated,
        recover_sha=recover_sha, target_dir=target_dir,
    )
    wall_start = time.monotonic()
    rc = subprocess.run(orchestrate_args, timeout=timeouts.UNBOUNDED).returncode
    wall_ms = int((time.monotonic() - wall_start) * 1000)
    if rc != 0:
        _fail_orchestration("Review orchestration failed", session_log)
    if not review_file.is_file():
        _fail_orchestration("Review orchestration completed but produced no review file", session_log)

    _cleanup_prior_review(review_file, prior_review_path)
    _display_review(review_file)

    if no_post:
        _print_summary(str(review_file), session_log, pr_url, wall_clock_ms=wall_ms)
        log.dim("Post to GitHub:  pr review --post")
        return

    if auto_post:
        _post_review(repo, pr_number, str(review_file), auto_submit)
        post_session_log = str(review_dir / FILENAME_POST_SESSION)
        _print_summary(str(review_file), session_log, pr_url, post_session_log, wall_clock_ms=wall_ms)
        return

    if not prompt.confirm("Satisfied with the review?"):
        _print_summary(str(review_file), session_log, pr_url, wall_clock_ms=wall_ms)
        log.dim("Edit the review:  $EDITOR " + str(review_file))
        log.dim("Post to GitHub:   pr review --post")
        sys.exit(0)

    if not prompt.confirm("Post review to GitHub?"):
        _print_summary(str(review_file), session_log, pr_url, wall_clock_ms=wall_ms)
        log.dim("Post to GitHub:  pr review --post")
        return

    _post_review(repo, pr_number, str(review_file), False)
    post_session_log = str(review_dir / FILENAME_POST_SESSION)

    if prompt.confirm("Submit review now?"):
        _submit_pending_review(repo, pr_number, str(review_file))

    _print_summary(str(review_file), session_log, pr_url, post_session_log, wall_clock_ms=wall_ms)


# ── Main flows ───────────────────────────────────────────────────────────────

def _run_review_pr(
    trail, ctx, pr_number, repo, review_dir, review_file,
    issue_link, no_post, auto_post, auto_submit,
    force, repo_dir, max_parallel, no_holistic, max_cost, model,
    effort=None, max_groups=None,
    no_scout=False, disprove=None, generated=False,
    recover=False, supersession_override=False,
) -> None:
    trail.info("resolve_context", f"resolved PR #{pr_number} in {repo}",
               data={"pr": pr_number, "repo": repo, "branch": ctx.branch})

    # Resolved before the issue lookup below, not with the worktree setup it
    # feeds further down: the repo's own .workbench.yml is what says which
    # tracker to read, and looking it up without one resolves to nothing.
    repo_root = _find_repo_root(repo, repo_dir)
    if not repo_root:
        trail.error("setup_worktree", f"cannot find local clone of {repo}")
        log.error(f"Cannot find local clone of {repo}. Clone it first and re-run from within the repo.")
        sys.exit(1)

    # Issue detection
    pr_meta = gh_client.pr_view(pr_number, "headRefName", "body", repo=repo)
    pr_head = pr_meta.get("headRefName", "")
    pr_body = pr_meta.get("body", "")

    issue_context = ""
    detected_link = ""
    if not issue_link:
        provider_info = review_issue.load_issue_provider(repo_root)
        issue_id = review_issue.extract_issue_id(provider_info.name, pr_head, pr_body)
        issue_result = review_issue.fetch_issue_context(
            provider_info.name, issue_id, repo, provider_info.options,
        )
        detected_link = issue_result.link
        issue_context = issue_result.context
        if detected_link:
            issue_link = detected_link

        if not no_post and not auto_post and not issue_link and not issue_context:
            issue_link = prompt.ask("Issue link (optional, Enter to skip): ")

    if issue_link or issue_context:
        trail.info("issue_context", "issue context available",
                   data={"issue_link": issue_link, "has_context": bool(issue_context)})

    pr_url = f"{GITHUB_BASE_URL}/{repo}/pull/{pr_number}"

    if recover:
        recover_sha = _resolve_recover_sha(review_dir, _get_pr_head_sha(repo, pr_number))
        has_pipeline_state = True
        force = True
    else:
        recover_sha = ""
        has_pipeline_state = (review_dir / FILENAME_PIPELINE_STATE).is_file()

    if has_pipeline_state and review_file.exists():
        _should_auto_recover(repo, pr_number, review_file)

    if not has_pipeline_state:
        _check_stale_review(repo, pr_number, review_file, force)
    trail.decision(
        "review_freshness",
        "resume" if has_pipeline_state else "fresh review",
        reason="pipeline state found" if has_pipeline_state else "no pipeline state",
        data={"has_pipeline_state": has_pipeline_state},
    )

    _check_pending_review(repo, pr_number, force)

    # Worktree setup
    trail.info("setup_worktree", f"setting up PR worktree",
               data={"repo_root": repo_root, "pr_head": pr_head})

    wt_result = review_worktree.setup_pr_worktree(repo, pr_number, repo_root, pr_head)

    # _pin_recover_worktree can exit, so it runs under the same finally as the
    # review itself — otherwise a fallback PR worktree would be left on disk.
    pinned_wt = None
    try:
        wt_path, pinned_wt = _pin_recover_worktree(
            recover_sha, wt_result.path, repo_root, f"recover-pr-{pr_number}",
        )

        # Inside the try, so a refusal still cleans up the worktree it read.
        # Its own flag rather than the `force` above, which by here has
        # absorbed --post/--no-post — see _supersession_override.
        _refuse_if_superseded(
            wt_path, repo, ctx.target_dir, ctx.branch,
            override=supersession_override, trail=trail,
        )

        session_log = str(review_dir / FILENAME_SESSION)
        prior_review_path = _resolve_prior_review(review_file, session_log, has_pipeline_state)

        trail.info("delegate_orchestrate", "delegating to review-orchestrate",
                   data={"wt_path": wt_path, "max_parallel": max_parallel,
                         "no_holistic": no_holistic, "max_cost": max_cost, "model": model})

        _run_review_body(
            pr_number, repo, review_file, review_dir, wt_path,
            session_log, prior_review_path, issue_link, issue_context,
            max_parallel, no_holistic, max_cost, model, no_post, auto_post,
            auto_submit, pr_url, effort=effort, max_groups=max_groups,
            no_scout=no_scout, disprove=disprove, generated=generated,
            recover_sha=recover_sha, target_dir=ctx.target_dir,
        )
    finally:
        review_worktree.cleanup_worktree(pinned_wt, repo_root)
        review_worktree.cleanup_worktree(wt_result, repo_root)


def _run_review(args, ctx: pr_context.ResolvedContext) -> None:
    """Review the PR *ctx* names.

    ``ctx`` comes from ``main()``, which resolved it to take the run lock.
    Resolving it again from the same inputs cost a ``gh`` round trip per review
    and left two independently derived copies of the one value this branch
    exists to derive once.
    """
    no_post = args.no_post
    auto_post = args.post
    auto_submit = args.submit
    issue_link = args.issue or ""
    max_parallel = args.max_parallel
    force = args.force
    no_holistic = args.no_holistic
    no_scout = args.no_scout
    disprove = args.disprove
    max_cost = args.max_cost
    model = args.model
    repo_dir = args.repo_dir or ""
    effort = args.effort
    max_groups = args.max_groups
    generated = args.generated
    recover = getattr(args, "recover", False)

    if no_post or auto_post:
        force = True

    pr_number = str(ctx.pr_number)
    repo = ctx.repo

    review_file = review_file_path(repo, pr_number)
    review_dir = review_file.parent
    review_dir.mkdir(parents=True, exist_ok=True)

    trail = Trail.start(
        script=SCRIPT,
        context={"repo": repo, "pr": pr_number, "branch": ctx.branch, "mode": "pr"},
        debug=getattr(args, "debug", False),
    )

    try:
        _run_review_pr(
            trail, ctx, pr_number, repo, review_dir, review_file,
            issue_link, no_post, auto_post, auto_submit,
            force, repo_dir, max_parallel, no_holistic, max_cost, model,
            effort=effort, max_groups=max_groups,
            no_scout=no_scout, disprove=disprove, generated=generated,
            recover=recover,
            supersession_override=_supersession_override(args.force, recover),
        )
        # Inside the trail's scope, so a failed write has somewhere to report.
        _update_pr_state(ctx, str(review_file), Mode.PR, trail=trail)
    except Exception as exc:
        trail.error("unexpected_error", str(exc))
        raise
    finally:
        trail.finish()


def _cleanup_self_review_worktree(wt_cleanup, repo_dir: str) -> None:
    # Runs from a `finally` that may already be unwinding the failure the
    # operator needs to see, so raising here would replace it with something
    # about git. Leaving the worktree behind is the lesser loss.
    try:
        original_repo_dir = repo_dir or git_client.out("rev-parse", "--show-toplevel")
    except OSError:
        return
    if original_repo_dir:
        review_worktree.cleanup_worktree(wt_cleanup, original_repo_dir)


def _run_self_review_body(
    repo, pr_number, wt_path, issue_link, max_parallel,
    no_holistic, max_cost, model, fix_pass, args,
    self_review_dir, branch_name, effort=None, max_groups=None,
    no_scout=False, disprove=None, generated=False,
    recover=False, head_sha="", *, ctx: pr_context.ResolvedContext, trail: Trail,
) -> None:
    review_file = self_review_dir / f"review{REVIEW_EXT}"
    session_log = str(self_review_dir / FILENAME_SESSION)

    # First thing in the body, ahead of the issue-context fetch below: this is
    # the cheapest point at which the run can still cost nothing.
    _refuse_if_superseded(
        wt_path, repo, ctx.target_dir, branch_name,
        override=_supersession_override(args.force, recover), trail=trail,
    )

    if recover:
        recover_sha = _resolve_recover_sha(self_review_dir, head_sha)
        has_pipeline_state = True
    else:
        recover_sha = ""
        has_pipeline_state = (self_review_dir / FILENAME_PIPELINE_STATE).is_file()
    prior_review_path = _resolve_prior_review(review_file, session_log, has_pipeline_state)

    issue_context = ""
    if not issue_link:
        provider_info = review_issue.load_issue_provider(wt_path)
        issue_id = review_issue.extract_issue_id(provider_info.name, branch_name)
        issue_result = review_issue.fetch_issue_context(
            provider_info.name, issue_id, repo, provider_info.options,
        )
        detected_link = issue_result.link
        issue_context = issue_result.context
        if detected_link:
            issue_link = detected_link

    if fix_pass and _recover_drifted(recover_sha, wt_path):
        log.error(
            f"--fix cannot run on a review recovered at {git_client.abbrev(recover_sha)} — HEAD has "
            f"moved, so the edits would land in a throwaway checkout. Recover without "
            f"--fix, then run `pr review --self --fix`."
        )
        sys.exit(1)

    review_wt_path, pinned_wt = _pin_recover_worktree(
        recover_sha, wt_path, wt_path, f"recover-{branch_name}",
    )
    orchestrate_args = _build_orchestrate_args(
        pr_number=pr_number, repo=repo, review_file=review_file,
        wt_path=review_wt_path, session_log=session_log,
        prior_review_path=prior_review_path, issue_link=issue_link,
        issue_context=issue_context, max_parallel=max_parallel,
        no_holistic=no_holistic, max_cost=max_cost, model=model,
        mode="self", fix_pass=fix_pass, post=args.post,
        effort=effort, max_groups=max_groups,
        no_scout=no_scout, disprove=disprove, generated=generated,
        recover_sha=recover_sha, target_dir=ctx.target_dir,
    )

    wall_start = time.monotonic()
    try:
        rc = subprocess.run(orchestrate_args, timeout=timeouts.UNBOUNDED).returncode
    finally:
        review_worktree.cleanup_worktree(pinned_wt, wt_path)
    wall_ms = int((time.monotonic() - wall_start) * 1000)
    if rc != 0:
        _fail_orchestration("Review orchestration failed", session_log)
    if not review_file.is_file():
        _fail_orchestration("Review orchestration completed but produced no review file", session_log)

    _cleanup_prior_review(review_file, prior_review_path)
    _display_review(review_file)

    pr_url = f"{GITHUB_BASE_URL}/{repo}/pull/{pr_number}" if pr_number else ""
    _print_summary(str(review_file), session_log, pr_url, "", branch_name, wall_clock_ms=wall_ms)

    _update_pr_state(ctx, str(review_file), Mode.SELF, trail=trail)

    json_stdout = getattr(args, "_json_stdout", None)
    if json_stdout is not None:
        summary = json_summary(repo, pr_number, str(review_file))
        os.write(json_stdout, (summary + "\n").encode())


def _resolve_wt_path(repo_dir: str, branch: str) -> str:
    cwd = repo_dir or None
    toplevel = pr_context._git_toplevel(cwd)
    if toplevel is not None:
        return str(toplevel)

    if not repo_dir and pr_context.is_bare_repo(cwd):
        return _resolve_bare_repo_worktree(branch)

    if repo_dir:
        log.error(f"Not a git repository: {repo_dir}")
    else:
        log.error("Not in a git repository — pass --repo-dir to specify the repo")
    sys.exit(1)


def _resolve_branch_input(pr_input: str, repo_dir: str) -> str:
    resolve_dir = repo_dir or "."
    try:
        r = subprocess.run(
            ["resolve-branch", pr_input],
            capture_output=True, text=True, cwd=resolve_dir, timeout=timeouts.LOCAL,
        )
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except Exception:
        pass
    return pr_input


def _run_self_review(args) -> None:
    pr_input = args.positional[0] if args.positional else ""
    issue_link = args.issue or ""
    max_parallel = args.max_parallel
    skip_user_verification = args.skip_user_verification
    force = args.force
    no_holistic = args.no_holistic
    no_scout = args.no_scout
    disprove = args.disprove
    max_cost = args.max_cost
    model = args.model
    repo_dir = args.repo_dir or ""
    fix_pass = args.fix
    effort = args.effort
    max_groups = args.max_groups
    generated = args.generated
    recover = getattr(args, "recover", False)

    is_pr = False
    is_branch = False
    if pr_input:
        if _is_pr_ref(pr_input):
            is_pr = True
        else:
            is_branch = True

    if is_branch:
        pr_input = _resolve_branch_input(pr_input, repo_dir)

    # Only a branch name is a worktree target — passing a PR ref here would have
    # the resolver create a worktree on a branch named after the PR number.
    wt_path = _resolve_wt_path(repo_dir, pr_input if is_branch else "")

    ctx = pr_context.resolve(
        pr=pr_input if is_pr else None,
        branch=pr_input if is_branch else None,
        repo_dir=wt_path,
    )
    repo = ctx.repo
    pr_number = str(ctx.pr_number) if ctx.pr_number else ""

    # Before the checkout is switched or a --fix pass edits it: two `--self`
    # runs on one branch are two processes committing to it. A no-op when `pr`
    # launched us — we resolve the same target and find its key already in
    # WORKBENCH_RUN_LOCK.
    run_lock.claim_for_process(
        ctx.target_dir,
        command=" ".join(["claude-review"] + sys.argv[1:]),
        started=pr_state.now_iso(),
    )

    wt_cleanup: review_worktree.WorktreeResult | None = None

    if is_pr:
        if not skip_user_verification:
            _verify_pr_ownership(pr_number, repo)
        wt_cleanup = review_worktree.switch_to_pr_branch(pr_number, repo, wt_path)
        if wt_cleanup:
            wt_path = wt_cleanup.path
    elif is_branch:
        wt_cleanup = review_worktree.switch_to_branch(pr_input, wt_path)
        if wt_cleanup:
            wt_path = wt_cleanup.path

    # Read HEAD after the switch — checking out a PR hard-resets the worktree to
    # the remote head, so ctx.head_sha can predate the commit the pipeline recorded.
    recover_head_sha = pr_context.head_sha(wt_path) if recover else ""

    repo_name = repo.split("/")[-1]
    branch_sanitized = (ctx.branch or "").replace("/", "-")
    self_review_dir = workbench_paths.reviews_dir() / f"{repo_name}-self-{branch_sanitized}"
    self_review_dir.mkdir(parents=True, exist_ok=True)

    trail = Trail.start(
        script=SCRIPT,
        context={"repo": repo, "pr": pr_number, "branch": ctx.branch, "mode": "self"},
        debug=getattr(args, "debug", False),
    )

    try:
        trail.info("resolve_context", f"self-review in {repo}",
                   data={"pr": pr_number, "repo": repo, "branch": ctx.branch, "wt_path": wt_path})
        _run_self_review_body(
            repo, pr_number, wt_path, issue_link, max_parallel,
            no_holistic, max_cost, model, fix_pass, args,
            self_review_dir=self_review_dir,
            branch_name=ctx.branch or "",
            effort=effort, max_groups=max_groups,
            no_scout=no_scout, disprove=disprove, generated=generated,
            recover=recover, head_sha=recover_head_sha,
            ctx=ctx, trail=trail,
        )
    except Exception as exc:
        trail.error("unexpected_error", str(exc))
        raise
    finally:
        trail.finish()
        if wt_cleanup:
            _cleanup_self_review_worktree(wt_cleanup, repo_dir)


# ── Main ─────────────────────────────────────────────────────────────────────

def main() -> None:
    signal.signal(
        signal.SIGINT,
        lambda *_: (log.blank(), log.info("Interrupted"),
                    sys.exit(proc.INTERRUPT_RETURNCODE)))

    parser = argparse.ArgumentParser(
        prog=SCRIPT,
        description="Run Claude's reviewer agent on a PR",
        add_help=True,
    )
    parser.add_argument("--no-post", action="store_true")
    parser.add_argument("--post", action="store_true")
    parser.add_argument("--submit", action="store_true")
    parser.add_argument("--self", action="store_true", dest="self_review")
    parser.add_argument("--fix", action="store_true")
    parser.add_argument("--skip-user-verification", action="store_true")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--recover", action="store_true")
    parser.add_argument("--no-holistic", action="store_true")
    parser.add_argument("--no-scout", action="store_true")
    parser.add_argument("--disprove", action="store_true", default=None)
    parser.add_argument("--no-disprove", action="store_true")
    parser.add_argument("--json-summary", action="store_true")
    parser.add_argument("--issue")
    parser.add_argument("--max-parallel", type=int, default=DEFAULT_MAX_PARALLEL)
    parser.add_argument("--max-cost", type=float)
    parser.add_argument("--model")
    parser.add_argument("--effort", choices=["low", "medium", "high"], default=None,
                        help="Effort preset (default: review.effort in config.yml, else medium)")
    parser.add_argument("--max-groups", type=int, default=None)
    parser.add_argument("--generated", action="store_true")
    parser.add_argument("--repo-dir", "--worktree", dest="repo_dir")
    parser.add_argument("--branch")
    parser.add_argument("--pr")
    parser.add_argument("-V", "--version", action="store_true")
    parser.add_argument("args", nargs="*")
    add_trail_args(parser)
    handle_value_flags(parser)

    parsed = parser.parse_args()

    if parsed.no_disprove:
        parsed.disprove = False
    elif parsed.disprove is None:
        parsed.disprove = None

    if parsed.version:
        print(version_string(SCRIPT))
        sys.exit(0)

    # JSON summary: save real stdout, redirect stdout to stderr
    _json_stdout_fd = None
    if parsed.json_summary:
        _json_stdout_fd = os.dup(sys.stdout.fileno())
        os.dup2(sys.stderr.fileno(), sys.stdout.fileno())
        sys.stdout = os.fdopen(sys.stdout.fileno(), "w", closefd=False)

    if not parsed.repo_dir and os.environ.get("REPO_DIR"):
        parsed.repo_dir = os.environ["REPO_DIR"]

    # Flatten positional args, incorporating --pr and --branch from dispatcher
    parsed.positional = list(parsed.args)
    if parsed.pr and not parsed.positional:
        parsed.positional = [parsed.pr]

    # Startup migrations
    workbench_paths.reviews_dir().mkdir(parents=True, exist_ok=True)
    _migrate_legacy_reviews()
    _migrate_flat_reviews()

    if parsed.fix and not parsed.self_review:
        log.error("--fix requires --self")
        sys.exit(1)

    if parsed.recover and parsed.force:
        log.error("--recover and --force are mutually exclusive")
        sys.exit(1)

    if parsed.self_review:
        parsed._json_stdout = _json_stdout_fd
        _run_self_review(parsed)
        if _json_stdout_fd is not None:
            os.close(_json_stdout_fd)
        return

    if parsed.no_post and parsed.post:
        log.error("--no-post and --post are mutually exclusive")
        sys.exit(1)

    command = parsed.positional[0] if parsed.positional else ""
    if not command:
        parser.print_help()
        sys.exit(1)

    _REMOVED = {"gc": "pr gc", "post": "pr review --post", "rebuild": "pr review --repair",
                "summary": "pr review --summary", "threads": "pr comments"}
    if command in _REMOVED:
        log.error(f"'{command}' subcommand removed. Use: {_REMOVED[command]}")
        sys.exit(1)

    pr_arg, branch_arg = pr_context.classify_target(command)
    ctx = pr_context.resolve(pr=pr_arg, branch=branch_arg, repo_dir=parsed.repo_dir)
    pr_num = str(ctx.pr_number)
    review_file = review_file_path(ctx.repo, pr_num)
    # A no-op when pr launched us — we resolve the same target and find its key
    # already in WORKBENCH_RUN_LOCK.
    run_lock.claim_for_process(
        ctx.target_dir,
        command=" ".join([SCRIPT] + sys.argv[1:]),
        started=pr_state.now_iso(),
    )
    _run_review(parsed, ctx)
    if _json_stdout_fd is not None:
        summary = json_summary(ctx.repo, pr_num, str(review_file))
        os.write(_json_stdout_fd, (summary + "\n").encode())
        os.close(_json_stdout_fd)


if __name__ == "__main__":
    main()
