#!/usr/bin/env python3
"""Query trail files and AI usage across otto-workbench scripts.

Trails are discovered from one root — `workbench_paths.trail_dir()`, monthly
files under the state root. The `stats` subcommand reads the global AI usage
ledger instead — a separate, monthly-rotated store that every AI call appends to.
"""

from __future__ import annotations

import argparse
import json
import re
import statistics
import sys
from datetime import datetime, timezone, timedelta
from pathlib import Path

LIB_DIR = Path(__file__).resolve().parent.parent.parent / "lib"
sys.path.insert(0, str(LIB_DIR))

import ai_usage
import log
import workbench_paths
from trail import FINISH_ACTION


ANSI_RESET = "\033[0m"
ANSI_BOLD = "\033[1m"
ANSI_LEVELS = {
    "debug": "\033[2m",
    "info": "\033[1;34m",
    "warn": "\033[1;33m",
    "error": "\033[1;31m",
}


# ── Discovery ─────────────────────────────────────────────────────────────

# A file whose stem names a month can be skipped by name. Any other stem —
# `legacy.jsonl`, where the cutover migration parks the pre-cutover history —
# cannot be placed in time from its name, so it is always read.
_MONTH_STEM = re.compile(r"\d{4}-\d{2}$")


def discover_trails(since: datetime | None = None) -> list[Path]:
    """Every trail file a *since* window can reach, oldest month first."""
    try:
        files = sorted(workbench_paths.trail_dir().glob("*.jsonl"))
    except OSError:
        # A missing trail root is not an error — glob on a directory that
        # does not exist yet raises nothing, so the only thing this catches
        # is a real I/O failure (e.g. permissions), and an empty result is
        # the right answer either way: there is nothing to query.
        return []
    if since is None:
        return files
    cutoff = f"{since:%Y-%m}"
    return [p for p in files if not _MONTH_STEM.match(p.stem) or p.stem >= cutoff]


# ── Loading ───────────────────────────────────────────────────────────────

def _parse_trail_file(path: str | Path) -> list[dict]:
    try:
        text = Path(path).read_text()
    except OSError:
        return []
    events = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            events.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return events


def load_events(trail_paths: list[str | Path]) -> list[dict]:
    events = []
    for path in trail_paths:
        events.extend(_parse_trail_file(path))
    events.sort(key=lambda e: e.get("ts", ""))
    return events


def load_trail_events(since: str | None) -> list[dict]:
    """Every event in the files *since* can reach, oldest first.

    The window is applied twice on purpose: once at the filename, which is what
    lets a year of history stay unopened, and once per record in
    `filter_events`, which is what makes the boundary exact.
    """
    return load_events(discover_trails(_parse_since(since) if since else None))


# ── Filtering ─────────────────────────────────────────────────────────────

def _parse_since(since: str) -> datetime:
    now = datetime.now(timezone.utc)
    suffixes = {"h": "hours", "d": "days", "m": "minutes"}
    suffix = since[-1:] if since else ""
    unit = suffixes.get(suffix)
    if not unit:
        return now - timedelta(hours=1)
    try:
        return now - timedelta(**{unit: int(since[:-1])})
    except ValueError:
        log.error(f"Invalid --since value: {since!r}")
        sys.exit(1)


def filter_events(
    events: list[dict],
    script: str | None = None,
    level: str | None = None,
    event_type: str | None = None,
    invocation: str | None = None,
    pr: int | str | None = None,
    repo: str | None = None,
    since: str | None = None,
) -> list[dict]:
    result = events
    if script:
        result = [e for e in result if e.get("script") == script]
    if level:
        result = [e for e in result if e.get("level") == level]
    if event_type:
        result = [e for e in result if e.get("event_type") == event_type]
    if invocation:
        result = [e for e in result if e.get("invocation") == invocation]
    if pr is not None:
        pr_str = str(pr)
        result = [e for e in result if str(e.get("context", {}).get("pr", "")) == pr_str]
    if repo:
        result = [e for e in result if e.get("context", {}).get("repo") == repo]
    if since:
        cutoff = _parse_since(since)
        cutoff_str = cutoff.strftime("%Y-%m-%dT%H:%M:%SZ")
        result = [e for e in result if e.get("ts", "") >= cutoff_str]
    return result


# ── Formatting ────────────────────────────────────────────────────────────

def _format_event_line(e: dict) -> str:
    ts = e.get("ts", "")[11:19]
    level = e.get("level", "?").upper().ljust(5)
    etype = e.get("event_type", "?").ljust(11)
    action = e.get("action", "?").ljust(20)
    detail = e.get("detail", "")
    color = ANSI_LEVELS.get(e.get("level", ""), "")
    parts = [f"{ts} {color}{level}{ANSI_RESET} {etype} {action} {detail}"]
    if e.get("reason"):
        parts.append(f"\n{'':>56}reason: {e['reason']}")
    if e.get("duration_ms") is not None:
        parts.append(f" ({e['duration_ms']}ms)")
    return "".join(parts)


def _finish_event(events: list[dict]) -> dict | None:
    """The one summary that reports the run's own duration.

    `summary` is no longer a single kind of event — `pr gc` writes a terminal
    per-PR outcome with the same type and no duration — so the run-end event is
    selected by action.
    """
    for e in events:
        if e.get("event_type") == "summary" and e.get("action") == FINISH_ACTION:
            return e
    return None


def _format_show(events: list[dict]) -> str:
    if not events:
        return "No events found."
    first = events[0]
    inv = first.get("invocation", "?")
    script = first.get("script", "?")
    ts = first.get("ts", "?")
    finish = _finish_event(events)
    duration = f" — {finish['duration_ms'] / 1000:.1f}s" if finish else ""
    ctx = first.get("context", {})
    ctx_str = " ".join(f"{k}={v}" for k, v in ctx.items())

    lines = [
        f"{ANSI_BOLD}Invocation {inv}{ANSI_RESET} — {script} — {ts}{duration}",
        f"Context: {ctx_str}",
        "",
    ]
    for e in events:
        lines.append(_format_event_line(e))
    return "\n".join(lines)


# ── Usage stats ───────────────────────────────────────────────────────────

STATS_GROUPINGS = ("script", "task", "model", "day")

# A session can span several models. The CLI reports cost per model but tokens only
# per session, so grouping by model splits the cost and leaves the token columns
# unattributed rather than counting one session's tokens against every model it used.
_UNATTRIBUTED_TOKENS = "model"

_NO_GROUP = "—"
_BILLED_KEYS = ("input_tokens", "cache_read_tokens", "cache_write_tokens")
_STATS_HEADER = ("GROUP", "CALLS", "COST", "BILLED IN", "OUTPUT", "CACHE", "MED TIME")


def _cost_shares(rec: dict, by: str) -> list[tuple[str, float]]:
    """Return the (group, cost) pairs one ledger record contributes to."""
    cost = rec.get("cost") or 0.0
    if by != _UNATTRIBUTED_TOKENS:
        group = rec.get("ts", "")[:10] if by == "day" else rec.get(by)
        return [(group or _NO_GROUP, cost)]
    by_model = rec.get("cost_by_model") or {}
    if by_model:
        return list(by_model.items())
    return [(rec.get("model") or _NO_GROUP, cost)]


def _new_group() -> dict:
    return {
        "calls": 0, "cost": 0.0, "billed_input": 0,
        "output_tokens": 0, "cache_read_tokens": 0, "durations": [],
    }


def _accumulate(group: dict, rec: dict, cost: float, attribute_tokens: bool) -> None:
    group["calls"] += 1
    group["cost"] += cost or 0.0
    duration = rec.get("duration_ms") or 0
    if duration:
        group["durations"].append(duration)
    if not attribute_tokens:
        return
    group["billed_input"] += sum(rec.get(k) or 0 for k in _BILLED_KEYS)
    group["output_tokens"] += rec.get("output_tokens") or 0
    group["cache_read_tokens"] += rec.get("cache_read_tokens") or 0


def _finalize_group(name: str, group: dict, attribute_tokens: bool) -> dict:
    durations = group["durations"]
    billed = group["billed_input"] if attribute_tokens else None
    cache_read = group["cache_read_tokens"] if attribute_tokens else None
    return {
        "group": name,
        "calls": group["calls"],
        "cost": group["cost"],
        "billed_input": billed,
        "output_tokens": group["output_tokens"] if attribute_tokens else None,
        "cache_read_tokens": cache_read,
        "cache_read_ratio": (cache_read / billed) if billed else None,
        "median_duration_ms": int(statistics.median(durations)) if durations else None,
    }


def aggregate_usage(records: list[dict], by: str) -> list[dict]:
    """Roll ledger records into one row per group, most expensive first."""
    attribute_tokens = by != _UNATTRIBUTED_TOKENS
    groups: dict[str, dict] = {}
    for rec in records:
        for name, cost in _cost_shares(rec, by):
            _accumulate(groups.setdefault(name, _new_group()), rec, cost, attribute_tokens)
    rows = [_finalize_group(name, g, attribute_tokens) for name, g in groups.items()]
    if by == "day":
        return sorted(rows, key=lambda r: r["group"])
    return sorted(rows, key=lambda r: r["cost"], reverse=True)


def _fmt_tokens(n: int | None) -> str:
    if n is None:
        return _NO_GROUP
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}k"
    return str(n)


def _fmt_duration(ms: int | None) -> str:
    if ms is None:
        return _NO_GROUP
    if ms >= 60_000:
        return f"{ms / 60_000:.1f}m"
    return f"{ms / 1000:.1f}s"


def _stats_cells(row: dict) -> tuple[str, ...]:
    ratio = row["cache_read_ratio"]
    return (
        str(row["group"]),
        str(row["calls"]),
        f"${row['cost']:.4f}",
        _fmt_tokens(row["billed_input"]),
        _fmt_tokens(row["output_tokens"]),
        _NO_GROUP if ratio is None else f"{ratio * 100:.0f}%",
        _fmt_duration(row["median_duration_ms"]),
    )


def _sum_column(rows: list[dict], key: str) -> int:
    return sum(r[key] or 0 for r in rows)


def _totals_row(rows: list[dict]) -> dict:
    billed = _sum_column(rows, "billed_input")
    cache_read = _sum_column(rows, "cache_read_tokens")
    return {
        "group": "TOTAL",
        "calls": _sum_column(rows, "calls"),
        "cost": sum(r["cost"] for r in rows),
        "billed_input": billed or None,
        "output_tokens": _sum_column(rows, "output_tokens") or None,
        "cache_read_tokens": cache_read or None,
        "cache_read_ratio": (cache_read / billed) if billed else None,
        # A median of per-group medians is not a median of anything.
        "median_duration_ms": None,
    }


def format_stats_table(rows: list[dict]) -> str:
    cells = [_STATS_HEADER, *(_stats_cells(r) for r in rows), _stats_cells(_totals_row(rows))]
    widths = [max(len(c) for c in column) for column in zip(*cells)]
    lines = []
    for cell_row in cells:
        head = cell_row[0].ljust(widths[0])
        rest = "  ".join(c.rjust(w) for c, w in zip(cell_row[1:], widths[1:]))
        lines.append(f"{head}  {rest}")
    lines[0] = f"{ANSI_BOLD}{lines[0]}{ANSI_RESET}"
    return "\n".join(lines)


# ── Commands ──────────────────────────────────────────────────────────────

def cmd_recent(args):
    events = load_trail_events(args.since)
    filtered = filter_events(events, repo=args.repo, since=args.since)
    if args.json:
        for e in filtered:
            print(json.dumps(e, separators=(",", ":")))
    else:
        for e in filtered:
            print(_format_event_line(e))


def cmd_query(args):
    events = load_trail_events(args.since)
    filtered = filter_events(
        events,
        script=args.script,
        level=args.level,
        event_type=args.event_type,
        invocation=args.invocation,
        pr=args.pr,
        repo=args.repo,
        since=args.since,
    )
    if args.json:
        for e in filtered:
            print(json.dumps(e, separators=(",", ":")))
    else:
        for e in filtered:
            print(_format_event_line(e))


def cmd_show(args):
    events = load_trail_events(None)
    filtered = filter_events(events, invocation=args.invocation)
    if args.json:
        for e in filtered:
            print(json.dumps(e, separators=(",", ":")))
    else:
        print(_format_show(filtered))


def cmd_list(args):
    events = load_trail_events(args.since)
    if args.since:
        events = filter_events(events, since=args.since)
    if args.repo:
        events = filter_events(events, repo=args.repo)
    if args.script:
        events = filter_events(events, script=args.script)

    # Group by invocation
    invocations: dict[str, list[dict]] = {}
    for e in events:
        inv = e.get("invocation", "?")
        invocations.setdefault(inv, []).append(e)

    # Sort by first event timestamp, most recent first
    sorted_invs = sorted(invocations.items(), key=lambda x: x[1][0].get("ts", ""), reverse=True)

    if args.json:
        for inv_id, inv_events in sorted_invs:
            first = inv_events[0]
            finish = _finish_event(inv_events)
            print(json.dumps({
                "invocation": inv_id,
                "script": first.get("script"),
                "ts": first.get("ts"),
                "event_count": len(inv_events),
                "duration_ms": finish.get("duration_ms") if finish else None,
            }, separators=(",", ":")))
    else:
        for inv_id, inv_events in sorted_invs:
            first = inv_events[0]
            finish = _finish_event(inv_events)
            duration = f"{finish['duration_ms'] / 1000:.1f}s" if finish else "?"
            ts = first.get("ts", "?")[:19]
            script = first.get("script", "?")
            n = len(inv_events)
            print(f"{inv_id}  {script:<20} {ts}  {n:>3} events  {duration}")


def cmd_stats(args):
    records = ai_usage.read_ledger(since=_parse_since(args.since))
    rows = aggregate_usage(records, args.by)
    if not rows:
        print(f"No AI usage recorded in the last {args.since}.")
        return
    if args.json:
        for row in rows:
            print(json.dumps(row, separators=(",", ":")))
        return
    print(f"AI usage — last {args.since}, by {args.by}")
    print(format_stats_table(rows))


# ── Main ──────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description="Query trail files across otto-workbench AI scripts.",
    )
    sub = parser.add_subparsers(dest="command")

    # recent
    p_recent = sub.add_parser("recent", help="Recent events (default: last 1h)")
    p_recent.add_argument("--since", default="1h", help="Time window (e.g. 2h, 1d, 30m)")
    p_recent.add_argument("--repo", help="Filter by repo (org/repo)")
    p_recent.add_argument("--json", action="store_true", help="Output raw JSONL")

    # query
    p_query = sub.add_parser("query", help="Filter events")
    p_query.add_argument("--script", help="Filter by script name")
    p_query.add_argument("--level", help="Filter by level (debug, info, warn, error)")
    p_query.add_argument("--event-type", help="Filter by event type")
    p_query.add_argument("--invocation", help="Filter by invocation ID")
    p_query.add_argument("--pr", type=int, help="Filter by PR number")
    p_query.add_argument("--repo", help="Filter by repo (org/repo)")
    p_query.add_argument("--since", help="Time window (e.g. 2h, 1d)")
    p_query.add_argument("--json", action="store_true", help="Output raw JSONL")

    # show
    p_show = sub.add_parser("show", help="Show a single invocation timeline")
    p_show.add_argument("invocation", help="Invocation ID")
    p_show.add_argument("--json", action="store_true", help="Output raw JSONL")

    # list
    p_list = sub.add_parser("list", help="List invocations")
    p_list.add_argument("--script", help="Filter by script name")
    p_list.add_argument("--since", help="Time window (e.g. 2h, 1d)")
    p_list.add_argument("--repo", help="Filter by repo (org/repo)")
    p_list.add_argument("--json", action="store_true", help="Output raw JSONL")

    # stats
    p_stats = sub.add_parser("stats", help="Aggregate AI cost and token usage")
    p_stats.add_argument("--since", default="7d", help="Time window (e.g. 24h, 7d)")
    p_stats.add_argument(
        "--by", default="script", choices=STATS_GROUPINGS, help="Group rows by",
    )
    p_stats.add_argument(
        "--json", action="store_true", help="Output one JSON object per group",
    )

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    commands = {
        "recent": cmd_recent,
        "query": cmd_query,
        "show": cmd_show,
        "list": cmd_list,
        "stats": cmd_stats,
    }
    commands[args.command](args)


if __name__ == "__main__":
    main()
