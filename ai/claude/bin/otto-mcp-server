#!/usr/bin/env bash
set -e

# The help below describes the schema flag without naming it. This launcher
# sits in one of the directories discovery always scans, and the source scan in
# ai/claude/mcps/server.py would read a literal here as a protocol
# implementation — probing it re-execs the server, which then blocks on stdin
# until the discovery timeout. Same reasoning as build-otto-ai-tools-tarball.
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
otto-mcp-server — dynamic MCP server for otto-workbench tools

Discovers scripts that declare a tool schema and exposes them via MCP stdio transport.

Always scans the workbench's own component bin/ directories. tool_dirs and
plugin_dirs in ~/.config/workbench/mcp-tools.json add more.

Usage: otto-mcp-server

Requires: uv, mcp Python package
EOF
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd -P)"
exec uv run --with mcp python3 "$SCRIPT_DIR/../mcps/server.py" "$@"
