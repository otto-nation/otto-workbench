#!/usr/bin/env python3
"""Unified PR lifecycle CLI.

Thin dispatch layer — subcommands delegate to external scripts via _COMMANDS
registry.  Flags pass through to the backing script untouched; run
'pr <command> --help' to see each script's flags.
"""

import argparse
import contextlib
import json
import signal
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

BIN_DIR = Path(__file__).resolve().parent
SCRIPT = Path(__file__).name
sys.path.insert(0, str(BIN_DIR.parent.parent / "lib"))

import ci_failures
import pr_comments
import pr_context
import pr_state
import push_status
import schema_gen
import rebase_status
import review_gc
import log
import review_common
import supersession
import workbench_paths
import workbench_projects
import run_lock
from review_common import (
    ReviewType, build_review_summary, find_review_file, json_summary, review_file_path,
)
from tool_parser import VALUE_FLAGS_FLAG
from trail import Trail, add_trail_args


# ── Command registry ────────────────────────────────────────────────────────
#
# Single source of truth for subcommands.  Delegating commands have a "script"
# key; internal commands omit it.  "prefix" adds sub-command tokens before the
# user's argv (e.g. claude-review gc …).

# Seconds to wait for a delegate to answer the --value-flags probe. The answer
# costs an interpreter start plus argparse construction, so this is already
# orders of magnitude of headroom — and a delegate that hangs stalls a command
# the user expected to be instant, so the ceiling stays low.
VALUE_FLAGS_TIMEOUT = 5.0

# What the pre-cutover layout called its worktree-local trail. Spelled here
# rather than imported: trail.py no longer names this file, because no trail is
# written to a worktree any more. It exists only as something to sweep.
_LEGACY_TRAIL_FILENAME = "trail.jsonl"


@dataclass(frozen=True)
class Need:
    """What one command needs of dispatch before its handler runs.

    Three independent axes, declared rather than opted out of. Independent
    because they routinely disagree: `rebase` needs `gh` to name its PR but
    must not fetch (it does its own), and `gc` writes nothing to the remote yet
    still locks, because it deletes the directory other runs key on.

    * ``depth`` — how far ``pr_context`` resolves. LOCAL is git alone; REMOTE
      adds the ``gh`` calls that name the repo and the PR.
    * ``update`` — whether to fetch and fast-forward the worktree
      (``update_to_remote``) before the handler runs.
    * ``lock`` — whether to hold the target's run lock for the whole dispatch.
      False only for a command that neither writes ``state.json`` nor touches
      the worktree, so it is safe alongside another run.
    """

    depth: pr_context.ContextDepth
    update: bool
    lock: bool


_LOCAL = pr_context.ContextDepth.LOCAL
_REMOTE = pr_context.ContextDepth.REMOTE

_COMMANDS = {
    "create":   {"help": "Create a PR (wraps task pr:create)",
                 "need": Need(_REMOTE, update=False, lock=True)},
    "status":   {"help": "Show CI, review, and comment status dashboard",
                 "need": Need(_LOCAL,  update=False, lock=False)},
    "ci":       {"help": "Check CI failures",                     "script": "ci-check",
                 "need": Need(_REMOTE, update=True,  lock=True)},
    "review":   {"help": "Run code review",                       "script": "claude-review",
                 "need": Need(_REMOTE, update=True,  lock=True)},
    "comments": {"help": "Fetch and manage PR review threads",    "script": "review-threads",
                 "need": Need(_REMOTE, update=True,  lock=True)},
    "fix":      {"help": "Fix CI + review + comments",
                 "need": Need(_REMOTE, update=True,  lock=True)},
    "rebase":   {"help": "Rebase onto origin/main",               "script": "pr-rebase",
                 "need": Need(_REMOTE, update=False, lock=True)},
    "describe": {"help": "Revise the PR description",             "script": "pr-describe",
                 "need": Need(_REMOTE, update=True,  lock=True)},
    "gc":       {"help": "Clean up stale PR artifacts",
                 "need": Need(_REMOTE, update=False, lock=True)},
}


def _validate_needs(commands: dict) -> None:
    """Raise unless every command declares a Need.

    The check that replaces "remember to edit two opt-out sets": a command that
    declares nothing fails at import, where the old sets silently handed it
    whatever not being listed happened to mean. A raise rather than an assert,
    so the invariant survives -O.
    """
    undeclared = sorted(
        name for name, entry in commands.items()
        if not isinstance(entry.get("need"), Need)
    )
    if undeclared:
        raise RuntimeError(
            "pr: commands declare no dispatch need: " + ", ".join(undeclared)
            + " — add a Need(depth, update=…, lock=…) to each _COMMANDS entry"
        )


_validate_needs(_COMMANDS)


def _run_delegate(entry: dict, argv: list[str],
                  ctx: pr_context.ResolvedContext, *,
                  original_pr: str | None = None,
                  original_branch: str | None = None) -> int:
    """Build and run a backing-script command with context injection.

    Forwards exactly one of --pr or --branch (never both) so the
    delegate's pr_context.resolve() doesn't hit the mutual-exclusivity
    check.  Priority: explicit --pr > resolved PR number > explicit
    --branch > auto-detected branch.  PR number is preferred over branch
    because it's a stable identifier that avoids a redundant gh API call
    in the delegate — and prevents mismatched --repo-dir/--branch when
    the worktree is on a different branch than the target.
    """
    cmd = [str(BIN_DIR / entry["script"])] + entry.get("prefix", [])
    if ctx.worktree_root:
        cmd += ["--repo-dir", str(ctx.worktree_root)]
    if original_pr is not None:
        cmd += ["--pr", str(original_pr)]
    elif ctx.pr_number is not None:
        cmd += ["--pr", str(ctx.pr_number)]
    elif original_branch is not None:
        cmd += ["--branch", original_branch]
    elif ctx.branch:
        cmd += ["--branch", ctx.branch]
    cmd += list(argv)
    return subprocess.run(cmd).returncode


# ── Helpers ─────────────────────────────────────────────────────────────────


def _split_argv(argv: list[str]) -> tuple[list[str], list[str]]:
    """Split argv into (positionals, flags)."""
    positionals = [a for a in argv if not a.startswith("-")]
    flags = [a for a in argv if a.startswith("-")]
    return positionals, flags


def _delegate_value_flags(entry: dict) -> frozenset[str]:
    """Ask a delegate which of its option strings consume a following value.

    The delegate's own argparse parser is the single source of truth for its
    flags, so the wrapper asks it (see tool_parser.handle_value_flags) instead
    of mirroring a list here that would rot the next time a delegate grows a
    flag.  Internal commands have no delegate and answer empty.
    """
    script = entry.get("script")
    if not script:
        return frozenset()
    try:
        probe = subprocess.run(
            [str(BIN_DIR / script), VALUE_FLAGS_FLAG],
            capture_output=True, text=True, timeout=VALUE_FLAGS_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        # Arity is an improvement on the historical arity-blind scan, not a
        # precondition for it: a delegate that is missing, crashes, or hangs
        # must not take down the command the user actually asked for. Every
        # failure degrades to "no option takes a value", which is exactly the
        # pre-arity behaviour — but a hung delegate is worth surfacing since
        # it's as diagnosable as the non-zero-exit case below.
        log.warn(f"{script} {VALUE_FLAGS_FLAG}: timed out after {VALUE_FLAGS_TIMEOUT}s")
        return frozenset()
    except (OSError, subprocess.SubprocessError) as exc:
        log.warn(f"{script} {VALUE_FLAGS_FLAG}: {exc}")
        return frozenset()
    if probe.returncode != 0:
        # Same degradation as above, but this failure is the delegate's own
        # doing rather than the environment's — a flag the protocol cannot
        # describe, or a parser that no longer builds. Reprint what it said so
        # whoever broke it sees a diagnosis instead of a token quietly going to
        # the wrong place.
        if probe.stderr.strip():
            log.warn(f"{script} {VALUE_FLAGS_FLAG}: {probe.stderr.strip()}")
        return frozenset()
    return frozenset(tok for tok in probe.stdout.split() if tok.startswith("-"))


def _positional_index(extra: list[str], value_flags: frozenset[str]) -> int:
    """Index in *extra* of the first bare positional, or -1 if there is none.

    Options are skipped, and so is the token after an option that takes a
    value — that token is the flag's argument, not the command's target.
    The ``--flag=value`` form carries its own value and skips nothing.
    """
    consumed = False
    for i, token in enumerate(extra):
        if consumed:
            consumed = False
            continue
        if token.startswith("-"):
            consumed = token in value_flags
            continue
        return i
    return -1


def _load_or_init(ctx: pr_context.ResolvedContext) -> pr_state.PRState:
    """Load existing state or create a fresh one from resolved context."""
    return pr_state.load_or_init(
        target_dir=ctx.target_dir,
        repo=ctx.repo,
        branch=ctx.branch,
        pr_number=ctx.pr_number,
        head_sha=ctx.head_sha,
        worktree_root=str(ctx.worktree_root) if ctx.worktree_root else "",
    )


def _parse_review_summary(output: str) -> dict | None:
    """Extract REVIEW_SUMMARY:{json} from claude-review output."""
    prefix = "REVIEW_SUMMARY:"
    lines = [l for l in output.splitlines() if l.startswith(prefix)]
    if not lines:
        return None
    try:
        return json.loads(lines[0][len(prefix):])
    except (json.JSONDecodeError, TypeError):
        return None


def _update_review_state(summary_data: dict,
                         ctx: pr_context.ResolvedContext) -> None:
    """Update pr_state from a parsed review summary dict.

    Best-effort: the caller has already done the real work (a review, a repair),
    and the review file it produced is user-scoped and survives.
    """
    findings = summary_data.get("findings", {})
    finding_counts = {
        k: v for k, v in findings.items()
        if k != "total" and isinstance(v, int) and v > 0
    }
    state = _load_or_init(ctx)
    pr_state.apply(state, pr_state.ReviewSummary(
        review_file=summary_data.get("review_file", ""),
        # The summary carries the type the review recorded; the stored value is
        # the fallback for a summary that predates the field. "pr" was never a
        # review type — that is a mode, and it is not this field's vocabulary.
        review_type=summary_data.get("review_type") or state.review.review_type or ReviewType.FULL,
        head_sha=summary_data.get("head_sha", ""),
        finding_counts=finding_counts,
        verdict=summary_data.get("verdict", ""),
        status=summary_data.get("status", pr_state.ReviewStatus.COMPLETED.value),
        failure_detail=summary_data.get("failure_detail", ""),
        cost_usd=summary_data.get("cost_usd", 0.0),
        updated_at=pr_state.now_iso(),
    ))
    pr_state.save_state(ctx.target_dir, state)


def _update_review_state_from_output(output: str,
                                     ctx: pr_context.ResolvedContext) -> None:
    """Parse REVIEW_SUMMARY from output and update pr_state."""
    summary_data = _parse_review_summary(output)
    if not summary_data:
        return
    _update_review_state(summary_data, ctx)


def _is_pr_target(target: str | None) -> bool:
    """Check if target looks like a PR URL or number (not a branch name)."""
    if not target:
        return False
    return pr_context.is_pr_ref(target)



# ── Subcommands ─────────────────────────────────────────────────────────────



def cmd_status(argv: list[str], ctx: pr_context.ResolvedContext, **_kw) -> int:
    """Render unified status dashboard from cached state."""
    wt = ctx.require_worktree()
    state = pr_state.load_state(ctx.target_dir)

    pr_label = f"#{state.identity.pr_number}" if state and state.identity.pr_number else "(no PR)"
    branch = state.identity.branch if state else ctx.branch
    repo = state.identity.repo if state else ctx.repo

    lines = [f"## PR Status — {repo} {pr_label} ({branch})", ""]

    if not state:
        lines.append("No status data yet. Run: pr ci, pr review, or pr comments")
        lines.append("")
        lines += push_status.render_status(wt, branch)
        print("\n".join(lines), file=sys.stderr)
        return 0

    lines += ci_failures.render_status(state.ci)
    lines.append("")
    lines += review_common.render_status(state.review)
    lines.append("")
    lines += pr_comments.render_status(state.comments)
    lines.append("")
    lines += pr_comments.render_triage_status(state.triage)
    lines.append("")
    lines += pr_comments.render_fix_status(state.fix)
    lines.append("")
    lines += rebase_status.render_status(state.rebase)
    lines.append("")
    unpushed = push_status.detect_unpushed(wt, branch)
    lines += push_status.render_status(wt, branch, ahead=unpushed)
    lines.append("")
    lines.append(_merge_readiness(state, unpushed=unpushed))

    print("\n".join(lines), file=sys.stderr)

    json.dump(pr_state.state_to_dict(state), sys.stdout, indent=2)
    print()
    return 0


def _merge_readiness(state: pr_state.PRState, *, unpushed: int | None = 0) -> str:
    ci_green = state.ci.conclusion == "success" if state.ci.updated_at else None
    has_must_fix = state.review.finding_counts.get("M", 0) > 0 if state.review.updated_at else None
    has_blockers = bool(state.comments.blocking_reviewers) if state.comments.updated_at else None
    review_incomplete = state.review.status in ("partial", "error") if state.review.updated_at else False
    # A summary or reply queue the fix pass rendered and never sent. The PR reads
    # as un-reviewed until --finish drains it, so merging leaves reviewers with no
    # record of the work.
    closeout_owed = pr_comments.closeout_debt(state.fix).owed

    pushed = unpushed == 0

    if (ci_green is True and has_must_fix is False and has_blockers is False
            and pushed and not review_incomplete and not closeout_owed):
        return "**Merge readiness**: ready"
    issues = []
    if ci_green is False:
        issues.append("CI failing")
    if has_must_fix is True:
        issues.append("must-fix findings")
    if has_blockers is True:
        issues.append("blocking reviewers")
    if not pushed:
        count = unpushed if unpushed is not None else None
        desc = f"{count} unpushed commit(s)" if count else "branch not pushed"
        issues.append(desc)
    if review_incomplete:
        issues.append("review incomplete")
    if closeout_owed:
        issues.append(f"closeout not delivered (run: {pr_comments.CLOSEOUT_COMMAND})")
    if ci_green is None or has_must_fix is None or has_blockers is None:
        unchecked = []
        if ci_green is None:
            unchecked.append("CI")
        if has_must_fix is None:
            unchecked.append("review")
        if has_blockers is None:
            unchecked.append("comments")
        issues.append(f"not checked: {', '.join(unchecked)}")
    return f"**Merge readiness**: blocked — {'; '.join(issues)}" if issues else "**Merge readiness**: ready"


def cmd_review(argv: list[str], ctx: pr_context.ResolvedContext, *,
               original_pr: str | None = None,
               original_branch: str | None = None,
               **_kw) -> int:
    """Delegate to claude-review, or handle --post/--repair/--summary/--recover locally."""
    flags = set(argv)
    mode_flags = flags & {"--post", "--repair", "--summary", "--recover"}
    if len(mode_flags) > 1:
        log.error(f"{SCRIPT}: --post, --repair, --summary, and --recover are mutually exclusive")
        return 1

    if "--post" in flags:
        return _review_post([a for a in argv if a != "--post"], ctx)
    if "--repair" in flags:
        return _review_repair(
            [a for a in argv if a != "--repair"], ctx,
        )
    if "--summary" in flags:
        return _review_summary(
            [a for a in argv if a != "--summary"], ctx,
        )

    has_self = "--self" in argv
    positionals, _ = _split_argv(argv)
    has_pr_target = (
        any(_is_pr_target(p) for p in positionals)
        or _is_pr_target(original_pr)
        or ctx.pr_number is not None
    )
    inject = ["--self"] if not has_self and not has_pr_target and not positionals else []
    rc = _run_delegate(_COMMANDS["review"], inject + list(argv), ctx,
                       original_pr=original_pr,
                       original_branch=original_branch)
    if rc != 0 or not ctx.pr_number:
        return rc
    pr_num = str(ctx.pr_number)
    review = find_review_file(ctx.repo, pr_num)
    if review:
        data = build_review_summary(ctx.repo, pr_num, str(review))
        _update_review_state(data, ctx)
    return rc


def _review_post(argv: list[str], ctx: pr_context.ResolvedContext) -> int:
    """Post an existing review directly to GitHub via review-post."""
    pr_num = str(ctx.pr_number) if ctx.pr_number else None
    if not pr_num:
        log.error("Cannot determine PR number")
        return 1

    review = find_review_file(ctx.repo, pr_num)
    if not review:
        log.error(f"No review file found for {ctx.repo}#{pr_num}")
        log.dim("Run: pr review")
        return 1

    cmd = [str(BIN_DIR / "review-post"), "--pr", pr_num, "--review-file", str(review)]
    if "--submit" in argv:
        cmd.append("--submit")
        argv = [a for a in argv if a != "--submit"]
    cmd += argv
    return subprocess.run(cmd).returncode


def _review_repair(argv: list[str], ctx: pr_context.ResolvedContext) -> int:
    """Repair broken review artifacts via summary or rebuild."""
    pr_num = str(ctx.pr_number) if ctx.pr_number else None
    if not pr_num:
        log.error("Cannot determine PR number")
        return 1

    review = find_review_file(ctx.repo, pr_num)
    if review:
        data = build_review_summary(ctx.repo, pr_num, str(review))
        _update_review_state(data, ctx)
        return 0

    log.info("No review file found, trying rebuild...")
    review_dir = review_file_path(ctx.repo, pr_num).parent
    if not review_dir.is_dir():
        log.error(f"No review directory found: {review_dir}")
        return 1

    cmd = [str(BIN_DIR / "review-rebuild"), "--review-dir", str(review_dir), "--pr", pr_num]
    cmd += argv
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.stderr:
        print(result.stderr, file=sys.stderr, end="")
    if result.stdout:
        print(result.stdout, end="")
    if result.returncode == 0:
        _update_review_state_from_output(result.stdout, ctx)
    return result.returncode


def _review_summary(argv: list[str], ctx: pr_context.ResolvedContext) -> int:
    """Output JSON summary of an existing review."""
    pr_num = str(ctx.pr_number) if ctx.pr_number else None
    if not pr_num:
        log.error("Cannot determine PR number")
        return 1

    review = find_review_file(ctx.repo, pr_num)
    if not review:
        log.error(f"No review file found for {ctx.repo}#{pr_num}")
        return 1

    print(json_summary(ctx.repo, pr_num, str(review)))
    return 0


def cmd_fix(argv: list[str], ctx: pr_context.ResolvedContext, **_kw) -> int:
    """Run fix passes for CI, review, and comments."""
    wt = ctx.require_worktree()
    state = pr_state.load_state(ctx.target_dir)
    if not state:
        log.error("No state yet. Run pr ci, pr review, or pr comments first.")
        return 1

    exit_code = 0

    if state.review.updated_at and sum(state.review.finding_counts.values()) > 0:
        log.info("Fixing review findings...")
        review_args = [str(BIN_DIR / "claude-review"), "--self", "--fix"]
        review_args += ["--repo-dir", str(wt)]
        review_args += list(argv)
        r = subprocess.run(review_args)
        if r.returncode == supersession.EXIT_SUPERSEDED:
            # Every remaining pass acts on the same branch, so a refusal that
            # says "this branch may not be worth working on" answers for all of
            # them. Continuing would spend the CI fix pass on the question the
            # review just declined to spend on.
            log.error("Stopping — the review refused this branch as superseded.")
            log.dim(f"Resolve it, or re-run with {supersession.OVERRIDE_FLAG} "
                    f"to override.")
            return supersession.EXIT_SUPERSEDED
        if r.returncode != 0:
            exit_code = 1

    ci_fixable = 0
    if state.ci.updated_at and state.ci.failure_count > 0:
        infra_count = state.ci.failure_kinds.get("infra", 0) + state.ci.failure_kinds.get("flaky", 0)
        ci_fixable = state.ci.failure_count - infra_count

    if ci_fixable > 0:
        log.blank()
        log.info(f"Fixing {ci_fixable} CI failure(s)...")
        rc = _run_delegate(
            _COMMANDS["ci"], ["--fix"] + list(argv), ctx,
            original_pr=_kw.get("original_pr"),
            original_branch=_kw.get("original_branch"),
        )
        if rc != 0:
            exit_code = 1

    actionable = state.comments.by_state.get("new", 0) + state.comments.by_state.get("contested", 0)
    if state.comments.updated_at and actionable > 0:
        log.blank()
        log.info(f"Comments: {actionable} actionable thread(s) — run pr comments --fix")

    # Last, because the description has to describe the branch as it ends up.
    # pr-describe re-resolves HEAD itself and no-ops when nothing landed, so
    # this is free on a run where every fix pass was a skip. The user's argv is
    # not forwarded: --fix and friends mean nothing here.
    log.blank()
    if _run_delegate(_COMMANDS["describe"], [], ctx,
                     original_pr=_kw.get("original_pr"),
                     original_branch=_kw.get("original_branch")) != 0:
        exit_code = 1

    return exit_code


def cmd_comments(argv: list[str], ctx: pr_context.ResolvedContext, *,
                 original_pr: str | None = None,
                 original_branch: str | None = None,
                 **_kw) -> int:
    """Delegate to review-threads, routing --triage, --fix and --finish flags."""
    return _run_delegate(_COMMANDS["comments"], list(argv), ctx,
                         original_pr=original_pr,
                         original_branch=original_branch)


# ceiling: this sweep runs on every `pr gc` forever, with no removal
# trigger of its own. Deliberate — the pre-target layout it cleans up after
# has no expiry, so neither does the code that reclaims it. Upgrade trigger:
# once the target-scoped layout has shipped long enough that no worktree
# still carries the legacy files, delete this function and its call site.
def _sweep_legacy_state(worktree_root: Path) -> int:
    """Remove what the pre-target layout left in a worktree.

    Returns 1 if anything was removed. No migration carries these: they are
    gitignored, worktree-local, and rebuilt by the next command that writes
    them. The trail goes with them now that every trail is written to the user's
    own state root — a `trail.jsonl` sitting in a working tree is litter.

    The directory itself is removed only when nothing else is in it: an entry
    this layout never wrote is not ours to delete.
    """
    legacy = worktree_root / workbench_paths.LEGACY_WORKTREE_STATE_DIRNAME
    removed = 0
    for name in (pr_state.STATE_FILE, run_lock.LOCK_FILE, _LEGACY_TRAIL_FILENAME):
        path = legacy / name
        if path.is_file():
            path.unlink(missing_ok=True)
            removed = 1
    if not removed:
        return 0
    try:
        legacy.rmdir()
    except OSError:
        # Something else is in there, or it is gone already. Either way the
        # files this layout owns are the only thing this sweep promised.
        pass
    log.info(f"GC: removed legacy worktree state in {legacy}")
    return 1


def cmd_create(argv: list[str], ctx: pr_context.ResolvedContext, **_kw) -> int:
    """Delegate PR creation to task pr:create."""
    cmd = ["task", "--global"]
    if ctx.worktree_root:
        cmd.append(f"REPO_DIR={ctx.worktree_root}")
    cmd.append("pr:create")
    if argv:
        cmd += ["--"] + list(argv)
    return subprocess.run(cmd).returncode


def cmd_gc(argv: list[str], ctx: pr_context.ResolvedContext, *, trail: Trail, **_kw) -> int:
    """Clean up stale PR artifacts across all domains."""
    # Everything but the legacy sweep is user-scoped and works from a bare repo.
    # Our own target is skipped: we are holding its lock right now.
    total = (
        review_gc.gc_reviews()
        + review_gc.prune_merged_reviews()
        + review_gc.prune_merged_targets(skip=ctx.target_dir, trail=trail)
    )
    if ctx.worktree_root:
        total += _sweep_legacy_state(ctx.worktree_root)

    if total > 0:
        log.info(f"GC: cleaned {total} item(s) total")
    else:
        log.info("GC: nothing to clean")
    return 0


# ── CLI ─────────────────────────────────────────────────────────────────────

# Custom handlers for commands that need more than passthrough.
_CUSTOM = {
    "create":   cmd_create,
    "status":   cmd_status,
    "review":   cmd_review,
    "comments": cmd_comments,
    "fix":      cmd_fix,
    "gc":       cmd_gc,
}

# Commands that accept no positional target, so every bare token in their argv
# belongs to the flag before it. 'create' always operates on the current branch
# and `task pr:create` has no way to accept a target, so the positional scan has
# nothing to find there — only flag values to swallow. Skipping the scan is what
# keeps `pr create --title "…"` from arriving as a dangling --title, and it needs
# no arity list of its own: the flags are parsed by parse_pr_flags in
# lib/ai/pr.sh, which stays their single source of truth.
_NO_TARGET_COMMANDS = {"create"}


def _build_parser() -> argparse.ArgumentParser:
    """Build the command parser.

    A delegating command's subparser declares no flags of its own — its argv is
    forwarded whole and `pr <command> --help` is answered by the delegate — so
    add_help is left off for those. The subparsers are not returned alongside:
    what a command declares is read back off the built parser with
    tool_parser.subparsers, which is what keeps _NO_TARGET_COMMANDS honest.
    """
    parser = argparse.ArgumentParser(
        prog=SCRIPT,
        description="PR lifecycle management",
        add_help=False,
    )
    parser.add_argument("-h", "--help", action="store_true", dest="help")

    sub = parser.add_subparsers(dest="command")
    for name, entry in _COMMANDS.items():
        sub.add_parser(name, help=entry["help"], add_help="script" not in entry)
    return parser


def _build_usage() -> str:
    max_name = max(len(n) for n in _COMMANDS)
    cmd_lines = "\n".join(
        f"  {name:<{max_name + 2}}{entry['help']}"
        for name, entry in _COMMANDS.items()
    )
    return f"""\
pr — PR lifecycle management

Usage: pr [global flags] <command> [flags]

Commands:
{cmd_lines}

Global flags (auto-detected from CWD when omitted):
  --repo-dir PATH    Git worktree directory
  --branch NAME      Branch name
  --pr NUM|URL       PR number or URL

Run 'pr <command> -h' for details on a specific command."""


def _tool_schema() -> dict:
    """Build --tool-schema output for the pr command."""
    return {
        "name": SCRIPT,
        "description": "Unified PR lifecycle CLI — CI, review, comments, rebase",
        "input_schema": {
            "type": "object",
            "properties": {
                "command": {
                    "type": "string",
                    "enum": list(_COMMANDS.keys()),
                    "description": "Subcommand to run",
                },
                "repo_dir": {"type": "string", "description": "Git worktree directory", "x-context": True},
                "branch": {"type": "string", "description": "Branch name", "x-context": True},
                "pr": {"type": "string", "description": "PR number or URL", "x-context": True},
            },
            "required": ["command"],
        },
        "output_schema": schema_gen.dataclass_to_schema(pr_state.PRState),
    }


def _dispatch(args, ctx: pr_context.ResolvedContext, extra: list[str], global_args, *,
              original_pr: str | None,
              original_branch: str | None) -> int:
    """Start the trail and route to the command's handler or backing script."""
    trail = Trail.start(
        script=SCRIPT,
        context={"repo": ctx.repo, "pr": ctx.pr_number, "branch": ctx.branch},
        debug=getattr(global_args, "debug", False),
    )
    try:
        trail.decision(
            "dispatch",
            f"routing to {args.command}",
            reason="matched command registry",
            data={"subcommand": args.command},
        )

        handler = _CUSTOM.get(args.command)
        if handler:
            return handler(extra, ctx,
                           trail=trail,
                           original_pr=original_pr,
                           original_branch=original_branch)
        assert "script" in _COMMANDS[args.command], \
            f"pr: command {args.command!r} has no handler and no script — register it in _CUSTOM or add a 'script' key"
        return _run_delegate(_COMMANDS[args.command], extra, ctx,
                             original_pr=original_pr,
                             original_branch=original_branch)
    except Exception as exc:
        trail.error("unexpected_error", str(exc))
        raise
    finally:
        trail.finish()


def main():
    if "--tool-schema" in sys.argv:
        json.dump(_tool_schema(), sys.stdout, indent=2)
        sys.stdout.write("\n")
        sys.exit(0)

    signal.signal(signal.SIGINT, lambda *_: (log.blank(), log.info("Interrupted"), sys.exit(130)))

    # Two-pass parse: extract global flags first, then route the subcommand.
    # Argparse subparsers swallow flags after the subcommand name, so
    # `pr rebase --repo-dir /path` would lose --repo-dir without this.
    _global = argparse.ArgumentParser(add_help=False)
    _global.add_argument("--repo-dir", "--worktree", dest="repo_dir")
    _global.add_argument("--branch")
    _global.add_argument("--pr")
    add_trail_args(_global)
    global_args, remaining = _global.parse_known_args()

    parser = _build_parser()

    args, extra = parser.parse_known_args(remaining)
    args.repo_dir = global_args.repo_dir
    args.branch = global_args.branch
    args.pr = global_args.pr

    usage = _build_usage()

    if args.help:
        print(usage)
        sys.exit(0)

    if not args.command:
        print(usage, file=sys.stderr)
        sys.exit(0)

    entry = _COMMANDS[args.command]
    if {"-h", "--help"} & set(extra) and "script" in entry:
        cmd = [str(BIN_DIR / entry["script"])] + entry.get("prefix", []) + ["--help"]
        sys.exit(subprocess.run(cmd).returncode)

    original_pr = getattr(args, "pr", None)
    original_branch = getattr(args, "branch", None)

    # Classify the first positional (if any) as PR or branch when no explicit
    # --pr/--branch flag was given and the command takes a target at all. The
    # delegate is only asked for its flag arity once a bare token exists to be
    # ambiguous about, so the common case (`pr review`, `pr comments --triage`)
    # spawns nothing.
    ambiguous = (original_pr is None and original_branch is None
                 and args.command not in _NO_TARGET_COMMANDS)
    if ambiguous and any(not a.startswith("-") for a in extra):
        idx = _positional_index(extra, _delegate_value_flags(entry))
        if idx >= 0:
            original_pr, original_branch = pr_context.classify_target(extra[idx])
            extra.pop(idx)

    # The command's declaration drives all three axes from here. Read after the
    # positional scan above, because that scan is what turns a bare token into
    # the --pr that can escalate the declared depth.
    need = entry["need"]

    ctx = pr_context.resolve_at(
        need.depth,
        pr=original_pr,
        branch=original_branch,
        repo_dir=getattr(args, "repo_dir", None),
    )

    # The CLI-only half of the project registry: a repo whose whole workbench
    # use is `pr` never opens a Claude session, so the SessionStart hook never
    # sees it. The root is already resolved, so this costs no subprocess.
    if ctx.worktree_root:
        workbench_projects.register(ctx.worktree_root)

    if need.update:
        ctx = pr_context.update_to_remote(ctx)

    # The lock is acquired before _dispatch so contention costs no trail
    # artifacts.
    try:
        lock = (
            run_lock.acquire(
                ctx.target_dir,
                command=" ".join(["pr"] + sys.argv[1:]),
                started=pr_state.now_iso(),
            )
            if need.lock else contextlib.nullcontext()
        )
        with lock:
            sys.exit(_dispatch(args, ctx, extra, global_args,
                               original_pr=original_pr,
                               original_branch=original_branch))
    except run_lock.LockBusy as exc:
        run_lock.report_busy(exc)
        sys.exit(1)


if __name__ == "__main__":
    main()
