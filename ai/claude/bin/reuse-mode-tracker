#!/usr/bin/env python3
"""Track /reuse lite|full|ultra commands via UserPromptSubmit hook.

Reads hook JSON from stdin, checks if the prompt matches /reuse <level>,
writes the level to reuse.level in ~/.config/workbench/config.yml, and emits
context.

Usage (called by settings.json UserPromptSubmit hook):
  echo '{"prompt":"/reuse ultra"}' | reuse-mode-tracker
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _reuse_levels import (  # noqa: E402
    LEVEL_DESCRIPTIONS,
    VALID_LEVELS,
    ConfigError,
    read_default,
    read_level,
    write_default,
    write_level,
)


def _handle_default(args: str) -> None:
    """Handle /reuse default [<level>]."""
    parts = args.split(None, 1)
    if len(parts) < 2:
        print(f"Current default reuse level: {read_default()}")
        return

    level = parts[1].lower().strip()
    if level not in VALID_LEVELS:
        print(f"Unknown reuse level: {level}. Valid: lite, full, ultra")
        return

    try:
        write_default(level)
    except ConfigError as exc:
        # This runs on UserPromptSubmit: an unwritable config must report itself
        # and let the prompt through, not abort the user's turn with a traceback.
        print(f"Could not save the default reuse level: {exc}")
        return
    print(f"Default reuse level set to: {level} — {LEVEL_DESCRIPTIONS[level]}")


def main() -> None:
    try:
        data = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return

    prompt = data.get("prompt", "").strip()
    if prompt != "/reuse" and not prompt.startswith("/reuse "):
        return

    parts = prompt.split(None, 1)
    if len(parts) < 2:
        print(f"Current reuse level: {read_level()}")
        return

    arg = parts[1].strip()
    if arg.lower() == "default" or arg.lower().startswith("default "):
        _handle_default(arg)
        return

    level = arg.lower()
    if level not in VALID_LEVELS:
        print(f"Unknown reuse level: {level}. Valid: lite, full, ultra, default <level>")
        return

    try:
        write_level(level)
    except ConfigError as exc:
        print(f"Could not save the reuse level: {exc}")
        return
    print(f"Reuse level set to: {level} — {LEVEL_DESCRIPTIONS[level]}")


if __name__ == "__main__":
    main()
