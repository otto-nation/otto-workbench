#!/usr/bin/env python3
"""Fetch PR review threads, compute lifecycle states, and output status.

Renders a human-readable dashboard to stderr and structured JSON to stdout.
Manages local state in <worktree>/ignore/pr-comments/state.json.

Usage:
  review-threads [--pr NUMBER] [--branch NAME] [--repo-dir PATH]
  review-threads --triage
  review-threads --fix
  review-threads --finish
"""

import argparse
import dataclasses
import functools
import json
import re
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass
from enum import Enum, StrEnum
from pathlib import Path
from string import Template

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "lib"))

import log
import agent_retry
import ai_backend
import pr_comments as pc
import pr_context
import pr_state
import run_lock
import publishing
from pr_comments import ThreadState
from pr_state import CommitStatus
import review_common
import review_issue
from review_common import Diagnosis
from pr_thread_models import (
    ClassificationResult,
    CommentFixResult,
    CommentItem,
    PRReport,
    ReportThread,
    TrackingResult,
    TriageResult,
    triage_result_from_dict,
)
from review_github import fetch_pr_data
from review_issue import CreatedIssue
import supersession
from tool_parser import handle_value_flags
from trail import Trail, add_trail_args

SCRIPT = Path(__file__).name

TRIAGE_CONTEXT_LINES = 10
FIX_MIN_TURNS = 20
FIX_MAX_TURNS_CAP = 60
FIX_TURNS_PER_ITEM = 5
FIX_MIN_BUDGET = 2.0
FIX_MAX_BUDGET_CAP = 5.0
FIX_BUDGET_PER_ITEM = 0.5
FIX_MODEL = "sonnet"
DIFF_CONTEXT_MAX_LINES = 100
FIX_RETRY_TURNS_MIN = 30
FIX_RETRY_TURNS_BUMP = 15
# A retry has already proven the first pass's cap insufficient, so it needs
# headroom above FIX_MAX_TURNS_CAP rather than the same budget again.
FIX_RETRY_MAX_TURNS_CAP = 120
# Largest item count that fits both caps at the per-item rates above. Derived,
# not chosen: raising either cap or lowering either rate widens the chunk.
FIX_CHUNK_SIZE = min(
    FIX_MAX_TURNS_CAP // FIX_TURNS_PER_ITEM,
    int(FIX_MAX_BUDGET_CAP // FIX_BUDGET_PER_ITEM),
)
TEMPLATE_DIR = Path(__file__).resolve().parent.parent.parent / "lib" / "review-templates"

_FENCE_RE = re.compile(r"```(?:json)?\s*\n(.*?)\n```", re.DOTALL)
_SUMMARY_MARKER = "<!-- pr-comments:summary -->"
_APPLIED_REPLY_PREFIX = "Applied:"
_ADDRESSED_REPLY_PREFIX = "Already addressed"
_DISMISSED_REPLY_PREFIX = "Suggestion reviewed and determined to be inapplicable"
_DEFERRED_REPLY_PREFIX = "Deferred:"
# Every opening line a generated reply can have. Ordered by nothing — this is a
# membership test, used to tell our own template apart from a reply someone
# rewrote by hand.
_GENERATED_REPLY_PREFIXES = (
    _APPLIED_REPLY_PREFIX,
    _ADDRESSED_REPLY_PREFIX,
    _DISMISSED_REPLY_PREFIX,
    _DEFERRED_REPLY_PREFIX,
)
# Every trailing paragraph a generated reply can have: one sentence naming a
# commit, a file, or an issue. Kept in step with the four body_fn builders
# below — a new trailing line there needs its opening added here, or the reply
# it appears in stops being recognised as ours.
_GENERATED_FOLLOWUP_RE = re.compile(
    r"(?:Fixed in|Result is in|Current behaviour is at|Addressed in|See|"
    r"Tracked in|Unchanged at) .+\.$",
    re.DOTALL,
)
# Not agent_retry.FIX_RETRY_HINT, which scolds an agent that produced nothing.
# This one addresses an agent that produced something and is being handed the
# remainder, so it points at the checklist rather than at the write mechanism.
_FIX_RESUME_HINT = (
    "This is a RETRY of a prior fix pass. Some items were already fixed in the "
    "previous pass — focus only on unchecked items below. Work efficiently.\n\n"
)


def _extract_json(text: str) -> str:
    """Strip markdown code fences or preamble from AI output before JSON parsing."""
    m = _FENCE_RE.search(text)
    if m:
        return m.group(1).strip()
    stripped = text.strip()
    start = stripped.find("{")
    if start > 0:
        end = stripped.rfind("}")
        if end > start:
            return stripped[start:end + 1]
    return stripped


def _parses_as_json(text: str) -> bool:
    """Whether triage output can be consumed. Drives the retry-once guard."""
    try:
        json.loads(_extract_json(text))
    except (json.JSONDecodeError, TypeError):
        return False
    return True


def _resolve_verified_threads(threads_raw: list, threads: dict) -> int:
    """Resolve all verified threads on GitHub. Returns count resolved."""
    resolved = 0
    for thread_data in threads_raw:
        tid = thread_data["id"]
        if threads.get(tid, {}).get("state") != pc.STATE_VERIFIED:
            continue
        if not pc.resolve_thread(tid):
            continue
        threads[tid]["state"] = pc.STATE_RESOLVED
        resolved += 1
    return resolved


def _gather_code_context(threads: list[ReportThread], repo_dir: Path) -> str:
    """Read surrounding source lines for each thread's file location."""
    snippets = []
    for t in threads:
        file_path = t.file
        line = int(t.line or 0)
        if not file_path or line == 0:
            continue
        full_path = repo_dir / file_path
        if not full_path.is_file():
            continue
        try:
            lines = full_path.read_text().splitlines()
        except OSError:
            continue
        start = max(0, line - 1 - TRIAGE_CONTEXT_LINES)
        end = min(len(lines), line + TRIAGE_CONTEXT_LINES)
        snippet = "\n".join(lines[start:end])
        if snippet:
            snippets.append(f"--- {file_path}:{start + 1}-{end} ---\n{snippet}\n---")
    return "\n".join(snippets)


def _branch_commit_log(wt_path: Path | None) -> str:
    """Commit subjects on this branch, newest first.

    Triage sees code context from current HEAD, which already contains fixes made
    in earlier rounds of the same review cycle.  Without the log it cannot tell a
    suggestion that was acted on from one that never applied, and defaults to
    calling the reviewer wrong.
    """
    if not wt_path:
        return ""
    base = f"origin/{_resolve_default_branch(wt_path)}"
    result = subprocess.run(
        ["git", "-C", str(wt_path), "log", "--format=%h %s", f"{base}..HEAD"],
        capture_output=True, text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def _build_triage_prompt(
    non_resolved: list[ReportThread], code_context: str,
    unseen_comments: list[dict] | None = None,
    commit_log: str = "",
) -> str:
    """Build the AI classification prompt for thread triage."""
    thread_json = json.dumps([dataclasses.asdict(t) for t in non_resolved], indent=2)
    context_block = ""
    if code_context:
        context_block = f"\nCode context for referenced files:\n{code_context}\n"

    history_block = ""
    if commit_log:
        history_block = (
            "\nCommits already made on this branch (newest first). A commit whose "
            "subject matches what a thread asks for means that thread was already "
            "acted on — classify it already_addressed, not invalid:\n"
            f"{commit_log}\n"
        )

    comments_block = ""
    comment_items_schema = ""
    if unseen_comments:
        comments_json = json.dumps(unseen_comments, indent=2)
        comments_block = f"""

Additionally, analyze these top-level PR comments. Each comment may contain multiple
actionable points — decompose them into individual items and classify each one separately.
Non-actionable preamble (greetings, praise, general observations) should be skipped.

Top-level comments:
{comments_json}
"""
        comment_items_schema = """
  "comment_items": [
    {{
      "source_id": "id from input comment",
      "source_type": "issue_comment or review_body (from input)",
      "index": 0,
      "reviewer": "user from input comment",
      "classification": "actionable_suggestion|question|approval|conflicting",
      "verification": "valid|already_addressed|invalid|needs_discussion (only for actionable_suggestion, empty string otherwise)",
      "complexity": "low|medium|high (only for actionable_suggestion with verification=valid, empty string otherwise)",
      "reasoning": "brief explanation",
      "summary": "one-line summary of this specific item",
      "file": "file path if referenced in the item (empty string if not)",
      "line": 0,
      "body": "relevant excerpt from the comment for this item",
      "evidence_file": "file proving the verdict (required for already_addressed/invalid)",
      "evidence_line": 0
    }}
  ],"""

    return f"""You are a code review triage assistant. Analyze these PR review threads and classify each one.

For each thread, provide:
1. classification: one of 'actionable_suggestion', 'question', 'approval', 'conflicting'
2. verification (only for actionable_suggestion): one of 'valid', 'already_addressed',
   'invalid', 'needs_discussion'
   - valid: the suggestion is correct and the code does NOT yet do what it asks
   - already_addressed: the code already does what the reviewer asks. The code context
     below is current HEAD, which includes commits made earlier in this same review
     cycle — so a suggestion that looks satisfied is usually one that was ALREADY ACTED
     ON in response to this very thread. This is agreement with the reviewer, not
     rejection of them.
   - invalid: the reviewer's premise is factually wrong — they misread the code, or the
     change they describe would break something. Use this ONLY when you can state the
     specific mistake in `reasoning`. "The code already does this" is NEVER invalid; it
     is already_addressed. When torn between invalid and any other value, do not pick
     invalid.
   - needs_discussion: a judgment call, tradeoff, or design decision the author must make
3. complexity (only for actionable_suggestion with verification=valid): one of 'low', 'medium', 'high'
   - low: rename, remove, import fix, guard/nil check, use existing helper
   - medium: logic change within a single function or file
   - high: cross-file refactor, design decision, or architectural change
4. reasoning: one sentence explaining your classification/verification
5. summary: one-line summary of the thread
6. evidence_file / evidence_line: the file and 1-based line that prove your verdict.
   REQUIRED for already_addressed and invalid — those verdicts get posted back to the
   reviewer as a claim about their code, and a claim with no line to point at is not one
   you can make. Cite the line that already does what the reviewer asked
   (already_addressed) or the line that contradicts their premise (invalid). If you
   cannot name one, the verdict is needs_discussion. Leave both empty otherwise.

Thread data:
{thread_json}
{context_block}{history_block}{comments_block}
Return JSON matching this exact schema:
{{
  "threads": [
    {{
      "id": "id from input",
      "state": "state from input",
      "classification": "actionable_suggestion|question|approval|conflicting",
      "verification": "valid|already_addressed|invalid|needs_discussion (only for actionable_suggestion, empty string otherwise)",
      "complexity": "low|medium|high (only for actionable_suggestion with verification=valid, empty string otherwise)",
      "reasoning": "brief explanation",
      "file": "file from input",
      "line": "line_from_input",
      "reviewer": "reviewer from input",
      "summary": "one-line summary",
      "evidence_file": "file proving the verdict (required for already_addressed/invalid)",
      "evidence_line": 0
    }}
  ],{comment_items_schema}
  "stats": {{
    "total": "count of threads",
    "actionable": "count of actionable threads",
    "questions": "count of question threads",
    "approvals": "count of approval threads",
    "conflicting": "count of conflicting threads",
    "valid": "count of valid threads",
    "invalid": "count of invalid threads",
    "already_addressed": "count of already-addressed threads",
    "comment_items_total": "count of decomposed comment items (0 if none)",
    "comment_items_actionable": "count of actionable comment items (0 if none)"
  }}
}}

IMPORTANT: Return ONLY the JSON object, no markdown fencing or explanation."""


def _collect_unseen_comments(report: PRReport) -> list[dict]:
    """Collect unseen issue and review body comments for triage decomposition."""
    unseen = []
    for c in report.issue_comments:
        if not c.get("seen"):
            unseen.append({
                "id": c["id"],
                "source_type": "issue_comment",
                "user": c.get("user", ""),
                "body": c.get("body", ""),
            })
    for c in report.review_body_comments:
        if not c.get("seen"):
            unseen.append({
                "id": c["id"],
                "source_type": "review_body",
                "user": c.get("user", ""),
                "body": c.get("body", ""),
            })
    return unseen


def _assign_item_ids(comment_items: list[CommentItem]) -> None:
    """Assign synthetic IDs to decomposed comment items in place."""
    for item in comment_items:
        prefix = "ic" if item.source_type == "issue_comment" else "rb"
        item.id = f"{prefix}-{item.source_id}-{item.index}"


_UNSUPPORTED_VERDICTS = ("already_addressed", "invalid")

_DOWNGRADE_REASON = (
    "downgraded from {verdict}: triage cited no line in this repo to back the claim"
)


def _evidence_is_real(repo_dir: Path, entry: CommentItem) -> bool:
    """Whether the entry cites a line that actually exists inside `repo_dir`.

    Both halves matter, and neither is checked by joining and stating the
    result.  Containment needs the resolved paths compared, because joining a
    directory with an absolute path discards the directory and a relative path
    made of `..` walks straight out of the tree — either way a citation from
    outside the repo would stat a real file and pass for verified.  The line
    number needs the file's length, because a permalink past EOF highlights
    nothing.
    """
    if not entry.has_evidence():
        return False
    root = repo_dir.resolve()
    try:
        cited = (root / entry.evidence_file).resolve()
        if not cited.is_relative_to(root) or not cited.is_file():
            return False
        with cited.open(encoding="utf-8", errors="replace") as fh:
            return entry.evidence_line <= sum(1 for _ in fh)
    except OSError:
        return False


def _downgrade_unsupported_verdicts(
    entries: list[CommentItem], repo_dir: Path, trail: Trail | None = None,
) -> int:
    """Demote verdicts that cannot cite code to needs_discussion. Returns count.

    `already_addressed` and `invalid` are posted back to the reviewer as claims
    about their code, so each one has to point at a line.  A verdict whose cited
    location does not exist in the tree is no better than one with no location:
    the reader gets a link to nothing.  Rather than post an unsupported claim,
    hand the thread to the author.
    """
    downgraded = 0
    for entry in entries:
        if entry.verification not in _UNSUPPORTED_VERDICTS:
            continue
        if _evidence_is_real(repo_dir, entry):
            continue
        reason = _DOWNGRADE_REASON.format(verdict=entry.verification)
        if trail:
            trail.info("triage_downgrade", reason, data={"thread": entry.id})
        log.warn(f"{entry.id}: {reason} — routing to needs_discussion")
        entry.verification = "needs_discussion"
        entry.complexity = ""
        entry.evidence_file = ""
        entry.evidence_line = 0
        entry.reasoning = f"{entry.reasoning} ({reason})".strip()
        downgraded += 1
    return downgraded


def _run_triage(report: PRReport, repo_dir: Path, ctx_args: dict,
                trail: Trail | None = None) -> tuple[TriageResult | None, int]:
    """Classify non-resolved threads and decompose top-level comments via AI.

    Returns (triage_result, exit_code). Caller handles stdout output.
    """
    non_resolved = [t for t in report.threads if t.state not in (ThreadState.RESOLVED, ThreadState.ADDRESSED)]
    unseen_comments = _collect_unseen_comments(report)

    if not non_resolved and not unseen_comments:
        return TriageResult(), 0

    code_context = _gather_code_context(non_resolved, repo_dir)
    prompt = _build_triage_prompt(
        non_resolved, code_context,
        unseen_comments=unseen_comments or None,
        commit_log=_branch_commit_log(repo_dir),
    )

    stdout, rc = agent_retry.retry_blank_response(
        lambda text: ai_backend.prompt(text, cwd=str(repo_dir), task="comment-triage"),
        prompt, label="Triage", usable=_parses_as_json,
    )
    if rc != 0:
        if trail:
            trail.error("triage", "AI prompt failed", data={"exit_code": rc})
        log.error("ai prompt failed")
        return None, 1

    try:
        raw = json.loads(_extract_json(stdout))
    except (json.JSONDecodeError, TypeError):
        preview = (stdout or "")[:200]
        if trail:
            trail.error("triage", "AI returned non-JSON output",
                        data={"output_len": len(stdout or ""),
                              "output_preview": (stdout or "")[:500]})
        log.error(f"ai returned non-JSON output ({len(stdout or '')} chars): {preview}")
        return None, 1

    triage_result = triage_result_from_dict(raw)
    _assign_item_ids(triage_result.comment_items)

    downgraded = _downgrade_unsupported_verdicts(
        triage_result.threads, repo_dir, trail,
    ) + _downgrade_unsupported_verdicts(
        triage_result.comment_items, repo_dir, trail,
    )
    if downgraded:
        # The model's own count is stale once a verdict moves.
        triage_result.stats.invalid = sum(
            1 for t in triage_result.threads if t.verification == "invalid"
        )

    # Update triage state
    try:
        stats = triage_result.stats
        st = pr_state.load_or_init(**ctx_args)
        pr_state.apply(st, pr_state.TriageSummary(
            total=stats.total,
            actionable=stats.actionable,
            valid=stats.valid,
            questions=stats.questions,
            comment_items_total=stats.comment_items_total,
            comment_items_actionable=stats.comment_items_actionable,
            updated_at=pr_state.now_iso(),
        ))
        pr_state.save_state(ctx_args["target_dir"], st)
    except Exception as exc:
        if trail:
            trail.error("triage", f"state update failed: {exc}")
        log.error(f"triage state update failed: {exc}")

    return triage_result, 0


def _thread_comment_text(comments: list) -> str:
    """Format a thread's comments as quoted conversation."""
    parts = []
    for c in comments:
        author = c.get("author", {}).get("login", "unknown")
        body = c.get("body", "").strip()
        if body:
            quoted = "\n".join(f"> {line}" for line in body.splitlines())
            parts.append(f"**@{author}:**\n{quoted}")
    return "\n\n".join(parts)


def _code_context_for_thread(file_path: str, line: int | str, repo_dir: Path) -> str:
    """Read surrounding source lines for a single thread's file location."""
    line = int(line) if line else 0
    if not file_path or line == 0:
        return ""
    full_path = repo_dir / file_path
    if not full_path.is_file():
        return ""
    try:
        lines = full_path.read_text().splitlines()
    except OSError:
        return ""
    start = max(0, line - 1 - TRIAGE_CONTEXT_LINES)
    end = min(len(lines), line + TRIAGE_CONTEXT_LINES)
    snippet = "\n".join(lines[start:end])
    return f"```\n{snippet}\n```" if snippet else ""


def _diff_context_for_file(file_path: str, wt_path: Path, default_branch: str = "main") -> str:
    """Get the PR diff for a file, truncated to DIFF_CONTEXT_MAX_LINES."""
    if not file_path:
        return ""
    result = subprocess.run(
        ["git", "-C", str(wt_path), "diff", f"origin/{default_branch}", "--", file_path],
        capture_output=True, text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return ""
    lines = result.stdout.splitlines()
    total = len(lines)
    if total > DIFF_CONTEXT_MAX_LINES:
        lines = lines[:DIFF_CONTEXT_MAX_LINES]
        lines.append(f"... ({total - DIFF_CONTEXT_MAX_LINES} more lines)")
    return "```diff\n" + "\n".join(lines) + "\n```"


def _build_tracking_file(
    tracking_path: Path,
    fixable: list[CommentItem],
    threads_by_id: dict[str, ReportThread],
    repo_dir: Path,
    pr_number: int,
    fixable_items: list[CommentItem] | None = None,
    default_branch: str = "main",
) -> None:
    """Build the tracking markdown file for the fix agent."""
    diff_cache: dict[str, str] = {}
    sections = []
    for thread in fixable:
        tid = thread.id
        report_thread = threads_by_id.get(tid)
        comments = report_thread.comments if report_thread else []
        conversation = _thread_comment_text(comments)
        code_ctx = _code_context_for_thread(thread.file, thread.line, repo_dir)
        if thread.file not in diff_cache:
            diff_cache[thread.file] = _diff_context_for_file(thread.file, repo_dir, default_branch)
        diff_ctx = diff_cache[thread.file]

        section = f"## <!-- thread:{tid} --> {thread.file}:{thread.line} — @{thread.reviewer}\n\n"
        if thread.summary:
            section += f"**Summary:** {thread.summary}\n\n"
        if conversation:
            section += f"**Conversation:**\n{conversation}\n\n"
        if code_ctx:
            section += f"**Code context:**\n{code_ctx}\n\n"
        if diff_ctx:
            section += f"**PR diff for this file:**\n{diff_ctx}\n\n"
        section += "- [ ] Apply fix\n"
        sections.append(section)

    for item in (fixable_items or []):
        location = f"{item.file}:{item.line}" if item.file and item.line else (item.file or "general")
        code_ctx = _code_context_for_thread(item.file, item.line, repo_dir) if item.file and item.line else ""
        if item.file and item.file not in diff_cache:
            diff_cache[item.file] = _diff_context_for_file(item.file, repo_dir, default_branch)
        diff_ctx = diff_cache.get(item.file, "")

        section = f"## <!-- item:{item.id} --> {location} — @{item.reviewer}\n\n"
        if item.summary:
            section += f"**Summary:** {item.summary}\n\n"
        if item.body:
            quoted = "\n".join(f"> {ln}" for ln in item.body.splitlines())
            section += f"**From comment by @{item.reviewer}:**\n{quoted}\n\n"
        if code_ctx:
            section += f"**Code context:**\n{code_ctx}\n\n"
        if diff_ctx:
            section += f"**PR diff for this file:**\n{diff_ctx}\n\n"
        section += "- [ ] Apply fix\n"
        sections.append(section)

    content = f"# Comment Fix Tracking — PR #{pr_number}\n\n"
    content += "\n".join(sections)
    tracking_path.parent.mkdir(parents=True, exist_ok=True)
    tracking_path.write_text(content)


def _render_fix_template(
    branch: str, repo: str, threads_content: str,
    tracking_file: str, wt_path: str, max_turns: int,
    main_wt_path: str = "",
) -> str:
    """Render the fix-comments.md template."""
    tmpl = Template((TEMPLATE_DIR / review_common.TEMPLATE_FIX_COMMENTS).read_text())
    result = tmpl.safe_substitute(
        branch_name=branch,
        repo=repo,
        threads_content=threads_content,
        tracking_file=tracking_file,
        worktree_block=review_common.build_worktree_block(wt_path),
        max_turns=str(max_turns),
    )
    if main_wt_path:
        result += (
            "\n## Main branch (read-only reference)\n"
            f"Checked out at: {main_wt_path}\n\n"
            "When a reviewer comment references code outside the PR diff — imports, "
            "callers, existing patterns, or shared utilities — read from this path "
            "to understand the baseline. Do not modify files in this worktree.\n"
        )
    return result


@functools.cache
def _resolve_default_branch(wt_path: Path) -> str:
    """`pr_context.default_branch`, cached for the run.

    The default branch cannot change mid-run and several call sites need it per
    file processed, so the shared resolver is memoised here rather than in the
    library every script imports.

    The cache is process-global (no `cache_clear` exposed).  Safe for a single
    CLI invocation, but a test harness that exercises multiple worktree paths
    with different mocked git state must call `_resolve_default_branch.cache_clear()`
    between cases to avoid stale results from an earlier call.
    """
    return pr_context.default_branch(wt_path)


def _find_and_update_main_worktree(wt_path: Path) -> Path | None:
    """Find the default-branch worktree and update it to match origin."""
    default_branch = _resolve_default_branch(wt_path)

    main_wt = pr_context.find_worktree_for_branch(default_branch, str(wt_path))
    if not main_wt:
        return None

    pr_context.fetch_and_reset(str(main_wt), default_branch)
    return main_wt


def _fix_turn_budget(item_count: int) -> int:
    return min(max(FIX_MIN_TURNS, item_count * FIX_TURNS_PER_ITEM), FIX_MAX_TURNS_CAP)


def _fix_budget_usd(item_count: int) -> float:
    return min(max(FIX_MIN_BUDGET, item_count * FIX_BUDGET_PER_ITEM), FIX_MAX_BUDGET_CAP)


def _fix_retry_budget(original: int) -> int:
    """Turns for a retry pass.

    Capped by FIX_RETRY_MAX_TURNS_CAP rather than the first pass's cap: clamping
    a retry to the budget that just ran out guarantees the same failure, which
    is what made the bump dead precisely when a retry was warranted.
    """
    return min(max(FIX_RETRY_TURNS_MIN, original + FIX_RETRY_TURNS_BUMP),
               FIX_RETRY_MAX_TURNS_CAP)


def _fix_chunks(items: list, size: int) -> list[list]:
    """Split work into runs a single agent pass can actually finish."""
    return [items[i:i + size] for i in range(0, len(items), size)]


def _fix_batches(threads: list, items: list) -> list[tuple[list, list]]:
    """Split threads and comment items into batches of at most FIX_CHUNK_SIZE.

    Chunked as one combined list rather than two, because the budget the chunk
    size protects is spent on the batch as a whole — chunking each kind on its
    own and pairing them up would put twice the cap in front of one agent.
    """
    tagged = [(True, t) for t in threads] + [(False, i) for i in items]
    return [
        ([w for is_thread, w in chunk if is_thread],
         [w for is_thread, w in chunk if not is_thread])
        for chunk in _fix_chunks(tagged, FIX_CHUNK_SIZE)
    ]


def _fix_session_log(wt_path: Path) -> str:
    """Where the fix agent streams its session, so a thrash can be diagnosed."""
    return str(wt_path / "ignore" / "pr-comments" / "fix-session.jsonl")


def _invoke_fix_agent(
    prompt: str, wt_path: Path, main_wt_path: Path | None = None,
    max_turns: int | None = None, max_budget: float | None = None,
    repo: str | None = None, pr_number: int | None = None,
) -> int:
    """Run AI agent to apply fixes. Returns exit code."""
    dirs = [str(wt_path)]
    if main_wt_path:
        dirs.append(str(main_wt_path))
    return ai_backend.invoke_fix(ai_backend.AgentInvocation(
        prompt=prompt,
        cwd=str(wt_path),
        session_log=_fix_session_log(wt_path),
        add_dirs=dirs,
        max_turns=max_turns if max_turns is not None else FIX_MIN_TURNS,
        max_budget=max_budget if max_budget is not None else FIX_MIN_BUDGET,
        model=FIX_MODEL,
        task="comment-fix",
        repo=repo,
        pr=str(pr_number) if pr_number else None,
    ))


def _guarded_fix_pass(
    prompt: str, wt_path: Path, main_wt: Path | None, tracking_file: Path,
    *, max_turns: int, max_budget: float, label: str,
    repo: str | None = None, pr_number: int | None = None,
) -> Diagnosis | None:
    """Run the fix agent, retrying once if it checked nothing off.

    An agent that finishes having touched no box and called no write tool was
    thrashing, and the shared guard's retry names the write mechanism.  Partial
    progress is not this function's business — `_retry_fix_pass` handles that,
    and the guard stays out of its way by treating a single checked box as
    output.  Returns the diagnosis, or None when the pass produced work.
    """
    def invoke(text: str, turns: int) -> int:
        return _invoke_fix_agent(
            text, wt_path, main_wt, max_turns=turns, max_budget=max_budget,
            repo=repo, pr_number=pr_number,
        )

    return agent_retry.run_guarded(
        invoke, prompt, _fix_session_log(wt_path),
        label=label, max_turns=max_turns,
        produced=lambda: _count_checked(tracking_file) > 0,
        hint_select=lambda diagnosis: agent_retry.FIX_RETRY_HINT,
        ceiling=FIX_RETRY_MAX_TURNS_CAP,
    )


@dataclass
class FixBatchResult:
    """What one batch of the fix pass produced."""

    tracking: TrackingResult
    unproductive: Diagnosis | None
    max_turns: int
    max_budget: float


def _run_fix_batch(
    chunk_threads: list, chunk_items: list, threads_by_id: dict,
    tracking_file: Path, wt_path: Path, main_wt: Path | None,
    ctx, pr_number: int, *, label: str, default_branch: str,
) -> FixBatchResult:
    """Run the fix agent over one batch and parse what it checked off.

    The tracking file is rebuilt per batch so the agent is handed only the items
    its budget covers — inlining the whole list is what let a 169 KB checklist
    reach a single 60-turn pass.
    """
    _build_tracking_file(
        tracking_file, chunk_threads, threads_by_id,
        wt_path, pr_number,
        fixable_items=chunk_items,
        default_branch=default_branch,
    )
    chunk_count = len(chunk_threads) + len(chunk_items)
    chunk_turns = _fix_turn_budget(chunk_count)
    chunk_budget = _fix_budget_usd(chunk_count)
    prompt = _render_fix_template(
        branch=ctx.branch,
        repo=ctx.repo,
        threads_content=tracking_file.read_text(),
        tracking_file=str(tracking_file),
        wt_path=str(wt_path),
        max_turns=chunk_turns,
        main_wt_path=str(main_wt) if main_wt else "",
    )
    log.info(f"{label} — applying review comment suggestions...")
    unproductive = _guarded_fix_pass(
        prompt, wt_path, main_wt, tracking_file,
        max_turns=chunk_turns, max_budget=chunk_budget,
        label=label, repo=ctx.repo, pr_number=pr_number,
    )
    log.blank()
    return FixBatchResult(
        tracking=_parse_tracking_results(
            tracking_file, chunk_threads, fixable_items=chunk_items,
        ),
        unproductive=unproductive,
        max_turns=chunk_turns,
        max_budget=chunk_budget,
    )


def _partition_batches(
    results: list[FixBatchResult],
) -> tuple[TrackingResult, TrackingResult]:
    """Split batch results into retry-eligible and already-retried totals.

    A batch the guard retried to no effect has had its second attempt, and
    handing its items to `_retry_fix_pass` would be a third identical run.
    Deferrals from batches that did produce work have only had one attempt, so
    one stalled batch must not spend the whole pass's retry.
    """
    retryable, stalled = TrackingResult(), TrackingResult()
    for batch in results:
        _merge_tracking(stalled if batch.unproductive else retryable, batch.tracking)
    return retryable, stalled


def _merge_tracking(into: TrackingResult, batch: TrackingResult) -> None:
    """Accumulate one batch's parsed results into the pass-wide totals."""
    into.fixed += batch.fixed
    into.deferred += batch.deferred
    into.fixed_items += batch.fixed_items
    into.deferred_items += batch.deferred_items


def _count_checked(path: Path) -> int:
    """Count checked checkboxes in a tracking file."""
    if not path.exists():
        return 0
    return sum(
        1 for line in path.read_text().splitlines()
        if re.match(r"^- \[[xX]\] ", line)
    )


def _count_unchecked(path: Path) -> int:
    """Count unchecked checkboxes in a tracking file."""
    if not path.exists():
        return 0
    return sum(
        1 for line in path.read_text().splitlines()
        if re.match(r"^- \[ \] ", line)
    )


def _parse_tracking_results(
    tracking_path: Path, fixable: list[CommentItem],
    fixable_items: list[CommentItem] | None = None,
) -> TrackingResult:
    """Parse tracking file to determine which threads/items were fixed vs deferred."""
    content = tracking_path.read_text()
    sections = re.split(r"^## <!-- (?:thread|item):", content, flags=re.MULTILINE)

    fixable_by_id = {t.id: t for t in fixable}
    items_by_id = {it.id: it for it in (fixable_items or [])}
    result = TrackingResult()

    for section in sections[1:]:
        tid_match = re.match(r"(\S+) -->", section)
        if not tid_match:
            continue
        tid = tid_match.group(1)
        is_checked = bool(re.search(r"^- \[[xX]\] ", section, re.MULTILINE))
        source = fixable_by_id.get(tid) or items_by_id.get(tid)
        if not source:
            continue
        is_item = tid in items_by_id
        if is_checked:
            (result.fixed_items if is_item else result.fixed).append(source)
        else:
            deferred = dataclasses.replace(source, reason="agent could not auto-fix")
            (result.deferred_items if is_item else result.deferred).append(deferred)

    return result


@dataclass
class CommitPushResult:
    sha: str | None
    # A pr_state.CommitStatus. Typed as `str` because a status read back out
    # of a state file is a plain string, and CommitStatus is a StrEnum
    # precisely so the two compare equal.
    status: str
    error: str


# A real commit the remote does not have. `push_failed` is git refusing;
# `push_held` is us refusing, because the gate was shut when the pass ran.
# Either way the SHA is local-only, so nothing may cite it outward yet — the
# commit link would 404 for the reviewer reading it.
_UNPUSHED_STATUSES = frozenset({CommitStatus.PUSH_FAILED, CommitStatus.PUSH_HELD})


def _commit_unpushed(status: str) -> bool:
    return status in _UNPUSHED_STATUSES


def _hold_push(wt_path: Path, sha: str | None) -> CommitPushResult:
    """Keep a commit local because the gate is shut."""
    publishing.draft("push", f"git -C '{wt_path}' push")
    return CommitPushResult(sha, CommitStatus.PUSH_HELD, "")


def _report_diverged_push(
    wt_path: Path, sha: str | None, err: str, trail: Trail | None,
) -> None:
    """Say a push was rejected, the same way from every path that pushes.

    The recovery is a force-push, which this deliberately prints rather than
    runs — a force-push is the user's call, not the pass's.
    """
    log.error(
        f"push failed — branch has diverged. Run:\n"
        f"  git -C '{wt_path}' push --force-with-lease"
    )
    if trail:
        trail.error("push", "push failed", data={"sha": sha, "error": err[:500]})


def _commit_regen_and_retry_push(
    wt_path: Path, trail: Trail | None,
) -> CommitPushResult | None:
    """If pre-push hooks left regenerated files uncommitted, commit and retry.

    Returns a successful CommitPushResult on retry success, None otherwise.
    """
    status = subprocess.run(
        ["git", "-C", str(wt_path), "status", "--porcelain", "--untracked-files=no"],
        capture_output=True, text=True,
    )
    modified = [
        line[3:] for line in status.stdout.splitlines()
        if line.startswith(" M ")
    ]
    if not modified:
        return None

    log.info("Committing regenerated files...")
    if trail:
        trail.info("push", "committing regenerated files before retry",
                    data={"files": modified})
    ar = subprocess.run(
        ["git", "-C", str(wt_path), "add", "-u"],
        capture_output=True,
    )
    if ar.returncode != 0:
        log.error("Failed to stage regenerated files.")
        return None
    rc = subprocess.run(
        ["git", "-C", str(wt_path), "commit", "-m",
         "chore: regenerate after review comment fixes"],
        capture_output=True, text=True,
    )
    if rc.returncode != 0:
        return None

    sha = _get_head_sha(wt_path)
    retry = subprocess.run(
        ["git", "-C", str(wt_path), "push"],
        capture_output=True, text=True,
    )
    if retry.returncode != 0:
        return None

    log.info("Pushed fixes (with regenerated files)")
    return CommitPushResult(sha, CommitStatus.PUSHED, "")


def _commit_and_push(
    wt_path: Path, fixed: int, deferred: int, trail: Trail | None = None,
) -> CommitPushResult:
    """Commit and push fixes. Returns structured result with status."""
    if not review_common.has_uncommitted_changes(wt_path):
        return CommitPushResult(None, CommitStatus.NO_CHANGES, "")

    subprocess.run(
        ["git", "-C", str(wt_path), "add", "-A"],
        capture_output=True, check=True,
    )

    msg = "fix: address review comments"
    if fixed:
        msg += f"\n\n{fixed} fixed, {deferred} deferred"

    result = subprocess.run(
        ["git", "-C", str(wt_path), "commit", "-m", msg],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        err = result.stderr.strip()
        log.error(f"commit failed: {err}")
        if trail:
            trail.error("commit", "commit failed", data={"error": err[:500]})
        return CommitPushResult(None, CommitStatus.COMMIT_FAILED, err)

    sha = _get_head_sha(wt_path)

    log.info(f"Committed fixes ({fixed} fixed, {deferred} deferred)")

    # The commit is ungated on purpose: it is local, undoable, and it is what
    # makes the work reviewable at all. The push is the outward act, so it waits
    # for the same permission every reply and comment waits for.
    if not publishing.enabled():
        return _hold_push(wt_path, sha)

    push = subprocess.run(
        ["git", "-C", str(wt_path), "push"],
        capture_output=True, text=True,
    )
    if push.returncode == 0:
        log.info("Pushed fixes")
        return CommitPushResult(sha, CommitStatus.PUSHED, "")

    # Pre-push hooks may regenerate files (e.g. proto → .pb.go, OpenAPI specs),
    # leaving uncommitted changes that cause the push to fail. Commit and retry.
    retried = _commit_regen_and_retry_push(wt_path, trail)
    if retried:
        return retried

    err = push.stderr.strip()
    _report_diverged_push(wt_path, sha, err, trail)
    return CommitPushResult(sha, CommitStatus.PUSH_FAILED, err)


def _commit_fixes(
    wt_path: Path, fixed: int, deferred: int, head_before: str,
    trail: Trail | None = None,
) -> CommitPushResult:
    """Commit the pass's work, and recover a commit the agent made itself.

    A hold does not reach this far, and that is deliberate: a local commit
    asserts nothing to a reviewer, because it only becomes visible on
    push and the push is what the hold stops. Leaving the fixes uncommitted
    instead would make them fragile, and would leave the next `--fix` round
    reading its own dirty tree as a refused commit.
    """
    cp = _commit_and_push(wt_path, fixed, deferred, trail=trail)
    if cp.status in (CommitStatus.NO_CHANGES, CommitStatus.COMMIT_FAILED):
        cp = _recover_agent_commit(wt_path, head_before, trail, prior=cp)
    return cp


def _our_last_reply_id(thread: ReportThread | None) -> int | None:
    """The ID of our own reply when it is still the last comment, else None.

    Editing is only safe while nobody has answered us: rewriting a comment a
    reviewer has already replied to changes the text their reply responds to.
    Authorship of the last comment is therefore the whole test, and resolution
    is orthogonal to it — a resolved thread whose last comment is ours still
    has one standing reply to revise.

    ThreadState.ADDRESSED cannot stand in for that: compute_thread_state
    returns RESOLVED for any resolved thread before it looks at who spoke
    last, and `--finish --post` resolves every thread it replies to. Reading
    the state instead of the comments stacked a second reply on exactly the
    threads the one-reply-per-thread rule is for.

    The length guard covers self-review, where the thread root is our own
    comment — editing that would rewrite the review point instead of our
    answer to it.
    """
    if not thread or len(thread.comments) < 2:
        return None
    if not pc.last_comment_is_mine(thread.comments, thread.my_login):
        return None
    return thread.comments[-1].get("databaseId")


def _upsert_thread_reply(
    thread: ReportThread, repo: str, pr_number: int, body: str, existing_id: int | None,
) -> bool:
    """Replace our standing reply on a thread, or post the first one."""
    if existing_id:
        return pc.patch_thread_reply(repo, existing_id, body)
    root_id = thread.comments[0].get("databaseId")
    if not root_id:
        return False
    return pc.post_thread_reply(repo, pr_number, root_id, body)


def _is_generated_reply(body: str) -> bool:
    """Whether a standing reply is still one of ours, in template shape.

    The upsert replaces our standing reply wholesale, and the fix queue
    re-drains every fixed thread on later rounds — so a reply someone rewrote
    by hand, with reasoning or an explicit decision not to do what the reviewer
    asked, would otherwise be overwritten by the three-line template with no
    undo but the edit history.

    Divergence is measured against the template rather than tracked by round
    number: the round a reply was written in says nothing about whether it is
    still ours. Regenerating an identical body is harmless; replacing a
    divergent one is not.

    ceiling: a hand edit still reads as generated when it stays inside the
    template's own free text — prose in the opening paragraph, or a trailing
    sentence that happens to start with one of the followup openings. Tightening
    the followup pattern is not the fix, since the linkless generated shapes
    would stop matching and their replies could never be updated again. Add an
    HTML marker to generated bodies and key off that if either case ever costs
    someone a reply.
    """
    paragraphs = [p.strip() for p in body.strip().split("\n\n") if p.strip()]
    if not paragraphs or not paragraphs[0].startswith(_GENERATED_REPLY_PREFIXES):
        return False
    return all(_GENERATED_FOLLOWUP_RE.fullmatch(p) for p in paragraphs[1:])


def _post_thread_replies(
    entries: list[CommentItem],
    threads_by_id: dict[str, ReportThread],
    repo: str,
    pr_number: int,
    body_fn: Callable[[CommentItem], str],
) -> int:
    """Leave one reply per thread, building each body with body_fn.

    Whichever verdict a round reaches, it lands in the same place: our standing
    reply on that thread, replaced — unless a human has rewritten that reply,
    in which case the thread is left alone. Returns the number replied to.
    """
    replied = 0
    edited = 0
    kept = 0
    for entry in entries:
        thread = threads_by_id.get(entry.id)
        if not thread or not thread.comments:
            continue
        existing_id = _our_last_reply_id(thread)
        if existing_id and not _is_generated_reply(str(thread.comments[-1].get("body", ""))):
            log.warn(f"{entry.id}: standing reply was hand-written — leaving it alone")
            kept += 1
            continue
        # ceiling: thread.comments is not refreshed after a post, so two replies
        # to one thread within a single run would still stack. Unreachable while
        # the reply categories stay a partition of the triage verdicts; refetch
        # the thread here if that ever stops holding.
        if not _upsert_thread_reply(thread, repo, pr_number, body_fn(entry), existing_id):
            continue
        replied += 1
        edited += existing_id is not None
    if edited:
        log.info(f"Edited {edited} standing repl{'y' if edited == 1 else 'ies'} in place")
    if kept:
        log.info(
            f"Left {kept} hand-written repl{'y' if kept == 1 else 'ies'} untouched "
            f"— use --reply <id> --body-file <f> to replace one deliberately"
        )
    return replied


def _post_fix_replies(
    fixed: list[CommentItem],
    threads_by_id: dict[str, ReportThread],
    repo: str,
    pr_number: int,
    commit_sha: str,
) -> int:
    """Post replies to each fixed thread. Returns count of replies posted.

    `commit_sha` covers the entries this pass just fixed. An entry replayed from
    state carries the commit that actually fixed it, which may be several rounds
    old — see `_entry_commit_sha`.
    """
    def body_fn(entry: CommentItem) -> str:
        sha = _entry_commit_sha(entry, commit_sha)
        parts = [
            f"{_APPLIED_REPLY_PREFIX} {entry.summary}",
            f"Fixed in [`{sha}`](https://github.com/{repo}/commit/{sha}).",
        ]
        # The file, not the line: the fix has just moved the lines around it,
        # and pointing a reviewer at the wrong line is worse than pointing them
        # at the file the change landed in.
        if entry.file:
            url = _blob_permalink(repo, sha, entry.file)
            parts.append(f"Result is in [`{entry.file}`]({url}).")
        return "\n\n".join(parts)

    posted = _post_thread_replies(fixed, threads_by_id, repo, pr_number, body_fn)
    if posted:
        log.info(f"Replied on {posted} fixed thread(s)")
    return posted


def _entry_commit_sha(
    entry: CommentItem | pr_state.ThreadOutcome, pass_sha: str = "",
) -> str:
    """The commit that fixed this entry, preferring the entry's own record.

    `pass_sha` describes the pass running now. An entry replayed from state may
    have been fixed rounds ago by a different commit, so its own SHA wins and
    the pass-level one is only a fallback for an entry that has none.

    Shared by the summary row and the thread reply on purpose: they were two
    implementations of the same attribution, and only the summary's was right —
    the reply pinned every round's `Fixed in` line, and every blob permalink
    beneath it, to whatever the latest pass had committed.
    """
    return getattr(entry, "commit_sha", "") or pass_sha


def _blob_permalink(repo: str, sha: str, filepath: str, line: int = 0) -> str:
    """A blob URL pinned to a SHA, so the link still points at the cited code.

    Branch-relative blob URLs drift as the branch moves; a claim posted to a
    reviewer has to survive the next push. Omit line for a whole-file link.
    """
    url = f"https://github.com/{repo}/blob/{sha}/{filepath}"
    return f"{url}#L{line}" if line else url


def _evidence_link(entry: CommentItem, repo: str, sha: str) -> str:
    """Render an entry's cited location as a markdown link, or "" if uncited."""
    if not entry.has_evidence() or not sha:
        return ""
    url = _blob_permalink(repo, sha, entry.evidence_file, entry.evidence_line)
    return f"[`{entry.evidence_file}:{entry.evidence_line}`]({url})"


def _code_link(
    entry: CommentItem, repo: str, sha: str, repo_dir: Path | None = None,
) -> str:
    """Link the code an entry is about, or "" when there is nothing to point at.

    Triage's citation is the better anchor where there is one, but entries
    rebuilt from stored thread records carry no citation at all.  Those still
    have the review comment's own file and line, which always resolve — GitHub
    anchored the thread there — so a reply is never left asserting something
    with no link behind it.
    """
    if entry.has_evidence() and (repo_dir is None or _evidence_is_real(repo_dir, entry)):
        link = _evidence_link(entry, repo, sha)
        if link:
            return link
    if not entry.file or not sha:
        return ""
    url = _blob_permalink(repo, sha, entry.file, entry.line)
    label = f"{entry.file}:{entry.line}" if entry.line else entry.file
    return f"[`{label}`]({url})"


def _find_addressing_commit(wt_path: Path, filepath: str) -> str | None:
    """Find the most recent branch commit that modified a file."""
    base = f"origin/{_resolve_default_branch(wt_path)}"
    result = subprocess.run(
        ["git", "-C", str(wt_path), "log", "-1", "--format=%H",
         f"{base}..HEAD", "--", filepath],
        capture_output=True, text=True,
    )
    sha = result.stdout.strip()
    return sha if sha else None


def _post_already_addressed_replies(
    fixed: list[CommentItem],
    threads_by_id: dict[str, ReportThread],
    repo: str,
    pr_number: int,
    wt_path: Path,
) -> int:
    """Post replies to threads already addressed in the current code. Returns count posted."""
    commit_cache: dict[str, str | None] = {}
    head_sha = _get_head_sha(wt_path)

    def body_fn(entry: CommentItem) -> str:
        if entry.file not in commit_cache:
            commit_cache[entry.file] = _find_addressing_commit(wt_path, entry.file)
        sha = commit_cache[entry.file]
        # The line was read at HEAD, so that is the tree the link has to pin to;
        # the addressing commit answers "when", not "where".
        parts = [f"{_ADDRESSED_REPLY_PREFIX}: {entry.summary}"]
        # No repo_dir: _downgrade_unsupported_verdicts already refused to let an
        # already_addressed verdict through without a citation that resolves.
        # Checking again here would only overrule it with a weaker link.
        link = _code_link(entry, repo, head_sha)
        if link:
            parts.append(f"Current behaviour is at {link}.")
        if sha:
            commit_url = f"https://github.com/{repo}/commit/{sha}"
            parts.append(f"Addressed in [`{sha[:7]}`]({commit_url}).")
        if len(parts) == 1:
            return (
                f"{_ADDRESSED_REPLY_PREFIX} in the current implementation: "
                f"{entry.summary}"
            )
        return "\n\n".join(parts)

    posted = _post_thread_replies(fixed, threads_by_id, repo, pr_number, body_fn)
    if posted:
        log.info(f"Replied on {posted} already-addressed thread(s)")
    return posted


def _post_dismissed_replies(
    dismissed: list[CommentItem],
    threads_by_id: dict[str, ReportThread],
    repo: str,
    pr_number: int,
    wt_path: Path,
) -> int:
    """Post replies to invalid suggestion threads. Returns count posted.

    Reserved for suggestions whose premise does not hold.  A suggestion the code
    already satisfies is not dismissed — it goes through
    _post_already_addressed_replies, which credits the reviewer instead of
    telling them their point did not apply.

    Telling a reviewer they misread the code is the one reply that most needs a
    line to point at, so the dismissal carries the permalink triage cited.
    """
    head_sha = _get_head_sha(wt_path)

    def body_fn(entry: CommentItem) -> str:
        reasoning = entry.reasoning
        body = _DISMISSED_REPLY_PREFIX
        body = f"{body}: {reasoning}" if reasoning else f"{body}."
        link = _evidence_link(entry, repo, head_sha)
        return f"{body}\n\nSee {link}." if link else body

    posted = _post_thread_replies(dismissed, threads_by_id, repo, pr_number, body_fn)
    if posted:
        log.info(f"Dismissed {posted} invalid suggestion(s)")
    return posted


def _post_deferred_replies(
    deferred: list[CommentItem],
    threads_by_id: dict[str, ReportThread],
    repo: str,
    pr_number: int,
    issue_id: str,
    issue_url: str,
    wt_path: Path | None = None,
) -> int:
    """Post replies to deferred threads linking the tracking issue."""
    issue_ref = f"[{issue_id}]({issue_url})" if issue_url else issue_id
    head_sha = _get_head_sha(wt_path) if wt_path else ""

    def body_fn(entry: CommentItem) -> str:
        parts = [f"{_DEFERRED_REPLY_PREFIX} {entry.summary}",
                 f"Tracked in {issue_ref}."]
        # A deferral says the code still stands as the reviewer found it, which
        # is a claim about the tree like any other — pin it.
        link = _code_link(entry, repo, head_sha, wt_path)
        if link:
            parts.append(f"Unchanged at {link}.")
        return "\n\n".join(parts)

    posted = _post_thread_replies(deferred, threads_by_id, repo, pr_number, body_fn)
    if posted:
        log.info(f"Replied on {posted} deferred thread(s)")
    return posted


_NO_ISSUE = CreatedIssue()


class _TrackAll(frozenset):
    """Sentinel for --track-all: every id is selected.

    A frozenset subclass rather than a truthy string so `t.id in track` reads
    the same for the ordinary per-thread case and this one.
    """

    def __contains__(self, item) -> bool:
        return True

    def __bool__(self) -> bool:
        # Inherited from frozenset, this would be False: the instance holds no
        # elements. It selects every id, so reporting itself as empty is the
        # opposite of the truth for anyone who asks.
        return True


TRACK_ALL = _TrackAll()


def _validate_track(state: pr_state.PRState, track) -> None:
    """Exit if --track named anything that is not a deferred thread.

    A typo'd id would otherwise be indistinguishable from a thread the tool
    chose not to file, and the user would read "filed nothing" as agreement.
    """
    if track is TRACK_ALL:
        return
    FA = pr_state.ThreadAction
    deferred_ids = {t.id for t in state.fix.threads if t.action == FA.DEFERRED}
    unknown = set(track) - deferred_ids
    if unknown:
        log.error(f"--track named threads that are not deferred: {sorted(unknown)}")
        sys.exit(1)


def _finalize_deferred(
    state: pr_state.PRState,
    ctx: pr_context.ResolvedContext,
    threads_by_id: dict,
    trail: Trail | None = None,
    *,
    track=frozenset(),
) -> CreatedIssue:
    """Create tracking issue and post deferred replies for threads named by --track.

    Mutates `state` and leaves the save to the caller, which mutates the same
    object either side of this call. Reading the file again here and saving
    that copy would drop whatever the caller had already written.

    `track` defaults to selecting nothing. Filing a thread on the tracking
    issue posts a reply, under the PR author's name, saying a reviewer's
    finding was triaged and postponed — a deferral is a decision someone makes
    per thread, never the fallback disposition for whatever a fix pass failed
    to fix.
    """
    if not state.fix.threads:
        return _NO_ISSUE

    _validate_track(state, track)

    FA = pr_state.ThreadAction
    # `reason` carries why the thread was held back, and it is the only column
    # in the tracking issue that distinguishes an agent that gave up from a
    # decision anyone made. Rebuilding the item without it renders every row
    # blank.
    deferred = [
        CommentItem(
            id=t.id, file=t.file, line=t.line,
            reviewer=t.reviewer, summary=t.summary, reason=t.reason,
        )
        for t in state.fix.threads
        if t.action == FA.DEFERRED and t.id in track
    ]
    if not deferred:
        return _NO_ISSUE

    pr_number = ctx.pr_number
    if not pr_number:
        return _NO_ISSUE

    issue = _create_or_update_deferred_issue(
        deferred, ctx.repo, pr_number, threads_by_id,
        ctx, state.fix.deferred_issue_id, trail,
        state.fix.deferred_issue_url,
    )

    if issue.id:
        _post_deferred_replies(
            deferred, threads_by_id, ctx.repo, pr_number,
            issue.id, issue.url, ctx.require_worktree(),
        )

    state.fix.deferred_issue_id = issue.id
    state.fix.deferred_issue_url = issue.url
    return issue


def _report_unfiled_deferrals(state: pr_state.PRState, track) -> None:
    """Name the deferrals nobody asked to file, so the omission is visible.

    Filing nothing is the correct default, but a silent nothing reads as "there
    was nothing to file". List the ids so the user can pass the ones they meant.

    Membership, not truthiness: a partial selection leaves the unnamed threads
    just as unfiled as no selection does, and they are the easiest ones to lose
    — the run reports success for the few that were named.
    """
    FA = pr_state.ThreadAction
    still = [
        t for t in state.fix.threads
        if t.action == FA.DEFERRED and t.id not in track
    ]
    if not still:
        return
    log.info(
        f"{len(still)} deferred thread(s) not filed — pass --track <id> for "
        f"each one to track, or --track-all: {', '.join(t.id for t in still)}"
    )


def _warn_if_snapshot_stale(state: pr_state.PRState, wt_path: Path) -> None:
    """Say so when the snapshot describes a tree that is no longer checked out.

    A warning rather than a refusal: reconciliation below re-derives every
    deferral from GitHub, and refusing outright would break the ordinary case
    of committing and then closing out. A snapshot with no recorded HEAD
    predates the field and cannot be vouched for either way, so it counts.
    """
    if not state.fix.threads:
        return
    current = _get_head_sha(wt_path)
    if state.fix.head_sha and state.fix.head_sha == current:
        return
    log.warn(
        f"Fix snapshot was taken at {state.fix.head_sha or '(unrecorded)'} "
        f"but HEAD is {current or '(unknown)'} — reconciling against GitHub"
    )


# Replies that say the thread was handled. _DEFERRED_REPLY_PREFIX is
# deliberately absent: it says the opposite, and counting it would make every
# thread reconcile itself on the second --finish.
_HANDLED_REPLY_PREFIXES = (
    _APPLIED_REPLY_PREFIX,
    _ADDRESSED_REPLY_PREFIX,
    _DISMISSED_REPLY_PREFIX,
)

# Reason stamped on an outcome the fix pass never landed. Read back by
# _fixed_status_for, which must not credit the pass's commit for it.
_RECONCILED_REASON = "reconciled: handled outside the fix pass"

# The two status cells that decline to name a commit. Both exist because the
# alternative is a confident wrong claim: the pass either knows someone else
# landed the work, or knows only that it cannot say who did.
_RECONCILED_STATUS_TEXT = "Addressed outside the fix pass"
_UNATTRIBUTED_STATUS_TEXT = "Fix applied (commit not recorded)"


def _thread_looks_handled(thread: ReportThread | None) -> bool:
    """True when GitHub shows this thread as dealt with, by anyone.

    Resolution is the strong signal, but a thread can be answered and left open
    for the reviewer to close. Both count: what disqualifies a thread from being
    reported as deferred is evidence that someone acted on it.
    """
    if not thread:
        return False
    if thread.is_resolved or thread.state in (ThreadState.RESOLVED, ThreadState.ADDRESSED):
        return True
    return any(
        str(c.get("body", "")).startswith(_HANDLED_REPLY_PREFIXES)
        for c in thread.comments
    )


def _finding_location(
    entry: CommentItem | pr_state.ThreadOutcome | ReportThread,
) -> str:
    """Reviewer and code location of an entry, or "" when it has neither.

    The join key between a review thread and a decomposed comment item that
    restates it. Both halves are required: a file on its own is too coarse to
    call two findings the same point, and two reviewers writing about one line
    are writing about two different things.

    Every use of the heuristic reads the tradeoff below: `_duplicate_item_ids`
    folds the pair out of a fresh render, and `_row_location_key` recovers the
    same key from an already-rendered row so `_carried_over_rows` does not
    reinstate a row this render folded.
    """
    # ceiling: reviewer plus file:line is the whole test for "the same point",
    # so two distinct findings by one reviewer on one line fold into one row —
    # and, read off a published row instead of an entry, a colliding row is
    # dropped from the carried-over set rather than preserved.
    # Upgrade trigger: once a reviewer's separate findings on a single line are
    # seen collapsing, compare the summaries too rather than the location alone.
    line = getattr(entry, "line", 0) or 0
    if not entry.file or not line:
        return ""
    return f"{entry.reviewer}|{entry.file}:{line}"


# The id in a permalink back to a top-level comment. Capturing, unlike
# _ROW_ANCHOR_RE below, because the id is the whole point here.
_SOURCE_ANCHOR_RE = re.compile(r"#(?:issuecomment|pullrequestreview)-(\d+)")


def _answered_comment_sources(
    outcomes: list[pr_state.ThreadOutcome],
    repo: str, pr_number: int, my_login: str,
) -> frozenset[str]:
    """Source comment ids our standing reply on the PR reports as handled.

    A decomposed comment item has no review thread, so `_thread_looks_handled`
    has nothing to read for one: the item is a fragment of a top-level comment,
    and a top-level comment carries no thread of its own. What it does carry is
    a reply of ours further down the PR citing its permalink — the same evidence
    a thread reply is, on the only surface the source has.

    Costs one listing, and only when the snapshot holds an unsettled item that
    such a reply could settle.
    """
    FA = pr_state.ThreadAction
    unsettled = (FA.DEFERRED, FA.NEEDS_HUMAN)
    if not any(
        o.action in unsettled and _comment_item_source(o).ok for o in outcomes
    ):
        return frozenset()
    if not my_login:
        # Without a login there is no telling our reply from the reviewer
        # restating their own point, and reading theirs as an answer would
        # settle the item on the strength of the complaint.
        log.warn(
            "Cannot identify our own comments — leaving comment items unreconciled"
        )
        return frozenset()
    mine = my_login.lower()
    # include_self, because the reply being looked for is ours and the listing
    # drops our own comments by default.
    answered: set[str] = set()
    for comment in pc.fetch_issue_comments(
        repo, pr_number, my_login, include_self=True,
    ):
        if str(comment.get("user", "")).lower() != mine:
            continue
        body = str(comment.get("body", ""))
        if not body.startswith(_HANDLED_REPLY_PREFIXES):
            continue
        answered.update(m.group(1) for m in _SOURCE_ANCHOR_RE.finditer(body))
    return frozenset(answered)


def _entry_looks_handled(
    outcome: pr_state.ThreadOutcome,
    threads_by_id: dict[str, ReportThread],
    answered_sources: frozenset[str],
    handled_locations: set[str],
) -> bool:
    """True when GitHub shows this snapshot row as dealt with, by anyone.

    Two kinds of row reach here. A review thread carries its own evidence and is
    read directly. A comment item has none to carry — looking its synthetic id
    up among review threads can only ever miss — so it is settled either by its
    source comment having been answered, or by a review thread saying the same
    thing about the same line being settled: triage decomposes a top-level
    comment without knowing which of its points an inline thread already covers.
    """
    thread = threads_by_id.get(outcome.id)
    if thread:
        return _thread_looks_handled(thread)
    source = _comment_item_source(outcome)
    if not source.ok:
        return False
    if source.id in answered_sources:
        return True
    return _finding_location(outcome) in handled_locations


def _reconcile_fix_snapshot(
    state: pr_state.PRState, threads_by_id: dict[str, ReportThread],
    answered_sources: frozenset[str] = frozenset(),
) -> int:
    """Flip snapshot outcomes that GitHub contradicts. Returns the flip count.

    The snapshot records what one fix pass concluded, and `FixSummary.merge_into`
    accumulates it across rounds without ever expiring an outcome. Work done by
    hand in between never passes through it, so a thread fixed outside the tool
    stays DEFERRED forever. Publishing that is a false claim about someone's
    code, so GitHub is consulted before anything is written.

    NEEDS_HUMAN is the same problem under another name, and a worse case of it:
    that outcome exists precisely because the pass handed the thread to the
    operator, so the operator settling it is the expected ending, not an
    exception. Reporting it as still awaiting discussion after it has been
    answered and pushed is the claim this is here to prevent.

    `answered_sources` is what GitHub said about the top-level comments behind
    the decomposed items — see `_answered_comment_sources`. It defaults to
    nothing asked, which is the honest reading for a caller that consulted only
    the review threads.
    """
    FA = pr_state.ThreadAction
    unsettled = (FA.DEFERRED, FA.NEEDS_HUMAN)
    handled_locations = {
        _finding_location(t) for t in threads_by_id.values()
        if _thread_looks_handled(t)
    } - {""}
    flipped = 0
    for outcome in state.fix.threads:
        if outcome.action not in unsettled:
            continue
        if not _entry_looks_handled(
            outcome, threads_by_id, answered_sources, handled_locations,
        ):
            continue
        outcome.action = FA.FIXED
        outcome.reason = _RECONCILED_REASON
        flipped += 1
    if flipped:
        log.info(f"Reconciled {flipped} stale outcome(s) against GitHub")
    return flipped


def _finish_deferred_work(
    ctx: pr_context.ResolvedContext,
    report: PRReport,
    trail: Trail | None = None,
    *,
    track=frozenset(),
) -> None:
    """Close out what the fix pass held back: replies, tracking issue, summary.

    A phase of its own rather than a tail of `--fix`, because the summary is
    withheld until the needs_human threads have been discussed — which by
    definition has not happened while the fix pass is still running.

    Reads state from disk rather than taking the caller's copy: the fix pass
    writes its outcomes there, so a copy read before it ran would be missing
    exactly the threads this phase exists to close out.
    """
    wt_path = ctx.require_worktree()
    if not ctx.pr_number:
        return
    state = pr_state.load_state(ctx.target_dir)
    if state is None:
        return
    threads_by_id = {t.id: t for t in report.threads}
    _push_held_commit(state, wt_path, trail)
    _post_pending_fix_replies(state, ctx.repo, ctx.pr_number, threads_by_id)
    _warn_if_snapshot_stale(state, wt_path)
    _reconcile_fix_snapshot(state, threads_by_id, _answered_comment_sources(
        state.fix.threads, ctx.repo, ctx.pr_number, report.my_login,
    ))
    _finalize_deferred(state, ctx, threads_by_id, trail=trail, track=track)
    _report_unfiled_deferrals(state, track)
    _render_deferred_summary(
        state, report, ctx.repo, ctx.pr_number, threads_by_id,
    )
    pr_state.save_state(ctx.target_dir, state)


def _push_held_commit(
    state: pr_state.PRState, wt_path: Path, trail: Trail | None = None,
) -> None:
    """Send the commit the fix pass kept local, now that a run says publish.

    The fix pass holds the push whenever a thread is still awaiting discussion,
    so `--fix --post` alone can never land those fixes on the remote. Clearing
    that takes a second, deliberate `--finish --post` — a human having read the
    open thread and said go. Everything downstream in --finish cites the commit,
    so this runs first: the replies and the summary are only allowed out once
    the SHA they link to is somewhere the reviewer can follow it.
    """
    fix = state.fix
    if not fix.commit_sha or not _commit_unpushed(fix.commit_status):
        return

    if _is_pushed(wt_path, fix.commit_sha):
        fix.commit_status = CommitStatus.PUSHED
        return

    if not publishing.enabled():
        publishing.draft("push", f"git -C '{wt_path}' push")
        return

    push = subprocess.run(
        ["git", "-C", str(wt_path), "push"],
        capture_output=True, text=True,
    )
    if push.returncode != 0:
        _report_diverged_push(wt_path, fix.commit_sha, push.stderr.strip(), trail)
        fix.commit_status = CommitStatus.PUSH_FAILED
        return

    log.info(f"Pushed held fixes ({fix.commit_sha})")
    fix.commit_status = CommitStatus.PUSHED


def _resolve_fixed_threads(
    fixed: list[CommentItem],
    threads_by_id: dict[str, ReportThread],
) -> int:
    """Resolve fixed threads on GitHub. Returns count resolved.

    Entries absent from threads_by_id are silently skipped — they are either
    comment items with synthetic IDs (ic-…/rb-…) that are not real review
    threads, or items added by callers for a different purpose.  Do not add
    comment items to `fixed` expecting them to be resolved here.
    """
    resolved = 0
    for entry in fixed:
        thread = threads_by_id.get(entry.id)
        if thread is None:
            continue
        if thread.is_resolved:
            continue
        if pc.resolve_thread(entry.id):
            resolved += 1
    if resolved:
        log.info(f"Resolved {resolved} fixed thread(s)")
    return resolved


def _build_deferred_issue_body(
    deferred: list[CommentItem],
    repo: str,
    pr_number: int,
    threads_by_id: dict[str, ReportThread],
) -> str:
    """Build markdown description for the deferred threads tracking issue."""
    pr_url = f"https://github.com/{repo}/pull/{pr_number}"
    parts = [
        f"## Deferred Review Comments — [PR #{pr_number}]({pr_url})",
        "",
        "| Thread | File | Reason |",
        "|--------|------|--------|",
    ]
    for entry in deferred:
        summary = entry.summary or "—"
        permalink = _thread_permalink(entry, threads_by_id, repo, pr_number)
        thread_cell = f"[{summary}]({permalink})" if permalink else summary
        file_cell = f"`{entry.file}:{entry.line}`" if entry.file else "—"
        reason = entry.reason or "—"
        parts.append(f"| {thread_cell} | {file_cell} | {reason} |")
    parts.append("")
    return "\n".join(parts)


def _update_deferred_issue(
    provider: str, issue_id: str, body: str, repo: str, opts: dict | None,
) -> CreatedIssue:
    ok = review_issue.update_issue(provider, issue_id, body, repo=repo, opts=opts)
    if not ok:
        log.error(f"Failed to update deferred issue {issue_id}")
        return CreatedIssue(id=issue_id)
    url = review_issue.get_issue_url(provider, issue_id)
    return CreatedIssue(id=issue_id, url=url)


def _create_deferred_issue(
    provider: str,
    body: str,
    ctx: pr_context.ResolvedContext,
    repo: str,
    pr_number: int,
    opts: dict | None,
    trail: Trail | None,
) -> CreatedIssue:
    parent_id = review_issue.extract_issue_id(provider, ctx.branch)
    # The configured team wins over the one implied by the branch: it is
    # what the repo declared, while the branch prefix is an inference from
    # whatever issue happened to name it.
    team = (opts or {}).get("team", "")
    if not team and parent_id and "-" in parent_id:
        team = parent_id.split("-", 1)[0]
    if not team and review_issue.needs_team_key(provider):
        log.dim(f"Cannot determine team key for {provider} issue creation — skipping")
        if trail:
            trail.info("deferred_issue", "skipped — no team key")
        return CreatedIssue()

    title = f"fix(review): deferred review comments — PR #{pr_number}"
    created = review_issue.create_issue(
        provider, team, title, body, parent_id=parent_id, repo=repo, opts=opts,
    )
    if not created:
        log.error("Failed to create deferred tracking issue")
        if trail:
            trail.error("deferred_issue", "creation failed")
        return CreatedIssue()

    if trail:
        trail.info("deferred_issue", f"created {created.id}", data={"url": created.url})
    return created


def _create_or_update_deferred_issue(
    deferred: list[CommentItem],
    repo: str,
    pr_number: int,
    threads_by_id: dict[str, ReportThread],
    ctx: pr_context.ResolvedContext,
    existing_issue_id: str,
    trail: Trail | None,
    existing_issue_url: str = "",
) -> CreatedIssue:
    """Create or update the deferred threads tracking issue."""
    if not deferred:
        return CreatedIssue(id=existing_issue_id)

    worktree = str(ctx.require_worktree())
    publishing_open = publishing.enabled()
    # A draft run files nothing — create_issue gates on publishing.enabled() —
    # so asking which tracker to file to would be a question with no consequence.
    if publishing_open:
        provider_info = review_issue.ensure_issue_provider(worktree)
    else:
        provider_info = review_issue.load_issue_provider(worktree)
    if not provider_info.resolved:
        # ensure_issue_provider has already said why. Recording it on the trail
        # is what puts the undelivered closeout in `pr status` rather than
        # leaving the queue looking filed. Not an error while the gate is
        # closed, though: with nothing configured to file to, a draft run
        # has failed at nothing it would otherwise have attempted.
        if trail and publishing_open:
            trail.error("deferred_issue", "no issue tracker configured")
        elif trail:
            trail.info("deferred_issue", "skipped — no issue tracker configured")
        return CreatedIssue()
    provider = provider_info.name

    body = _build_deferred_issue_body(deferred, repo, pr_number, threads_by_id)

    if existing_issue_id:
        issue = _update_deferred_issue(
            provider, existing_issue_id, body, repo, provider_info.options,
        )
        return CreatedIssue(id=issue.id, url=issue.url or existing_issue_url)

    return _create_deferred_issue(provider, body, ctx, repo, pr_number, provider_info.options, trail)


def _fixed_status_for(
    entry: CommentItem | pr_state.ThreadOutcome, cp: CommitPushResult, repo: str,
) -> str:
    """Status cell for one fixed row, preferring the thread's own commit.

    `cp` describes the pass that is running now; a ThreadOutcome replayed from
    state may have been fixed several rounds ago by a different commit. Its own
    SHA is the accurate attribution, and the pass-level text — including
    "no commit needed" — is only right for a row that has none.

    Reachable only from `_render_deferred_summary`, which refuses to post while
    a recorded commit is still unpushed, so the commit link cannot 404.
    """
    sha = _entry_commit_sha(entry)
    if sha:
        return f"Fixed in [`{sha}`](https://github.com/{repo}/commit/{sha})"
    # Reconciled outcomes were handled by hand or by the reviewer, and the
    # commit that did it is not recorded anywhere. Falling through would credit
    # the pass's commit for work it never did.
    if getattr(entry, "reason", "") == _RECONCILED_REASON:
        return _RECONCILED_STATUS_TEXT
    return _fixed_status_text(cp, repo)


def _fixed_status_text(cp: CommitPushResult, repo: str) -> str:
    """Human-readable status for fixed threads in the summary table."""
    if cp.sha and cp.status == CommitStatus.PUSHED:
        url = f"https://github.com/{repo}/commit/{cp.sha}"
        return f"Fixed in [`{cp.sha}`]({url})"
    if cp.status == CommitStatus.NO_CHANGES:
        # "A fix was applied" and "nothing was committed" contradict each other,
        # and which half is wrong is not knowable from here — a hook may have
        # rejected the commit, or the edit may have been a no-op. Publishing the
        # confident reading ("no commit needed") over a rejected commit asserts
        # more than is known, so the cell states only what is certain.
        return _UNATTRIBUTED_STATUS_TEXT
    if cp.status == CommitStatus.COMMIT_FAILED:
        return "Fix applied (commit failed — pre-commit hook?)"
    if cp.status == CommitStatus.RECONCILED:
        return _RECONCILED_STATUS_TEXT
    # Both callers refuse to render an unpushed commit, so these two are not
    # reachable today. They are spelled out anyway: the fallback below reads as
    # "not done yet", which would be a false claim about a commit that exists
    # and is only waiting to be published.
    if cp.status == CommitStatus.PUSH_HELD:
        return "Fix committed locally (push held pending discussion)"
    if cp.status == CommitStatus.PUSH_FAILED:
        return "Fix committed locally (push failed)"
    return "Fix pending"


def _warn_unattributed_fixes(fixed: list, cp: CommitPushResult) -> None:
    """Say so when rows claim fixes that no commit accounts for.

    The contradiction is caught rather than rendered silently: the summary goes
    out under the operator's name, and a row that asserts both halves is a claim
    about their branch that nothing in the run supports.
    """
    if cp.sha or not fixed:
        return
    if cp.status not in (CommitStatus.NO_CHANGES, CommitStatus.COMMIT_FAILED):
        return
    orphans = [e for e in fixed if not getattr(e, "commit_sha", "")]
    if not orphans:
        return
    log.warn(
        f"{len(orphans)} fixed row(s) have no commit to attribute them to "
        f"(commit status: {cp.status}) — rendering them without a claim"
    )


@dataclass(frozen=True)
class CommentSource:
    """The top-level comment a decomposed item was split out of.

    Empty for anything that is not such an item — a review thread's id parses to
    no source at all — and `ok` is how a caller asks which it got. A type with a
    predicate rather than a pair of strings because "is this a comment item"
    and "which comment" are asked together everywhere they are asked.
    """

    type: str = ""
    id: str = ""

    @property
    def ok(self) -> bool:
        return bool(self.id)

    def permalink(self, repo: str, pr_number: int) -> str | None:
        """The anchor a reader follows back to the comment, or None."""
        if not self.ok:
            return None
        base = f"https://github.com/{repo}/pull/{pr_number}"
        if self.type == "issue_comment":
            return f"{base}#issuecomment-{self.id}"
        if self.type == "review_body":
            return f"{base}#pullrequestreview-{self.id}"
        return None


def _comment_item_source(
    entry: CommentItem | pr_state.ThreadOutcome,
) -> CommentSource:
    """The comment a decomposed item came from, empty when it is not one."""
    source_id = getattr(entry, "source_id", "")
    source_type = getattr(entry, "source_type", "")
    if not source_id and not source_type:
        # ThreadOutcome — parse synthetic id (ic-{source_id}-{index} or rb-{source_id}-{index})
        eid = entry.id
        if eid.startswith("ic-"):
            source_type = "issue_comment"
            source_id = "-".join(eid.split("-")[1:-1])
        elif eid.startswith("rb-"):
            source_type = "review_body"
            source_id = "-".join(eid.split("-")[1:-1])
    return CommentSource(source_type, source_id)


def _comment_item_permalink(
    entry: CommentItem | pr_state.ThreadOutcome,
    repo: str, pr_number: int,
) -> str | None:
    """Build a permalink for a decomposed comment item from its source comment."""
    return _comment_item_source(entry).permalink(repo, pr_number)


def _thread_permalink(
    entry: CommentItem | pr_state.ThreadOutcome,
    threads_by_id: dict[str, ReportThread],
    repo: str, pr_number: int,
) -> str | None:
    """Build a GitHub permalink for a review thread or comment item."""
    thread = threads_by_id.get(entry.id)
    if thread and thread.comments:
        db_id = thread.comments[0].get("databaseId")
        if db_id:
            return f"https://github.com/{repo}/pull/{pr_number}#discussion_r{db_id}"
    return _comment_item_permalink(entry, repo, pr_number)


def _escape_cell(text: str) -> str:
    """Escape a literal pipe so free-form text cannot break out of its cell.

    Summaries and reasons are prose written per round, and nothing constrains
    them to avoid a pipe. One unescaped pipe shifts every later cell in the row,
    which breaks the rendered table and corrupts the key that carry-over reads
    back out of the published comment — a row whose key never matches itself
    looks new every round.
    """
    return text.replace("|", "\\|")


def _summary_cell(
    entry: CommentItem | pr_state.ThreadOutcome,
    threads_by_id: dict[str, ReportThread],
    repo: str, pr_number: int,
) -> str:
    """Thread summary as a markdown link if a permalink is available, plain text otherwise."""
    summary = _escape_cell(entry.summary or "—")
    url = _thread_permalink(entry, threads_by_id, repo, pr_number)
    if url:
        return f"[{summary}]({url})"
    return summary


def _build_row(
    entry: CommentItem | pr_state.ThreadOutcome, status: str,
    threads_by_id: dict[str, ReportThread], repo: str, pr_number: int,
    head_sha: str = "",
) -> str:
    """Build a single summary table row for a thread entry.

    The file cell is a permalink whenever a SHA is known — every claim the table
    makes should be one line away from the code that backs it.
    """
    summary = _summary_cell(entry, threads_by_id, repo, pr_number)
    reviewer = f"@{entry.reviewer}" if entry.reviewer else "—"
    if entry.file and entry.line:
        file_loc = f"`{entry.file}:{entry.line}`"
        if head_sha:
            url = _blob_permalink(repo, head_sha, entry.file, entry.line)
            file_loc = f"[{file_loc}]({url})"
    elif entry.file:
        file_loc = f"`{entry.file}`"
    else:
        file_loc = "—"
    return f"| {summary} | {reviewer} | {file_loc} | {_escape_cell(status)} |"


def _summarize_comment_body(body: str, max_len: int = 120) -> str:
    """Extract first meaningful line from a comment body, truncated."""
    in_html_comment = False
    for raw_line in body.splitlines():
        stripped = raw_line.strip()
        if in_html_comment:
            in_html_comment = "-->" not in stripped
            continue
        if stripped.startswith("<!--"):
            in_html_comment = "-->" not in stripped
            continue
        line = stripped.lstrip("#").strip()
        if not line:
            continue
        if len(line) > max_len:
            return line[:max_len - 1] + "…"
        return line
    return "(empty)"


_SummaryEntry = CommentItem | pr_state.ThreadOutcome


def _duplicate_item_ids(
    entries: list[_SummaryEntry], threads_by_id: dict[str, ReportThread],
) -> set[str]:
    """Ids of comment items a review thread in the same table already covers.

    Triage decomposes a top-level comment into items without knowing which of
    its points an inline thread already carries, so one review finding can
    arrive twice — once as a thread and once as a fragment of the comment that
    restated it. Rendering both puts one point in the table under two outcomes
    that need not agree, which reads as the summary contradicting itself. The
    thread is the copy that stays: it is where the reply lands and where
    resolution is recorded.

    What counts as "the same point" is `_finding_location`, whose ceiling
    comment names what that coarsening costs.
    """
    covered = {
        _finding_location(e) for e in entries if e.id in threads_by_id
    } - {""}
    return {
        e.id for e in entries
        if e.id not in threads_by_id
        and _comment_item_source(e).ok
        and _finding_location(e) in covered
    }


_SUMMARY_TABLE_COLUMNS = ("Thread", "Reviewer", "File", "Action")
_SUMMARY_TABLE_HEADER = f"| {' | '.join(_SUMMARY_TABLE_COLUMNS)} |"
_SUMMARY_TABLE_DIVIDER = "|" + "|".join("-" * 8 for _ in _SUMMARY_TABLE_COLUMNS) + "|"


class HumanReason(Enum):
    """Why a thread was routed to a human, in both spellings it is written in.

    `value` is the machine-readable token stamped on the entry's `reason`.
    `to_outcome` persists it as `ThreadOutcome.reason`, and a later `--finish`
    reads it back out of the state file to render the Action cell through
    `prose_for` — that round trip is why the values must stay stable. They also
    leave the process verbatim, in the stdout JSON report and the
    `publishing_hold` trail entry, but neither of those interprets them.

    `--track` and the deferral replies read neither: both work the deferred
    bucket, whose `reason` is free text ("agent could not auto-fix") and never
    a member of this enum.

    `prose` is what the summary table's Action cell shows, alongside "Already
    addressed" and "Dismissed (invalid)". One member owns both, so a token
    cannot reach the published comment the way `needs_discussion` once did.
    """

    CONTESTED = ("contested", "Contested — needs discussion")
    CONFLICTING = ("conflicting", "Conflicting reviewer feedback")
    QUESTION = ("question", "Question for the author")
    COMPLEX = ("complex", "Too complex to auto-fix")
    NEEDS_DISCUSSION = ("needs_discussion", "Needs discussion")

    def __new__(cls, value: str, prose: str) -> "HumanReason":
        obj = object.__new__(cls)
        obj._value_ = value
        obj.prose = prose
        return obj

    @classmethod
    def prose_for(cls, reason: str) -> str:
        """The Action cell text for `reason`, readable whatever it holds.

        A reason no member claims — an older state file, a hand-edited entry —
        falls back to the generic prose rather than being emitted raw, since an
        unrecognised token in a published comment is the failure this maps away.
        """
        try:
            return cls(reason).prose
        except ValueError:
            return cls.NEEDS_DISCUSSION.prose


def _build_summary_body(
    fixed: list[_SummaryEntry],
    needs_human: list[_SummaryEntry],
    deferred: list[_SummaryEntry],
    cp: CommitPushResult,
    repo: str,
    pr_number: int,
    threads_by_id: dict[str, ReportThread],
    dismissed: list[_SummaryEntry] | None = None,
    already_addressed: list[_SummaryEntry] | None = None,
    issue_comments: list[dict] | None = None,
    review_body_comments: list[dict] | None = None,
    deferred_issue_id: str = "",
    deferred_issue_url: str = "",
    has_comment_items: bool = False,
    head_sha: str = "",
    carried_over: list[str] | None = None,
) -> str:
    """Build the markdown body for the fix summary comment.

    ``carried_over`` holds rows lifted verbatim from the published comment that
    this render cannot account for — see `_carried_over_rows`. They are already
    rendered, so they are re-emitted as-is rather than round-tripped through an
    entry the state file does not have.
    """
    dismissed = dismissed or []
    already_addressed = already_addressed or []
    issue_comments = issue_comments or []
    review_body_comments = review_body_comments or []
    carried_over = carried_over or []
    # Ahead of the counts, not just the rows: a count with no row under it is a
    # claim the table cannot show the reader.
    folded = _duplicate_item_ids(
        [*fixed, *already_addressed, *dismissed, *needs_human, *deferred],
        threads_by_id,
    )
    fixed = [e for e in fixed if e.id not in folded]
    already_addressed = [e for e in already_addressed if e.id not in folded]
    dismissed = [e for e in dismissed if e.id not in folded]
    needs_human = [e for e in needs_human if e.id not in folded]
    deferred = [e for e in deferred if e.id not in folded]
    fixed_count = len(fixed)
    deferred_count = len(deferred)
    human_count = len(needs_human)
    dismissed_count = len(dismissed)
    addressed_count = len(already_addressed)
    carried_count = len(carried_over)

    parts = [_SUMMARY_MARKER, "## Review Comments Addressed", ""]
    counts = []
    if fixed_count:
        counts.append(f"**{fixed_count} fixed**")
    if addressed_count:
        counts.append(f"{addressed_count} already addressed")
    if dismissed_count:
        counts.append(f"{dismissed_count} dismissed")
    if deferred_count:
        counts.append(f"{deferred_count} deferred")
    if human_count:
        counts.append(f"{human_count} need discussion")
    if carried_count:
        counts.append(f"{carried_count} carried over")
    parts.append(" · ".join(counts))
    parts.append("")

    rows = []
    # The fix commit is the tree the table describes; fall back to the reviewed
    # head when nothing was committed.
    link_sha = cp.sha or head_sha
    for entry in fixed:
        rows.append(_build_row(
            entry, _fixed_status_for(entry, cp, repo), threads_by_id, repo,
            pr_number, getattr(entry, "commit_sha", "") or link_sha,
        ))
    for entry in already_addressed:
        rows.append(_build_row(entry, "Already addressed", threads_by_id, repo, pr_number, link_sha))
    for entry in dismissed:
        rows.append(_build_row(entry, "Dismissed (invalid)", threads_by_id, repo, pr_number, link_sha))
    for entry in needs_human:
        reason = HumanReason.prose_for(entry.reason)
        rows.append(_build_row(entry, reason, threads_by_id, repo, pr_number, link_sha))
    if deferred_issue_id and deferred_issue_url:
        deferred_status = f"Deferred → [{deferred_issue_id}]({deferred_issue_url})"
    elif deferred_issue_id:
        deferred_status = f"Deferred → {deferred_issue_id}"
    else:
        deferred_status = "Deferred"
    for entry in deferred:
        rows.append(_build_row(entry, deferred_status, threads_by_id, repo, pr_number, link_sha))
    rows.extend(carried_over)

    if rows:
        parts.append(_SUMMARY_TABLE_HEADER)
        parts.append(_SUMMARY_TABLE_DIVIDER)
        parts.extend(rows)
        parts.append("")

    if carried_count:
        parts.append(
            f"> {carried_count} row{review_common.plural(carried_count)} carried over "
            "from an earlier round that this checkout's state file does not cover."
        )
        parts.append("")

    if not has_comment_items:
        parts.extend(_render_raw_comment_sections(review_body_comments, issue_comments))

    return "\n".join(parts)


def _render_raw_comment_sections(
    review_body_comments: list[dict],
    issue_comments: list[dict],
) -> list[str]:
    """Render unseen comments as summary sections (fallback when items weren't decomposed)."""
    parts: list[str] = []
    unseen_reviews = [c for c in review_body_comments if not c.get("seen")]
    if unseen_reviews:
        parts.extend(["### Review-Level Comments", ""])
        parts.extend(_format_review_body_items(unseen_reviews))
        parts.append("")

    unseen_issue = [c for c in issue_comments if not c.get("seen")]
    if unseen_issue:
        parts.extend(["### Discussion Comments", ""])
        parts.extend(_format_issue_comment_items(unseen_issue))
        parts.append("")

    return parts


def _format_review_body_items(comments: list[dict]) -> list[str]:
    lines = []
    for c in comments:
        user = c.get("user", "unknown")
        state = c.get("state", "")
        summary = _summarize_comment_body(c.get("body", ""))
        state_badge = f" ({state})" if state else ""
        lines.append(f"- **@{user}**{state_badge}: {summary}")
    return lines


def _format_issue_comment_items(comments: list[dict]) -> list[str]:
    lines = []
    for c in comments:
        user = c.get("user", "unknown")
        summary = _summarize_comment_body(c.get("body", ""))
        lines.append(f"- **@{user}**: {summary}")
    return lines


# What identifies a rendered row across rounds. The permalink anchor is the
# only stable part: the summary text is regenerated per round and the file cell
# is pinned to whichever SHA that round rendered against.
_ROW_ANCHOR_RE = re.compile(r"#(?:discussion_r|issuecomment-|pullrequestreview-)\d+")
# The two halves of the anchor set, for telling which surface a rendered row
# came from once the entry behind it is out of reach.
_ITEM_ANCHOR_RE = re.compile(r"#(?:issuecomment|pullrequestreview)-\d+")
_THREAD_ANCHOR_RE = re.compile(r"#discussion_r\d+")
_MD_LINK_RE = re.compile(r"\[([^\]]*)\]\([^)]*\)")
_CELL_SPLIT_RE = re.compile(r"(?<!\\)\|")


def _row_cells(row: str) -> list[str]:
    """Split a rendered row into cells, honouring the escape `_escape_cell` writes."""
    return [cell.strip() for cell in _CELL_SPLIT_RE.split(row.strip().strip("|"))]


def _row_location_key(row: str) -> str:
    """Reviewer and file cell of a rendered row, stripped of decoration.

    The rendered counterpart of `_finding_location`: what two rows about one
    point at one line still share once the anchors, the pinned SHAs and the
    outcome cell are taken away. "" for a row naming no line, which can never
    establish that two rows are the same finding.

    Same coarsening, same tradeoff — see the ceiling comment on
    `_finding_location` — and one step coarser again, because a published row
    is markdown rather than a typed entry: the reviewer and file cells are all
    that survive to match on.
    """
    cells = _row_cells(row)
    if len(cells) < len(_SUMMARY_TABLE_COLUMNS):
        return ""
    location = _MD_LINK_RE.sub(r"\1", cells[2]).replace("`", "").strip()
    if ":" not in location:
        return ""
    return f"{cells[1]}|{location}"


def _summary_row_key(row: str) -> str:
    """Identity of one rendered summary row.

    Falls back to the row's own text for a row with no permalink — a comment
    item whose source could not be resolved. Link targets and backticks are
    stripped so the same entry keys the same way however it was decorated, and
    the Action cell is left out because a later round changing it (deferred to
    fixed) is exactly the case that must count as the same row.
    """
    anchor = _ROW_ANCHOR_RE.search(row)
    if anchor:
        return anchor.group(0)
    return " | ".join(
        _MD_LINK_RE.sub(r"\1", cell).replace("`", "").strip()
        for cell in _row_cells(row)[:len(_SUMMARY_TABLE_COLUMNS) - 1]
    )


def _summary_table_rows(body: str) -> list[str]:
    """The data rows of the summary table in a rendered body, in order."""
    rows = []
    for raw in body.splitlines():
        line = raw.strip()
        if not line.startswith("|"):
            continue
        if not line.strip("|-: "):
            continue
        if _row_cells(line) == list(_SUMMARY_TABLE_COLUMNS):
            continue
        rows.append(line)
    return rows


def _carried_over_rows(published: str, fresh: str) -> list[str]:
    """Rows the published summary holds that a fresh render does not.

    The summary is one comment edited in place across a review cycle, but the
    replacement body is built entirely from local state — which is per-target
    and per-worktree, and routinely absent for a round the comment already
    covers: `pr gc`, a recreated worktree, a later round run from another
    machine. Treating state as authoritative then silently deletes rounds
    nobody can recover from the comment.

    So the published comment is read as the record it is. Anything in it this
    render cannot account for is kept verbatim rather than overwritten. The
    table therefore only ever grows: a row no later render reproduces is carried
    forward for the life of the PR. That is the intended trade — a stale row a
    reader can see beats a round nobody can recover.

    The one thing that is not a lost round is a row this render folded into
    another: a comment item restating a review thread was published under its
    own anchor before `_duplicate_item_ids` started collapsing the pair, and
    carrying it forward would restore the duplicate this render just removed. A
    fresh thread row at that location accounts for it — "that location" being
    `_row_location_key`, so the ceiling on `_finding_location` bounds this too:
    an item row that collides with an unrelated fresh thread row is dropped
    rather than carried.
    """
    if not published:
        return []
    fresh_rows = _summary_table_rows(fresh)
    fresh_keys = {_summary_row_key(row) for row in fresh_rows}
    folded = {
        _row_location_key(row) for row in fresh_rows
        if _THREAD_ANCHOR_RE.search(row)
    } - {""}
    return [
        row for row in _summary_table_rows(published)
        if _summary_row_key(row) not in fresh_keys
        and not (_ITEM_ANCHOR_RE.search(row) and _row_location_key(row) in folded)
    ]


def _newest_reviewer_activity(report: PRReport) -> str:
    """The newest review or review comment on the PR that is not ours.

    Our own is excluded because the fix pass replies to threads before it
    publishes, and a run that counted its own replies would find the summary
    answered every single round.  An unknown login counts as somebody else's,
    the same way `ReportThread.my_login` reads "cannot tell" as not ours.

    Issue-level comments are not read here. `find_marker_comment` already lists
    them to locate the summary, so `MarkerComment.newest_other_at` covers them
    off that listing — and covers the bot comments the report filters out,
    which bury a summary as surely as a human's do.
    """
    mine = report.my_login.lower()
    stamps = [
        v.get("submitted_at", "") for v in report.verdicts
        if not mine or (v.get("user") or "").lower() != mine
    ]
    stamps += [
        c.get("createdAt", "")
        for thread in report.threads for c in thread.comments
        if not mine or ((c.get("author") or {}).get("login") or "").lower() != mine
    ]
    return max((s for s in stamps if s), default="")


def _summary_answered_since(existing: pc.MarkerComment, activity_at: str) -> bool:
    """Whether anything was said on the PR below the published summary.

    Editing is invisible: GitHub leaves the comment where it was posted and
    notifies nobody.  So an edit is only honest while the summary is still the
    last word — once a reviewer has answered below it, the round's outcome
    would land in a comment the reader has already scrolled past, and the round
    posts a fresh summary instead.

    A target with no timestamp keeps the in-place edit rather than guessing.
    The lookup could not read when the comment was posted, and guessing "buried"
    there would append a duplicate summary on every round for the life of the PR.
    """
    if not existing.comment_id or not existing.created_at:
        return False
    return max(existing.newest_other_at, activity_at) > existing.created_at


def _publish_summary(
    repo: str, pr_number: int, build_body: Callable[..., str],
    activity_at: str = "",
) -> str | None:
    """Publish the summary without ever shrinking what it already says.

    `build_body(carried_over=...)` renders from local state. It is called a
    second time when the published comment holds rows that render did not
    cover, because the carried rows have to reach the reader through the same
    body — the counts line and the table are one artifact, not two.

    The comment is edited in place while nothing has been said below it, and
    posted fresh once something has — see `_summary_answered_since`. Either way
    the body carries the marker and every row the published comment held, so
    the newest summary is always the complete one and the next round finds it.

    A lookup that fails outright carries nothing: `MarkerComment.body` is empty,
    so this cannot tell a comment it could not read from one that says nothing.
    `post_issue_comment` then posts rather than patching, on the standing trade
    that a duplicate comment beats a lost update — the earlier rounds stay
    readable in the comment this run could not reach.
    """
    existing = pc.find_marker_comment(repo, pr_number, _SUMMARY_MARKER)
    body = build_body(carried_over=[])
    carried = _carried_over_rows(existing.body, body)
    if carried:
        log.warn(
            f"Published summary has {len(carried)} row(s) this run cannot account "
            "for — carrying them forward rather than dropping them"
        )
        body = build_body(carried_over=carried)
    if _summary_answered_since(existing, activity_at):
        log.info(
            "The published summary has been answered since it was posted — "
            "posting a fresh one rather than editing a comment nobody will re-read"
        )
        return pc.post_issue_comment(repo, pr_number, body)
    return pc.post_issue_comment(
        repo, pr_number, body, marker=_SUMMARY_MARKER, existing=existing,
    )


def _post_fix_summary(
    fixed: list[CommentItem],
    needs_human: list[CommentItem],
    deferred: list[CommentItem],
    cp: CommitPushResult,
    repo: str,
    pr_number: int,
    threads_by_id: dict[str, ReportThread],
    dismissed: list[CommentItem] | None = None,
    already_addressed: list[CommentItem] | None = None,
    issue_comments: list[dict] | None = None,
    review_body_comments: list[dict] | None = None,
    has_comment_items: bool = False,
    head_sha: str = "",
    activity_at: str = "",
) -> str | None:
    """Post summary issue comment to the PR. Returns the comment URL or None."""
    dismissed = dismissed or []
    already_addressed = already_addressed or []
    issue_comments = issue_comments or []
    review_body_comments = review_body_comments or []
    has_unseen = (
        any(not c.get("seen") for c in issue_comments)
        or any(not c.get("seen") for c in review_body_comments)
    )
    if (not fixed and not needs_human and not deferred and not dismissed
            and not already_addressed and not has_unseen):
        return None
    url = _publish_summary(repo, pr_number, functools.partial(
        _build_summary_body,
        fixed, needs_human, deferred, cp, repo, pr_number, threads_by_id,
        dismissed=dismissed,
        already_addressed=already_addressed,
        issue_comments=issue_comments,
        review_body_comments=review_body_comments,
        has_comment_items=has_comment_items,
        head_sha=head_sha,
    ), activity_at=activity_at)
    if url:
        log.info(f"Posted fix summary: {url}")
    elif publishing.enabled():
        log.error("failed to post fix summary")
    return url


def _post_pending_fix_replies(
    state: pr_state.PRState,
    repo: str,
    pr_number: int,
    threads_by_id: dict[str, ReportThread],
) -> None:
    """Send the replies the fix pass produced but did not deliver.

    Four ways a reply ends up here: the push failed, the push was held because
    discussion was open, the run was a draft, or the pass had nothing to commit
    because the operator landed the same fixes by hand first. Called during
    --finish, which is the second chance for all four.

    All three reply buckets are drained, not just the fixed one. The
    already-addressed and dismissed replies are sent eagerly during triage,
    before any fix work runs, so a drafted pass renders them and then drops
    them — and the triage-only pass, where nothing was fixable, is exactly the
    shape that leaves no fixed entry to carry them back.
    """
    fix = state.fix
    if not _commit_unpushed(fix.commit_status) and not fix.replies_pending:
        return

    wt_path = Path(state.identity.worktree_root) if state.identity.worktree_root else None
    if not wt_path:
        return

    # Only a pass that made its own commit has to wait for it. One that
    # committed nothing leaves entries citing the commits that did — already on
    # the remote — and the triage buckets cite HEAD rather than a fix commit,
    # so there is nothing for either to wait on.
    if fix.commit_sha and not _is_pushed(wt_path, fix.commit_sha):
        log.info("Push still pending — skipping deferred replies")
        return

    FA = pr_state.ThreadAction

    def bucket(action: str) -> list[CommentItem]:
        # commit_sha carried, not dropped: this queue spans rounds, and an
        # entry fixed two commits ago must still cite the commit that fixed it.
        # `reason` carries the dismissal's justification, which `to_outcome`
        # folded in from `reasoning` — without it a drained dismissal tells a
        # reviewer their premise fails and gives them nothing to argue with.
        return [
            CommentItem(id=t.id, file=t.file, line=t.line,
                        reviewer=t.reviewer, summary=t.summary,
                        reasoning=t.reason, commit_sha=t.commit_sha)
            for t in fix.threads if t.action == action
        ]

    # Accumulate rather than discard: these are the same round's replies
    # finally going out, and the fix pass already counted any it sent
    # itself. A draft returns 0 here, so a drafted drain adds nothing.
    fixed = bucket(FA.FIXED)
    if fixed:
        fix.replies_posted += _post_fix_replies(
            fixed, threads_by_id, repo, pr_number, fix.commit_sha,
        )
        _resolve_fixed_threads(fixed, threads_by_id)

    addressed = bucket(FA.ALREADY_ADDRESSED)
    if addressed:
        fix.replies_posted += _post_already_addressed_replies(
            addressed, threads_by_id, repo, pr_number, wt_path,
        )
        _resolve_fixed_threads(addressed, threads_by_id)

    # Not resolved, unlike the other two: telling a reviewer their premise does
    # not hold is the reply most likely to be argued with, so the thread stays
    # open for them to answer. Mirrors the triage phase.
    dismissed = bucket(FA.DISMISSED)
    if dismissed:
        fix.replies_posted += _post_dismissed_replies(
            dismissed, threads_by_id, repo, pr_number, wt_path,
        )

    # A draft delivered nothing, so the queue has to survive for the next run.
    if publishing.enabled():
        if _commit_unpushed(fix.commit_status):
            fix.commit_status = CommitStatus.PUSHED
        fix.replies_pending = False


def _reconciled_commit(
    fix: pr_state.FixSummary, status: str, wt_path: Path | None,
) -> CommitPushResult:
    """The pass's commit as the worktree now shows it, not as it was recorded.

    The permalinks in this summary already fall back to the identity HEAD when
    the pass recorded no commit of its own; the status cell did not, so a
    hook-rejected commit the operator then made by hand rendered as a flat
    "no commit needed" beside a file link pointing at the very change it
    denied.

    A moved HEAD with nothing recorded means someone committed outside the
    pass. That commit is only worth naming if a reviewer can open it, so an
    unpushed one falls back to the same non-committal cell a reconciled
    outcome gets.
    """
    if fix.commit_sha or not wt_path or not fix.head_sha:
        return CommitPushResult(fix.commit_sha or None, status, "")
    current = _get_head_sha(wt_path)
    if not current or current == fix.head_sha:
        return CommitPushResult(None, status, "")
    if _is_pushed(wt_path, current):
        log.info(f"Attributing fixes to {current} — HEAD moved past the fix snapshot")
        return CommitPushResult(current, CommitStatus.PUSHED, "")
    return CommitPushResult(None, CommitStatus.RECONCILED, "")


def _render_deferred_summary(
    state: pr_state.PRState, report: PRReport, repo: str, pr_number: int,
    threads_by_id: dict[str, ReportThread],
) -> None:
    """Re-render fix summary from state and post it.

    Called during --finish after the deferred tracking issue has been created
    and stored in state.fix.  Rebuilds the summary body from FixSummary's
    structured data so the issue link renders inline — no string patching.
    Updates state.fix.summary_url and summary_deferred on success.
    """
    fix = state.fix
    if not fix.summary_deferred:
        return

    wt_path = Path(state.identity.worktree_root) if state.identity.worktree_root else None

    status = fix.commit_status
    if _commit_unpushed(fix.commit_status) and fix.commit_sha:
        if not wt_path or not _is_pushed(wt_path, fix.commit_sha):
            log.info("Push still pending — keeping summary deferred")
            return
        status = CommitStatus.PUSHED
        # Same reason as the deferred-reply queue: only a run that actually
        # publishes may retire an unpushed status, or the queue is lost silently.
        if publishing.enabled():
            fix.commit_status = status

    # A plain partition over every action, with nothing dropped: this renderer
    # is the only one --finish reaches, and the condition that routes here is
    # the presence of needs_human, so omitting that bucket would omit exactly
    # the threads that took the most operator judgment.
    #
    # _finish_deferred_work reconciles the snapshot against GitHub before
    # calling this, so a thread settled outside the fix pass has already been
    # flipped to FIXED and cannot still be sitting in DEFERRED or NEEDS_HUMAN.
    FA = pr_state.ThreadAction
    fixed = [t for t in fix.threads if t.action == FA.FIXED]
    needs_human = [t for t in fix.threads if t.action == FA.NEEDS_HUMAN]
    deferred = [t for t in fix.threads if t.action == FA.DEFERRED]
    dismissed = [t for t in fix.threads if t.action == FA.DISMISSED]
    already_addressed = [t for t in fix.threads if t.action == FA.ALREADY_ADDRESSED]

    cp = _reconciled_commit(fix, status, wt_path)
    _warn_unattributed_fixes(fixed, cp)
    url = _publish_summary(repo, pr_number, functools.partial(
        _build_summary_body,
        fixed, needs_human, deferred, cp, repo, pr_number, threads_by_id,
        dismissed=dismissed,
        already_addressed=already_addressed,
        issue_comments=report.issue_comments,
        review_body_comments=report.review_body_comments,
        deferred_issue_id=fix.deferred_issue_id,
        deferred_issue_url=fix.deferred_issue_url,
        has_comment_items=fix.has_comment_items,
        head_sha=cp.sha or state.identity.head_sha,
    ), activity_at=_newest_reviewer_activity(report))
    if url:
        log.info(f"Posted deferred fix summary: {url}")
        fix.summary_url = url
        fix.summary_deferred = False
    elif publishing.enabled():
        log.error("failed to post deferred fix summary")


def _summary_still_owed(
    fixed: list,
    needs_human: list,
    deferred: list,
    dismissed: list,
    commit_status: str,
    has_unaccounted: bool,
) -> bool:
    """Whether --finish must re-render the fix summary later.

    Discussion that is still open, or a commit that never reached the remote,
    both make the summary premature. So does a draft run: it printed the summary
    instead of posting it, so everything it had to say is still owed.
    """
    if deferred or needs_human or has_unaccounted:
        return True
    if _commit_unpushed(commit_status):
        return True
    return not publishing.enabled() and bool(fixed or dismissed)


def _post_or_defer_summary(
    fixed: list[CommentItem],
    needs_human: list[CommentItem],
    deferred: list[CommentItem],
    cp: CommitPushResult,
    repo: str,
    pr_number: int,
    threads_by_id: dict[str, ReportThread],
    dismissed: list[CommentItem] | None = None,
    already_addressed: list[CommentItem] | None = None,
    issue_comments: list[dict] | None = None,
    review_body_comments: list[dict] | None = None,
    has_comment_items: bool = False,
    head_sha: str = "",
    activity_at: str = "",
) -> str | None:
    """Post summary immediately or defer to state when discussion is pending.

    Returns the comment URL if posted, None if deferred or nothing to post.
    When deferred, the summary is re-rendered from FixSummary during --finish.
    """
    _warn_unattributed_fixes(fixed, cp)
    if _commit_unpushed(cp.status):
        log.info("Deferred fix summary — commit not on the remote, will post after push lands")
        return None

    if not needs_human and not deferred:
        return _post_fix_summary(
            fixed, needs_human, deferred, cp, repo, pr_number,
            threads_by_id, dismissed=dismissed,
            already_addressed=already_addressed,
            issue_comments=issue_comments,
            review_body_comments=review_body_comments,
            has_comment_items=has_comment_items,
            head_sha=head_sha,
            activity_at=activity_at,
        )

    log.info("Deferred fix summary — will render from state on --finish")
    return None


def _get_head_sha(wt_path: Path) -> str:
    return subprocess.run(
        ["git", "-C", str(wt_path), "rev-parse", "--short", "HEAD"],
        capture_output=True, text=True,
    ).stdout.strip()


def _is_pushed(wt_path: Path, sha: str) -> bool:
    """Check if a commit has been pushed to the remote tracking branch."""
    result = subprocess.run(
        ["git", "-C", str(wt_path), "branch", "-r", "--contains", sha],
        capture_output=True, text=True,
    )
    return result.returncode == 0 and result.stdout.strip() != ""


def _unrecovered_commit(
    wt_path: Path, prior: CommitPushResult | None,
) -> CommitPushResult:
    """What the pass knows when recovery found no commit of the agent's.

    Recovery exists to *add* information. When it finds none, whatever the
    caller already established stands: overwriting a `commit_failed` with
    `no_changes` here publishes "Fix applied (no commit needed)" over a commit
    a pre-commit hook rejected.

    With nothing prior to preserve, the tree itself distinguishes the two
    remaining readings. Changes still sitting there after a commit was
    attempted mean something refused it, not that there was nothing to commit.
    """
    if prior is not None and prior.status != CommitStatus.NO_CHANGES:
        return prior
    if review_common.has_uncommitted_changes(wt_path):
        return CommitPushResult(
            None, CommitStatus.COMMIT_FAILED, "changes remain uncommitted in the worktree",
        )
    return CommitPushResult(None, CommitStatus.NO_CHANGES, "")


def _recover_agent_commit(
    wt_path: Path, head_before: str, trail: Trail | None = None,
    prior: CommitPushResult | None = None,
) -> CommitPushResult:
    """Detect and push commits made directly by the fix agent.

    `prior` is what the caller's own commit attempt concluded, and it is never
    downgraded — see `_unrecovered_commit`.
    """
    head_after = _get_head_sha(wt_path)
    if head_after == head_before:
        return _unrecovered_commit(wt_path, prior)

    if _is_pushed(wt_path, head_after):
        return CommitPushResult(head_after, CommitStatus.PUSHED, "")

    if not publishing.enabled():
        return _hold_push(wt_path, head_after)

    push = subprocess.run(
        ["git", "-C", str(wt_path), "push"],
        capture_output=True, text=True,
    )
    if push.returncode == 0:
        log.info("Pushed agent-committed fixes")
        return CommitPushResult(head_after, CommitStatus.PUSHED, "")

    err = push.stderr.strip()
    log.error("push failed after agent commit")
    if trail:
        trail.error("push", "push failed after agent commit",
                    data={"sha": head_after, "error": err[:500]})
    return CommitPushResult(head_after, CommitStatus.PUSH_FAILED, err)


def _build_thread_outcomes(
    fixed: list[CommentItem],
    deferred: list[CommentItem],
    needs_human: list[CommentItem],
    dismissed: list[CommentItem],
    already_addressed: list[CommentItem] | None = None,
    commit_sha: str = "",
) -> list[pr_state.ThreadOutcome]:
    """Build ThreadOutcome list from categorized entries.

    `commit_sha` is stamped on the fixed outcomes only. The others were not
    landed by this commit, and a SHA on them would read as if they had been.
    """
    FA = pr_state.ThreadAction
    outcomes: list[pr_state.ThreadOutcome] = []
    for entry in fixed:
        outcome = entry.to_outcome(FA.FIXED)
        outcome.commit_sha = _entry_commit_sha(entry, commit_sha)
        outcomes.append(outcome)
    for entry in deferred:
        outcomes.append(entry.to_outcome(FA.DEFERRED))
    for entry in needs_human:
        outcomes.append(entry.to_outcome(FA.NEEDS_HUMAN))
    for entry in dismissed:
        outcomes.append(entry.to_outcome(FA.DISMISSED))
    for entry in already_addressed or []:
        outcomes.append(entry.to_outcome(FA.ALREADY_ADDRESSED))
    return outcomes


def _persist_fix_state(
    fix_summary: pr_state.FixSummary,
    wt_path: Path,
    ctx: pr_context.ResolvedContext,
    trail: Trail | None,
) -> None:
    """Save fix pass results to PR state."""
    try:
        st = pr_state.load_or_init(
            target_dir=ctx.target_dir, repo=ctx.repo, branch=ctx.branch,
            pr_number=ctx.pr_number, head_sha=ctx.head_sha,
            worktree_root=str(wt_path),
        )
        pr_state.apply(st, fix_summary)
        pr_state.save_state(ctx.target_dir, st)
    except Exception as exc:
        if trail:
            trail.error("fix_state", f"fix state update failed: {exc}")
        log.error(f"fix state update failed: {exc}")


def _classify_triage_entries(
    triage_entries: list[CommentItem],
) -> ClassificationResult:
    """Classify triage entries into fixable/needs_human/dismissed.

    Works for both threads and comment items.
    """
    result = ClassificationResult()

    for tt in triage_entries:
        if tt.state == ThreadState.CONTESTED:
            result.needs_human.append(
                dataclasses.replace(tt, reason=HumanReason.CONTESTED.value))
            continue

        if tt.classification == "conflicting":
            result.needs_human.append(
                dataclasses.replace(tt, reason=HumanReason.CONFLICTING.value))
            continue

        if tt.classification == "question":
            result.needs_human.append(
                dataclasses.replace(tt, reason=HumanReason.QUESTION.value))
            continue

        if tt.classification != "actionable_suggestion":
            continue

        if tt.verification == "valid" and tt.complexity == "high":
            result.needs_human.append(
                dataclasses.replace(tt, reason=HumanReason.COMPLEX.value))
            continue

        if tt.verification == "valid":
            result.fixable.append(tt)
        elif tt.verification == "needs_discussion":
            result.needs_human.append(
                dataclasses.replace(tt, reason=HumanReason.NEEDS_DISCUSSION.value))
        elif tt.verification == "already_addressed":
            result.already_addressed.append(tt)
        elif tt.verification == "invalid":
            result.dismissed.append(dataclasses.replace(tt, reasoning=tt.reasoning))

    return result


def _accounted_thread_ids(
    fixable: list[CommentItem],
    needs_human: list[CommentItem],
    dismissed: list[CommentItem],
    already_addressed: list[CommentItem] | None = None,
) -> set[str]:
    """Return IDs of all threads that have a disposition in the fix pipeline."""
    return {
        entry.id
        for entries in (fixable, needs_human, dismissed, already_addressed or [])
        for entry in entries
    }


def _retry_fix_pass(
    deferred_threads: list[CommentItem],
    deferred_items: list[CommentItem],
    original_fixable: list[CommentItem],
    original_fixable_items: list[CommentItem],
    threads_by_id: dict[str, ReportThread],
    wt_path: Path,
    pr_number: int,
    ctx: pr_context.ResolvedContext,
    main_wt: Path | None,
    original_turns: int,
    trail: Trail | None = None,
    default_branch: str = "main",
) -> TrackingResult:
    """Retry fix pass with only deferred items and increased budget."""
    fixable_by_id = {t.id: t for t in original_fixable}
    items_by_id = {it.id: it for it in original_fixable_items}

    retry_fixable = [fixable_by_id[e.id] for e in deferred_threads
                     if e.id in fixable_by_id]
    retry_items = [items_by_id[e.id] for e in deferred_items
                   if e.id in items_by_id]

    if not retry_fixable and not retry_items:
        return TrackingResult(deferred=list(deferred_threads),
                              deferred_items=list(deferred_items))

    tracking_dir = wt_path / "ignore" / "pr-comments"
    tracking_file = tracking_dir / "fix-tracking.md"

    _build_tracking_file(
        tracking_file, retry_fixable, threads_by_id,
        wt_path, pr_number,
        fixable_items=retry_items,
        default_branch=default_branch,
    )

    retry_count = len(retry_fixable) + len(retry_items)
    retry_turns = _fix_retry_budget(original_turns)

    prompt = _FIX_RESUME_HINT + _render_fix_template(
        branch=ctx.branch,
        repo=ctx.repo,
        threads_content=tracking_file.read_text(),
        tracking_file=str(tracking_file),
        wt_path=str(wt_path),
        max_turns=retry_turns,
        main_wt_path=str(main_wt) if main_wt else "",
    )

    log.info(f"Retry pass — {retry_count} deferred items (max_turns={retry_turns})...")
    _guarded_fix_pass(
        prompt, wt_path, main_wt, tracking_file,
        max_turns=retry_turns, max_budget=_fix_budget_usd(retry_count),
        label="Fix retry pass",
        repo=ctx.repo, pr_number=pr_number,
    )
    log.blank()

    result = _parse_tracking_results(
        tracking_file, retry_fixable, fixable_items=retry_items,
    )

    if trail:
        trail.info("fix_retry", "retry pass complete",
                    data={"fixed": len(result.fixed), "fixed_items": len(result.fixed_items),
                          "still_deferred": len(result.deferred) + len(result.deferred_items)})

    return result


def _hold_if_superseded(
    verdict: supersession.Verdict, trail: Trail | None = None,
) -> None:
    """Report what the preflight found, and hold if any of it is evidence.

    A hold rather than the refusal `pr review` and `pr rebase` answer with: by
    the time this runs the triage pass has already been paid for, so there is
    nothing left to save by stopping, and the fixes themselves are worth having
    locally either way. What must not happen is asserting outward that
    superseded code was fixed.

    The hold is the same one an open thread places, and reaches the same acts:
    the push, the `Fixed in <sha>` replies, the thread resolutions, and the
    summary. The local commit is not one of them — see `_commit_fixes`.
    """
    supersession.report(verdict)
    if not verdict.superseded:
        return
    holding = verdict.holding
    publishing.hold(
        f"{len(holding)} supersession signal(s) suggest this branch is superseded"
    )
    if trail:
        trail.decision(
            "publishing_hold",
            f"held publishing — {len(holding)} supersession signal(s)",
            reason="fixing code the default branch has already removed asserts it should exist",
            data={"signals": [s.kind for s in holding]},
        )


def _hold_while_contested(
    needs_human: list[CommentItem], trail: Trail | None = None,
) -> None:
    """Stop the pass asserting progress while a thread is still being argued.

    Threads are bucketed independently, so a finding that says "your root cause
    does not exist" only removes itself from `fixable` — the pass goes on to fix
    everything else, commit it, push it, and reply that it is done. Every one of
    those findings can be individually real and the branch still not worth
    landing — that is how a pass pushes a run of fixes to superseded code.

    Telling a premise-invalidating question from a bikeshed is the hard problem,
    and getting it wrong in the permissive direction is what this exists to
    prevent. So the halt is deliberately blunt — any open thread — and cheap:
    the fixes are still applied and still committed locally, and only the
    outward acts wait. A wrong call costs a local commit, not a pushed one. The
    human clears it by answering and re-running `--finish --post`.
    """
    if not needs_human:
        return
    publishing.hold(f"{len(needs_human)} thread(s) awaiting discussion")
    if trail:
        trail.decision(
            "publishing_hold",
            f"held publishing — {len(needs_human)} thread(s) awaiting discussion",
            reason="a contested thread can invalidate the premise of every other fix",
            data={"reasons": sorted({t.reason for t in needs_human if t.reason})},
        )


def _triage_replies_drafted(
    already_addressed: list[CommentItem], dismissed: list[CommentItem],
) -> bool:
    """Whether this pass rendered triage replies it did not send.

    The already-addressed and dismissed replies go out during triage, before
    the pass knows whether anything is fixable. A draft renders them to stderr
    and sends nothing, so the queue has to say they are still owed — otherwise
    `--finish --post` finds a drained queue and publishes nothing, and a whole
    approved round goes missing.
    """
    return bool(already_addressed or dismissed) and not publishing.enabled()


def _run_comment_fix(
    triage_result: TriageResult,
    report: PRReport,
    wt_path: Path,
    ctx: pr_context.ResolvedContext,
    trail: Trail | None = None,
) -> CommentFixResult:
    """Apply mechanical fixes for valid actionable comment threads and items."""
    threads_by_id = {t.id: t for t in report.threads}

    # Classify threads
    thread_cls = _classify_triage_entries(triage_result.threads)
    fixable = thread_cls.fixable
    needs_human = thread_cls.needs_human
    dismissed = thread_cls.dismissed

    # Classify comment items
    item_cls = _classify_triage_entries(triage_result.comment_items)
    fixable_items = item_cls.fixable
    items_needs_human = item_cls.needs_human
    items_dismissed = item_cls.dismissed
    items_already_addressed = item_cls.already_addressed

    all_needs_human = needs_human + items_needs_human
    all_dismissed = dismissed + items_dismissed
    all_addressed = thread_cls.already_addressed + items_already_addressed

    _hold_if_superseded(
        supersession.detect_cached(
            wt_path, ctx.repo, ctx.target_dir,
            base=f"origin/{_resolve_default_branch(wt_path)}", trail=trail,
        ),
        trail,
    )
    _hold_while_contested(all_needs_human, trail)

    non_resolved_ids = {t.id for t in report.threads if t.state != ThreadState.RESOLVED}
    accounted_ids = _accounted_thread_ids(
        fixable + (fixable_items or []),
        all_needs_human,
        all_dismissed,
        all_addressed,
    )
    has_unaccounted = bool(non_resolved_ids - accounted_ids)

    no_commit = CommitPushResult(None, CommitStatus.NO_CHANGES, "")

    triage_replies = 0
    if dismissed:
        triage_replies += _post_dismissed_replies(
            dismissed, threads_by_id, ctx.repo, report.pr_number, wt_path,
        )
    if all_addressed:
        triage_replies += _post_already_addressed_replies(
            all_addressed, threads_by_id, ctx.repo, report.pr_number, wt_path,
        )
        _resolve_fixed_threads(all_addressed, threads_by_id)

    all_fixable = bool(fixable) or bool(fixable_items)
    has_items = (
        bool(fixable_items) or bool(items_needs_human)
        or bool(items_dismissed) or bool(items_already_addressed)
    )

    empty_result = CommentFixResult(
        needs_human=all_needs_human, dismissed=all_dismissed,
        already_addressed=all_addressed,
        commit_status=CommitStatus.NO_CHANGES, replies_posted=triage_replies,
    )

    if not all_fixable:
        early_deferred = bool(all_needs_human) or has_unaccounted
        if has_unaccounted:
            log.info("Deferred fix summary — unresolved threads not yet addressed")
            summary_url = None
        elif all_dismissed or all_needs_human or all_addressed:
            summary_url = _post_or_defer_summary(
                [], all_needs_human, [], no_commit, ctx.repo, report.pr_number,
                threads_by_id, dismissed=all_dismissed,
                already_addressed=all_addressed,
                issue_comments=report.issue_comments,
                review_body_comments=report.review_body_comments,
                has_comment_items=has_items,
                head_sha=ctx.head_sha,
                activity_at=_newest_reviewer_activity(report),
            )
        else:
            summary_url = None
        empty_result.summary_url = summary_url
        empty_result.summary_deferred = summary_url is None and early_deferred
        _persist_fix_state(pr_state.FixSummary(
            threads=_build_thread_outcomes(
                [], [], all_needs_human, all_dismissed, all_addressed,
            ),
            commit_status=no_commit.status,
            head_sha=_get_head_sha(wt_path),
            replies_posted=triage_replies,
            replies_pending=_triage_replies_drafted(all_addressed, all_dismissed),
            summary_url=summary_url or "",
            summary_deferred=summary_url is None and early_deferred,
            updated_at=pr_state.now_iso(),
        ), wt_path, ctx, trail)
        return empty_result

    tracking_dir = wt_path / "ignore" / "pr-comments"
    tracking_file = tracking_dir / "fix-tracking.md"

    default_branch = _resolve_default_branch(wt_path)

    total_items = len(fixable) + len(fixable_items or [])

    head_before = _get_head_sha(wt_path)

    main_wt = _find_and_update_main_worktree(wt_path)

    batches = _fix_batches(list(fixable), list(fixable_items or []))
    if len(batches) > 1:
        log.info(
            f"Fix pass — {total_items} items in {len(batches)} batches "
            f"of up to {FIX_CHUNK_SIZE}..."
        )

    results = []
    for n, (chunk_threads, chunk_items) in enumerate(batches, start=1):
        label = ("Fix pass" if len(batches) == 1
                 else f"Fix pass (batch {n}/{len(batches)})")
        results.append(_run_fix_batch(
            chunk_threads, chunk_items, threads_by_id, tracking_file,
            wt_path, main_wt, ctx, report.pr_number,
            label=label, default_branch=default_branch,
        ))

    retryable, stalled = _partition_batches(results)
    # The largest batch's budget, not the last one's — the remainder chunk is
    # usually the smallest and would understate what a pass was given.
    max_turns = max((r.max_turns for r in results), default=0)
    max_budget = max((r.max_budget for r in results), default=0.0)

    tracking = TrackingResult()
    _merge_tracking(tracking, retryable)
    _merge_tracking(tracking, stalled)

    if retryable.deferred or retryable.deferred_items:
        retry_result = _retry_fix_pass(
            retryable.deferred, retryable.deferred_items,
            fixable, fixable_items or [],
            threads_by_id, wt_path, report.pr_number,
            ctx, main_wt, max_turns, trail,
            default_branch=default_branch,
        )
        tracking.fixed = tracking.fixed + retry_result.fixed
        tracking.deferred = retry_result.deferred + stalled.deferred
        tracking.fixed_items = tracking.fixed_items + retry_result.fixed_items
        tracking.deferred_items = retry_result.deferred_items + stalled.deferred_items

    fixed_count = len(tracking.fixed) + len(tracking.fixed_items)
    deferred_count = len(tracking.deferred) + len(tracking.deferred_items)

    cp = _commit_fixes(wt_path, fixed_count, deferred_count, head_before, trail)

    replies_posted = triage_replies
    if tracking.fixed and cp.status == CommitStatus.PUSHED:
        if cp.sha:
            replies_posted += _post_fix_replies(
                tracking.fixed, threads_by_id, ctx.repo, report.pr_number,
                cp.sha,
            )
        else:
            replies_posted += _post_already_addressed_replies(
                tracking.fixed, threads_by_id, ctx.repo, report.pr_number,
                wt_path,
            )
        _resolve_fixed_threads(tracking.fixed, threads_by_id)

    all_fixed = tracking.fixed + tracking.fixed_items
    all_deferred = tracking.deferred + tracking.deferred_items

    pending_deferred = _summary_still_owed(
        all_fixed, all_needs_human, all_deferred, all_dismissed,
        cp.status, has_unaccounted,
    )

    summary_url = _post_or_defer_summary(
        all_fixed, all_needs_human, all_deferred, cp,
        ctx.repo, report.pr_number,
        threads_by_id, dismissed=all_dismissed,
        already_addressed=all_addressed,
        issue_comments=report.issue_comments,
        review_body_comments=report.review_body_comments,
        has_comment_items=has_items,
        head_sha=cp.sha or ctx.head_sha,
        activity_at=_newest_reviewer_activity(report),
    )

    _persist_fix_state(pr_state.FixSummary(
        threads=_build_thread_outcomes(
            all_fixed, all_deferred, all_needs_human, all_dismissed,
            all_addressed, commit_sha=cp.sha or "",
        ),
        commit_sha=cp.sha or "",
        commit_status=cp.status,
        # HEAD after the pass, not ctx.head_sha: the fix pass commits, so the
        # snapshot must name the commit its outcomes were measured against.
        head_sha=_get_head_sha(wt_path),
        replies_posted=replies_posted,
        replies_pending=(
            bool(tracking.fixed) and not publishing.enabled()
            or _triage_replies_drafted(all_addressed, all_dismissed)
        ),
        summary_url=summary_url or "",
        summary_deferred=summary_url is None and pending_deferred,
        has_comment_items=has_items,
        updated_at=pr_state.now_iso(),
    ), wt_path, ctx, trail)

    return CommentFixResult(
        fixed=all_fixed,
        needs_human=all_needs_human,
        dismissed=all_dismissed,
        already_addressed=all_addressed,
        deferred=all_deferred,
        commit_sha=cp.sha,
        commit_status=cp.status,
        replies_posted=replies_posted,
        summary_url=summary_url,
        summary_deferred=summary_url is None and pending_deferred,
        max_turns=max_turns,
        max_budget=max_budget,
        batches=len(batches),
    )


def _run_threads(trail, args, ctx) -> None:
    repo = ctx.repo
    pr_number = ctx.pr_number
    branch = ctx.branch
    toplevel = ctx.require_worktree()
    head_sha = ctx.head_sha

    owner, repo_name = repo.split("/", 1)

    pr_data = fetch_pr_data(repo, str(pr_number))
    my_login = pr_data.viewer_login

    state_path = toplevel / "ignore" / "pr-comments" / "state.json"

    # Load prior state
    prior_state = pc.load_state(state_path)
    prior_threads = prior_state.get("threads", {}) if prior_state else {}

    # Fetch from GitHub (served from pr_data, no extra API calls)
    threads_raw = pc.fetch_threads(owner, repo_name, pr_number, pr_data)
    verdicts = pc.fetch_reviewer_verdicts(repo, pr_number, pr_data)
    issue_comments = pc.fetch_issue_comments(repo, pr_number, my_login, pr_data)
    review_body_comments = pc.fetch_review_body_comments(
        repo, pr_number, my_login, pr_data,
    )
    trail.info("fetch_threads", f"fetched {len(threads_raw)} threads",
               data={"count": len(threads_raw)})

    # Sync
    threads = pc.sync_threads(threads_raw, prior_threads, my_login)
    synced_resolved = sum(1 for t in threads.values() if t.get("state") == pc.STATE_RESOLVED)
    synced_open = len(threads) - synced_resolved
    trail.info("sync_threads", f"{synced_resolved} resolved, {synced_open} open",
               data={"resolved": synced_resolved, "open": synced_open, "total": len(threads)})

    # Resolve verified threads if requested (or as part of triage)
    if args.finish or args.triage:
        resolved_count = _resolve_verified_threads(threads_raw, threads)
        if resolved_count:
            log.info(f"Resolved {resolved_count} verified threads")

    # Save state
    state = pc.empty_state(repo, pr_number, my_login)
    state["threads"] = threads
    pc.save_state(state_path, state)

    # Dashboard to stderr
    dashboard = pc.render_dashboard(
        pr_number, threads, verdicts, issue_comments,
        review_body_comments=review_body_comments,
    )
    print(dashboard, file=sys.stderr)

    # Build report
    report_threads = []
    for thread_data in threads_raw:
        tid = thread_data["id"]
        t = threads.get(tid, {})
        comments = thread_data.get("comments", {}).get("nodes", [])
        report_threads.append(ReportThread(
            id=tid,
            state=ThreadState(t.get("state", "new")),
            classification=t.get("classification"),
            reviewer=t.get("reviewer", ""),
            comments=comments,
            is_resolved=thread_data.get("isResolved", False),
            file=thread_data.get("path", ""),
            line=thread_data.get("line"),
            my_login=my_login,
        ))
    report = PRReport(
        repo=repo,
        pr_number=pr_number,
        my_login=my_login,
        threads=report_threads,
        issue_comments=issue_comments,
        review_body_comments=review_body_comments,
        verdicts=verdicts,
    )

    # Update unified PR state (best-effort)
    ctx_args = dict(
        target_dir=ctx.target_dir, worktree_root=str(toplevel), repo=repo, branch=branch,
        pr_number=pr_number, head_sha=head_sha,
    )
    try:
        thread_states: dict[str, int] = {}
        for t in report.threads:
            thread_states[t.state] = thread_states.get(t.state, 0) + 1
        blocking = [
            v.get("user", "unknown")
            for v in report.verdicts
            if v.get("state") == "CHANGES_REQUESTED"
        ]
        has_approvals = any(
            v.get("state") == "APPROVED" for v in report.verdicts
        )
        st = pr_state.load_or_init(**ctx_args)
        prior_seen_ids = set(st.comments.seen_issue_comment_ids)
        current_ids = [c["id"] for c in issue_comments]
        for c in issue_comments:
            c["seen"] = c["id"] in prior_seen_ids
        prior_seen_review_ids = set(st.comments.seen_review_body_comment_ids)
        current_review_ids = [c["id"] for c in review_body_comments]
        for c in review_body_comments:
            c["seen"] = c["id"] in prior_seen_review_ids
        pr_state.apply(st, pr_state.CommentsSummary(
            total_threads=len(report.threads),
            by_state=thread_states,
            blocking_reviewers=blocking,
            has_approvals=has_approvals,
            seen_issue_comment_ids=current_ids,
            seen_review_body_comment_ids=current_review_ids,
            updated_at=pr_state.now_iso(),
        ))

        pr_state.save_state(ctx.target_dir, st)
    except Exception as exc:
        trail.error("state_update", f"state update failed: {exc}")
        log.error(f"state update failed: {exc}")

    # Triage and/or fix mode
    if args.triage:
        triage_mode = "fix" if args.fix else "triage"
        trail.decision("triage_mode", f"running {triage_mode}",
                       reason="--fix flag" if args.fix else "--triage flag",
                       data={"fix": args.fix, "triage": args.triage})
        triage_result, rc = _run_triage(report, toplevel, ctx_args, trail=trail)
        if rc != 0:
            sys.exit(rc)

        if args.fix and triage_result:
            fixable_count = sum(
                1 for t in triage_result.threads
                if t.classification == "actionable_suggestion"
                and t.verification == "valid"
            )
            fixable_items_count = sum(
                1 for it in triage_result.comment_items
                if it.classification == "actionable_suggestion"
                and it.verification == "valid"
            )
            trail.decision(
                "fix_classification",
                f"{fixable_count} fixable threads, {fixable_items_count} fixable items identified",
                reason="classification=actionable_suggestion and verification=valid",
                data={"fixable": fixable_count, "fixable_items": fixable_items_count,
                      "total": len(triage_result.threads),
                      "total_items": len(triage_result.comment_items)},
            )
            fix_pass = _run_comment_fix(triage_result, report, toplevel, ctx, trail=trail)
            trail.info("fix_result", "fix pass complete",
                       data={"fixable": fixable_count,
                             "deferred": len(fix_pass.deferred),
                             "dismissed": len(fix_pass.dismissed),
                             "already_addressed": len(fix_pass.already_addressed),
                             "batches": fix_pass.batches,
                             "max_turns": fix_pass.max_turns,
                             "max_budget": fix_pass.max_budget,
                             "commit_sha": fix_pass.commit_sha,
                             "commit_status": fix_pass.commit_status})
            output = dataclasses.asdict(triage_result)
            output["fix_pass"] = dataclasses.asdict(fix_pass)
            output["issue_comments"] = report.issue_comments
            output["review_body_comments"] = report.review_body_comments
        else:
            output = dataclasses.asdict(triage_result) if triage_result else {}
            output["issue_comments"] = report.issue_comments
            output["review_body_comments"] = report.review_body_comments
    else:
        output = dataclasses.asdict(report)

    # After the fix pass, not before: a combined --fix --finish run would
    # otherwise close out the previous run's deferred set and leave this one's
    # untouched. Outside the state-update try/except, because a caller running
    # this to close the loop needs a failure to be an error, not a log line.
    if args.finish:
        track = TRACK_ALL if args.track_all else frozenset(args.track)
        _finish_deferred_work(ctx, report, trail=trail, track=track)

    json.dump(output, sys.stdout, indent=2)
    print()


def _find_reply_target(
    threads_raw: list[dict], target: str, my_login: str,
) -> ReportThread | None:
    """Resolve a thread by node ID or by any comment ID inside it.

    Both, because the two are handed out by different things: the report prints
    the node ID, while a reviewer sends a link ending `#discussion_r3717174529`
    — which is a comment ID, and the only identifier a human ever has.
    """
    wanted = target.strip().rsplit("#", 1)[-1].removeprefix("discussion_r")
    for data in threads_raw:
        comments = data.get("comments", {}).get("nodes", [])
        ids = {str(c.get("databaseId")) for c in comments}
        if data.get("id") != target and wanted not in ids:
            continue
        is_resolved = data.get("isResolved", False)
        return ReportThread(
            id=data.get("id", ""),
            state=pc.compute_thread_state(comments, is_resolved, my_login),
            reviewer=(comments[0].get("author") or {}).get("login", "") if comments else "",
            comments=comments,
            is_resolved=is_resolved,
            file=data.get("path", ""),
            line=data.get("line"),
            my_login=my_login,
        )
    return None


def _read_reply_body(body_file: str | None) -> str | None:
    """Read a reply body from a file, or from stdin when given '-'.

    None for a path that is not there, "" for a file that is: a mistyped path
    and an empty draft need different advice.
    """
    if not body_file:
        return None
    if body_file == "-":
        return sys.stdin.read().strip()
    path = Path(body_file)
    if not path.is_file():
        return None
    return path.read_text(encoding="utf-8").strip()


def _run_reply(ctx: pr_context.ResolvedContext, target: str, body_file: str | None) -> int:
    """Post one hand-written reply through the same upsert the fix pass uses.

    Manual replies used to go straight to the REST replies endpoint, with no
    dedup on that path at all — which is how a thread ends up carrying three of
    our comments that contradict each other. Routing them here holds a manual
    reply to the same one-per-thread rule as a generated one.
    """
    body = _read_reply_body(body_file)
    if body is None:
        missing = f"--body-file not found: {body_file}" if body_file else "--reply needs --body-file"
        log.error(missing)
        return 1
    if not body:
        log.error(f"--body-file is empty: {body_file}")
        return 1

    repo = ctx.repo
    pr_number = ctx.pr_number
    owner, repo_name = repo.split("/", 1)
    pr_data = fetch_pr_data(repo, str(pr_number))
    threads_raw = pc.fetch_threads(owner, repo_name, pr_number, pr_data)

    thread = _find_reply_target(threads_raw, target, pr_data.viewer_login)
    if thread is None:
        log.error(f"no review thread on PR #{pr_number} matches {target!r}")
        return 1

    if "/blob/" not in body:
        log.warn(
            "reply cites no permalink — a claim about the code needs a link to "
            "the line that settles it"
        )

    existing_id = _our_last_reply_id(thread)
    wrote = _upsert_thread_reply(thread, repo, pr_number, body, existing_id)
    if not publishing.enabled():
        # The closing line is the one read as the outcome, so it carries the
        # same label the body was printed under rather than a past tense the
        # run never earned.
        publishing.draft(f"{'edit' if existing_id else 'post'} reply on {thread.id}")
        return 0
    if not wrote:
        log.error(f"failed to reply on {thread.id}")
        return 1
    log.info(f"{'Edited' if existing_id else 'Posted'} reply on {thread.id}")
    return 0


def _build_parser() -> argparse.ArgumentParser:
    # Two axes, and the help text has to keep them apart: --triage/--fix/--finish
    # /--reply choose the work, --post decides whether it leaves the machine.
    # Read as peers, `--finish --post` looks like it says publish twice, and the
    # pair gets typed as one unit — which is how a bare --finish stops being the
    # way to preview a closeout.
    parser = argparse.ArgumentParser(
        description="PR review threads. Phase flags (--triage/--fix/--finish/"
                    "--reply) pick the work; --post publishes it.")
    parser.add_argument("--pr", help="PR number")
    parser.add_argument("--branch", help="Branch name (resolved via resolve-branch)")
    parser.add_argument("--triage", action="store_true",
                        help="Phase: classify threads via AI and auto-resolve verified")
    parser.add_argument("--fix", action="store_true",
                        help="Phase: triage threads and apply mechanical fixes via "
                             "Claude agent")
    parser.add_argument("--finish", action="store_true", dest="finish",
                        help="Phase: close out deferred work — replies, tracking "
                             "issue, summary. Drafts them unless --post is given")
    parser.add_argument("--track", action="append", default=[], metavar="THREAD_ID",
                        help="File this deferred thread on the tracking issue "
                             "(repeatable). Deferral is a per-thread decision, so "
                             "--finish files nothing unless told which threads")
    parser.add_argument("--track-all", action="store_true",
                        help="File every deferred thread. Only for a set the user "
                             "has actually reviewed")
    parser.add_argument("--post", action="store_true",
                        help="Gate, not a phase: publish whatever the chosen phase "
                             "produced — replies, summaries, resolutions "
                             "(default: print drafts to stderr and post nothing)")
    parser.add_argument("--repo-dir", "--worktree",
                        help="Git worktree directory (skips git toplevel detection)")
    parser.add_argument("--reply", metavar="THREAD_OR_COMMENT_ID",
                        help="Reply to one thread, editing our standing reply if it "
                             "is still the last comment. Accepts a thread node ID, a "
                             "comment ID, or a #discussion_r... URL. A write like any "
                             "other: needs --post to leave the machine")
    parser.add_argument("--body-file", metavar="PATH",
                        help="File holding the --reply body ('-' for stdin)")
    add_trail_args(parser)
    return parser


def main():
    parser = _build_parser()
    handle_value_flags(parser)
    args = parser.parse_args()

    if args.fix:
        args.triage = True
    if args.post:
        publishing.enable()
    else:
        log.info("Draft mode — nothing is posted to GitHub. Re-run with --post to publish.")

    ctx = pr_context.resolve(
        pr=args.pr, branch=args.branch, repo_dir=args.repo_dir,
    )
    repo = ctx.repo
    pr_number = ctx.pr_number
    if pr_number is None:
        log.error("No PR found for current branch")
        sys.exit(1)

    if args.reply:
        sys.exit(_run_reply(ctx, args.reply, args.body_file))
    branch = ctx.branch
    # Called for its raise, not its value: a bare-repo run must fail here,
    # before the lock and the trail.
    ctx.require_worktree()
    head_sha = ctx.head_sha

    # A no-op when pr launched us — we resolve the same target and find its key
    # already in WORKBENCH_RUN_LOCK.
    # Acquired before Trail.start so contention costs no trail artifacts.
    run_lock.claim_for_process(
        ctx.target_dir,
        command=" ".join([SCRIPT] + sys.argv[1:]),
        started=pr_state.now_iso(),
    )

    trail = Trail.start(
        script=SCRIPT,
        context={"repo": repo, "pr": pr_number, "branch": branch},
        debug=args.debug,
    )

    try:
        _run_threads(trail, args, ctx)
    except Exception as exc:
        trail.error("unexpected_error", str(exc))
        raise
    finally:
        trail.finish()


if __name__ == "__main__":
    main()
