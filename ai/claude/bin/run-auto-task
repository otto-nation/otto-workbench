#!/usr/bin/env bash
# Run a Claude Code skill as a headless background session.
#
# Usage: run-auto-task <skill-name>
#
# Spawns `claude -p` in the background with --bare (skips hooks to prevent
# cascading) and streams output to ~/.claude/logs/<skill>-<timestamp>.log.
# Designed to be called from Stop hooks instead of setting pending flags.
#
# Env:
#   CLAUDE_LOG_DIR  — override log directory (default: ~/.claude/logs)

set -e

_SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
. "$(git -C "$(dirname "$_SELF")" rev-parse --show-toplevel)/lib/constants.sh"

usage() {
  cat <<EOF
Usage: run-auto-task <skill-name>

Run a Claude Code skill as a headless background session.

Spawns \`claude -p\` with --bare (skips hooks to prevent cascading) and
streams output to ~/.claude/logs/<skill>-<timestamp>.log.

Env:
  CLAUDE_LOG_DIR  override log directory (default: ~/.claude/logs)
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

skill="${1:?Usage: run-auto-task <skill-name>}"

log_dir="${CLAUDE_LOG_DIR:-$CLAUDE_DIR/logs}"
mkdir -p "$log_dir"
timestamp="$(date +%Y%m%d-%H%M%S)"
log_file="${log_dir}/${skill}-${timestamp}.log"
raw_file="${log_file%.log}.jsonl"

# ceiling: bypasses ai_backend so the skill can use slash commands, which
# _base_cmd() disables; route through the backend once it takes a slash-commands flag.
# Until then the raw stream is teed here and rendered back to readable text, so the
# call still lands in the usage ledger without the log turning into JSONL.
if ! command -v ai-usage-log > /dev/null 2>&1; then
  nohup claude -p "/$skill" --bare --permission-mode bypassPermissions \
    > "$log_file" 2>&1 & disown
  exit 0
fi

(
  trap '' HUP
  claude -p "/$skill" --bare --permission-mode bypassPermissions \
    --output-format stream-json --verbose 2>&1 |
    ai-usage-log render --tee "$raw_file" > "$log_file"
  rc="${PIPESTATUS[0]}"
  ai-usage-log record --from-log "$raw_file" --script run-auto-task \
    --entry-point agent --task "$skill" --exit-code "$rc" || true
) > /dev/null 2>&1 & disown
