#!/usr/bin/env python3
"""Workbench status line — reuse level + PR state.

Called by Claude Code statusline; receives session JSON on stdin.

Usage: workbench-statusline
  Reads session JSON on stdin (from Claude Code statusline hook).
  Outputs compact status: reuse level (if non-default) and PR state.
"""

from __future__ import annotations

import contextlib
import io
import subprocess
import sys
from pathlib import Path

if "--help" in sys.argv or "-h" in sys.argv:
    for line in (__doc__ or "").strip().splitlines():
        print(line)
    sys.exit(0)

BIN_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN_DIR))
sys.path.insert(0, str(BIN_DIR.parent.parent / "lib"))
from _reuse_levels import read_default, read_level

try:
    import pr_state
except Exception:
    # The status line renders on every turn and has no way to report a fault.
    # A broken ai/lib blanks the PR segment rather than killing the line.
    pr_state = None


def _reuse_piece() -> str:
    level = read_level()
    default = read_default()
    if level != default:
        return f"reuse:{level}"
    return ""


def _pr_piece() -> str:
    if pr_state is None:
        return ""

    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            return ""
        repo_root = result.stdout.strip()
    except Exception:
        return ""

    # load_state warns on stderr when the file will not parse. The status line
    # has nowhere to put that, so it is swallowed here; `pr status` and every
    # write path still surface it.
    with contextlib.redirect_stderr(io.StringIO()):
        state = pr_state.load_state(Path(repo_root))

    if state is None or not state.identity.pr_number:
        return ""

    label = f"PR#{state.identity.pr_number}"
    details = _pr_details(state)
    if details:
        label = f"{label} {details}"
    return label


def _pr_details(state: pr_state.PRState) -> str:
    parts: list[str] = []

    if state.ci.conclusion == "failure" and state.ci.failure_count > 0:
        parts.append(f"CI:{state.ci.failure_count}F")
    elif state.ci.conclusion == "success":
        parts.append("CI:ok")
    elif state.ci.conclusion:
        parts.append(f"CI:{state.ci.conclusion}")

    if state.review.verdict:
        parts.append(f"review:{state.review.verdict}")

    open_threads = state.comments.by_state.get("open") or 0
    if open_threads > 0:
        parts.append(f"{open_threads}open")

    return " ".join(parts)


def main() -> None:
    pieces: list[str] = []
    reuse = _reuse_piece()
    if reuse:
        pieces.append(reuse)
    try:
        pr = _pr_piece()
    except Exception:
        # Same policy as the guarded import above, applied to the whole segment:
        # the status line has nowhere to report a fault, so a broken PR segment
        # blanks itself instead of taking the line — and `reuse:` — down with it.
        pr = ""
    if pr:
        pieces.append(pr)
    if pieces:
        print(" ".join(pieces), end="")


if __name__ == "__main__":
    main()
