#!/usr/bin/env python3
"""Workbench status line — reuse level + PR state.

Called by Claude Code statusline; receives session JSON on stdin.

Usage: workbench-statusline
  Reads session JSON on stdin (from Claude Code statusline hook).
  Outputs compact status: reuse level (if non-default) and PR state.
"""

import os
import sys
from pathlib import Path

if "--help" in sys.argv or "-h" in sys.argv:
    for line in (__doc__ or "").strip().splitlines():
        print(line)
    sys.exit(0)

# ai/lib, from WORKBENCH_AI_LIB_DIR's checkout when that is set — see ai/bin/_libdir.py
_AI_LIB_DIR = Path(__file__).resolve().parent.parent.parent / "lib"
if os.environ.get("WORKBENCH_AI_LIB_DIR"):
    sys.path.insert(0, str(_AI_LIB_DIR.parent / "bin"))
    from _libdir import pinned_ai_lib_dir
    del sys.path[0]
    _AI_LIB_DIR = pinned_ai_lib_dir()
sys.path.insert(0, str(_AI_LIB_DIR))

from cli.workbench_statusline import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
