{
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.local/bin/workbench-statusline",
    "refreshInterval": 10
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); if printf '%s' \"$cmd\" | grep -qE '[>].*\\.superpowers/'; then printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"auto-allowed .superpowers/ write\"}}'; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.local/bin/claude-bash-guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file_path=$(jq -r '.tool_input.file_path // empty'); [[ -z \"$file_path\" ]] && exit 0; repo_dir=$(cd \"$(dirname \"$file_path\")\" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || exit 0; branch=$(git -C \"$repo_dir\" branch --show-current 2>/dev/null); [[ -z \"$branch\" ]] && exit 0; if [[ \"$branch\" == \"main\" || \"$branch\" == \"master\" ]]; then git -C \"$repo_dir\" check-ignore -q \"$file_path\" 2>/dev/null && exit 0; echo \"BLOCKED: Cannot edit files on $branch. Create a worktree first: wt switch -c <branch>\" >&2; exit 2; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file_path=$(jq -r '.tool_input.file_path // empty'); if [[ \"$file_path\" == *.sh ]]; then shellcheck \"$file_path\" 2>&1 | head -20 || true; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/bin/reuse-session-start 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/bin/reuse-mode-tracker 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.local/bin/reuse-subagent-start 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/skills/dream/should-dream.sh && run-auto-task dream || true"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/skills/promote/should-promote.sh && run-auto-task promote || true"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/skills/retro/should-retro.sh && run-auto-task retro || true"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/skills/anatomy/generate-anatomy.sh || true"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/skills/machine/generate-machine-profile.sh || true"
          },
          {
            "type": "command",
            "command": "repo=$(git rev-parse --show-toplevel 2>/dev/null) && bash $HOME/.claude/skills/ceiling-debt/should-ceiling-scan.sh \"$repo\" && python3 $HOME/.local/bin/ceiling-scan --output \"$repo/.claude/ceiling-debt.md\" \"$repo\" || true"
          },
          {
            "type": "command",
            "command": "find $HOME/.claude/logs -name '*.log' -mtime +7 -delete 2>/dev/null || true"
          }
        ]
      }
    ]
  },
