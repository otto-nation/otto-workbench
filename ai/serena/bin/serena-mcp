#!/usr/bin/env bash
# serena-mcp — scaffolds Serena MCP into a project's .mcp.json.
#
# Both files it touches are tracked project files, so it resolves the working
# tree they belong to before writing rather than trusting the current directory.
# A shell sitting in a bare-repo container has no working tree, and a .mcp.json
# written there is read by nothing and covered by no .gitignore, review, or CI
# check — see lib/worktree.sh and _scaffold_root() below.

set -e

_SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
# shellcheck source=/dev/null
. "$(dirname "$_SELF")/../../../lib/ui.sh"

# shellcheck disable=SC2034  # used by commands_usage() via nameref
COMMANDS=(
  "init"    "Add Serena to .mcp.json in the current project (creates if missing)"
  "status"  "Show whether Serena is configured in the current project"
)

MCP_NAME="serena"
SERENA_IGNORES=(".serena/")

# The canonical Serena MCP server entry — single source of truth.
SERENA_ENTRY='{
  "command": "uvx",
  "args": ["-p", "3.13", "--from", "git+https://github.com/oraios/serena", "serena", "init"]
}'

# ─── Helpers ──────────────────────────────────────────────────────────────────

# _scaffold_root — prints the directory .mcp.json and .gitignore belong in, or
# fails with the reason on stderr.
#
# project_root's 2 — no repository here at all — is not an error for this one:
# scaffolding a plain directory is a real thing to want, so it stands. Its 1 is
# fatal, and is the case this wrapper exists for: a container whose default
# branch has no checkout, where falling through to the current directory would
# write both files into the container itself.
_scaffold_root() {
  local root rc=0

  root="$(project_root)" || rc=$?
  if [[ "$rc" -eq 2 ]]; then
    pwd -P
    return 0
  fi
  if [[ "$rc" -ne 0 ]]; then
    err "No worktree resolved for $(pwd -P) — nothing scaffolded"
    return 1
  fi

  printf '%s\n' "$root"
}

# _ensure_gitignore — appends Serena entries to .gitignore if missing.
_ensure_gitignore() {
  local pattern added=false
  for pattern in "${SERENA_IGNORES[@]}"; do
    if [[ -f "$GITIGNORE_FILE" ]] && grep -qxF "$pattern" "$GITIGNORE_FILE"; then
      continue
    fi
    echo "$pattern" >> "$GITIGNORE_FILE"
    added=true
  done

  if [[ "$added" == true ]]; then
    success "Added Serena entries to $GITIGNORE_FILE"
  fi
}

# ─── Commands ─────────────────────────────────────────────────────────────────

cmd_init() {
  local existing="{}"
  if [[ -f "$MCP_FILE" ]]; then
    existing=$(cat "$MCP_FILE")
    if echo "$existing" | jq -e ".mcpServers.${MCP_NAME}" > /dev/null 2>&1; then
      success "Serena already configured in $MCP_FILE"
      return
    fi
    info "Adding Serena to existing $MCP_FILE"
  else
    info "Creating $MCP_FILE with Serena"
  fi

  local result
  result=$(echo "$existing" | jq --argjson entry "$SERENA_ENTRY" \
    '.mcpServers //= {} | .mcpServers.serena = $entry')

  printf '%s\n' "$result" > "$MCP_FILE"
  success "Serena configured in $MCP_FILE"

  _ensure_gitignore
}

cmd_status() {
  if [[ ! -f "$MCP_FILE" ]]; then
    info "No $MCP_FILE found"
    return
  fi

  if jq -e ".mcpServers.${MCP_NAME}" "$MCP_FILE" > /dev/null 2>&1; then
    success "Serena is configured in $MCP_FILE"
  else
    info "Serena is not configured in $MCP_FILE"
  fi
}

# ─── Main ─────────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Scaffold Serena MCP into a project's .mcp.json.

Usage: $(basename "$0") <command>

Commands:
$(commands_usage)

Serena is a heavyweight MCP server that starts LSP servers for code intelligence.
This script keeps it project-scoped so it only runs where explicitly enabled.

Both files are written to the working tree the current directory belongs to, so
a shell in a bare-repo container scaffolds the worktree rather than the container.
EOF
}

main() {
  local command="${1:-}" root

  case "$command" in
    init|status)
      root="$(_scaffold_root)" || exit 1
      MCP_FILE="$root/.mcp.json"
      GITIGNORE_FILE="$root/.gitignore"
      ;;
  esac

  case "$command" in
    init)   cmd_init ;;
    status) cmd_status ;;
    -h|--help|"")
      usage
      ;;
    *)
      err "Unknown command: $command"
      usage
      exit 1
      ;;
  esac
}

main "$@"
