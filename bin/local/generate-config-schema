#!/usr/bin/env python3
"""Generate the config schema and its docs reference from WorkbenchConfig.

Usage: bin/local/generate-config-schema [--check]
       bin/local/generate-config-schema --emit config-reference

The dataclass in ai/lib/workbench_config.py is the single definition of what
the workbench config holds; ai/lib/workbench_config_report.py renders it to the
JSON Schema editors and validators read, and to the key reference lib/config.sh's
header asks for with an `<!-- include: ... --emit config-reference -->` directive.
tests/test_workbench_config.py fails when the committed schema and the
generator disagree; bin/local/validate-docs-composed covers the docs block.

Options:
  --check              Exit 1 if a committed file is stale, without rewriting it
  --emit BLOCK         Print one generated block to stdout. Blocks:
                       config-reference
  -h, --help           Show this help
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

# Checked before REPO_ROOT is resolved via git, so --help works outside a
# git repo (e.g. `pip show`-style introspection, or a stray checkout).
if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
    print(__doc__.strip())
    sys.exit(0)

REPO_ROOT = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    ).stdout.strip(),
)
sys.path.insert(0, str(REPO_ROOT / "ai" / "lib"))

import workbench_config  # noqa: E402
import workbench_config_report  # noqa: E402

SCHEMA_FILE = REPO_ROOT / workbench_config.SCHEMA_PATH

# The committed schema carries a "regenerate with ..." banner naming this
# script, and workbench_config_report.py renders it, so it holds the name.
# Check it here rather than trusting it: this is the one place that knows where
# the script actually lives, and a banner pointing at a moved script sends the
# next reader after a command that no longer exists.
if Path(__file__).resolve() != (
    REPO_ROOT / workbench_config_report.GENERATOR_PATH
).resolve():
    raise SystemExit(
        f"{Path(__file__).resolve()} is not "
        f"{workbench_config_report.GENERATOR_PATH} — update GENERATOR_PATH in "
        f"{workbench_config_report.__file__}, or run this from its own checkout",
    )


# The blocks --emit can print, by the name a directive spells. Keyed on the
# name rather than dispatched through a chain of ifs, so adding a block is one
# entry here and the renderer it names.
BLOCKS = {"config-reference": workbench_config_report.docs_reference}


def render() -> list[tuple[Path, str]]:
    """Every file this generator owns, paired with the text it should hold."""
    return [(SCHEMA_FILE, workbench_config_report.schema_json() + "\n")]


def emit(name: str) -> int:
    """Print one generated block to stdout, for a compose-docs directive."""
    if name not in BLOCKS:
        names = ", ".join(sorted(BLOCKS))
        print(f"--emit: no block named {name!r}. Available: {names}", file=sys.stderr)
        return 1
    print(BLOCKS[name]())
    return 0


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    if argv and argv[0] == "--emit":
        if len(argv) != 2:
            print("--emit takes exactly one block name", file=sys.stderr)
            return 2
        return emit(argv[1])

    if argv and argv[0] not in ("--check",):
        print(f"Unknown argument: {argv[0]}\n\n{__doc__.strip()}", file=sys.stderr)
        return 2

    targets = render()

    if argv and argv[0] == "--check":
        stale = [
            path for path, text in targets
            if (path.read_text() if path.is_file() else "") != text
        ]
        if stale:
            names = ", ".join(str(p.relative_to(REPO_ROOT)) for p in stale)
            print(
                f"{names} is stale — run {workbench_config_report.GENERATOR_PATH}",
                file=sys.stderr,
            )
            return 1
        print(f"{len(targets)} generated files are current")
        return 0

    for path, text in targets:
        path.write_text(text)
        print(f"Generated {path.relative_to(REPO_ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
