#!/usr/bin/env python3
"""Generate config.schema.json from the WorkbenchConfig dataclass.

Usage: bin/local/generate-config-schema [--check]

The dataclass in ai/lib/workbench_config.py is the single definition of what
the workbench config holds; this renders it to the JSON Schema editors and
validators read. tests/test_workbench_config.py fails when the committed file
and the generator disagree.

Options:
  --check     Exit 1 if the committed file is stale, without rewriting it
  -h, --help  Show this help
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    ).stdout.strip(),
)
sys.path.insert(0, str(REPO_ROOT / "ai" / "lib"))

import workbench_config  # noqa: E402

SCHEMA_FILE = REPO_ROOT / "config.schema.json"


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    generated = workbench_config.schema_json() + "\n"

    if argv and argv[0] == "--check":
        current = SCHEMA_FILE.read_text() if SCHEMA_FILE.is_file() else ""
        if current != generated:
            print(
                "config.schema.json is stale — run bin/local/generate-config-schema",
                file=sys.stderr,
            )
            return 1
        print("config.schema.json is current")
        return 0

    SCHEMA_FILE.write_text(generated)
    print(f"Generated {SCHEMA_FILE.relative_to(REPO_ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
