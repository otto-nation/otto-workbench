#!/usr/bin/env python3
"""Generate herdr-app theme files from the palettes that own their colors.

Usage: bin/local/generate-herdr-app-themes [--check] [--palettes DIR] [--out DIR]
                                           [--tokens FILE] [--terminal DIR] [--site DIR]
                                           [--offline] [--resolve-brand]

Every ai/herdr/app/palettes/*.toml holds a [palette] of named colors and one
[themes.<name>] table per theme, whose values are palette names. A palette value
is #rrggbb or brand:<token> (the CSS custom property without its leading --).
[schemes] maps a theme name to light or dark and is never rendered; a theme that
uses brand: must have one. A theme table may set terminal = "brand", which
fills background, foreground, selection, cursor and ansi from the brand
terminal file for that theme's scheme; setting any of those keys as well is
an error, as is terminal = "brand" against a brand without terminal files
(needs @otto-nation/brand ≥ 1.3.0). Each theme is rendered to
ai/herdr/app/themes/<name>.generated.json with every name replaced by its hex;
sync links it into herdr-app as <name>.json (HERDR_APP_THEME_SUFFIX in
lib/constants.sh names the suffix for the sync side). herdr-app skips a theme file in which a color names another color, so the
JSON must carry literal hex values and cannot be the source.

Options:
  --check          Exit 1 if a theme file is stale or missing, without writing.
                   Implies --offline: never fetches.
  --palettes DIR   Read palettes from DIR (default: ai/herdr/app/palettes)
  --out DIR        Write themes to DIR (default: ai/herdr/app/themes)
  --tokens FILE    Read brand tokens from FILE instead of the pinned install
  --terminal DIR   Read otto-{light,dark}.json from DIR instead of the pin
  --site DIR       Site package root (default: <repo>/site)
  --offline        Do not fetch the pinned brand tarball
  --resolve-brand  Load brand tokens (fetching unless --offline), print the
                   source (tokens|installed|cache|fetched), write no themes.
  -h, --help       Show this help

Exit status: 0 up to date (or written), 1 stale under --check, 2 a palette is
invalid: a value that is not a palette name, a palette entry that is not
#rrggbb or brand:<token>, a missing or invalid [schemes] entry, an unknown
brand token, two palettes defining the same theme, terminal = "brand" against
a brand without terminal files, or terminal = "brand" with those keys also
set. 3 brand tokens unavailable — run bin/local/dev-deps.
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import io
import json
import os
import re
import sys
import tarfile
import time
import tomllib
from dataclasses import dataclass
from pathlib import Path

HEX = re.compile(r"^#[0-9a-fA-F]{6}$")
BRAND = re.compile(r"^brand:([a-z0-9-]+)$")
DECL = re.compile(r"--([a-z0-9-]+):\s*(#[0-9a-fA-F]{6})")
# tests/herdr_app_theme.bats checks this against HERDR_APP_THEME_SUFFIX.
SUFFIX = ".generated.json"
# The hosted runners see transient 5xx, 429 and timeouts from the registry; retry
# those, never any other 4xx.
FETCH_ATTEMPTS = 3
FETCH_BACKOFF = 5.0
# Layout 2 stores the tarball under herdr-app-themes/2/ so a 1.2.0-era entry
# (the tarball directly in herdr-app-themes/) is not opened as a brand that
# includes terminal files.
CACHE_LAYOUT = "2"
TERMINAL_KEYS = ("background", "foreground", "selection", "cursor", "ansi")


class PaletteError(Exception):
    """A palette file that cannot be rendered."""


class BrandError(Exception):
    """Brand tokens could not be loaded."""


@dataclass(frozen=True)
class BrandPin:
    url: str
    version: str
    integrity: str


@dataclass(frozen=True)
class BrandLoad:
    tokens: dict[str, dict[str, str]]
    source: str
    terminal: dict[str, dict]


def _parse_tokens(text: str) -> dict[str, dict[str, str]]:
    """Light and dark maps of token name to #rrggbb from a tokens.css body."""
    stripped = re.sub(r"/\*.*?\*/", "", text, flags=re.DOTALL)
    root_m = re.search(r":root\s*\{(.*?)\}", stripped, flags=re.DOTALL)
    if root_m is None:
        raise BrandError("brand tokens have no :root block")
    root = dict(DECL.findall(root_m.group(1)))
    dark_m = re.search(r"\.dark\s*\{(.*?)\}", stripped, flags=re.DOTALL)
    dark = dict(DECL.findall(dark_m.group(1))) if dark_m else {}
    return {"light": root, "dark": {**root, **dark}}


def _terminal_pair(read) -> dict[str, dict]:
    """Light and dark terminal maps from a reader of otto-<scheme>.json text."""
    raw: dict[str, dict] = {}
    for scheme in ("light", "dark"):
        body = read(scheme)
        if body is None:
            continue
        try:
            data = json.loads(body)
        except json.JSONDecodeError as err:
            raise BrandError(f"brand terminal otto-{scheme}.json is not JSON") from err
        if not isinstance(data, dict):
            raise BrandError(f"brand terminal otto-{scheme}.json is not an object")
        raw[scheme] = data
    return raw if len(raw) == 2 else {}


def _terminal_from_dir(path: Path) -> dict[str, dict]:
    """otto-{light,dark}.json from PATH, or {} if the pair is missing."""
    def read(scheme: str) -> str | None:
        file = path / f"otto-{scheme}.json"
        if not file.is_file():
            return None
        return file.read_text()

    return _terminal_pair(read)


def _pin(site: Path) -> BrandPin:
    """The pinned @otto-nation/brand URL, version and integrity from site/."""
    url = json.loads((site / "package.json").read_text()).get("dependencies", {}).get("@otto-nation/brand")
    if not url:
        raise BrandError("site/package.json has no dependencies[@otto-nation/brand]")
    entry = json.loads((site / "package-lock.json").read_text()).get("packages", {}).get("node_modules/@otto-nation/brand", {})
    version, integrity, resolved = entry.get("version"), entry.get("integrity"), entry.get("resolved")
    if not version:
        raise BrandError("site/package-lock.json has no packages[node_modules/@otto-nation/brand].version")
    if not integrity:
        raise BrandError("site/package-lock.json has no packages[node_modules/@otto-nation/brand].integrity")
    if not resolved:
        raise BrandError("site/package-lock.json has no packages[node_modules/@otto-nation/brand].resolved")
    if resolved != url:
        raise BrandError("site/package-lock.json is stale — run npm --prefix site install")
    return BrandPin(url=url, version=version, integrity=integrity)


def _installed(site: Path, pin: BrandPin) -> BrandLoad | None:
    """BrandLoad from node_modules when that install's version matches the pin."""
    pkg = site / "node_modules/@otto-nation/brand"
    manifest = pkg / "package.json"
    css = pkg / "src/tokens.css"
    if not manifest.is_file() or not css.is_file():
        return None
    if json.loads(manifest.read_text()).get("version") != pin.version:
        return None
    return BrandLoad(_parse_tokens(css.read_text()), "installed", _terminal_from_dir(pkg / "terminal"))


def _cache_path(pin: BrandPin) -> Path:
    """State-dir path of the pinned tarball; resolved per call from the live root."""
    from urllib.parse import urlparse
    import core.workbench_paths
    return (
        core.workbench_paths.state_dir()
        / "herdr-app-themes"
        / CACHE_LAYOUT
        / Path(urlparse(pin.url).path).name
    )


def _verified(blob: bytes, pin: BrandPin) -> bool:
    """Whether BLOB's sha512 matches the lock integrity."""
    digest = base64.b64encode(hashlib.sha512(blob).digest()).decode()
    return digest == pin.integrity.removeprefix("sha512-")


def _tar_text(tar: tarfile.TarFile, name: str) -> str | None:
    """Decoded member NAME, or None if it is missing."""
    try:
        member = tar.extractfile(name)
    except KeyError:
        return None
    if member is None:
        return None
    return member.read().decode()


def _package_from_tarball(blob: bytes) -> tuple[str, dict[str, dict]]:
    """tokens.css text and terminal maps from an npm-pack tarball body."""
    with tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz") as tar:
        text = _tar_text(tar, "package/src/tokens.css")
        if text is None:
            raise BrandError("brand tarball has no package/src/tokens.css")
        terminal = _terminal_pair(
            lambda scheme: _tar_text(tar, f"package/terminal/otto-{scheme}.json")
        )
    return text, terminal


def _cached(pin: BrandPin) -> BrandLoad | None:
    """BrandLoad from the verified cache tarball, or None if missing or corrupt."""
    path = _cache_path(pin)
    if not path.is_file():
        return None
    blob = path.read_bytes()
    if not _verified(blob, pin):
        return None
    text, terminal = _package_from_tarball(blob)
    return BrandLoad(_parse_tokens(text), "cache", terminal)


def _transient(err: Exception) -> bool:
    """Whether ERR is a 5xx/429, a timeout, a dropped connection or a DNS miss."""
    import socket
    from urllib.error import HTTPError, URLError
    if isinstance(err, HTTPError):
        return err.code >= 500 or err.code == 429
    if isinstance(err, URLError) and isinstance(err.reason, OSError):
        err = err.reason
    return isinstance(err, (TimeoutError, ConnectionError, socket.gaierror))


def _download(url: str) -> bytes | OSError:
    """One attempt at URL's body, or the error that ended it."""
    from urllib.request import urlopen
    import core.timeouts
    try:
        with urlopen(url, timeout=core.timeouts.TRANSFER) as resp:
            return resp.read()
    except OSError as err:
        return err


def _fetch(pin: BrandPin) -> BrandLoad:
    """Download the pin, verify, atomically cache, and return the brand load."""
    from urllib.parse import urlparse
    parsed = urlparse(pin.url)
    if parsed.scheme not in ("https", "file"):
        raise BrandError(f"brand tarball URL scheme {parsed.scheme!r} is not https or file")
    for attempt in range(1, FETCH_ATTEMPTS + 1):
        blob = _download(pin.url)
        if isinstance(blob, bytes):
            break
        if attempt == FETCH_ATTEMPTS or not _transient(blob):
            raise BrandError(f"brand tokens unavailable: {blob}") from blob
        time.sleep(FETCH_BACKOFF * attempt)
    if not _verified(blob, pin):
        raise BrandError("brand tarball failed integrity check")
    path = _cache_path(pin)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp")
    try:
        tmp.write_bytes(blob)
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)
    text, terminal = _package_from_tarball(blob)
    return BrandLoad(_parse_tokens(text), "fetched", terminal)


def _load_brand(
    tokens: Path | None,
    terminal_dir: Path | None,
    site: Path,
    offline: bool,
) -> BrandLoad:
    """Parsed tokens, terminal maps, and which source answered."""
    if tokens is not None:
        terminal = _terminal_from_dir(terminal_dir) if terminal_dir is not None else {}
        return BrandLoad(_parse_tokens(tokens.read_text()), "tokens", terminal)
    pin = _pin(site)
    loaded = _installed(site, pin)
    if loaded is None:
        loaded = _cached(pin)
    if loaded is None:
        if not offline:
            loaded = _fetch(pin)
        else:
            raise BrandError("brand tokens unavailable offline — run bin/local/dev-deps")
    if terminal_dir is not None:
        return BrandLoad(loaded.tokens, loaded.source, _terminal_from_dir(terminal_dir))
    return loaded


def _brand_loader(tokens: Path | None, terminal_dir: Path | None, site: Path, offline: bool):
    """Zero-argument brand loader: --tokens/--terminal, install, cache, then fetch."""
    loaded: BrandLoad | None = None

    def brand() -> BrandLoad:
        nonlocal loaded
        if loaded is None:
            loaded = _load_brand(tokens, terminal_dir, site, offline)
        return loaded

    return brand


def _resolve(value: object, palette: dict[str, str], where: str) -> object:
    """Replace every palette name in VALUE (a string, list or table) with its hex."""
    if isinstance(value, dict):
        return {k: _resolve(v, palette, f"{where}.{k}") for k, v in value.items()}
    if isinstance(value, list):
        return [_resolve(v, palette, f"{where}[{i}]") for i, v in enumerate(value)]
    if isinstance(value, str) and value in palette:
        return palette[value]
    raise PaletteError(f"{where}: {value!r} is not a name in [palette]")


def _palette_hex(
    name: str,
    value: object,
    source: Path,
    theme: str,
    schemes: dict,
    brand,
) -> str:
    """Literal #rrggbb for one palette entry, resolving brand:<token> via SCHEME."""
    if isinstance(value, str) and HEX.match(value):
        return value
    ref = BRAND.match(value) if isinstance(value, str) else None
    if ref is None:
        raise PaletteError(f"{source.name}: palette.{name} = {value!r} is not #rrggbb")
    scheme = schemes.get(theme)
    if scheme not in ("light", "dark"):
        raise PaletteError(
            f"{source.name}: themes.{theme} uses brand tokens but has no [schemes] entry"
        )
    hex_value = brand().tokens[scheme].get(ref.group(1))
    if hex_value is None:
        raise PaletteError(
            f"{source.name}: themes.{theme} palette.{name} = {value!r} is not a token"
        )
    return hex_value


def _fill_terminal(spec: dict, source: Path, theme: str, schemes: dict, brand) -> tuple[dict, dict]:
    """Theme spec without terminal keys, plus brand terminal values to splice in."""
    spec = dict(spec)
    mode = spec.pop("terminal", None)
    if mode is None:
        return spec, {}
    if mode != "brand":
        raise PaletteError(
            f"{source.name}: themes.{theme}.terminal = {mode!r} is not \"brand\""
        )
    clash = [key for key in TERMINAL_KEYS if key in spec]
    if clash:
        raise PaletteError(
            f"{source.name}: themes.{theme} terminal = \"brand\" cannot set {', '.join(clash)}"
        )
    scheme = schemes.get(theme)
    if scheme not in ("light", "dark"):
        raise PaletteError(
            f"{source.name}: themes.{theme} uses brand tokens but has no [schemes] entry"
        )
    block = brand().terminal.get(scheme)
    if not isinstance(block, dict) or any(key not in block for key in TERMINAL_KEYS):
        raise PaletteError(
            f"{source.name}: themes.{theme} terminal = \"brand\" "
            "needs @otto-nation/brand ≥ 1.3.0"
        )
    return spec, {key: block[key] for key in TERMINAL_KEYS}


def _render_source(source: Path, brand) -> dict[str, str]:
    """The theme files one palette file defines, each mapped to its text."""
    data = tomllib.loads(source.read_text())
    palette, themes = data.get("palette", {}), data.get("themes", {})
    schemes = data.get("schemes", {})
    for name, scheme in schemes.items():
        if name not in themes:
            raise PaletteError(f"{source.name}: schemes.{name} names an undefined theme")
        if scheme not in ("light", "dark"):
            raise PaletteError(f"{source.name}: schemes.{name} = {scheme!r} is not light or dark")
    files: dict[str, str] = {}
    for theme, spec in themes.items():
        rest, filled = _fill_terminal(spec, source, theme, schemes, brand)
        resolved = {
            name: _palette_hex(name, value, source, theme, schemes, brand)
            for name, value in palette.items()
        }
        files[f"{theme}{SUFFIX}"] = (
            json.dumps({**filled, **_resolve(rest, resolved, f"{source.name}: themes.{theme}")}, indent=2)
            + "\n"
        )
    return files


def render(palettes_dir: Path, brand) -> dict[str, str]:
    """Every theme file name mapped to the text it should hold."""
    out: dict[str, str] = {}
    for source in sorted(palettes_dir.glob("*.toml")):
        files = _render_source(source, brand)
        clash = sorted(files.keys() & out.keys())
        if clash:
            raise PaletteError(f"{source.name}: theme {clash[0].removesuffix(SUFFIX)!r} is defined by another palette too")
        out.update(files)
    return out


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--palettes", type=Path)
    parser.add_argument("--out", type=Path)
    parser.add_argument("--tokens", type=Path)
    parser.add_argument("--terminal", type=Path)
    parser.add_argument("--site", type=Path)
    parser.add_argument("--offline", action="store_true")
    parser.add_argument("--resolve-brand", action="store_true")
    parser.add_argument("-h", "--help", action="store_true")
    args = parser.parse_args(argv)
    if args.help:
        print(__doc__.strip())
        return 0

    root = Path(__file__).resolve().parents[2]
    palettes_dir = args.palettes or root / "ai/herdr/app/palettes"
    out_dir = args.out or root / "ai/herdr/app/themes"
    site = args.site or root / "site"
    sys.path.insert(0, str(root / "ai" / "lib"))
    offline = args.offline
    if args.check:
        offline = True

    try:
        if args.resolve_brand:
            print(_load_brand(args.tokens, args.terminal, site, offline).source)
            return 0
        files = render(palettes_dir, _brand_loader(args.tokens, args.terminal, site, offline))
    except BrandError as err:
        print(f"generate-herdr-app-themes: {err}", file=sys.stderr)
        return 3
    except (PaletteError, tomllib.TOMLDecodeError) as err:
        print(f"generate-herdr-app-themes: {err}", file=sys.stderr)
        return 2

    stale = [
        name for name, text in files.items()
        if not (out_dir / name).is_file() or (out_dir / name).read_text() != text
    ]
    if args.check:
        for name in stale:
            print(f"{out_dir / name} is stale — run bin/local/generate-herdr-app-themes", file=sys.stderr)
        return 1 if stale else 0
    out_dir.mkdir(parents=True, exist_ok=True)
    for name in stale:
        # A sibling temp file and an atomic replace: sync links these files
        # into herdr-app's config, so a half-written one would be read live.
        tmp = out_dir / f".{name}.tmp"
        try:
            tmp.write_text(files[name])
            os.replace(tmp, out_dir / name)
        finally:
            tmp.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
