#!/usr/bin/env bash
# Renders the module reference in docs/libraries.md from lib/ itself.
#
# A module's section is its own header comment. The block between the shebang
# and the first line of code is markdown, and this script prints it under an
# `### <name>` heading followed by the module's function table — so the prose
# describing a module lives beside the code it describes, and moving a function
# moves its documentation with it.
#
# Header conventions:
#
#   # doc-group: <key>   Which group the module belongs to. Optional; lib/*.sh
#                        defaults to `core` and lib/ai/*.sh to `ai`. The group
#                        headings and their intros are prose, and live in
#                        docs/libraries.src.md, which asks for each group by key.
#   # shellcheck ...     Skipped — a linter directive is not documentation.
#
# A header may itself carry an include directive; bin/local/compose-docs expands
# what this prints, so lib/roots.sh asks for its own roots table and lib/config.sh
# for the config key reference, each next to the prose that explains it.
#
# Modules are alphabetical within a group. Any other order would need a list of
# module names somewhere, and that list is the thing this script exists to avoid.
#
# Usage: bin/local/generate-lib-reference --group <key>
#        bin/local/generate-lib-reference --roots-table
#        bin/local/generate-lib-reference --groups

set -euo pipefail

_SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "$_SELF")/../.." && pwd)}"
# shellcheck source=/dev/null
. "$REPO_ROOT/lib/ui.sh"

LIB_DIR="${LIB_DIR:-$REPO_ROOT/lib}"

# The facade is described by the "Loading" section of docs/libraries.src.md and
# defines no functions of its own, so it gets no module section.
FACADE_MODULE="ui.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") --group <key>
       $(basename "$0") --roots-table
       $(basename "$0") --groups

Render the docs/libraries.md module reference from the lib/ sources.

Options:
  --group <key>  Print every module in that group, alphabetically
  --roots-table  Print the workbench roots table read from lib/roots.sh
  --groups       List the group keys the modules declare
  -h, --help     Show this help

Environment:
  LIB_DIR        Directory holding the modules (default: lib/)
EOF
}

# _lib_files ARRAY_REF — every documented module, alphabetical, lib/ then lib/ai/.
_lib_files() {
  local -n __out=$1
  local f
  __out=()
  for f in "$LIB_DIR"/*.sh "$LIB_DIR"/ai/*.sh; do
    if [[ -f "$f" && "${f##*/}" != "$FACADE_MODULE" ]]; then
      __out+=("$f")
    fi
  done
}

# _lib_group FILE — the group key FILE declares, or its directory's default.
#
# Read from the header block only, the same span _lib_header renders. A line
# further down the file that happens to read `# doc-group: x` — inside a code
# example, say — describes the convention rather than declaring a group.
# shellcheck disable=SC2016  # awk program, not shell expansion
_lib_group() {
  local declared
  declared="$(awk '
    NR == 1 { next }
    !/^#/ { exit }
    /^#[[:space:]]*doc-group:/ {
      sub(/^#[[:space:]]*doc-group:[[:space:]]*/, "")
      print
      exit
    }
  ' "$1")"
  if [[ -n "$declared" ]]; then
    printf '%s' "$declared"
    return 0
  fi
  if [[ "$1" == "$LIB_DIR"/ai/* ]]; then
    printf 'ai'
    return 0
  fi
  printf 'core'
}

# _lib_header FILE — the module's doc prose: the comment block under the
# shebang, uncommented, with linter directives and the group marker dropped.
# shellcheck disable=SC2016  # awk program, not shell expansion
_lib_header() {
  awk '
    NR == 1 { next }
    !/^#/ { exit }
    {
      line = $0
      sub(/^#[[:space:]]?/, "", line)
      if (line ~ /^shellcheck/ || line ~ /^doc-group:/) next
      print line
    }
  ' "$1"
}

# _lib_facade ARRAY_REF — the modules lib/ui.sh sources, so the note saying so
# is read off the facade instead of repeated in every module that is in it.
# shellcheck disable=SC2178  # __out is a nameref to an array — shellcheck misreads it
_lib_facade() {
  local -n __out=$1
  local name
  __out=()
  while IFS= read -r name; do
    __out+=("$name")
  done < <(sed -n 's|^[[:space:]]*\.[[:space:]].*/\([a-z_]*\.sh\)"$|\1|p' "$LIB_DIR/$FACADE_MODULE")
}

# _lib_doc_rows FILE — "signature<TAB>purpose" per public function in FILE.
#
# The convention the sources already follow: a comment block above the
# definition whose first line names the function. The purpose is the text after
# the em dash on that line, or the first following comment line when the
# signature stands alone. A function whose purpose comes out empty is
# undocumented, which _lib_check_purposes turns into a failure.
#
# The block is matched by name rather than by adjacency, so declarations
# between the comment and the definition (lib/install.sh has two) still pair up.
# shellcheck disable=SC2016  # awk program, not shell expansion
_lib_doc_rows() {
  awk '
    /^[[:space:]]*#/ {
      line = $0
      sub(/^[[:space:]]*#[[:space:]]?/, "", line)
      if (line ~ /^shellcheck/) next
      if (!in_block) { in_block = 1; n = 0 }
      block[++n] = line
      next
    }
    { in_block = 0 }
    /^[A-Za-z][A-Za-z0-9_]*\(\)/ {
      name = $0
      sub(/\(\).*/, "", name)
      if (n == 0 || substr(block[1], 1, length(name)) != name) { print name "\t"; next }
      sig = block[1]
      start = 2
      dash = index(sig, "—")
      if (dash > 0) {
        purpose = substr(sig, dash + length("—"))
        sig = substr(sig, 1, dash - 1)
      } else {
        purpose = ""
        while (start <= n && block[start] == "") start++
        purpose = block[start++]
      }
      # A purpose wrapped across comment lines keeps going until the sentence
      # closes, taking only as much of the line that closes it as the sentence
      # needs. What follows is detail the table has no room for — the reader
      # who wants it opens the file.
      while (purpose !~ /[.:!?]"?$/ && start <= n && block[start] != "") {
        cont = block[start++]
        stop = index(cont, ". ")
        if (stop > 0) cont = substr(cont, 1, stop)
        purpose = purpose " " cont
      }
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", sig)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", purpose)
      sub(/:$/, "", purpose)
      print sig "\t" purpose
    }
  ' "$1"
}

# _lib_functions_table FILE — the Function/Purpose table for one module, or
# nothing when the module offers no public functions.
_lib_functions_table() {
  local file="$1" sig purpose rows=""
  while IFS=$'\t' read -r sig purpose; do
    [[ -n "$sig" && -n "$purpose" ]] || continue
    [[ "$sig" == _* ]] && continue
    # shellcheck disable=SC2016  # backticks are markdown literals
    rows+="$(printf '| `%s` | %s |' "${sig//|/\\|}" "${purpose//|/\\|}")"$'\n'
  done < <(_lib_doc_rows "$file")
  [[ -n "$rows" ]] || return 0
  printf '\n| Function | Purpose |\n'
  printf '|----------|---------|\n'
  printf '%s' "$rows"
}

# _lib_roots_table — the three workbench roots, read from lib/roots.sh.
# Constant, XDG variable and default all come off the assignment; what the root
# holds is the comment above it, so the doc cannot claim a default the resolver
# does not use.
# shellcheck disable=SC2016  # awk program, not shell expansion
_lib_roots_table() {
  if [[ ! -f "$LIB_DIR/roots.sh" ]]; then
    err "lib/roots.sh is missing — cannot render the roots table"
    return 1
  fi
  printf '| Constant | Holds | XDG rung | Default |\n'
  printf '|----------|-------|----------|---------|\n'
  awk '
    /^[[:space:]]*#/ {
      line = $0
      sub(/^[[:space:]]*#[[:space:]]?/, "", line)
      if (line ~ /^shellcheck/) next
      if (!in_block) { in_block = 1; n = 0 }
      block[++n] = line
      next
    }
    { in_block = 0 }
    /^WORKBENCH_[A-Z]+_DIR=/ {
      if (n == 0) next
      name = $0
      sub(/=.*/, "", name)
      holds = block[1]
      sub(/[.[:space:]]+$/, "", holds)
      xdg = "—"
      if (match($0, /XDG_[A-Z]+_HOME/)) xdg = substr($0, RSTART, RLENGTH)
      def = "—"
      if (match($0, /\$HOME\/[^"]+/)) {
        def = substr($0, RSTART, RLENGTH)
        sub(/^\$HOME/, "~", def)
      }
      printf "| `%s` | %s | `%s` | `%s` |\n", name, holds, xdg, def
      n = 0
    }
  ' "$LIB_DIR/roots.sh"
}

# _lib_check_purposes FILE REL — fails, naming each one, when a public function
# in FILE has no documented purpose.
#
# An undocumented function would otherwise render as a blank table row, so the
# reference is only trustworthy if being incomplete stops the build.
_lib_check_purposes() {
  local file="$1" rel="$2" sig purpose ok=true
  while IFS=$'\t' read -r sig purpose; do
    [[ -n "$sig" && "$sig" != _* && -z "$purpose" ]] || continue
    err "lib/$rel: ${sig%% *} has no doc comment — add '# ${sig%% *} ARGS — purpose.' above it"
    ok=false
  done < <(_lib_doc_rows "$file")
  [[ "$ok" == true ]]
}

# _in_list NEEDLE HAYSTACK... — whether NEEDLE is one of the remaining arguments.
_in_list() {
  local needle="$1" item
  shift
  for item in "$@"; do
    if [[ "$item" == "$needle" ]]; then return 0; fi
  done
  return 1
}

# _render_module FILE REL FACADE... — one module's section.
#
# No leading blank line: the section starts where the include directive was, and
# the prose above it already ended with one. _emit_group supplies the separator
# between modules instead.
_render_module() {
  local file="$1" rel="$2"
  shift 2
  _lib_check_purposes "$file" "$rel" || return 1
  printf '### %s\n\n' "$rel"
  _lib_header "$file"
  _lib_functions_table "$file"
  if _in_list "$rel" "$@"; then
    # shellcheck disable=SC2016  # backticks are markdown literals
    printf '\nLoaded via `ui.sh`.\n'
  fi
}

# _emit_group KEY — every module in the group, alphabetical.
_emit_group() {
  local key="$1" file rel found=false
  local -a files=() facade=()
  _lib_files files
  _lib_facade facade
  for file in "${files[@]}"; do
    rel="${file#"$LIB_DIR"/}"
    [[ "$(_lib_group "$file")" == "$key" ]] || continue
    if [[ "$found" == true ]]; then printf '\n'; fi
    found=true
    _render_module "$file" "$rel" "${facade[@]}" || return 1
  done
  if [[ "$found" != true ]]; then
    err "--group: no module declares the group '$key'"
    return 1
  fi
}

# _emit_groups — every group key the modules declare, one per line.
_emit_groups() {
  local -a files=()
  local file
  _lib_files files
  for file in "${files[@]}"; do
    _lib_group "$file"
    printf '\n'
  done | sort -u
}

main() {
  local mode="" key=""
  while (( $# > 0 )); do
    case "$1" in
      -h|--help)     usage; return 0 ;;
      --groups)      mode="groups" ;;
      --roots-table) mode="roots" ;;
      --group)
        if [[ -z "${2:-}" ]]; then err "--group requires a group key"; return 2; fi
        mode="group"; key="$2"; shift
        ;;
      *) err "Unknown option: $1"; usage >&2; return 2 ;;
    esac
    shift
  done

  case "$mode" in
    group)  _emit_group "$key" ;;
    roots)  _lib_roots_table ;;
    groups) _emit_groups ;;
    *)      err "Nothing to do — pass --group, --roots-table, or --groups"; usage >&2; return 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
