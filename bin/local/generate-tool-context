#!/usr/bin/env bash
# Regenerates the AI tool-context rule files, and emits doc blocks on demand.
#
# Writes:
#   ai/guidelines/rules/tools.generated.md  — always-loaded tool context for AI sessions
#   ai/guidelines/rules/tools.generated.<scope>.md — path-scoped variants
#
# With --emit <name> it writes nothing and prints one documentation block to
# stdout instead. bin/local/compose-docs is the caller: a docs/<name>.src.md
# names the block it wants and this script answers, so neither side holds a list
# of the other's sections. A new block is a new _emit_<name> function here plus
# the include line in the source file that wants it.
#
# Run automatically via pre-push hook and otto-workbench sync.
# Never edit generated content directly — edit the source files instead.
#
# Registry discovery:
#   Uses collect_registries() to auto-discover all */registry.yml and /*/*/registry.yml
#   files, plus brew stacks (brew/*/*.registry.yml) and consumer env files (*.env.yml).
#   Adding a new registry requires only creating the file — no edits here.
#
# Each registry file must contain a `meta` block:
#   meta:
#     section:       "Section Title"   # H2 heading in generated output
#     scope:         go                # optional: routes into tools.generated.<scope>.md
#     install_check: false             # if true, omit tools not found in PATH
#     validation:    brewfile          # brewfile | bindir | zsh-comments | none
#     source:        brew/Brewfile     # relative path used by validate-registries
#
# Each tool entry has a `visibility` field controlling AI rendering:
#   visibility: full   — full entry (heading, description, when_to_use, usage)
#   visibility: brief  — compact one-liner
#   visibility: hidden — omitted from AI context
#
# Scoped output:
#   Registries with meta.scope route into tools.generated.<scope>.md with paths:
#   frontmatter (loaded only when the session touches matching file types).
#   Registries without scope (or scope: core) render into tools.generated.md
#   (always loaded, no frontmatter). Scope-to-paths mapping is defined in
#   SCOPE_PATHS below.
#
# Environment overrides (for tests):
#   REGISTRY_SCAN_DIR    root directory for registry discovery (default: REPO_ROOT)
#   BREW_STACKS_DIR      brew/ directory (scanned for *.registry.yml stacks)
#   TOOL_CONTEXT_OUTPUT  tools.generated.md path
#   TASKFILE_PATH        Taskfile.global.yml path
#   AI_DIR               ai/ directory

REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel)}"
WORKBENCH_DIR="${WORKBENCH_DIR:-$REPO_ROOT}"

# shellcheck source=/dev/null
. "$REPO_ROOT/lib/ui.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/lib/registries.sh"

# ── Helpers ───────────────────────────────────────────────────────────────────

# _join SEP ITEMS... — joins items with SEP
_join() {
  local sep=$1; shift
  local result="" item
  for item in "$@"; do
    [[ -n "$result" ]] && result+="$sep"
    result+="$item"
  done
  printf '%s' "$result"
}

# _iter_tools FILE CALLBACK
# Calls CALLBACK name description when_to_use usage docs commands_json for each tool in FILE.
_iter_tools() {
  local file="$1" cb="$2"
  [[ -f "$file" ]] || return 0
  local count i
  count=$(yq '.tools | length' "$file")
  for (( i=0; i<count; i++ )); do
    local name
    name=$(yq ".tools[$i].name" "$file")
    "$cb" \
      "$name" \
      "$(yq ".tools[$i].description"   "$file")" \
      "$(yq ".tools[$i].when_to_use"   "$file")" \
      "$(yq ".tools[$i].usage // \"\""  "$file")" \
      "$(yq ".tools[$i].docs  // \"\""  "$file")" \
      "$(yq -o=json ".tools[$i].commands // \"\""  "$file")"
  done
}

# _iter_tools_by_visibility FILE VISIBILITY CALLBACK
# Like _iter_tools but only calls CALLBACK for tools matching VISIBILITY (full|brief|hidden).
_iter_tools_by_visibility() {
  local file="$1" target_vis="$2" cb="$3"
  [[ -f "$file" ]] || return 0
  local count i
  count=$(yq '.tools | length' "$file")
  for (( i=0; i<count; i++ )); do
    local name vis
    name=$(yq ".tools[$i].name" "$file")
    vis=$(yq ".tools[$i].visibility" "$file")
    [[ "$vis" == "$target_vis" ]] || continue
    "$cb" \
      "$name" \
      "$(yq ".tools[$i].description"   "$file")" \
      "$(yq ".tools[$i].when_to_use // \"\""   "$file")" \
      "$(yq ".tools[$i].usage // \"\""  "$file")" \
      "$(yq ".tools[$i].docs  // \"\""  "$file")" \
      "$(yq -o=json ".tools[$i].commands // \"\""  "$file")"
  done
}

# ── tools.generated.md ────────────────────────────────────────────────────────

_render_subcommands() {
  local commands_json="$1"
  [[ -n "$commands_json" && "$commands_json" != "null" && "$commands_json" != '""' ]] || return 0
  local cmd_count cmd_i cmd_name cmd_desc
  cmd_count=$(printf '%s' "$commands_json" | jq 'length')
  [[ "$cmd_count" -gt 0 ]] || return 0
  printf -- '- **Subcommands**:\n'
  for (( cmd_i=0; cmd_i<cmd_count; cmd_i++ )); do
    cmd_name=$(printf '%s' "$commands_json" | jq -r ".[$cmd_i].name")
    cmd_desc=$(printf '%s' "$commands_json" | jq -r ".[$cmd_i].description")
    # shellcheck disable=SC2016  # backticks are markdown literals
    printf '  - `%s` — %s\n' "$cmd_name" "$cmd_desc"
  done
}

_tool_md_entry() {
  local name="$1" description="$2" when_to_use="$3" usage="$4"
  local commands_json="${6:-}"
  printf '\n### %s\n' "$name"
  printf '%s\n' "$description"
  printf -- '- **When to use**: %s\n' "$when_to_use"
  if [[ -z "$usage" || "$usage" == "null" ]]; then
    # >&2 needed: warn() writes to stdout; without redirect it leaks into $(_iter_tools_by_visibility ...)
    warn "generate-tool-context: '$name' has visibility: full but no usage field" >&2
  fi
  # shellcheck disable=SC2016  # backticks are markdown literals, not shell substitution
  if [[ -n "$usage" && "$usage" != "null" ]]; then printf -- '- **Usage**: `%s`\n' "$usage"; fi
  _render_subcommands "$commands_json"
}

_tool_ref_entry() {
  local name="$1" description="$2"
  printf -- '- **%s** — %s\n' "$name" "$description"
}

# Per-section buffers — multiple registries with the same meta.section accumulate
# here, then _flush_sections renders each section once: brief entries first (under
# the ## heading), then full entries (with ### headings). This prevents brief entries
# from visually nesting under a preceding full entry's heading.
declare -A _section_brief=()
declare -A _section_full=()
declare -a _section_order=()

# _collect_registry FILE — buffers tools into per-section accumulators.
_collect_registry() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local count
  count=$(yq '.tools | length' "$file")
  [[ "$count" -gt 0 ]] || return 0

  local section
  section=$(yq '.meta.section // "Tools"' "$file")

  local full_content brief_content
  full_content=$(_iter_tools_by_visibility "$file" "full" _tool_md_entry)
  brief_content=$(_iter_tools_by_visibility "$file" "brief" _tool_ref_entry)

  [[ -n "$full_content" || -n "$brief_content" ]] || return 0

  if [[ -z "${_section_brief[$section]+set}" ]]; then
    _section_order+=("$section")
    _section_brief[$section]=""
    _section_full[$section]=""
  fi

  [[ -n "$brief_content" ]] && _section_brief[$section]+="$brief_content"$'\n'
  [[ -n "$full_content" ]] && _section_full[$section]+="$full_content"$'\n'
  return 0
}

# _flush_sections — renders all accumulated sections in discovery order, then resets.
_flush_sections() {
  local _sec
  for _sec in "${_section_order[@]}"; do
    local brief="${_section_brief[$_sec]}"
    local full="${_section_full[$_sec]}"
    [[ -n "$brief" || -n "$full" ]] || continue
    printf '\n## %s\n' "$_sec"
    [[ -n "$brief" ]] && printf '%s' "$brief"
    [[ -n "$full" ]] && printf '%s' "$full"
    :
  done
  _section_brief=()
  _section_full=()
  _section_order=()
}

# ── Scope → paths mapping ────────────────────────────────────────────────────
# Centralized here so registries stay simple (just `scope: go`). Adding a new
# scope requires an entry here and `scope:` in the registry YAML.

declare -gA SCOPE_PATHS
SCOPE_PATHS[go]='  - "**/*.go"
  - "**/go.mod"
  - "**/go.sum"'
SCOPE_PATHS[java]='  - "**/*.java"
  - "**/*.kt"
  - "**/*.kts"
  - "**/build.gradle*"
  - "**/pom.xml"'
SCOPE_PATHS[infra]='  - "**/Dockerfile*"
  - "**/compose*.yml"
  - "**/compose*.yaml"
  - "**/*.tf"
  - "**/k8s/**"
  - "**/kubernetes/**"'
SCOPE_PATHS[workbench]='  - "**/bin/local/**"
  - "**/lib/*.sh"
  - "**/install.components"'

# ── Documentation blocks ─────────────────────────────────────────────────────
#
# Every _emit_<name> function below is a block --emit can print, and a block a
# docs/*.src.md can include. The mapping is the name itself, so neither this
# script nor the composer keeps a list of them.

# shellcheck disable=SC2016  # backticks are markdown literals, not shell substitution
_tool_readme_row() { printf '| `%s` | %s |\n' "$1" "$2"; }

_emit_scripts_table() {
  printf '| Script | Description |\n'
  printf '|--------|-------------|\n'
  local -a _script_registries=()
  collect_registries _script_registries "${REGISTRY_SCAN_DIR:-$REPO_ROOT}" "$BREW_STACKS_DIR"
  for _reg in "${_script_registries[@]}"; do
    local _val
    _val=$(yq '.meta.validation // ""' "$_reg")
    if [[ "$_val" == "bindir" ]]; then
      _iter_tools "$_reg" _tool_readme_row
    fi
  done
}

_emit_tasks_block() {
  local count i key desc
  printf '```bash\n'
  count=$(yq '.tasks | to_entries | length' "$TASKFILE_PATH")
  for (( i=0; i<count; i++ )); do
    key=$(yq ".tasks | to_entries[$i].key" "$TASKFILE_PATH")
    desc=$(yq ".tasks | to_entries[$i].value.desc // \"\"" "$TASKFILE_PATH")
    # Exclude utility/infrastructure tasks; only surface user-facing AI tasks
    [[ "$key" == brew:* || "$key" == "help" ]] && continue
    [[ -z "$desc" || "$desc" == "null" ]] && continue
    printf 'task --global %-20s # %s\n' "$key" "$desc"
  done
  printf '```\n'
}

# _extract_frontmatter_field FILE FIELD — reads a YAML frontmatter field from a markdown file.
_extract_frontmatter_field() {
  local file="$1" field="$2"
  sed -n '/^---$/,/^---$/p' "$file" 2>/dev/null \
    | grep "^${field}:" \
    | sed "s/^${field}:[[:space:]]*//" \
    | sed 's/^"\(.*\)"$/\1/' \
    | head -1 \
    || true
}

_emit_ai_installs() {
  # Derive display paths from constants, replacing $HOME prefix with ~
  local claude_home="~${CLAUDE_DIR#"$HOME"}"
  local claude_rules="~${CLAUDE_RULES_DIR#"$HOME"}"
  # Source dirs within the repo
  local skills_src="$AI_DIR/skills"
  local claude_agents_src="$AI_DIR/claude/agents"
  local claude_mcps_src="$AI_DIR/claude/mcps"

  printf '**Claude Code:**\n'
  # shellcheck disable=SC2016  # backticks are markdown literals, not shell substitution
  printf -- '- `%s/settings.json` — permissions and deny rules (merged, not overwritten)\n' "$claude_home"
  # shellcheck disable=SC2016
  printf -- '- `%s/CLAUDE.md` — coding guidelines\n' "$claude_home"
  # shellcheck disable=SC2016
  printf -- '- `%s/` — language and tool-specific rules (symlinked)\n' "$claude_rules"

  # Skills summary with link to the full Skill Reference section
  local skill_names=()
  for d in "$skills_src"/*/; do
    [[ -d "$d" ]] || continue
    skill_names+=("$(basename "$d")")
  done
  if [[ ${#skill_names[@]} -gt 0 ]]; then
    # shellcheck disable=SC2016  # backticks are markdown literals
    printf '\n**Skills:** %s — see [Skill Reference](#skill-reference) for invocation, output, and lifecycle details.\n' \
      "$(_join ', ' "${skill_names[@]}")"
  fi

  # Agents table with descriptions from agent .md frontmatter
  local has_agents=false
  for f in "$claude_agents_src"/*.md; do
    [[ -f "$f" ]] || continue
    if [[ "$has_agents" == false ]]; then
      printf '\n**Agents:**\n\n'
      printf '| Agent | Description |\n'
      printf '|-------|-------------|\n'
      has_agents=true
    fi
    local agent_name agent_desc
    agent_name="$(basename "${f%.md}")"
    agent_desc="$(_extract_frontmatter_field "$f" "description")"
    [[ -z "$agent_desc" ]] && agent_desc="—"
    printf '| %s | %s |\n' "$agent_name" "$agent_desc"
  done

  # MCPs
  local mcps=()
  for f in "$claude_mcps_src"/*.json; do
    if [[ -f "$f" ]]; then
      mcps+=("$(jq -r '.name // ""' "$f")")
    fi
  done
  if [[ ${#mcps[@]} -gt 0 ]]; then
    printf '\n**MCP Servers:** %s\n' "$(_join ', ' "${mcps[@]}")"
  fi

}

# _emit_lifecycle — renders the Session Lifecycle section for ai-automation.md.
# Explains the auto-trigger pipeline. Skill cadences are shown in the skills table
# rendered by _emit_ai_installs (single source for all skill metadata).
_emit_lifecycle() {
  printf '## Session Lifecycle\n\n'
  # shellcheck disable=SC2016  # backticks are markdown literals
  printf 'Skills with a cadence (shown in the table above) auto-trigger via Stop hooks in `settings.json`:\n\n'
  # shellcheck disable=SC2016  # backticks are markdown literals
  printf '1. **Session exit** — Stop hooks run `should-<skill>.sh` cooldown checks. If due, creates `~/.claude/.<skill>-pending`\n'
  printf '2. **Next session start** — Claude reads CLAUDE.md, sees the pending flag, runs the skill as a background subagent, then deletes the flag\n'
  printf '3. **Skill completion** — completion script records a timestamp so the cooldown resets\n'
  # shellcheck disable=SC2016  # backticks are markdown literals
  printf '\nAdditionally, `wt-cleanup --quiet` runs on every session exit to remove stale git worktrees.\n'
  printf '\n### Manual triggers\n\n'
  # shellcheck disable=SC2016  # backticks are markdown literals
  printf 'All lifecycle skills can be run on demand: `/ceiling-debt`, `/dream`, `/promote`, `/retro`, `/anatomy`, `/machine`.\n'
}

# _emit_skill_reference — renders the Skill Reference section for ai-automation.md.
# Reads invocation, description, output, and lifecycle fields from each SKILL.md frontmatter.
_emit_skill_reference() {
  local skills_src="$AI_DIR/skills"

  printf '## Skill Reference\n'

  for d in "$skills_src"/*/; do
    [[ -d "$d" ]] || continue
    local skill_file="$d/SKILL.md"
    [[ -f "$skill_file" ]] || continue

    local skill_name skill_desc invocation output cadence trigger skip output_tool
    skill_name="$(basename "$d")"
    skill_desc="$(_extract_frontmatter_field "$skill_file" "description")"
    invocation="$(_extract_frontmatter_field "$skill_file" "invocation")"
    output="$(_extract_frontmatter_field "$skill_file" "output")"
    cadence="$(_extract_frontmatter_field "$skill_file" "lifecycle_cadence")"
    trigger="$(_extract_frontmatter_field "$skill_file" "trigger")"
    skip="$(_extract_frontmatter_field "$skill_file" "skip")"
    output_tool=$(awk '
      NR==1 && /^---$/ { in_fm=1; next }
      in_fm && /^---$/ { exit }
      in_fm && /^output_schema:/ { in_os=1; next }
      in_os && /^[^ ]/ { exit }
      in_os && /^[[:space:]]*tool:[[:space:]]/ { sub(/.*tool:[[:space:]]*/, ""); gsub(/["\047]/, ""); print; exit }
    ' "$skill_file")

    [[ -z "$invocation" ]] && invocation="/$skill_name"
    [[ -z "$skill_desc" ]] && skill_desc="—"

    # shellcheck disable=SC2016  # backticks are markdown literals
    printf '\n### `%s`\n\n' "$invocation"
    printf '%s\n\n' "$skill_desc"
    printf '```\n%s\n```\n' "$invocation"

    if [[ -n "$output" ]]; then
      # shellcheck disable=SC2016  # backticks are markdown literals
      printf '\n**Output:** `%s`\n' "$output"
    fi
    if [[ -n "$output_tool" ]]; then
      # shellcheck disable=SC2016  # backticks are markdown literals
      printf '**Output schema:** `%s --tool-schema` (MCP tool: `%s`)\n' "$output_tool" "$output_tool"
    fi
    if [[ -n "$cadence" ]]; then
      printf '**Auto-trigger:** %s (via Stop hook)\n' "$cadence"
    fi
    if [[ -n "$trigger" ]]; then
      printf '**Trigger:** %s\n' "$trigger"
    fi
    if [[ -n "$skip" ]]; then
      printf '**Skip:** %s\n' "$skip"
    fi
  done
}

# _tool_readme_table_row NAME DESCRIPTION WHEN_TO_USE USAGE DOCS
# Renders a single row for the README tools table. Name links to docs if available.
_tool_readme_table_row() {
  local name="$1" description="$2" docs="$5"
  local display_name
  if [[ -n "$docs" && "$docs" != "null" ]]; then
    display_name="[${name}](${docs})"
  else
    display_name="$name"
  fi
  printf '| %s | %s |\n' "$display_name" "$description"
}

# _render_readme_registry FILE — renders a single registry as a tools table section.
# Skips the section if no tools are present. Does NOT filter by install_check
# because the README is reference documentation, not runtime context.
_render_readme_registry() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local count
  count=$(yq '.tools | length' "$file")
  [[ "$count" -gt 0 ]] || return 0

  local section
  section=$(yq '.meta.section // "Tools"' "$file")

  local content
  content=$(_iter_tools "$file" _tool_readme_table_row)
  [[ -n "$content" ]] || return 0

  printf '\n**%s**\n\n' "$section"
  printf '| Tool | Description |\n'
  printf '|------|-------------|\n'
  printf '%s\n' "$content"
}

_emit_tools_table() {
  # Same registry order as tools.generated.md, but skip bin and zsh (they have their own sections)
  _render_readme_registry "$BREW_REGISTRY"
  _render_readme_registry "$MISE_REGISTRY"
  while IFS= read -r -d '' registry; do
    _render_readme_registry "$registry"
  done < <(find "$BREW_STACKS_DIR" -mindepth 2 -maxdepth 2 -name '*.registry.yml' -print0 | sort -z)
}

# _emit_after_install — numbered post-install steps from setup.conf post_install fields.
_emit_after_install() {
  [[ -f "$COMPONENTS_FILE" ]] || return 0
  local step_num=1
  # shellcheck disable=SC2016  # backticks are markdown literals, not shell substitution
  printf '%d. **Reload your shell**: `exec zsh`\n' "$step_num"
  step_num=$(( step_num + 1 ))

  local component conf note
  while IFS= read -r component; do
    [[ -z "$component" || "$component" =~ ^# ]] && continue
    conf="$REPO_ROOT/$component/setup.conf"
    [[ -f "$conf" ]] || continue
    note=$(conf_get "$conf" post_install) || true
    [[ -n "$note" ]] || continue
    printf '%d. %s\n' "$step_num" "$note"
    step_num=$(( step_num + 1 ))
  done < "$COMPONENTS_FILE"
}

# _emit_core_components — discovers core components (steps.sh without setup.conf).
_emit_core_components() {
  local names=()
  for steps in "$REPO_ROOT"/*/steps.sh; do
    [[ -f "$steps" ]] || continue
    local dir
    dir=$(dirname "$steps")
    # Core = has steps.sh but no setup.conf (not an optional component)
    [[ -f "$dir/setup.conf" ]] && continue
    names+=("\`$(basename "$dir")\`")
  done
  printf '**Existing core components:** %s\n' "$(_join ', ' "${names[@]}")"
}

# _emit_optional_components — lists optional components from install.components with sync info.
_emit_optional_components() {
  [[ -f "$COMPONENTS_FILE" ]] || return 0
  local entries=() component label sync_note
  while IFS= read -r component; do
    [[ -z "$component" || "$component" =~ ^# ]] && continue
    local conf="$REPO_ROOT/$component/setup.conf"
    [[ -f "$conf" ]] || continue
    label=$(conf_get "$conf" label)
    [[ -n "$label" ]] || label="$component"
    if [[ -f "$REPO_ROOT/$component/steps.sh" ]]; then
      sync_note="has sync"
    else
      sync_note="no sync"
    fi
    entries+=("\`$component\` ($sync_note)")
  done < "$COMPONENTS_FILE"
  printf '**Existing optional components:** %s\n' "$(_join ', ' "${entries[@]}")"
}

# _emit_workbench_commands — renders otto-workbench subcommands table + detail paragraphs
# from the `commands` array on the otto-workbench entry in bin/registry.yml.
_emit_workbench_commands() {
  [[ -f "$BIN_REGISTRY" ]] || return 0
  local count
  count=$(yq '.tools[] | select(.name == "otto-workbench") | .commands | length' "$BIN_REGISTRY" 2>/dev/null)
  [[ "$count" -gt 0 ]] || return 0

  # Command table with optional detail column
  printf '| Command | Scope | Description |\n'
  printf '|---------|-------|-------------|\n'
  local i
  for (( i=0; i<count; i++ )); do
    local cmd scope desc
    cmd=$(yq ".tools[] | select(.name == \"otto-workbench\") | .commands[$i].name" "$BIN_REGISTRY")
    scope=$(yq ".tools[] | select(.name == \"otto-workbench\") | .commands[$i].scope" "$BIN_REGISTRY")
    desc=$(yq ".tools[] | select(.name == \"otto-workbench\") | .commands[$i].description" "$BIN_REGISTRY")
    # shellcheck disable=SC2016  # backticks are markdown literals
    printf '| `otto-workbench %s` | %s | %s |\n' "$cmd" "$scope" "$desc"
  done
}

# ── Main ─────────────────────────────────────────────────────────────────────

# _block_names — every block --emit accepts, one per line.
#
# Read off the defined functions rather than a list, so adding a block is
# adding a function and nothing else.
_block_names() {
  declare -F | sed -n 's/^declare -f _emit_//p' | tr '_' '-' | sort
}

# _emit NAME — prints one documentation block on stdout.
_emit() {
  local fn="_emit_${1//-/_}"
  if ! declare -F "$fn" > /dev/null; then
    err "--emit: no block named '$1'. Available:"
    _block_names | sed 's/^/  /' >&2
    return 1
  fi
  "$fn"
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [--quiet]
       $(basename "$0") --emit <block>

Regenerate the tools.generated*.md rule files from the source registries.

With --emit nothing is written: one documentation block is printed to stdout
instead. bin/local/compose-docs is the caller, via an include directive in a
docs/*.src.md.

Options:
  --emit <block>  Print the named block to stdout
  --quiet         Suppress per-file success messages
  -h, --help      Show this help

Blocks:
$(_block_names | sed 's/^/  /')
EOF
}

# _init_paths — the source locations every block and the rule files read from.
_init_paths() {
  BREW_STACKS_DIR="${BREW_STACKS_DIR:-"$REPO_ROOT/brew"}"
  BREW_REGISTRY="${BREW_REGISTRY:-"$REPO_ROOT/brew/registry.yml"}"
  MISE_REGISTRY="${MISE_REGISTRY:-"$REPO_ROOT/mise/registry.yml"}"
  BIN_REGISTRY="${BIN_REGISTRY:-"$REPO_ROOT/bin/registry.yml"}"
  OUTPUT="${TOOL_CONTEXT_OUTPUT:-"$REPO_ROOT/$TOOLS_GENERATED_RELPATH"}"
  TASKFILE_PATH="${TASKFILE_PATH:-"$REPO_ROOT/Taskfile.global.yml"}"
  AI_DIR="${AI_DIR:-"$REPO_ROOT/ai"}"
  COMPONENTS_FILE="${COMPONENTS_FILE:-"$REPO_ROOT/install.components"}"
}

main() {
  set -euo pipefail

  QUIET=false
  local emit=""
  while (( $# > 0 )); do
    case "$1" in
      -h|--help) usage; return 0 ;;
      --quiet)   QUIET=true ;;
      --emit)
        if [[ -z "${2:-}" ]]; then err "--emit requires a block name"; return 2; fi
        emit="$2"; shift
        ;;
      *) err "Unknown option: $1"; usage >&2; return 2 ;;
    esac
    shift
  done

  if ! command -v yq >/dev/null 2>&1; then
    err "yq not found — run: brew install yq"
    return 1
  fi

  _init_paths

  if [[ -n "$emit" ]]; then
    _emit "$emit"
    return
  fi

  _gen_success() { $QUIET || success "$*"; }

  _tool_registries=()
  collect_registries _tool_registries "${REGISTRY_SCAN_DIR:-$REPO_ROOT}" "$BREW_STACKS_DIR"

  # Group registries by meta.scope (empty/core → core group, others → named scope)
  declare -a _core_registries=()
  declare -A _scope_registries=()
  for _reg in "${_tool_registries[@]}"; do
    _scope=$(yq '.meta.scope // ""' "$_reg")
    if [[ -z "$_scope" || "$_scope" == "null" || "$_scope" == "core" ]]; then
      _core_registries+=("$_reg")
    else
      _scope_registries["$_scope"]+="$_reg"$'\n'
    fi
  done

  OUTPUT_DIR="$(dirname "$OUTPUT")"

  # Core file — always loaded, no frontmatter.
  declare -A _section_brief=() _section_full=()
  declare -a _section_order=()
  {
    printf '# Tools\n'
    printf '<!-- AUTO-GENERATED — do not edit directly -->\n'
    printf '<!-- Regenerate: generate-tool-context -->\n'
    for _reg in "${_core_registries[@]}"; do
      _collect_registry "$_reg"
    done
    _flush_sections
  } > "$OUTPUT"
  $QUIET || success "Generated $(basename "$OUTPUT")"

  # Scoped files — loaded only when the session touches matching file types.
  for _scope in "${!_scope_registries[@]}"; do
    _scope_output="$OUTPUT_DIR/tools.generated.${_scope}.md"
    _scope_regs="${_scope_registries[$_scope]}"
    _paths="${SCOPE_PATHS[$_scope]:-}"

    if [[ -z "$_paths" ]]; then
      err "Scope '$_scope' has no entry in SCOPE_PATHS — add a paths mapping before using it"
      return 1
    fi

    _section_brief=(); _section_full=(); _section_order=()
    {
      printf -- '---\npaths:\n%s\n---\n' "$_paths"
      printf '# Tools — %s\n' "$_scope"
      printf '<!-- AUTO-GENERATED — do not edit directly -->\n'
      printf '<!-- Regenerate: generate-tool-context -->\n'
      while IFS= read -r _reg; do
        [[ -z "$_reg" ]] && continue
        _collect_registry "$_reg"
      done <<< "$_scope_regs"
      _flush_sections
    } > "$_scope_output"
    $QUIET || success "Generated $(basename "$_scope_output")"
  done

  # Clean up stale scope files (scopes that no longer have registries).
  for _existing in "$OUTPUT_DIR"/tools.generated.*.md; do
    [[ -f "$_existing" ]] || continue
    _stale_file="$(basename "$_existing")"
    _existing_scope="${_stale_file#tools.generated.}"
    _existing_scope="${_existing_scope%.md}"
    if [[ -z "${_scope_registries[$_existing_scope]+set}" ]]; then
      rm "$_existing"
      $QUIET || info "Removed stale $(basename "$_existing")"
    fi
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
