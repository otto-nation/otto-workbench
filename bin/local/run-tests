#!/usr/bin/env bash
# run-tests — run the bats and pytest suites with the repo's parallelism settings.
#
# The three callers that run the suites — Taskfile.yml, the pre-push hook, and
# CI — used to spell the invocation out themselves, and drifted: pre-push passed
# --jobs 8, CI passed --jobs 4, and the Taskfile passed nothing at all, so
# `task test` took 318s for the suite pre-push finished in 92s. The flags live
# here now, and all three call this.
#
# Output is the runner's own, unfiltered: pre-push parses the TAP stream for its
# slow-test report, so nothing may sit between bats and its caller. Verbosity is
# left at each runner's default — CI used to pass pytest -v, which under xdist
# prints five thousand PASSED lines interleaved across a dozen workers and says
# nothing the failure output does not. A caller that wants it back passes it
# after --.
#
# Usage: bin/local/run-tests [--bats|--pytest] [--shard N/M] [-- RUNNER_ARGS...]
# Exit code: 0 when every suite it ran passed, 1 otherwise.

set -e

_SELF="${BASH_SOURCE[0]}"
# Path arithmetic rather than `git rev-parse --show-toplevel`: the pre-push hook
# runs this with GIT_DIR exported, and with one set git skips discovery and
# answers the caller's cwd instead of the repo root. See lib/ui.sh's header.
WORKBENCH_DIR="$(cd "$(dirname "$_SELF")/../.." && pwd)"
# shellcheck source=../../lib/ui.sh
. "$WORKBENCH_DIR/lib/ui.sh"

# Same GIT_DIR, one rung lower. A test that inherits it runs its `git -C <tmp>`
# calls against the real repo instead: a suite caught here staged 2400 temp
# files into the workbench's own index and wrote a placeholder identity to its
# config. tests/test_helper.bash clears these per test as well — this is the
# belt to that suspenders, since the hook is the only caller that sets them and
# this is the one place every hook-run suite passes through.
unset GIT_DIR GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# Both suites are bound by disk contention rather than CPU — every case builds a
# temp tree and shells out to git — so throughput plateaus well below the core
# count. Measured on an 18-core machine with nothing else running: bats runs the
# suite in 318s at --jobs 1, 92s at 8, 80s at 12, and 83s at 16.
#
# ceiling: one cap for both runners, derived from bats' curve. Upgrade to a
# per-runner cap if pytest's own measured plateau lands somewhere other than 12.
TEST_JOBS_CAP=12

# The suite does not fail gracefully when it cannot get scheduled: a subprocess
# that never runs surfaces as a timeout, a SIGPIPE, or a git daemon that will
# not answer, none of which name the machine as the cause. Three whole-suite
# runs at 12 jobs each on 18 cores produced a handful of such failures every
# time, and never the same test twice. The slot pool is what keeps the second
# and third runs out of that territory; the floor is what keeps them making
# progress rather than queueing behind the first.
TEST_JOBS_FLOOR=2

# JOBS — the resolved parallelism, set once by main() before either suite runs.
JOBS=""

# JOBS_CORES — the core count the pool was sized from. report_jobs() reads it
# rather than recomputing, so the figure it prints is the one JOBS came from.
JOBS_CORES=""

# test_jobs — how many test processes to run at once.
#
# The cap, less whatever the machine's other test runs are already holding. A
# slot is claimed for the length of this run, so a sibling that started a
# moment ago has already taken its share — which is the whole reason this is
# not sized from the load average. That average is a one-minute figure, so two
# suites launched within a minute of each other both read an idle machine and
# both take the cap: 24 heavy processes on 18 cores. Measured here, the bats
# suite takes 299s with 12 jobs and 377s when a concurrent run has pushed it to
# 7 — and that 7 was itself a lagging read of load its sibling had just made.
#
# The claim itself happens later, in main(), because a flock must wrap the work
# rather than be taken and returned. This only decides what to ask for.
#
# Under CI the pool is skipped entirely: a hosted runner is dedicated to this
# job, the three bats shards run on separate runners, and a pool keyed on a
# machine-wide state dir would only ever contend with itself.
#
# TEST_JOBS overrides everything for a caller that knows better — a shared
# runner that should not take the whole box, or a bisect that wants the serial
# ordering back with TEST_JOBS=1.
#
# side effect: sets JOBS and JOBS_CORES; does not echo a value.
test_jobs() {
  JOBS_CORES=$(cpu_count) || JOBS_CORES=1
  if [[ -n "${TEST_JOBS:-}" ]]; then
    JOBS="$TEST_JOBS"
    return 0
  fi
  JOBS=$(( JOBS_CORES < TEST_JOBS_CAP ? JOBS_CORES : TEST_JOBS_CAP ))
}

# report_jobs — say how parallel this run is, and why, before it starts.
#
# A suite sized down by another worktree's run looks exactly like a suite that
# is simply slow: `JOBS` is resolved silently, so the only signal is a wall
# time three times the usual one, discoverable after the fact and only by
# someone who knows the usual one. The same suite has run at 88s and 241s on
# this machine within the hour, and nothing in either run's output said which
# it was going to be.
#
# To stderr, because the pre-push hook captures this script's stdout to count
# passes out of it — a line on stdout would be parsed as a test result.
report_jobs() {
  if [[ -n "${TEST_JOBS:-}" ]]; then
    info "Test parallelism: ${JOBS} job(s) — set by TEST_JOBS" >&2
    return 0
  fi
  # The granted count, not the requested one: WORKBENCH_TEST_SLOTS_GRANTED is
  # what the pool actually handed this run, and saying so is the point of the
  # line. A run sized down by a sibling otherwise looks like a suite that is
  # simply slow.
  local granted="${WORKBENCH_TEST_SLOTS_GRANTED:-$JOBS}"
  local why="${JOBS_CORES} cores, capped at ${TEST_JOBS_CAP}"
  if [[ -n "${CI:-}" ]]; then
    why="${why}, pool skipped under CI"
  elif (( granted < JOBS )); then
    why="${why}; pool granted ${granted} — another test run holds the rest"
    if (( granted <= TEST_JOBS_FLOOR )); then
      why="${why}, expect a slow run"
    fi
  fi
  info "Test parallelism: ${granted} job(s) (${why})" >&2
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [--bats|--pytest] [--shard N/M] [-- RUNNER_ARGS...]

Run the test suites with the repo's parallelism settings. With no suite flag,
runs bats and then pytest, stopping at the first failure.

Options:
  --bats          Run only the bats suite
  --pytest        Run only the pytest suite
  --shard N/M     Run only shard N of M (1-indexed). Partitions bats files
                  via longest-processing-time packing on @test count.
  --files LIST    Run only the bats files in LIST (newline-separated paths).
                  Used by the pre-push hook for change-based selection.
  --pytest-files LIST
                  Run only the pytest files in LIST (newline-separated paths).
                  The pytest counterpart of --files.
  --changed       Run only the files the diff against origin/main can reach,
                  via select-tests and select-pytest. Falls back to the whole
                  suite when a selector is missing or declines to narrow.
  --              Pass every remaining argument through to the runner
  -h, --help      Show this help

Environment:
  TEST_JOBS       Parallel test processes. Defaults to at least $TEST_JOBS_FLOOR, at most $TEST_JOBS_CAP,
                  and within that to whatever share of the machine this repo's
                  other test runs are not already holding. Set it to take the
                  sizing back; TEST_JOBS=1 restores the serial ordering.
EOF
}

# _find_min_bucket TOTAL — echo the index of the bucket with the smallest load.
# Reads bucket_load[] from the caller's scope.
_find_min_bucket() {
  local total="$1" j min_idx=0 min_load=${bucket_load[0]}
  for (( j = 1; j < total; j++ )); do
    [[ ${bucket_load[$j]} -lt $min_load ]] || continue
    min_load=${bucket_load[$j]}
    min_idx=$j
  done
  echo "$min_idx"
}

# shard_files SHARD TOTAL — emit the test file paths for shard SHARD of TOTAL.
#
# Partitions by longest-processing-time (LPT) packing on @test count: sort files
# by descending test count, then assign each to the lightest bucket. Deterministic
# under LC_ALL=C. Files are emitted one per line, absolute paths.
shard_files() {
  local shard="$1" total="$2"
  if [[ "$shard" -lt 1 || "$shard" -gt "$total" ]]; then
    err "--shard: shard $shard out of range 1..$total"
    return 1
  fi

  # Collect (test_count, filename) pairs sorted by descending test count, then
  # by filename for stability when counts are equal.
  local -a weights=() files=()
  local count fname
  while IFS= read -r line; do
    count="${line%% *}"
    fname="${line#* }"
    weights+=("$count")
    files+=("$fname")
  done < <(
    for f in "$WORKBENCH_DIR"/tests/*.bats; do
      c=$(grep -c '^@test ' "$f" 2>/dev/null) || c=0
      echo "$c $(basename "$f")"
    done | LC_ALL=C sort -rn -k1,1 -k2,2
  )

  # LPT packing: assign each file to the bucket with the smallest load.
  local -a bucket_load=()
  local -a bucket_assign=()
  local i
  for (( i = 0; i < total; i++ )); do
    bucket_load[$i]=0
  done
  for (( i = 0; i < ${#files[@]}; i++ )); do
    local min_idx
    min_idx=$(_find_min_bucket "$total")
    bucket_assign[$i]=$min_idx
    bucket_load[$min_idx]=$(( ${bucket_load[$min_idx]} + ${weights[$i]} ))
  done

  # Emit files assigned to the requested shard (0-indexed internally).
  local target=$(( shard - 1 ))
  for (( i = 0; i < ${#files[@]}; i++ )); do
    if [[ ${bucket_assign[$i]} -eq $target ]]; then
      echo "$WORKBENCH_DIR/tests/${files[$i]}"
    fi
  done
}

# run_bats ARGS... — the bats suite, TAP on stdout.
#
# --timing is not optional: the pre-push hook reads the per-test durations out
# of this stream to report the ones over its threshold.
#
# When SHARD is set (N/M), only the files assigned to that shard are run.
run_bats() {
  # A test that swaps HOME changes what mise considers its global config, and
  # mise ignores `trusted_config_paths` in a config that is not the global one
  # — after which the file is untrusted, which mise treats as an error. Every
  # jq and yq call in that test then dies, because both are mise shims on a
  # machine that manages them, and the failure names YAML rather than mise.
  #
  # Pinned here rather than in common_setup because setup_file() runs before
  # any per-test setup, and a file that swaps HOME there is already too late
  # for the helper to correct. This is the one place every caller — pre-push,
  # CI, the Taskfile — goes through.
  export MISE_GLOBAL_CONFIG_FILE="${MISE_GLOBAL_CONFIG_FILE:-$HOME/.config/mise/config.toml}"

  # Give this worktree's run a scratch root of its own. bats derives one from
  # $TMPDIR when this is unset, so two worktrees running the suite at once take
  # sibling directories under one machine-wide parent — and the tree lock does
  # not separate them, because it is per-tree while $TMPDIR is per-machine.
  #
  # A test pinning TMPDIR to its own bats scratch then writes inside that
  # parent, so anything sweeping it takes the other run's live directory with
  # it. What that looks like is not a failed assertion: the sibling run loses
  # the files bats itself is writing, and reports `teardown_file failed` for
  # tests that never ran, with a total short of the suite's real count.
  #
  # Keyed by worktree path and pid so concurrent runs cannot collide, and
  # removed on the way out because bats only cleans a root it created itself.
  # The trap is EXIT rather than RETURN so an interrupted run collects too;
  # a leftover from a killed run is orphaned garbage rather than a blocker for
  # the next one — the pid suffix makes the path unique per invocation, and a
  # fresh run only collides with it on pid reuse.
  if [[ -z "${BATS_RUN_TMPDIR:-}" ]]; then
    local tree_id
    tree_id="$(printf '%s' "$WORKBENCH_DIR" | shasum | cut -c1-8)"
    BATS_RUN_TMPDIR="${TMPDIR:-/tmp}/workbench-bats-$tree_id.$$"
    export BATS_RUN_TMPDIR
    # shellcheck disable=SC2064  # expand now: the path must survive the trap
    trap "rm -rf '$BATS_RUN_TMPDIR'" EXIT
  fi

  local jobs_flag=()
  # bats farms tests out through GNU parallel and silently runs them serially
  # without it, so the flag is only worth passing when parallel is installed.
  command -v parallel >/dev/null 2>&1 && jobs_flag=(--jobs "$(granted_jobs)")

  if [[ -n "${SHARD:-}" ]]; then
    local shard_n="${SHARD%/*}"
    local shard_m="${SHARD#*/}"
    local -a shard_test_files=()
    while IFS= read -r f; do
      shard_test_files+=("$f")
    done < <(shard_files "$shard_n" "$shard_m")
    if [[ ${#shard_test_files[@]} -eq 0 ]]; then
      err "--shard $SHARD: produced an empty file list"
      return 1
    fi
    bats "${shard_test_files[@]}" --timing "${jobs_flag[@]}" "$@"
  elif [[ -n "${BATS_FILES:-}" ]]; then
    local -a file_list=()
    while IFS= read -r f; do
      [[ -n "$f" ]] && file_list+=("$f")
    done <<< "$BATS_FILES"
    if [[ ${#file_list[@]} -eq 0 ]]; then
      err "--files: no files provided"
      return 1
    fi
    bats "${file_list[@]}" --timing "${jobs_flag[@]}" "$@"
  else
    bats "$WORKBENCH_DIR/tests/" --recursive --timing "${jobs_flag[@]}" "$@"
  fi
}

# run_pytest ARGS... — the pytest suite.
#
# xdist is a soft dependency: this repo installs no Python packages of its own,
# so a checkout whose pytest has no xdist plugin still runs the suite, just
# serially. -p xdist is probed rather than assumed for that reason.
#
# --basetemp is not cosmetic. Without it every worktree's run shares
# $TMPDIR/pytest-of-$USER, and pytest's own numbered-directory cleanup sweeps
# that shared root on exit — so three concurrent suites each walk and rm_rf a
# tree the other two are writing into, on a disk they are already contending
# for. Keyed by worktree and pid, matching what run_bats does with
# BATS_RUN_TMPDIR, and left behind on exit because pytest's own `keep=3`
# retention is what collects it.
run_pytest() {
  local jobs_flag=()
  if pytest -VV 2>/dev/null | grep -q xdist; then
    jobs_flag=(-n "$(granted_jobs)")
  else
    # Say so rather than just being six times slower. A pytest that resolves to
    # a different interpreter than the one xdist was installed into — a version
    # manager's shim taking precedence over pipx on PATH, say — turns a 65s
    # suite into a 420s one, and nothing in the output names the cause.
    warn "pytest has no xdist plugin: running serially. $(command -v pytest)" >&2
  fi

  local basetemp_flag=()
  if [[ -z "${PYTEST_DEBUG_TEMPROOT:-}" ]]; then
    local tree_id
    tree_id="$(printf '%s' "$WORKBENCH_DIR" | shasum | cut -c1-8)"
    basetemp_flag=(--basetemp "${TMPDIR:-/tmp}/workbench-pytest-$tree_id.$$")
  fi

  if [[ -n "${PYTEST_FILES:-}" ]]; then
    local -a file_list=()
    while IFS= read -r f; do
      [[ -n "$f" ]] && file_list+=("$f")
    done <<< "$PYTEST_FILES"
    if [[ ${#file_list[@]} -eq 0 ]]; then
      err "--pytest-files: no files provided"
      return 1
    fi
    pytest "${file_list[@]}" "${jobs_flag[@]}" "${basetemp_flag[@]}" "$@"
    return
  fi
  pytest "$WORKBENCH_DIR/tests/" "${jobs_flag[@]}" "${basetemp_flag[@]}" "$@"
}

# SHARD — when set, only this shard's files are run. Format: N/M.
SHARD=""

# BATS_FILES — when set, run only these bats files (newline-separated paths).
BATS_FILES=""

# PYTEST_FILES — when set, run only these pytest files (newline-separated).
PYTEST_FILES=""

# CHANGED — when true, ask the selectors what the diff can reach.
CHANGED=false

# select_changed — fill BATS_FILES and PYTEST_FILES from the selectors.
#
# A selector that is missing, fails, or prints nothing leaves its variable
# empty, which run_bats and run_pytest read as "the whole suite". That is the
# only safe direction to fail: a selection that silently narrowed to nothing
# would report a green gate having run no tests.
# No --base, so the selectors use their own default of origin/main, and no
# fetch either — unlike the pre-push hook, which passes the ref it has just
# fetched. That divergence is deliberate and safe in this direction: both
# selectors diff `origin/main...HEAD`, which resolves through the merge base,
# so a local origin/main that is behind the real one moves that base *earlier*
# and selects a superset. The failure mode of a stale base here is running too
# many tests, never too few. Fetching instead would put a network round trip
# in front of the target developers run between edits.
select_changed() {
  local selected
  if [[ "$1" != pytest ]] && [[ -x "$WORKBENCH_DIR/bin/local/select-tests" ]]; then
    selected=$("$WORKBENCH_DIR/bin/local/select-tests" 2>/dev/null) || selected=""
    BATS_FILES="$selected"
  fi
  if [[ "$1" != bats ]] && [[ -x "$WORKBENCH_DIR/bin/local/select-pytest" ]]; then
    selected=$("$WORKBENCH_DIR/bin/local/select-pytest" 2>/dev/null) || selected=""
    PYTEST_FILES="$selected"
  fi
}

# granted_jobs — the parallelism this run actually holds.
#
# The pool wrapper exports what it granted, which is at most what JOBS asked
# for and less when a sibling run holds the rest. Reading it here rather than
# overwriting JOBS keeps the request and the grant separable, which is what
# lets report_jobs() say "asked 12, got 5" instead of only "5".
granted_jobs() {
  echo "${WORKBENCH_TEST_SLOTS_GRANTED:-$JOBS}"
}

main() {
  local -a ORIGINAL_ARGS=("$@")
  local suite=all
  local -a runner_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --bats) suite=bats ;;
      --pytest) suite=pytest ;;
      --shard) shift; SHARD="$1" ;;
      --files) shift; BATS_FILES="$1" ;;
      --pytest-files) shift; PYTEST_FILES="$1" ;;
      --changed) CHANGED=true ;;
      --) shift; runner_args=("$@"); break ;;
      *) err "Unknown option: $1"; usage >&2; exit 1 ;;
    esac
    shift
  done

  if [[ -n "$SHARD" && "$suite" != bats ]]; then
    err "--shard only applies to the bats suite; pass --bats"
    exit 1
  fi

  if [[ -n "$BATS_FILES" && "$suite" != bats ]]; then
    err "--files only applies to the bats suite; pass --bats"
    exit 1
  fi

  if [[ -n "$PYTEST_FILES" && "$suite" != pytest ]]; then
    err "--pytest-files only applies to the pytest suite; pass --pytest"
    exit 1
  fi

  if $CHANGED && [[ -n "$SHARD$BATS_FILES$PYTEST_FILES" ]]; then
    err "--changed cannot be combined with --shard, --files or --pytest-files"
    exit 1
  fi

  if [[ -n "$SHARD" && -n "$BATS_FILES" ]]; then
    err "--shard and --files are mutually exclusive"
    exit 1
  fi

  if [[ -n "$SHARD" ]]; then
    if ! [[ "$SHARD" =~ ^[0-9]+/[0-9]+$ ]]; then
      err "--shard: expected N/M (e.g. 1/3), got '$SHARD'"
      exit 1
    fi
  fi

  if [[ "$suite" == all && ${#runner_args[@]} -gt 0 ]]; then
    err "Pass-through arguments need a suite: --bats or --pytest"
    exit 1
  fi

  # Resolved once, before either suite starts, so bats and pytest run at the
  # same parallelism rather than pytest being sized from whatever bats just
  # left behind.
  #
  # Called directly rather than through `JOBS=$(test_jobs)`: a command
  # substitution runs the function in a subshell, which would discard the
  # JOBS_CORES global it sets before report_jobs() below gets to read it.
  test_jobs

  # Two wrappers, in this order, both re-execing rather than calling: a flock
  # lives only as long as the process holding its descriptor, so each has to
  # wrap this script rather than be taken from inside it. Their markers
  # (WORKBENCH_TREE_LOCK, WORKBENCH_TEST_SLOTS) are what stop the re-entry
  # recursing.
  #
  # The tree lock first, the slot claim second. The tree lock can wait — it is
  # shared, but a concurrent validator holds it — and slots held across that
  # wait would be capacity reserved by a run that is not yet running. Claiming
  # after it means the grant is taken at the moment the suite actually starts.
  if [[ -z "${WORKBENCH_TREE_LOCK:-}" ]]; then
    exec "$WORKBENCH_DIR/bin/local/with-tree-lock" "$WORKBENCH_DIR" \
      --label "bin/local/run-tests" -- "$WORKBENCH_DIR/bin/local/run-tests" \
      "${ORIGINAL_ARGS[@]+"${ORIGINAL_ARGS[@]}"}"
  fi

  # Skipped under CI and when TEST_JOBS pins the count: a hosted runner is
  # dedicated to this job and should take the whole box, and a caller that has
  # named a number is not asking to be sized.
  if [[ -z "${WORKBENCH_TEST_SLOTS:-}" && -z "${CI:-}" && -z "${TEST_JOBS:-}" ]]; then
    exec "$WORKBENCH_DIR/bin/local/claim-job-slots" \
      --want "$JOBS" --floor "$TEST_JOBS_FLOOR" --cores "$JOBS_CORES" \
      --label "bin/local/run-tests" -- "$WORKBENCH_DIR/bin/local/run-tests" \
      "${ORIGINAL_ARGS[@]+"${ORIGINAL_ARGS[@]}"}"
  fi

  # After both re-execs, not before: each pre-wrapper process execs away, so a
  # report written there is printed again by the process that replaces it. It
  # also has to come after the claim, since the granted count is the number
  # worth announcing.
  report_jobs

  # After the re-execs too: the selectors shell out to git and read every test
  # file, which is work the pre-exec process would throw away.
  if $CHANGED; then
    select_changed "$suite"
  fi

  [[ "$suite" == pytest ]] || run_bats "${runner_args[@]+"${runner_args[@]}"}"
  [[ "$suite" == bats ]] || run_pytest "${runner_args[@]+"${runner_args[@]}"}"
}

# Guarded so tests/run_tests.bats can source the sizing functions without
# running a suite.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
