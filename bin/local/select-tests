#!/usr/bin/env bash
# select-tests — emit the bats test files affected by a set of changed paths.
#
# Derives dependencies by grepping path literals ($REPO_ROOT/...) from each
# test file and matching them against the changed paths. When a library file
# changes, its reverse-transitive closure is computed — every script that
# sources it (directly or through a chain) is treated as also changed, so a
# test referencing a bin/ script is selected when one of that script's
# transitive lib/ deps changes. A test whose dependencies a path literal cannot
# name — a directory it lists, a registry scan, a path built from bash -c's
# positionals — declares them on a `# select-on: PATTERN...` line (see
# _declared_patterns).
#
# Usage: select-tests [--base REF] [--paths-file FILE] [--validate] [--all]
#   --base REF     Diff against REF (default: origin/main)
#   --validate     Fail if any test file has neither refs nor a select-on
#                  declaration (catches renames that silently break the map), if a
#                  suite hands the repo root to a collect_* scanner without
#                  declaring what it scans, or if a declared pattern matches no
#                  tracked file
#   --all          Print all test files (used when fallback triggers fire)
#
# Output: one absolute path per line, suitable for passing to bats.
# Exit code: 0 on success, including when nothing is selected — empty output
# then means no bats file is affected; non-zero on error.

set -e

_SELF="${BASH_SOURCE[0]}"
WORKBENCH_DIR="$(cd "$(dirname "$_SELF")/../.." && pwd)"

# shellcheck source=../../lib/ui.sh
. "$WORKBENCH_DIR/lib/ui.sh"

TESTS_DIR="$WORKBENCH_DIR/tests"

# Fallback triggers — changes to these run the full suite. Only the helper
# every suite loads belongs here. A per-area helper selects the suites that
# load it (_loads_helper). run-tests and select-tests are selected by their own
# suites' refs — the pre-push hook runs both on every push, so a break in either
# shows there — and a workflow file is CI's, which runs the whole suite anyway.
FULL_SUITE_TRIGGERS=(
  tests/test_helper.bash
)

# ── Transitive dependency graph ────────────────────────────────────────────────
# Build a forward-edge map (file → files it sources) from every bash script
# under lib/ and bin/, then invert it to answer "what scripts are affected when
# this file changes" via reverse-transitive closure.

# _source_edges_for REL_PATH — emit the repo-relative paths a script directly sources.
# REL_PATH is relative to WORKBENCH_DIR. Handles five forms:
#   1a. $WORKBENCH_DIR/lib/X.sh   (absolute via variable)
#   1b. $LIB_SRC_DIR/X.sh         (absolute via variable, always resolves to lib/)
#   2.  $_*_lib_dir/X.sh          (sibling in the same directory)
#   3.  $(dirname ...)/X.sh       (sibling or parent-relative, any number of
#                                  ../ hops climbing from the sourcing file's
#                                  own directory or a directory variable)
#   4.  $(git -C ... rev-parse --show-toplevel)/X.sh  (absolute via inline
#                                  git call, no intermediate variable)
# Not every sourcing pattern in the repo is covered — see the ceiling note on
# _build_dep_graph for the coverage boundary and its upgrade trigger.
_source_edges_for() {
  local rel_path="$1"
  local file="$WORKBENCH_DIR/$rel_path"
  local file_dir
  file_dir="$(dirname "$rel_path")"

  # Form 1a: absolute via $WORKBENCH_DIR / $REPO_ROOT / $_SCRIPT_ROOT
  grep -nE '(source|\.)\s+"\$\{?(WORKBENCH_DIR|REPO_ROOT|_SCRIPT_ROOT)\}?/' "$file" 2>/dev/null \
    | grep -v '^[0-9]*:\s*#' \
    | grep -oE '\$\{?(WORKBENCH_DIR|REPO_ROOT|_SCRIPT_ROOT)\}?/[^"]+' \
    | sed -E 's/^\$\{?(WORKBENCH_DIR|REPO_ROOT|_SCRIPT_ROOT)\}?\///' \
    || true

  # Form 1b: $LIB_SRC_DIR/X.sh — always resolves to lib/X.sh
  grep -nE '(source|\.)\s+"\$LIB_SRC_DIR/' "$file" 2>/dev/null \
    | grep -v '^[0-9]*:\s*#' \
    | grep -oE '\$LIB_SRC_DIR/[^"]+' \
    | sed 's/^\$LIB_SRC_DIR/lib/' \
    || true

  # Form 2: $_*_lib_dir/X.sh — these vars always resolve to the sourcing
  # file's own directory, so the dep is a sibling.
  grep -oE '\$_[a-z_]*_lib_dir/[^"]+' "$file" 2>/dev/null \
    | sed -E 's/^\$_[a-z_]*_lib_dir\///' \
    | grep -E '\.(sh|bash)$' \
    | while IFS= read -r sibling; do echo "${file_dir}/${sibling}"; done \
    || true

  # Form 3: $(dirname "$_*_dir")/X.sh, $(dirname "${BASH_SOURCE...")/X.sh, or
  # $(dirname "$_SELF")/../../X.sh — dirname of $BASH_SOURCE/$_SELF is the
  # file's own dir → sibling; dirname of a $_foo_dir living in lib/ai → lib/
  # (parent). Any ../ hops after the dirname(...) call climb further still.
  grep -oE '"\$\(dirname [^)]+\)[a-z_./]*\.sh"' "$file" 2>/dev/null \
    | sed 's/^"//; s/"$//' \
    | while IFS= read -r expr; do
        local arg suffix base_dir
        arg="${expr#*dirname }"
        arg="${arg%%\)*}"
        suffix="${expr#*\)}"
        if [[ "$arg" == *'BASH_SOURCE'* || "$arg" == *'_SELF'* ]]; then
          base_dir="$file_dir"
        elif [[ "$arg" == *'_dir'* ]]; then
          base_dir="$(dirname "$file_dir")"
        else
          continue
        fi
        while [[ "$suffix" == /..* ]]; do
          suffix="${suffix#/..}"
          base_dir="$(dirname "$base_dir")"
        done
        if [[ "$base_dir" == "." ]]; then
          echo "${suffix#/}"
        else
          echo "${base_dir}${suffix}"
        fi
      done \
    || true

  # Form 4: $(git -C ... rev-parse --show-toplevel)/X.sh — resolves inline to
  # the repo root without an intermediate WORKBENCH_DIR-style variable.
  grep -oE '"\$\(git -C .* rev-parse --show-toplevel\)/[a-z_/]+\.sh"' "$file" 2>/dev/null \
    | sed -E 's/.*rev-parse --show-toplevel\)\///' \
    | sed 's/"$//' \
    || true
}

# _DEP_GRAPH_BUILT — set to 1 after _build_dep_graph runs.
_DEP_GRAPH_BUILT=0

# _build_dep_graph — scan every bash script under lib/, bin/, ai/, git/, zsh/,
# docker/ and build the reverse dependency map. Called once, cached.
#
# ceiling: _source_edges_for only recognizes the four literal forms
# documented above it. A script that sources through an arbitrary
# intermediate variable — e.g. git/bin/local/generate-git-rules assigning
# CONVENTIONS_SH="${CONVENTIONS_SH:-"$REPO_ROOT/lib/conventions.sh"}" and
# then sourcing "$CONVENTIONS_SH" — resolves to a real dependency this
# graph never records, so a change to that file will not select tests
# reachable only through such a script. Upgrade trigger: a second
# custom-variable sourcing indirection shows up elsewhere in the repo,
# at which point add a form for a `. "$VAR"` where VAR's own definition
# line contains a WORKBENCH_DIR/REPO_ROOT-rooted default.
_build_dep_graph() {
  [[ $_DEP_GRAPH_BUILT -eq 1 ]] && return 0

  # _REVERSE_DEPS must be declared here rather than at file scope: when this
  # file is sourced inside a function (e.g. bats setup()), a file-scope
  # `declare -A` creates a local that vanishes when the sourcing function
  # returns, leaving an untyped global that treats ["lib/ui.sh"] as arithmetic.
  declare -gA _REVERSE_DEPS 2>/dev/null || declare -A _REVERSE_DEPS
  _REVERSE_DEPS=()

  # Forward edges: file → files it sources
  local -A forward=()
  local script dep rel
  while IFS= read -r script; do
    rel="${script#"$WORKBENCH_DIR"/}"
    while IFS= read -r dep; do
      [[ -z "$dep" ]] && continue
      forward["$rel"]+="$dep "
    done < <(_source_edges_for "$rel")
  done < <(
    find "$WORKBENCH_DIR/lib" "$WORKBENCH_DIR/bin" \
         "$WORKBENCH_DIR/ai" "$WORKBENCH_DIR/git" \
         "$WORKBENCH_DIR/zsh" "$WORKBENCH_DIR/docker" \
         -type f \( -name '*.sh' -o -name '*.bash' \) \
         ! -path '*/.git/*' ! -path '*/node_modules/*' 2>/dev/null
    # Also include extensionless scripts (e.g. bin/otto-workbench,
    # ai/bin/workbench-rules, git/bin/generate-changelog)
    find "$WORKBENCH_DIR/bin" "$WORKBENCH_DIR/ai" "$WORKBENCH_DIR/git" \
         "$WORKBENCH_DIR/zsh" "$WORKBENCH_DIR/docker" \
         -type f ! -name '*.*' \
         ! -path '*/.git/*' ! -path '*/node_modules/*' 2>/dev/null
  )

  # Invert: for each edge A→B, record B has dependent A.
  local source_file
  for source_file in "${!forward[@]}"; do
    local deps="${forward[$source_file]}"
    for dep in $deps; do
      _REVERSE_DEPS["$dep"]+="$source_file "
    done
  done

  _DEP_GRAPH_BUILT=1
  return 0
}

# _reverse_closure FILE — emit every script that transitively depends on FILE.
# Uses BFS over _REVERSE_DEPS. Includes FILE itself.
_reverse_closure() {
  local start="$1"
  local -A visited=()
  local -a queue=("$start")
  local head=0
  visited["$start"]=1

  while [[ $head -lt ${#queue[@]} ]]; do
    local current="${queue[$head]}"
    head=$((head + 1))
    local dependents="${_REVERSE_DEPS[$current]:-}"
    for dep in $dependents; do
      [[ -n "${visited[$dep]:-}" ]] && continue
      visited["$dep"]=1
      queue+=("$dep")
    done
  done

  printf '%s\n' "${!visited[@]}"
}

# _expand_changed_files CHANGED_FILES... — expand the list to include scripts
# that transitively depend on any changed file. Prints the expanded list.
_expand_changed_files() {
  _build_dep_graph

  local -A expanded=()
  local f
  for f in "$@"; do
    expanded["$f"]=1
    # Only compute reverse closure for files that exist as dep-graph nodes
    [[ -n "${_REVERSE_DEPS[$f]:-}" ]] || continue
    while IFS= read -r dep; do
      expanded["$dep"]=1
    done < <(_reverse_closure "$f")
  done

  printf '%s\n' "${!expanded[@]}" | LC_ALL=C sort
}

# ── Helpers ─────────────────────────────────────────────────────────────

# _is_in_array VALUE ARRAY... — returns 0 if VALUE is in the remaining args.
_is_in_array() {
  local needle="$1"; shift
  local item
  for item in "$@"; do
    if [[ "$item" == "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

# _is_full_suite_trigger CHANGED_FILE — returns 0 if this file triggers a full run.
_is_full_suite_trigger() {
  _is_in_array "$1" "${FULL_SUITE_TRIGGERS[@]}"
}

# _loads_helper TEST_FILE CHANGED_FILE — returns 0 when CHANGED_FILE is a
# tests/*.bash helper that TEST_FILE loads with bats' `load NAME`, quoted or
# not, on an uncommented line. Helpers load no other helper, so one level is
# the whole graph.
_loads_helper() {
  local test_file="$1" changed="$2" name
  [[ "$changed" == tests/*.bash ]] || return 1
  name="${changed#tests/}"
  name="${name%.bash}"
  [[ "$name" != */* ]] || return 1
  name="$(printf '%s' "$name" | sed 's/[][\.*+?^$(){}|/]/\\&/g')"
  grep -qE "^[[:space:]]*load[[:space:]]+['\"]?${name}['\"]?[[:space:]]*(\$|#)" "$test_file" 2>/dev/null
}

# _ref_matches_any REF CHANGED_FILES... — returns 0 if any changed file matches REF.
_ref_matches_any() {
  local ref="$1"; shift
  local changed
  for changed in "$@"; do
    if _path_matches "$changed" "$ref"; then
      return 0
    fi
  done
  return 1
}

# _test_matches_changes TEST_FILE CHANGED_FILES... — returns 0 if any changed
# file matches any source ref the test declares.
_test_matches_changes() {
  local test_file="$1"; shift
  local -a changed_files=("$@")
  local test_name
  test_name="$(basename "$test_file" .bats)"

  # A changed .bats file always selects itself, and a changed helper selects
  # every suite that loads it
  for changed in "${changed_files[@]}"; do
    if [[ "$changed" == "tests/${test_name}.bats" ]]; then
      return 0
    fi
    if _loads_helper "$test_file" "$changed"; then
      return 0
    fi
  done

  # Extract refs and check against changed files
  local ref
  while IFS= read -r ref; do
    [[ -z "$ref" ]] && continue
    if _ref_matches_any "$ref" "${changed_files[@]}"; then
      return 0
    fi
  done < <(_extract_refs "$test_file")

  local pattern
  while IFS= read -r pattern; do
    [[ "$pattern" == none ]] && continue
    if _pattern_matches_any "$pattern" "${changed_files[@]}"; then
      return 0
    fi
  done < <(_declared_patterns "$test_file")
  return 1
}

# _declared_patterns TEST_FILE — emit the patterns the test declares on
# `# select-on: PATTERN...` lines, one per line.
#
# A pattern is a repo-relative glob matched with bash's [[ == ]], where `*`
# also crosses `/`: `docs/*.md` matches docs/sub/x.md too, which errs towards
# selecting. The word `none` declares a suite that depends on nothing in the
# repo beyond its own file and the helpers it loads.
_declared_patterns() {
  { grep -E '^#[[:space:]]*select-on:' "$1" 2>/dev/null || true; } \
    | sed -E 's/^#[[:space:]]*select-on:[[:space:]]*//' \
    | tr -s ' \t' '\n\n' \
    | sed '/^$/d'
}

# _has_source_refs TEST_FILE — returns 0 if the test has at least one source ref.
_has_source_refs() {
  local ref
  while IFS= read -r ref; do
    [[ -n "$ref" ]] && return 0
  done < <(_extract_refs "$1")
  return 1
}

# _extract_refs FILE — emit the source paths a bats test references.
# Looks for $REPO_ROOT/path and $WORKBENCH_DIR/path patterns, including the
# "$REPO_ROOT"/path spelling, a bare directory ("$REPO_ROOT/lib/"*.sh reads as
# lib), and a file at the repo root (Taskfile.yml, install.components).
_extract_refs() {
  local file="$1" root='(\$REPO_ROOT|\$WORKBENCH_DIR|\$\{REPO_ROOT\}|\$\{WORKBENCH_DIR\})"?/'
  {
    grep -oE "${root}(lib|bin|ai|git|zsh|docker|eval|site|maintenance|terminals|editors|mise|Formula|scripts|\.github|packages|docs|tests)/[^ \"'})]*" "$file" 2>/dev/null || true
    grep -oE "${root}[A-Za-z][A-Za-z0-9_-]*\.[A-Za-z][A-Za-z0-9.]*([^A-Za-z0-9./_-]|\$)" "$file" 2>/dev/null || true
  } \
    | sed -E 's/^\$(\{)?(REPO_ROOT|WORKBENCH_DIR)\}?"?\///; s/[^A-Za-z0-9./_-]$//; s:/+$::' \
    | sed '/^$/d' \
    | sort -u
}

# _path_matches CHANGED_FILE REF — returns 0 if the changed file is under the ref path.
_path_matches() {
  local changed="$1" ref="$2"
  # Strip trailing quotes/parens that grep may have captured
  ref="${ref%%[\"\')\}\;]*}"
  # A ref to a specific file: exact match or the changed file is under it
  [[ "$changed" == "$ref" ]] && return 0
  # A ref to a directory: the changed file is under that directory
  [[ "$changed" == "${ref}"/* ]] && return 0
  # The changed file's directory matches the ref's directory
  local ref_dir="${ref%/*}"
  local changed_dir="${changed%/*}"
  [[ "$changed_dir" == "$ref_dir" ]] && return 0
  return 1
}

# _all_test_files — emit every .bats file path, one per line.
_all_test_files() {
  find "$TESTS_DIR" -maxdepth 1 -name '*.bats' -print | LC_ALL=C sort
}

# _scans_real_tree TEST_FILE — returns 0 if the test hands the repo root itself
# to a collect_* scanner on an uncommented line.
#
# Such a suite asserts over every registry or env file the scan globs, none of
# which it names as a path literal, so a change to one selects nothing. Only
# the root spellings count: a collector given a fixture directory reads files
# the suite wrote itself, which a path-literal map has no need to see.
#
# Boundary: a double-quoted root word on a single line. A single-quoted root
# (e.g. inside a bash -c string) or a call split across lines is not detected.
_scans_real_tree() {
  grep -qE '^[^#]*\bcollect_[a-z_]+[[:space:]][^#]*"\$\{?(REPO_ROOT|repo_root|WORKBENCH_DIR)\}?"' "$1" 2>/dev/null
}

# _validate_test_refs — fail if any test has neither refs nor a select-on
# declaration, scans the real tree (_scans_real_tree) without declaring what it
# scans, or declares a pattern no tracked file matches.
_validate_test_refs() {
  local problems=0 test_file test_name pattern
  local -a tracked=()
  # An inherited GIT_DIR outranks -C, so a caller's (or a hook's) git
  # environment would list another repo's files; clear it in the subshell.
  mapfile -t tracked < <(git_env_clear; git -C "$WORKBENCH_DIR" ls-files 2>/dev/null)
  if [[ ${#tracked[@]} -eq 0 ]]; then
    err "Could not list tracked files in $WORKBENCH_DIR — cannot check select-on patterns"
    return 1
  fi
  while IFS= read -r test_file; do
    test_name="$(basename "$test_file" .bats)"
    local -a declared=()
    mapfile -t declared < <(_declared_patterns "$test_file")
    if _scans_real_tree "$test_file" && { [[ ${#declared[@]} -eq 0 ]] || [[ "${declared[*]}" == none ]]; }; then
      err "Real-tree scan with no select-on declaration: $test_name (a collect_* call is given the repo root)"
      problems=$((problems + 1))
      continue
    fi
    if [[ ${#declared[@]} -eq 0 ]] && ! _has_source_refs "$test_file"; then
      err "Unmapped test: $test_name (no source refs and no select-on declaration)"
      problems=$((problems + 1))
      continue
    fi
    for pattern in "${declared[@]}"; do
      [[ "$pattern" == none ]] && continue
      _pattern_matches_any "$pattern" "${tracked[@]}" && continue
      err "Stale select-on pattern in $test_name: $pattern matches no tracked file"
      problems=$((problems + 1))
    done
  done < <(_all_test_files)
  if [[ $problems -gt 0 ]]; then
    err "$problems test selection problem(s) — declare dependencies with a '# select-on: PATTERN...' line"
    return 1
  fi
  return 0
}

# _pattern_matches_any PATTERN PATHS... — returns 0 if any path matches PATTERN.
_pattern_matches_any() {
  local pattern="$1" path; shift
  for path in "$@"; do
    # shellcheck disable=SC2053  # the pattern is a glob on purpose
    if [[ "$path" == $pattern ]]; then
      return 0
    fi
  done
  return 1
}

# _changed_paths BASE — paths differing from BASE in the working tree: committed
# since the merge base, staged, unstaged, and untracked. Prints nothing when
# BASE does not resolve, which main() reads as "select everything".
#
# The working tree counts because a fix pass runs the selection before it
# commits: its edits are in the tree and not yet in history.
_changed_paths() {
  local base="$1" merge_base
  git rev-parse --verify --quiet "${base}^{commit}" >/dev/null 2>&1 || return 0
  merge_base=$(git merge-base "$base" HEAD 2>/dev/null) || merge_base="$base"
  git diff --name-only "$merge_base" 2>/dev/null || true
  git ls-files --others --exclude-standard 2>/dev/null || true
}

# _input_paths BASE FILE — the paths listed in FILE when one was given, else the
# diff from BASE. A fix pass hands its own paths so the selection it re-runs at
# its pre-pass tree is the selection it ran, rather than a diff of that tree.
_input_paths() {
  local base="$1" file="$2"
  if [[ -n "$file" ]]; then
    cat "$file"
    return 0
  fi
  _changed_paths "$base"
}

main() {
  local base="origin/main"
  local validate=false
  local print_all=false
  local paths_file=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base)
        [[ -n "${2:-}" ]] || { err "--base requires an argument"; exit 2; }
        shift; base="$1" ;;
      --paths-file)
        [[ -n "${2:-}" ]] || { err "--paths-file requires an argument"; exit 2; }
        shift; paths_file="$1" ;;
      --validate) validate=true ;;
      --all) print_all=true ;;
      -h|--help)
        echo "Usage: select-tests [--base REF] [--paths-file FILE] [--validate] [--all]"
        exit 0
        ;;
      *) err "Unknown option: $1"; exit 1 ;;
    esac
    shift
  done

  if [[ -n "$paths_file" && ! -r "$paths_file" ]]; then
    err "--paths-file: cannot read $paths_file"
    exit 2
  fi

  if $print_all; then
    _all_test_files
    return 0
  fi

  # Changed files relative to the base, working tree included — see _changed_paths
  local -a changed_files=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && changed_files+=("$f")
  done < <(_input_paths "$base" "$paths_file" | LC_ALL=C sort -u)

  if [[ ${#changed_files[@]} -eq 0 ]]; then
    # No changes detected — run everything
    _all_test_files
    return 0
  fi

  # Check for full-suite triggers
  for changed in "${changed_files[@]}"; do
    if _is_full_suite_trigger "$changed"; then
      _all_test_files
      return 0
    fi
  done

  # Expand changed files through the reverse-transitive dependency graph.
  # If lib/roots.sh changed, every script that sources it (directly or through
  # a chain like lib/constants.sh → lib/ui.sh → bin/otto-workbench) is also
  # treated as changed.
  local -a expanded_files=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && expanded_files+=("$f")
  done < <(_expand_changed_files "${changed_files[@]}")
  changed_files=("${expanded_files[@]}")

  # Build the selected set
  local -a selected=()

  # For each test file not already selected, check if any changed file
  # matches any of its source refs
  while IFS= read -r test_file; do
    _test_matches_changes "$test_file" "${changed_files[@]}" && selected+=("$test_file")
  done < <(_all_test_files)

  # Validation mode: check for unmapped tests
  if $validate; then
    _validate_test_refs
  fi

  # Deduplicate and sort
  # Nothing selected prints nothing: callers read empty output from a selector
  # that succeeded as "no bats file is affected", and a failure as "run all".
  if [[ ${#selected[@]} -gt 0 ]]; then
    printf '%s\n' "${selected[@]}" | LC_ALL=C sort -u
  fi

  local total
  total=$(_all_test_files | wc -l | tr -d ' ')
  local count
  count=0
  if [[ ${#selected[@]} -gt 0 ]]; then
    count=$(printf '%s\n' "${selected[@]}" | LC_ALL=C sort -u | wc -l | tr -d ' ')
  fi
  echo "# selected $count/$total test files" >&2
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
