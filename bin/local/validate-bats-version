#!/usr/bin/env python3
"""Validate that a bats suite using flags on `run` declares the version they need.

Usage: bin/local/validate-bats-version [--quiet] [file...]

`run !`, `run -N`, `run --separate-stderr` and `run --keep-empty-lines` are all
1.5.0 features. bats does not refuse them on an older release — it runs the test
and appends BW02 to a warnings block at the end of the suite. A warning that is
always printed is a warning nobody reads, and the next one to appear arrives
into a block that already looks normal.

`bats_require_minimum_version 1.5.0` at the top of the file is what licenses the
flags and silences BW02. It has to precede the first flagged `run`, since bats
evaluates it in file order.

Only suites that actually use the flags are checked. A suite with no flagged
`run` needs no declaration and is not required to carry one.

When no files are given, discovers every .bats file in the repo.

Exit code: 0 if all files pass, 1 if any have violations.
"""

import argparse
import os
import re
import sys

_WORKBENCH_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.path.insert(0, os.path.join(_WORKBENCH_DIR, 'lib'))
from ansi import RED, GREEN, DIM, NC  # noqa: E402
from repo_scan import BASE_SKIP_DIRS  # noqa: E402

REQUIRED_VERSION = '1.5.0'

# The flags run() parses, from bats-core test_functions.bash: a bare `!`, `-N`
# for an expected exit code, and the two long options. A bare `--` also counts —
# run() sets has_flags before it breaks out of the loop.
FLAGGED_RUN = re.compile(r'(?:^|[;&|(]|\bthen\b|\belse\b|\bdo\b)\s*run\s+(!|-\d+|--\S*)(?:\s|$)')

DECLARATION = re.compile(r'^\s*bats_require_minimum_version\s+(\S+)')

COMMENT = re.compile(r'(^|\s)#.*')


def strip_comments(line: str) -> str:
    return COMMENT.sub(r'\1', line)


def _declaration_line(lines: list[str]) -> int | None:
    """Return the 1-based line of the version declaration, or None."""
    for lineno, line in enumerate(lines, 1):
        if DECLARATION.match(strip_comments(line)):
            return lineno
    return None


def _flagged_runs(lines: list[str]) -> list[tuple[int, str]]:
    """Return (line_number, line) for every `run` invoked with a flag."""
    found = []
    for lineno, line in enumerate(lines, 1):
        if FLAGGED_RUN.search(strip_comments(line)):
            found.append((lineno, line.strip()))
    return found


def check_file(filepath: str) -> tuple[str, list[tuple[int, str]]] | None:
    """Return (reason, offending flagged runs) when the file violates, else None."""
    with open(filepath, errors='replace') as f:
        lines = f.readlines()

    flagged = _flagged_runs(lines)
    if not flagged:
        return None

    declared_at = _declaration_line(lines)
    if declared_at is None:
        return (f'uses flags on `run` without bats_require_minimum_version {REQUIRED_VERSION}', flagged)

    late = [(n, text) for n, text in flagged if n < declared_at]
    if late:
        return (f'bats_require_minimum_version is declared at line {declared_at}, '
                'after a flagged `run` has already been evaluated', late)

    return None


def discover_suites(repo_root: str) -> list[str]:
    suites = []
    for dirpath, dirnames, filenames in os.walk(repo_root):
        dirnames[:] = [d for d in dirnames if d not in BASE_SKIP_DIRS]
        suites.extend(os.path.join(dirpath, f) for f in filenames if f.endswith('.bats'))
    return sorted(suites)


def _report_violation(relpath: str, reason: str, offenders: list[tuple[int, str]]) -> None:
    print(f'{RED}✗{NC} {relpath}: {reason}', file=sys.stderr)
    for lineno, line in offenders:
        print(f'      line {lineno}: {line}', file=sys.stderr)
    print(f'    {DIM}add `bats_require_minimum_version {REQUIRED_VERSION}` '
          f'below the file header, above the first test{NC}', file=sys.stderr)


def _report_pass(relpath: str, quiet: bool) -> None:
    if not quiet:
        print(f'  {GREEN}✓{NC} {relpath}')


def _print_summary(files_checked: int, errors: int) -> None:
    print()
    if errors == 0:
        print(f'{GREEN}✓{NC} {files_checked} bats suites checked, every flagged `run` is declared')
    else:
        print(f'{RED}✗{NC} {errors} of {files_checked} bats suites use flags on `run` undeclared',
              file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(
        description='Validate that bats suites using flags on `run` declare the minimum version.')
    parser.add_argument('--quiet', action='store_true', help='Only show failures and summary')
    parser.add_argument('files', nargs='*', help='Files to check (auto-discovers if omitted)')
    args = parser.parse_args()

    files = args.files if args.files else discover_suites(_WORKBENCH_DIR)

    errors = 0
    for filepath in files:
        relpath = os.path.relpath(filepath, _WORKBENCH_DIR)
        violation = check_file(filepath)

        if violation is None:
            _report_pass(relpath, args.quiet)
            continue

        errors += 1
        _report_violation(relpath, *violation)

    _print_summary(len(files), errors)
    if errors:
        sys.exit(1)


if __name__ == '__main__':
    main()
