#!/usr/bin/env python3
"""Validate that every deliberate-simplification marker resolves.

Usage: bin/local/validate-ceiling [--quiet] [DIR]

ai/guidelines/rules/general.md requires a marker to name both the tradeoff and
the upgrade trigger. A marker with only the tradeoff records that the shortcut
was considered and nothing about when it stops being acceptable, so nobody ever
revisits it — the exact rot the convention exists to prevent.

Two ways to satisfy this gate, and the second is not a loophole: some
simplifications genuinely have no upgrade path, and saying so is more honest
than inventing a threshold to get past a check.

    ceiling:            must name a trigger
    ceiling-permanent:  accepted for good, counted separately

The trigger grammar is ai/bin/ceiling-scan's, and this validator reuses
that scanner rather than re-deriving it — two parsers for one comment format is
how the ledger and the gate come to disagree about the same marker.

Exit code: 0 if every marker resolves, 1 if any names neither.
"""

from __future__ import annotations

import argparse
import functools
import importlib.machinery
import importlib.util
import os
import sys
from pathlib import Path

_WORKBENCH_DIR = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(_WORKBENCH_DIR / "lib"))
from ansi import DIM, GREEN, NC, RED  # noqa: E402

SCANNER = _WORKBENCH_DIR / "ai" / "bin" / "ceiling-scan"


@functools.cache
def _scanner():
    """Import ceiling-scan by path — the filename is hyphenated, so it is not importable.

    Cached: the module is stateless, and re-executing it per call would make a
    scan of several directories pay the import over and over.
    """
    loader = importlib.machinery.SourceFileLoader("ceiling_scan", str(SCANNER))
    spec = importlib.util.spec_from_loader("ceiling_scan", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def check_directory(root: Path) -> list[dict]:
    """The markers under *root* that name neither a trigger nor permanence."""
    scanner = _scanner()
    return [m for m in scanner.scan_directory(root) if scanner.is_untriggered(m)]


def _report(violations: list[dict]) -> None:
    print(f"{RED}✗{NC} {len(violations)} marker(s) name a tradeoff but no trigger",
          file=sys.stderr)
    for m in violations:
        print(f"      {m['file']}:{m['line']}: {m['ceiling']}", file=sys.stderr)
    print(f"    {DIM}name the condition that ends it (if / once / when / unless / until,",
          file=sys.stderr)
    print(f"    or an explicit \"Upgrade trigger:\" sentence), or mark it permanent{NC}",
          file=sys.stderr)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Validate that every ceiling marker names a trigger or is permanent.",
    )
    parser.add_argument("--quiet", action="store_true", help="Only show failures")
    parser.add_argument("directory", nargs="?", default=str(_WORKBENCH_DIR),
                        help="Directory to scan (default: the repo root)")
    args = parser.parse_args()

    root = Path(args.directory).resolve()
    violations = check_directory(root)

    if violations:
        _report(violations)
        sys.exit(1)
    if not args.quiet:
        rel = os.path.relpath(root, _WORKBENCH_DIR)
        print(f"{GREEN}✓{NC} every ceiling marker in {rel} names a trigger or is permanent")


if __name__ == "__main__":
    main()
