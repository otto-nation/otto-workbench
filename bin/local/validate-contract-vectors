    ({'XDG_STATE_HOME': ''}, 'An exported-but-empty XDG variable is unset, per the spec.'),
]

ROOT_VARS = ('WORKBENCH_STATE_DIR', 'XDG_STATE_HOME', 'WORKBENCH_CONFIG_DIR', 'XDG_CONFIG_HOME')


# ── Generation ──────────────────────────────────────────────────────────────

def _row(inputs, expected, note):
    """One fixture row, with its note only when it carries one.

    Notes are attached to the first row of a group and left off the rows that
    illustrate the same rule, so a consumer reading the artifact sees the
    reasoning without it being repeated verbatim on every line.
    """
    row = dict(inputs)
    row['expected'] = expected
    if note:
        row['note'] = note
    return row


def _restore_env(saved):
    """Put back what was there, treating a recorded None as "was not set"."""
    for var, value in saved.items():
        if value is None:
            os.environ.pop(var, None)
        else:
            os.environ[var] = value


def _relative_target_dir(key, branch):
    """target_dir() under a known root, cut back to the part consumers join.

    Composing the string here from TARGETS_DIR and slug() would publish this
    script's idea of the join rather than the function's — the one row a
    regeneration could not catch drifting.
    """
    root = '/nonexistent-state'
    saved = {'WORKBENCH_STATE_DIR': os.environ.get('WORKBENCH_STATE_DIR')}
    try:
        os.environ['WORKBENCH_STATE_DIR'] = root
        return os.path.relpath(pr_target.target_dir(key, branch), root)
    finally:
        _restore_env(saved)


def _resolved_state_root(env, home):
    """state_dir() under one environment, with this machine's paths tokenized."""
    saved = {var: os.environ.get(var) for var in (*ROOT_VARS, 'HOME')}
    try:
        for var in ROOT_VARS:
            os.environ.pop(var, None)
        os.environ['HOME'] = home
        for var, value in env.items():
            os.environ[var] = value.replace(HOME, home)
        return str(workbench_paths.state_dir()).replace(home, HOME)
    finally:
        _restore_env(saved)


def build_artifact():
    """The published fixtures, computed from the live implementation."""
    # A path this machine does not have, so a rung that silently expanded
    # something else would show up as an untokenized absolute path in the diff.
    home = '/nonexistent-home'
    return {
        'contract': 'pr-target',
        'version': VERSION,
        'owner': {
            'repo': 'otto-nation/otto-workbench',
            'modules': ['ai/lib/pr_target.py', 'ai/lib/workbench_paths.py'],
            'regenerate': 'bin/local/validate-contract-vectors --write',
        },
        'description':
            'Fixtures for the run-target path layout, generated from the owning '
            'implementation. Consumers vendor this file verbatim and assert '
            'against it rather than transcribing the tables by hand.',
        'layout': {
            'path': '<state_root>/<targets_dir>/<repo_key>-<branch_slug>/',
            'targets_dir': pr_target.TARGETS_DIR,
            'state_file': pr_state.STATE_FILE,
            'lock_file': run_lock.LOCK_FILE,
            'reviews_dir': review_common.REVIEWS_DIR.name,
            'worktree_state_dir': workbench_paths.WORKTREE_STATE_DIRNAME,
            'legacy_worktree_state_dir': workbench_paths.LEGACY_WORKTREE_STATE_DIRNAME,
        },
        'state_root': [
            _row({'env': env}, _resolved_state_root(env, home), note)
            for env, note in STATE_ROOT_INPUTS
        ],
        'slug': [
            _row({'branch': branch}, pr_target.slug(branch), note)
            for branch, note in SLUG_INPUTS
        ],
        'repo_key': [
            _row({'url': url}, pr_target._repo_key(url), note)
            for url, note in REPO_KEY_INPUTS
        ],
        'target_dir': [
            _row({'repo_key': key, 'branch': branch}, _relative_target_dir(key, branch), note)
            for key, branch, note in TARGET_DIR_INPUTS
        ],
    }


def serialize(artifact):
    """Stable text, so a diff shows the changed row and nothing else."""
    return json.dumps(artifact, indent=2, ensure_ascii=False, sort_keys=False) + '\n'


# ── CLI ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description='Validate the published run-target contract fixtures.')
    parser.add_argument('--quiet', action='store_true', help='Only show failures')
    parser.add_argument('--write', action='store_true',
                        help='Regenerate the artifact instead of checking it')
    args = parser.parse_args()

    path = os.path.join(_WORKBENCH_DIR, ARTIFACT)
    current = serialize(build_artifact())

    if args.write:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w', encoding='utf-8') as handle:
            handle.write(current)
        if not args.quiet:
            print(f'{GREEN}✓{NC} wrote {ARTIFACT}')
        return

    try:
        with open(path, encoding='utf-8') as handle:
            committed = handle.read()
    except FileNotFoundError:
        print(f'{RED}✗{NC} {ARTIFACT} is missing', file=sys.stderr)
        print(f'    {DIM}regenerate: bin/local/validate-contract-vectors --write{NC}',
              file=sys.stderr)
        sys.exit(1)

    if committed == current:
        if not args.quiet:
            print(f'{GREEN}✓{NC} {ARTIFACT} matches the implementation')
        return

    print(f'{RED}✗{NC} {ARTIFACT} is stale — the implementation moved without it',
          file=sys.stderr)
    diff = difflib.unified_diff(
        committed.splitlines(keepends=True), current.splitlines(keepends=True),
        fromfile=f'{ARTIFACT} (committed)', tofile='(implementation)')
    sys.stderr.writelines(diff)
    print(f'\n    {DIM}Every consumer vendors this file. If the change is intended:{NC}',
          file=sys.stderr)
    print(f'    {DIM}  1. bin/local/validate-contract-vectors --write{NC}', file=sys.stderr)
    print(f'    {DIM}  2. commit the artifact with the change{NC}', file=sys.stderr)
    print(f'    {DIM}  3. open the ui-code PR that re-vendors it{NC}', file=sys.stderr)
    sys.exit(1)


if __name__ == '__main__':
    main()
