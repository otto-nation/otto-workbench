#!/usr/bin/env python3
"""Validate that the published contract fixtures still match the implementation.

Usage: bin/local/validate-contract-vectors [--quiet] [--write]

The run-target path layout is a published interface: ui-code reimplements it in
TypeScript so its server can find state written by this repo's `pr` CLI. Neither
repo's CI can see the other, so nothing catches a change to `pr_target.py` or
`workbench_paths.py` that moves the directory — the consumer keeps reading a
path nobody writes, and a missing state file reads as "never reviewed" rather
than as an error. That failure has already shipped once: #624 phase 4 added the
XDG rung to `state_dir()` and ui-code went on resolving the old default.

So the fixtures are generated from the live functions and committed:

    docs/contracts/pr-target-vectors.json

This script regenerates them and diffs against that file. A behaviour change
fails here, at the moment it is made, by the person making it — which is the
only place the drift is visible, because the consumer's tests assert against a
copy of this same artifact and would happily keep passing.

Failing is the point, not a nuisance. When the change is intended, rerun with
--write, commit the artifact, and open the matching consumer PR: the artifact
is the thing consumers vendor, so until it lands they have nothing to update to.

Exit code: 0 if the artifact is current, 1 if it is stale.
"""

import argparse
import difflib
import json
import os
import sys

_WORKBENCH_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.path.insert(0, os.path.join(_WORKBENCH_DIR, 'lib'))
sys.path.insert(0, os.path.join(_WORKBENCH_DIR, 'ai', 'lib'))
from ansi import RED, GREEN, DIM, NC  # noqa: E402

import pr_state  # noqa: E402
import pr_target  # noqa: E402
import review_common  # noqa: E402
import run_lock  # noqa: E402
import workbench_paths  # noqa: E402

ARTIFACT = os.path.join('docs', 'contracts', 'pr-target-vectors.json')

# Consumers substitute their own home directory. Absolute paths from this
# machine would make the artifact unusable anywhere else, and unstable here.
HOME = '<home>'

# Bumped when a row's meaning changes, not when one is added: a consumer pinned
# to an older artifact needs to know whether its copy is merely incomplete or
# actively wrong.
VERSION = 1

# ── Inputs ──────────────────────────────────────────────────────────────────
