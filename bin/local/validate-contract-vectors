# Each row is one resolution of the state root. The environment is a dimension
# of the contract in its own right: no table of path-to-key rows could have
# caught a missing rung, which is exactly how the consumer went stale.
STATE_ROOT_INPUTS = [
    ({}, 'No override and no XDG variable: the built-in default.'),
    ({'XDG_STATE_HOME': f'{HOME}/xdg-state'},
     'The XDG rung, which appends "workbench" to the value.'),
