#!/usr/bin/env python3
"""Validate that no module freezes a workbench root into an import-time constant.

Usage: bin/local/validate-frozen-roots [--quiet] [file...]

`ai/lib/core/workbench_paths.py` resolves every root per call, and says in its own
header why: the environment is routinely re-pointed after import — by tests, and
by callers that move a root before invoking a subprocess — so a module-level

    LEDGER_DIR = workbench_paths.state_dir() / "usage"

captures whichever value happened to be live when the first importer loaded the
module and never sees the change.  The failure is silent on both sides: the
writer keeps appending under the stale root, and the reader finds an empty
directory it cannot distinguish from having nothing to report.  Every test that
re-points a root then has to patch each frozen constant by name, which is a list
that only grows and is only ever discovered by a test that mysteriously fails.

The fix is always the same shape — a function:

    def ledger_dir() -> Path:
        return workbench_paths.state_dir() / LEDGER_DIRNAME

Assignments inside a function body are fine: they resolve when the function
runs, which is the behaviour this check exists to preserve.  So is a call
inside a lambda body, or handed to `default_factory`, for the same reason.  A
bare directory *name* (`LEDGER_DIRNAME = "usage"`) is fine too — a name is not
a path, and sharing one is how two modules agree on a subtree.

Exit code: 0 if all files pass, 1 if any have violations.
"""

import argparse
import ast
import os
import sys
from dataclasses import dataclass

_WORKBENCH_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.path.insert(0, os.path.join(_WORKBENCH_DIR, 'lib'))
from ansi import RED, GREEN, DIM, NC  # noqa: E402

MODULE = 'workbench_paths'

# The root resolvers. Each returns a path built from the live environment, so a
# call to any of them belongs inside a function, not at module scope.
ROOTS = frozenset({
    'config_dir',
    'state_dir',
    'cache_dir',
    'trail_dir',
    'reviews_dir',
    'projects_registry',
})

SEARCH_DIRS = ('ai', 'bin')
SKIP_DIRS = {'.git', '__pycache__', '.venv', 'node_modules'}


def _names_module(dotted: str | None) -> bool:
    """Whether *dotted* names the watched module, however deep it is packaged.

    `workbench_paths` moved under `core/`, so the shape every caller now writes
    is `core.workbench_paths`, not the bare name — and matching on the last
    dotted segment rather than a fixed prefix means the next re-layering does
    not have to touch this again.
    """
    return dotted is not None and (dotted == MODULE or dotted.endswith(f'.{MODULE}'))


@dataclass(frozen=True)
class Violation:
    line: int
    name: str
    root: str


# ── AST analysis ─────────────────────────────────────────────────────────────


def _imported_roots(tree) -> set[str]:
    """Root resolvers pulled into this module's namespace by `from` import.

    A `from workbench_paths import state_dir` leaves nothing at the call site to
    say where `state_dir` came from, so the local name (or its alias) has to be
    remembered to recognise the call. `_module_names` does the same job for the
    other import form. `_names_module` accepts the module however it is
    dotted — `from core.workbench_paths import state_dir` is the same import as
    far as this check is concerned.
    """
    names = set()
    for node in ast.walk(tree):
        if not isinstance(node, ast.ImportFrom) or not _names_module(node.module):
            continue
        names |= {a.asname or a.name for a in node.names if a.name in ROOTS}
    return names


def _plain_import_bound_name(alias: ast.alias) -> str | None:
    """The local name one `import` alias binds, if it names the watched module.

    An aliased `import core.workbench_paths as wp` binds `wp` regardless of how
    deep the dotted path runs. A bare `import core.workbench_paths` binds only
    `core` — Python puts nothing else in scope for that form — so it counts
    here only when it is the exact bare module name; the deeper bare case is
    `_bare_dotted_imports`' job instead.
    """
    if alias.asname:
        return alias.asname if _names_module(alias.name) else None
    return alias.name if alias.name == MODULE else None


def _module_names(tree) -> set[str]:
    """Local names bound to the module itself, aliases included.

    `import workbench_paths as wp` writes `wp.state_dir()` at the call site, so
    matching the module's own name would miss it — and an alias freezes a root
    exactly as hard as the spelled-out name does. `from core import
    workbench_paths` binds the same name through a package import rather than a
    plain one, and is the shape every caller now uses — `not _names_module(node.module)`
    keeps this from double-counting the `from workbench_paths import state_dir`
    shape `_imported_roots` already owns.
    """
    names = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            names |= {n for a in node.names for n in [_plain_import_bound_name(a)] if n}
        elif isinstance(node, ast.ImportFrom) and not _names_module(node.module):
            names |= {a.asname or a.name for a in node.names if a.name == MODULE}
    return names


def _bare_dotted_imports(tree) -> set[str]:
    """Dotted paths to the module bound with no alias, e.g. `import core.workbench_paths`.

    Python binds only the top-level package (`core`) for that form, so the call
    site has to spell the whole path — `core.workbench_paths.state_dir()` — and
    `_called_root` matches it as a dotted chain rather than a single attribute
    hop off a name in `_module_names`.
    """
    paths = set()
    for node in ast.walk(tree):
        if not isinstance(node, ast.Import):
            continue
        paths |= {a.name for a in node.names if a.asname is None and _names_module(a.name)}
    return paths


def _dotted_name(node) -> str | None:
    """*node* as a dotted string (`core.workbench_paths`), or None if it is not
    a plain chain of attribute access on a name — the only shape a bare
    `import a.b` call site can be written in."""
    if isinstance(node, ast.Name):
        return node.id
    if isinstance(node, ast.Attribute):
        owner = _dotted_name(node.value)
        return f'{owner}.{node.attr}' if owner is not None else None
    return None


def _called_root(func, local_roots: set[str], module_names: set[str],
                  dotted_paths: set[str] = frozenset()) -> str | None:
    """The root resolver a call's *func* names, as written at the call site."""
    if isinstance(func, ast.Name):
        return func.id if func.id in local_roots else None
    if not isinstance(func, ast.Attribute) or func.attr not in ROOTS:
        return None
    owner = func.value
    if isinstance(owner, ast.Name) and owner.id in module_names:
        return f'{owner.id}.{func.attr}'
    owner_path = _dotted_name(owner)
    if owner_path is not None and owner_path in dotted_paths:
        return f'{owner_path}.{func.attr}'
    return None


def _eager_children(node):
    """The children of *node* that are evaluated when *node* is.

    Only a lambda differs from "all of them": its body runs later, so a
    `GET = lambda: state_dir()` defers the call exactly as a `def` does, while
    its parameter defaults still run now. A lambda invoked where it is written
    defers nothing, so the call it sits under hands its body back too.
    """
    if isinstance(node, ast.Lambda):
        return [d for d in node.args.defaults + node.args.kw_defaults if d]
    children = list(ast.iter_child_nodes(node))
    if isinstance(node, ast.Call) and isinstance(node.func, ast.Lambda):
        children.append(node.func.body)
    return children


def _eager_calls(node):
    """Every call in *node* that runs when *node* is evaluated."""
    if isinstance(node, ast.Call):
        yield node
    for child in _eager_children(node):
        yield from _eager_calls(child)


def _resolver_called(node, local_roots: set[str], module_names: set[str],
                      dotted_paths: set[str] = frozenset()) -> str | None:
    """The root resolver *node* calls, or None if it reaches no root.

    Walks the whole subtree, so a root buried in an expression —
    `state_dir() / "usage"`, `Path(str(trail_dir()))` — is caught: what freezes
    the value is the call happening at import, not where it sits in the term.
    """
    named = (
        _called_root(c.func, local_roots, module_names, dotted_paths)
        for c in _eager_calls(node)
    )
    return next((n for n in named if n is not None), None)


def _assigned_names(node) -> list[str]:
    targets = node.targets if isinstance(node, ast.Assign) else [node.target]
    return [n.id for t in targets for n in ast.walk(t) if isinstance(n, ast.Name)]


def _module_level_assignments(tree):
    """Every assignment that runs at import — module scope and class bodies.

    A class body executes at import just as the module body does, so a root
    frozen into a class attribute is frozen exactly as hard as one at the top
    level. Function bodies are not descended into: that is where a root call
    belongs.
    """
    found = []
    pending = list(tree.body)
    while pending:
        node = pending.pop()
        if isinstance(node, ast.ClassDef):
            pending += node.body
        elif isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign)):
            found.append(node)
    return found


def check_file(filepath: str) -> list[Violation]:
    with open(filepath, encoding='utf-8') as f:
        source = f.read()
    if MODULE not in source:
        return []
    try:
        tree = ast.parse(source, filename=filepath)
    except SyntaxError as exc:
        # Silence here would read as "clean" for a file this check never saw.
        print(f'{RED}!{NC} {filepath}: unparseable, not checked ({exc})',
              file=sys.stderr)
        return []
    local_roots = _imported_roots(tree)
    module_names = _module_names(tree)
    dotted_paths = _bare_dotted_imports(tree)
    found = []
    for node in _module_level_assignments(tree):
        if node.value is None:
            continue
        root = _resolver_called(node.value, local_roots, module_names, dotted_paths)
        if root is None:
            continue
        names = _assigned_names(node) or ['<unnamed>']
        found.append(Violation(line=node.lineno, name=names[0], root=root))
    return sorted(found, key=lambda v: v.line)


# ── Discovery ────────────────────────────────────────────────────────────────


def _is_python(path: str) -> bool:
    if path.endswith('.py'):
        return True
    if os.path.splitext(path)[1] or not os.access(path, os.X_OK):
        return False
    try:
        with open(path, 'rb') as f:
            first = f.readline()
    except OSError:
        return False
    return first.startswith(b'#!') and b'python' in first


def discover_scripts(repo_root: str) -> list[str]:
    found = []
    roots = [os.path.join(repo_root, d) for d in SEARCH_DIRS]
    for root in roots:
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            paths = [os.path.join(dirpath, f) for f in filenames]
            found += [p for p in paths if _is_python(p)]
    return sorted(found)


# ── Reporting ────────────────────────────────────────────────────────────────


def _report_violations(relpath: str, violations: list[Violation]) -> None:
    print(f'{RED}✗{NC} {relpath}: a workbench root is frozen at import',
          file=sys.stderr)
    for v in violations:
        print(f'    line {v.line}: {v.name} = {v.root}(...) '
              f'{DIM}— move the call into a function{NC}', file=sys.stderr)
    print(f'    {DIM}why the roots resolve per call is in '
          f'ai/lib/core/{MODULE}.py{NC}', file=sys.stderr)


def _print_summary(files_checked: int, errors: int) -> None:
    print()
    if errors == 0:
        print(f'{GREEN}✓{NC} {files_checked} files checked, '
              'every workbench root resolves per call')
    else:
        print(f'{RED}✗{NC} {errors} of {files_checked} files freeze a workbench '
              'root into an import-time constant', file=sys.stderr)


# ── CLI ──────────────────────────────────────────────────────────────────────


def main():
    parser = argparse.ArgumentParser(
        description='Validate that no module freezes a workbench root at import.')
    parser.add_argument('--quiet', action='store_true',
                        help='Only show failures and summary')
    parser.add_argument('files', nargs='*',
                        help='Files to check (auto-discovers if omitted)')
    args = parser.parse_args()

    repo_root = _WORKBENCH_DIR
    files = args.files or discover_scripts(repo_root)

    errors = 0
    for filepath in files:
        violations = check_file(filepath)
        relpath = os.path.relpath(filepath, repo_root)
        errors += 1 if violations else 0
        if violations:
            _report_violations(relpath, violations)
        elif not args.quiet:
            print(f'  {GREEN}✓{NC} {relpath}')

    _print_summary(len(files), errors)
    if errors:
        sys.exit(1)


if __name__ == '__main__':
    main()
