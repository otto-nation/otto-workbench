#!/usr/bin/env python3
"""Validate that every `ai/lib` module is named through its package.

Usage: bin/local/validate-import-form [--quiet] [file...]

One spelling, everywhere:

    import pr.state            # not `from pr import state`
    pr.state.load_state(...)   # not `pr_state.load_state(...)`

#908 repackaged `ai/lib` into layered packages and aliased every import back
to its old flat name so the move could be proved byte-exact. #1137 retired
those aliases. This keeps them retired, and it is scoped to the whole tree
rather than to `ai/lib`, because `tests/` imports the same modules and a
regression there is the same regression.

`bin/local/validate-ai-layers` answers a different question — whether a
package *may* import another — and is scoped to `ai/lib` for that reason.
This one is about how an import is written, wherever it is written.

Three things are checked:

  1. An `ai/lib` module is imported as `import pkg.mod`, never
     `from pkg import mod`. The `from` form binds a bare leaf, and seventeen
     leaf names repeat across packages — `client` is both `gh.client` and
     `git.client`, `types` lives in five packages — so the bare form cannot be
     made collision-free. An alias avoids the collision by reintroducing
     exactly what #1137 removed.

  2. No module import is aliased, in either spelling.

  3. No local shadows a package whose modules the same function reaches.
     `import pr.state` binds `pr` at module scope, so a local called `pr` in a
     function that also reaches `pr.state` captures the package, and the call
     fails at runtime rather than at import.

A fourth check covers shell. `tests/*.bats` embeds Python in heredocs, which
no AST can see, and a reach-through survived there through three green runs of
everything else: `mod.agent_templates` in `review_orchestrate_prompt.bats`,
where `agent_templates` was `cli.review_orchestrate`'s alias for
`agent.templates`. The retired names cannot be listed — they no longer exist —
but they can be *derived*: `<package>_<module>` naming a real pair is the
shape every one of them had. Anchored on a leading dot, so it matches an
attribute reach-through and not a variable that merely reads that way.

Importing a *symbol* is untouched: `from pr.state import PRState` binds a
class, not a module, and is the normal way to reach one.

Exit code: 0 if every file passes, 1 if any do not.
"""

from __future__ import annotations

import argparse
import ast
import os
import re
import sys
from dataclasses import dataclass
from pathlib import Path

_WORKBENCH_DIR = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(_WORKBENCH_DIR / "lib"))
from ansi import DIM, GREEN, NC, RED  # noqa: E402
from repo_scan import BASE_SKIP_DIRS  # noqa: E402

LIB_DIR = Path("ai") / "lib"
SCAN_ROOTS = ("ai", "tests", "lib", "bin")
SHELL_SUFFIXES = (".bats", ".bash", ".sh")
SKIP_DIRS = BASE_SKIP_DIRS | {"__pycache__", ".venv", "venv"}


@dataclass(frozen=True)
class Finding:
    line: int
    reason: str


@dataclass(frozen=True)
class Layout:
    """Which packages exist under `ai/lib`, and what modules each holds."""

    modules: dict[str, frozenset[str]]

    @classmethod
    def read(cls, repo_root: Path) -> "Layout":
        lib = repo_root / LIB_DIR
        return cls(modules={
            p.name: frozenset(m.stem for m in p.glob("*.py") if m.stem != "__init__")
            for p in sorted(lib.iterdir())
            if p.is_dir() and (p / "__init__.py").exists()
        })

    @property
    def packages(self) -> frozenset[str]:
        return frozenset(self.modules)

    def holds(self, package: str, module: str) -> bool:
        return module in self.modules.get(package, frozenset())


def _chain(node: ast.expr) -> list[str] | None:
    """The dotted name an attribute expression spells, if it spells one."""
    parts = []
    while isinstance(node, ast.Attribute):
        parts.append(node.attr)
        node = node.value
    if not isinstance(node, ast.Name):
        return None
    parts.append(node.id)
    return list(reversed(parts))


def _from_import_findings(node: ast.AST, layout: Layout):
    """`from pkg import mod`, which binds a leaf that cannot stay unique."""
    if not isinstance(node, ast.ImportFrom) or node.level or not node.module:
        return
    if node.module not in layout.packages:
        return
    for alias in node.names:
        if not layout.holds(node.module, alias.name):
            continue
        spelled = f"from {node.module} import {alias.name}"
        spelled += f" as {alias.asname}" if alias.asname else ""
        yield Finding(node.lineno,
                      f"{spelled} — write `import {node.module}.{alias.name}` "
                      f"and call it `{node.module}.{alias.name}.…`")


def _plain_import_findings(node: ast.AST, layout: Layout):
    """`import pkg.mod as x`, the alias wearing the other spelling — or the
    whole package aliased bare (`import pkg as x`), which wears it just as
    well once a module of that package is reached through the alias."""
    if not isinstance(node, ast.Import):
        return
    for alias in node.names:
        head, _, leaf = alias.name.partition(".")
        if not alias.asname:
            continue
        if not layout.holds(head, leaf) and not (not leaf and head in layout.packages):
            continue
        yield Finding(node.lineno,
                      f"import {alias.name} as {alias.asname} — an aliased module "
                      f"is what #1137 removed; call it `{alias.name}.…`")


def _import_findings(tree: ast.Module, layout: Layout):
    """Imports of an `ai/lib` module written in a form #1137 retired."""
    for node in ast.walk(tree):
        yield from _from_import_findings(node, layout)
        yield from _plain_import_findings(node, layout)


_SCOPE_BOUNDARIES = (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda,
                     ast.ListComp, ast.SetComp, ast.DictComp, ast.GeneratorExp)


def _walk_own_scope(fn: ast.AST):
    """Like `ast.walk`, but does not cross into a nested function, lambda, or
    comprehension — each of those has its own scope in Python, so a name they
    bind says nothing about what *this* function binds."""
    stack = list(ast.iter_child_nodes(fn))
    while stack:
        node = stack.pop()
        yield node
        if not isinstance(node, _SCOPE_BOUNDARIES):
            stack.extend(ast.iter_child_nodes(node))


def _packages_bound_in(fn: ast.AST, layout: Layout) -> set[str]:
    """Package names this function binds as a local or a parameter."""
    args = fn.args
    bound = {a.arg for a in [*args.posonlyargs, *args.args, *args.kwonlyargs]
             if a.arg in layout.packages}
    return bound | {n.id for n in _walk_own_scope(fn)
                    if isinstance(n, ast.Name)
                    and isinstance(n.ctx, (ast.Store, ast.Del))
                    and n.id in layout.packages}


def _captures_in(fn: ast.AST, bound: set[str], layout: Layout):
    """Where this function reaches `pkg.mod` through a local called `pkg`."""
    for node in ast.walk(fn):
        if not isinstance(node, ast.Attribute):
            continue
        parts = _chain(node)
        if not parts or len(parts) < 2 or parts[0] not in bound:
            continue
        if not layout.holds(parts[0], parts[1]):
            continue
        yield Finding(node.lineno,
                      f"local {parts[0]!r} shadows the package, so "
                      f"`{parts[0]}.{parts[1]}` reaches the local and not the "
                      f"module — rename the local")


def _shadow_findings(tree: ast.Module, layout: Layout):
    """Locals that capture a package the same function reaches through."""
    for fn in ast.walk(tree):
        if not isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        bound = _packages_bound_in(fn, layout)
        if bound:
            yield from _captures_in(fn, bound, layout)


def _retired_alias_names(layout: Layout) -> dict[str, str]:
    """`{pkg_mod: pkg.mod}` — the shape every retired alias had.

    Derived rather than listed. The names are gone from the tree, so a list
    would be a second copy of history that nothing keeps true.
    """
    return {f"{pkg}_{mod}": f"{pkg}.{mod}"
            for pkg, mods in layout.modules.items() for mod in mods}


def check_shell(source: str, layout: Layout) -> list[Finding]:
    """Reach-throughs in the Python that shell files embed in heredocs."""
    retired = _retired_alias_names(layout)
    if not retired:
        return []
    pattern = re.compile(r"\.(" + "|".join(map(re.escape, retired)) + r")\b")
    found = []
    for number, line in enumerate(source.splitlines(), 1):
        for match in pattern.finditer(line):
            name = match.group(1)
            found.append(Finding(number,
                                 f".{name} — {name} was an alias for "
                                 f"{retired[name]}; reach the module directly"))
    return found


def check_source(source: str, layout: Layout) -> list[Finding]:
    try:
        tree = ast.parse(source)
    except SyntaxError:
        return []
    found = {*_import_findings(tree, layout), *_shadow_findings(tree, layout)}
    return sorted(found, key=lambda f: (f.line, f.reason))


def _is_python(path: Path) -> bool:
    """Whether *path* is Python, by extension or by shebang."""
    if path.suffix == ".py":
        return True
    if path.suffix:
        return False
    try:
        first = path.open(errors="replace").readline()
    except OSError:
        return False
    return first.startswith("#!") and "python" in first


def _python_under(base: Path):
    for path in sorted(base.rglob("*")):
        if path.is_dir() or SKIP_DIRS & set(path.parts):
            continue
        if _is_python(path) or path.suffix in SHELL_SUFFIXES:
            yield path


def discover_files(repo_root: Path) -> list[Path]:
    """Every Python source in the tree, extensionless `#!python` included."""
    out: list[Path] = []
    for root in SCAN_ROOTS:
        base = repo_root / root
        if base.exists():
            out.extend(_python_under(base))
    return out


def _report(relpath: str, findings: list[Finding], quiet: bool) -> None:
    if not findings:
        if not quiet:
            print(f"  {GREEN}✓{NC} {relpath}")
        return
    print(f"{RED}✗{NC} {relpath}")
    for finding in findings:
        print(f"    {DIM}{finding.line}:{NC} {finding.reason}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Validate that every ai/lib module is named through its package.")
    parser.add_argument("--quiet", action="store_true",
                        help="Only show failures and the summary")
    parser.add_argument("files", nargs="*", help="Files to check (auto-discovers if omitted)")
    args = parser.parse_args(argv)

    repo_root = _WORKBENCH_DIR
    layout = Layout.read(repo_root)
    files = [Path(f).resolve() for f in args.files] or discover_files(repo_root)

    failed = 0
    for path in files:
        source = path.read_text(errors="replace")
        findings = (check_shell(source, layout) if path.suffix in SHELL_SUFFIXES
                    else check_source(source, layout))
        relpath = os.path.relpath(path, repo_root)
        failed += 1 if findings else 0
        _report(relpath, findings, args.quiet)

    if failed:
        print(f"\n{RED}✗{NC} {failed} file(s) name an ai/lib module the old way")
        return 1
    print(f"\n{GREEN}✓{NC} {len(files)} file(s) checked, "
          f"every ai/lib module named through its package")
    return 0


if __name__ == "__main__":
    sys.exit(main())
