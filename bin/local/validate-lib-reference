#!/usr/bin/env bash
# Validate that docs/libraries.src.md asks for every group the modules declare.
#
# The module sections in docs/libraries.md are rendered from lib/ itself, so the
# .src.md holds only prose plus one include directive per group. Two ways that
# arrangement can fail quietly, and this is what catches them:
#
#   A module in a group nobody asks for is documented nowhere. Adding
#   `# doc-group: foo` to a module is meant to be the whole change, so this
#   fails until docs/libraries.src.md carries the directive that renders it.
#
#   A hand-written `### name` section in the .src.md would sit beside the
#   generated ones looking identical, and drift from the module it describes —
#   which is the arrangement this whole thing replaced.
#
# Freshness of the composed file is not checked here: bin/local/compose-docs
# --check covers every artifact, through bin/local/validate-docs-composed.
#
# Usage: bin/local/validate-lib-reference [--quiet]
# Exit codes: 0 if the source doc asks for every group; 1 if it does not; 2 on
#             a usage error.

set -euo pipefail

_SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "$_SELF")/../.." && pwd)}"
# shellcheck source=../../lib/ui.sh
. "$REPO_ROOT/lib/ui.sh"

GENERATOR="bin/local/generate-lib-reference"
SRC_DOC="${SRC_DOC:-$REPO_ROOT/docs/libraries.src.md}"

usage() {
  cat <<EOF
Usage: $(basename "$0") [--quiet]

Check that docs/libraries.src.md requests every group lib/ declares, and holds
no hand-written module section.

Options:
  --quiet     Suppress output on success
  -h, --help  Show this help

Environment:
  SRC_DOC     The source doc to check (default: docs/libraries.src.md)
EOF
}

QUIET=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quiet) QUIET=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) err "Unknown argument: $1"; usage >&2; exit 2 ;;
  esac
done

if [[ ! -f "$SRC_DOC" ]]; then
  err "$SRC_DOC is missing — the module reference has no source doc"
  exit 1
fi

errors=0

# A `###` heading in the source doc is a module section written by hand. The
# generator emits every real one, so this can only be a stale copy of one.
while IFS= read -r heading; do
  err "docs/libraries.src.md: hand-written module section '$heading'"
  echo "  Module sections come from the module's own header comment in lib/." >&2
  errors=$((errors + 1))
done < <(grep '^### ' "$SRC_DOC" || true)

# Every group a module declares must be requested by a directive. The reverse —
# a directive naming a group no module declares — is the generator's own error,
# raised when compose-docs runs it.
groups=0
while IFS= read -r group; do
  groups=$((groups + 1))
  if grep -qF -- "<!-- include: $GENERATOR --group $group -->" "$SRC_DOC"; then continue; fi
  err "docs/libraries.src.md does not render the '$group' group"
  echo "  Add: <!-- include: $GENERATOR --group $group -->" >&2
  errors=$((errors + 1))
done < <("$REPO_ROOT/$GENERATOR" --groups)

if (( errors > 0 )); then
  exit 1
fi

$QUIET || success "docs/libraries.src.md renders all $groups module groups"
