#!/usr/bin/env python3
"""Validate that the values with an owner under ai/ are spelled by their owner.

Usage: bin/local/validate-magic-values [--quiet] [file...]

Some numbers here are conventions rather than choices — how much of a sha a
reader is shown, what a process exits with when it was interrupted, how much of
a command's output a record carries.  Each one has a module that owns it, and a
literal written at the call site is the same number with the reason stripped
off: `sha[:7]` says seven, not "abbreviated the way git abbreviates"; a bare
`sys.exit(130)` says a hundred and thirty, not "interrupted".  Spelled out at
enough call sites, the convention stops being one — the thirty-first site is
free to write eight, and nothing reports that the two disagree.

Three shapes are rejected:

  sha[:7]                 an abbreviation length     -> git_client.abbrev(sha)
  sys.exit(130)           an exit code               -> proc.INTERRUPT_RETURNCODE
  excerpt = out[:500]     a cap that already has an  -> trail.EXCERPT_LIMIT
                          owner

The first is recognised by the name being sliced, so any length is a finding —
the owner decides how many characters, and a call site that picks its own is the
disagreement this check exists to prevent.  The other two are recognised by
value: the owners in `OWNERS` are read out of their own source, so what counts
as an exit code or a cap is whatever those modules currently say it is, and
renaming a constant fails here rather than silently retiring the rule.

A module-level `NAME = 124` is never a finding wherever it appears.  That is
what naming a value looks like; a check that flagged it would have nowhere left
for an owner to live.

A cap is matched by value alone, so a slice that lands on 200 for a reason of
its own is a finding too.  That is deliberate rather than a false positive: two
sites written to the same number are indistinguishable from here, and the way
past the check is to name the cap that was meant — which is the outcome either
way.  Matching on what is being sliced, the way the sha rule does, would need a
vocabulary for every noun a body of text goes by.

Known limits: only a cap that some module has already named is watched, so a
one-off `desc[:80]` passes — this check reports a value that has an owner being
respelled, not every number that could deserve one.  A new owner is protected
once it is added to `EXIT_OWNERS` or `CAP_OWNERS`.  And an exit code is only
recognised where it is exited with, compared against, keyed by or assigned to
something spelled `returncode` or `exit_code`, so a wrapper that renames the
field hides its literal.

Exit code: 0 if all files pass, 1 if any have violations.
"""

import argparse
import ast
import functools
import os
import re
import sys
from dataclasses import dataclass

_WORKBENCH_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.path.insert(0, os.path.join(_WORKBENCH_DIR, 'lib'))
from ansi import RED, GREEN, DIM, NC  # noqa: E402

SEARCH_DIRS = ('ai',)
SKIP_DIRS = {'.git', '__pycache__', '.venv', 'node_modules'}

LIB_DIR = os.path.join('ai', 'lib')


@dataclass(frozen=True)
class Owner:
    """Where a watched module's file lives, and the name a call site spells.

    The two are not derivable from each other: 76 of the 101 ai/lib modules
    were renamed, not merely relocated, when they moved into packages, so a
    module's package-relative file path can differ from the bare name a call
    site still writes under the R41 alias rule.  `review_budget` is one —
    the file is `review/budget.py`, but a call site still spells the constant
    `review_budget.MAX_REVIEW_BODY_LEN`.  `proc` and `trail` kept their
    basenames under `core/`, so `package` differs from their pre-move layout
    but `display` does not.
    """

    package: str
    file: str
    display: str


_PROC = Owner('core', 'proc', 'proc')
_TRAIL = Owner('core', 'trail', 'trail')
_REVIEW_BUDGET = Owner('review', 'budget', 'review_budget')

# The constants this check holds the monopoly for, as (owner, name) under
# ai/lib.  Their values are read from the modules themselves rather than
# repeated here — a validator that spelled 130 out would be the thing it
# rejects.
EXIT_OWNERS = (
    (_PROC, 'TIMEOUT_RETURNCODE'),
    (_PROC, 'INTERRUPT_RETURNCODE'),
    (_PROC, 'MISSING_RETURNCODE'),
)
CAP_OWNERS = (
    (_PROC, 'DETAIL_LIMIT'),
    (_TRAIL, 'EXCERPT_LIMIT'),
    (_REVIEW_BUDGET, 'MAX_REVIEW_BODY_LEN'),
)

ABBREV = 'git_client.abbrev(...)'

# A sha is sliced under many names — `sha`, `head_sha`, `commit["sha"]` — so the
# expression being sliced is matched as text.  The boundaries keep `sha256` and
# a word merely containing the letters out of it.
SHA_RE = re.compile(r'(?<![a-z])sha(?![a-z0-9])')

# What an exit code is compared against or assigned to.  `returncode` is what
# subprocess calls it, `exit_code` what the trail records do.
EXIT_CONTEXT_RE = re.compile(r'return_?code|exit_?code')

EXIT_CALLS = {'exit', '_exit', 'SystemExit'}


@dataclass(frozen=True)
class Violation:
    """One value written out where its owner should have been named.

    `found` quotes the site as it reads now; `suggestion` is the owner to write
    instead, already spelled the way the call site would spell it.
    """

    line: int
    found: str
    suggestion: str


# ── Owners ───────────────────────────────────────────────────────────────────


@functools.cache
def _module_constants(repo_root: str, owner: Owner) -> dict[str, int]:
    """Every module-level integer constant in the owner's file.

    Cached because several owners share a module, and each of them would
    otherwise re-read and re-parse the same file.
    """
    path = os.path.join(repo_root, LIB_DIR, owner.package, f'{owner.file}.py')
    with open(path) as f:
        tree = ast.parse(f.read(), filename=path)
    return dict(pair for node in tree.body for pair in _int_assignment(node))


def resolve_owners(repo_root: str, owners) -> dict[int, list[str]]:
    """The watched values, each mapped to the owners that spell it.

    A value can have more than one owner — 500 is both a trail excerpt and a
    truncated-file cap — and the report names all of them, because which one a
    given call site means is a question only its author can answer.
    """
    by_value: dict[int, list[str]] = {}
    for owner, name in owners:
        constants = _module_constants(repo_root, owner)
        if name not in constants:
            raise SystemExit(
                f'{RED}✗{NC} {owner.display}.{name} is gone — this check watches '
                f'a constant that no longer exists; update its owners table')
        by_value.setdefault(constants[name], []).append(f'{owner.display}.{name}')
    return by_value


# ── AST analysis ─────────────────────────────────────────────────────────────


def _is_int(node) -> bool:
    return isinstance(node.value, int) and not isinstance(node.value, bool)


def _int_assignment(node) -> list[tuple[str, int]]:
    """The names *node* binds to an integer, with the value, or [] if it binds none.

    `NAME: int = 130` counts alongside `NAME = 130` — an owner is no less named
    for carrying an annotation, and a check that read only one of the two forms
    would report the constant missing the day a module gained the other.
    """
    targets = node.targets if isinstance(node, ast.Assign) else \
        [node.target] if isinstance(node, ast.AnnAssign) else []
    value = getattr(node, 'value', None)
    if not isinstance(value, ast.Constant) or not _is_int(value):
        return []
    return [(t.id, value.value) for t in targets if isinstance(t, ast.Name)]


def _int_bound(node) -> tuple[int, str] | None:
    """The integer a slice bound is, with the sign it was written with."""
    inner, sign = node, ''
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.USub):
        inner, sign = node.operand, '-'
    if not isinstance(inner, ast.Constant) or not _is_int(inner):
        return None
    return inner.value, sign


def _slices(tree):
    """Every `x[a:b]` with an integer bound, as (node, value, sign)."""
    sliced = [n for n in ast.walk(tree)
              if isinstance(n, ast.Subscript) and isinstance(n.slice, ast.Slice)]
    bounds = [(n, b) for n in sliced
              for b in (n.slice.lower, n.slice.upper) if b is not None]
    return [(n, *parsed) for n, b in bounds
            for parsed in [_int_bound(b)] if parsed is not None]


def _named_constants(tree) -> set[int]:
    """The line numbers of module-level `NAME = <int>` assignments.

    An owner is defined somewhere, and that definition is the one place the
    number belongs.  Matching by line keeps the exemption to the assignment
    itself rather than to the whole module.
    """
    return {node.lineno for node in tree.body
            if any(name.isupper() for name, _ in _int_assignment(node))}


def _sha_slices(tree) -> list[Violation]:
    """Every abbreviation length written at a call site instead of asked for."""
    return [Violation(line=node.lineno,
                      found=f'{ast.unparse(node)}',
                      suggestion=ABBREV)
            for node, value, sign in _slices(tree)
            if not sign and SHA_RE.search(ast.unparse(node.value).lower())]


def _capped_slices(tree, caps: dict[int, list[str]]) -> list[Violation]:
    """Every slice bound that respells a cap some module already owns."""
    return [Violation(line=node.lineno,
                      found=f'{ast.unparse(node)}',
                      suggestion=' or '.join(f'{sign}{name}' for name in caps[value]))
            for node, value, sign in _slices(tree) if value in caps]


def _exit_literals(tree, codes: dict[int, list[str]]):
    """Every integer written where an exit code is exited with or read back.

    Four positions count: the argument of an exit call, the other side of a
    comparison against a `returncode`, a value assigned or passed under that
    name, and a dict entry keyed by it — which is how the trail records one.  A
    bare `return 130` is not among them: a function returning a number is not
    necessarily returning this one.
    """
    return [(v, codes[v.value])
            for node in ast.walk(tree) for v in _exit_positions(node)
            if isinstance(v, ast.Constant) and _is_int(v) and v.value in codes]


def _exit_positions(node):
    """The expressions in *node* that hold an exit code, if it is such a node."""
    if isinstance(node, ast.Call):
        name = node.func.attr if isinstance(node.func, ast.Attribute) else \
            getattr(node.func, 'id', '')
        if name in EXIT_CALLS:
            return node.args[:1]
        return [kw.value for kw in node.keywords
                if kw.arg and EXIT_CONTEXT_RE.search(kw.arg)]
    if isinstance(node, ast.Dict):
        return [v for k, v in zip(node.keys, node.values)
                if isinstance(k, ast.Constant) and isinstance(k.value, str)
                and EXIT_CONTEXT_RE.search(k.value)]
    if isinstance(node, ast.Compare):
        sides = [node.left] + node.comparators
        named = any(EXIT_CONTEXT_RE.search(ast.unparse(s).lower()) for s in sides)
        return sides if named else []
    if isinstance(node, (ast.Assign, ast.AnnAssign)):
        targets = node.targets if isinstance(node, ast.Assign) else [node.target]
        named = any(EXIT_CONTEXT_RE.search(ast.unparse(t).lower()) for t in targets)
        return [node.value] if named and node.value is not None else []
    return []


def check_file(filepath: str, exits: dict[int, list[str]],
               caps: dict[int, list[str]]) -> list[Violation] | None:
    """The findings in *filepath*, or None for a file that could not be read.

    None rather than an empty list, because the two answers are not the same
    one: a file this check never parsed has no findings and no clean bill
    either, and reporting it as clean is how a syntax error under `ai/` would
    leave the run green.
    """
    with open(filepath) as f:
        source = f.read()
    try:
        tree = ast.parse(source, filename=filepath)
    except SyntaxError as exc:
        print(f'{RED}!{NC} {filepath}: unparseable, not checked ({exc})',
              file=sys.stderr)
        return None
    found = _sha_slices(tree) + _capped_slices(tree, caps)
    found += [Violation(line=node.lineno, found=repr(node.value),
                        suggestion=' or '.join(owners))
              for node, owners in _exit_literals(tree, exits)]
    exempt = _named_constants(tree)
    return sorted((v for v in found if v.line not in exempt), key=lambda v: v.line)


# ── Discovery ────────────────────────────────────────────────────────────────


def _is_python(path: str) -> bool:
    if path.endswith('.py'):
        return True
    if os.path.splitext(path)[1] or not os.access(path, os.X_OK):
        return False
    try:
        with open(path, 'rb') as f:
            first = f.readline()
    except OSError:
        return False
    return first.startswith(b'#!') and b'python' in first


def discover_scripts(repo_root: str) -> list[str]:
    found = []
    roots = [os.path.join(repo_root, d) for d in SEARCH_DIRS]
    for root in roots:
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            paths = [os.path.join(dirpath, f) for f in filenames]
            found += [p for p in paths if _is_python(p)]
    return sorted(found)


# ── Reporting ────────────────────────────────────────────────────────────────


def _report_violations(relpath: str, violations: list[Violation]) -> None:
    print(f'{RED}✗{NC} {relpath}: a value written out instead of named',
          file=sys.stderr)
    for v in violations:
        print(f'    line {v.line}: {v.found} '
              f'{DIM}— use {v.suggestion}{NC}', file=sys.stderr)


def _report_file(relpath: str, violations: list[Violation] | None, quiet: bool) -> None:
    """What one file's result looks like on the way past.

    A file that could not be parsed gets no line here — its warning went out
    when the parse failed, and a tick beside it would contradict that.
    """
    if violations:
        _report_violations(relpath, violations)
    elif violations == [] and not quiet:
        print(f'  {GREEN}✓{NC} {relpath}')


def _print_summary(files_checked: int, errors: int, unreadable: int) -> None:
    print()
    if errors:
        print(f'{RED}✗{NC} {errors} of {files_checked} files write out a value '
              f'that has an owner', file=sys.stderr)
    if unreadable:
        print(f'{RED}✗{NC} {unreadable} file{"" if unreadable == 1 else "s"} '
              f'could not be parsed and went unchecked', file=sys.stderr)
    if not errors and not unreadable:
        print(f'{GREEN}✓{NC} {files_checked} files checked, '
              f'every owned value is spelled by its owner')


# ── CLI ──────────────────────────────────────────────────────────────────────


def main():
    parser = argparse.ArgumentParser(
        description='Validate that owned values are spelled by their owner, not written out.')
    parser.add_argument('--quiet', action='store_true',
                        help='Only show failures and summary')
    parser.add_argument('files', nargs='*',
                        help='Files to check (auto-discovers if omitted)')
    args = parser.parse_args()

    repo_root = _WORKBENCH_DIR
    exits = resolve_owners(repo_root, EXIT_OWNERS)
    caps = resolve_owners(repo_root, CAP_OWNERS)

    # Named files go through the same gate discovery applies, so a non-Python
    # path is out of scope rather than reported unparseable.
    files = [f for f in args.files if _is_python(f)] if args.files \
        else discover_scripts(repo_root)

    errors, unreadable = 0, 0
    for filepath in files:
        violations = check_file(filepath, exits, caps)
        errors += 1 if violations else 0
        unreadable += 1 if violations is None else 0
        _report_file(os.path.relpath(filepath, repo_root), violations, args.quiet)

    _print_summary(len(files) - unreadable, errors, unreadable)
    if errors or unreadable:
        sys.exit(1)


if __name__ == '__main__':
    main()
