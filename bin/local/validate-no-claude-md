#!/usr/bin/env bash
# Validate that a repo tracks no CLAUDE.md — AGENTS.md is the only instructions
# file name.
#
# Claude Code reads AGENTS.md only when no CLAUDE.md exists in the directory
# chain, so a CLAUDE.md anywhere — a full file, a pointer to AGENTS.md, one in a
# subdirectory — makes it ignore the sibling AGENTS.md without any error. The
# check reads the same candidate set every other caller does
# (ai/lib/core/project_context.py --shadows), so what counts as a shadow is
# decided in one place: a root CLAUDE.md, .claude/CLAUDE.md, and any tracked
# CLAUDE.md at depth. There are no exemptions.
#
# Usage: bin/local/validate-no-claude-md [--quiet] [--registered] [DIR]
# Exit codes: 0 if no checked repo has a CLAUDE.md, 1 if any does, 2 on a usage
#             error.

set -euo pipefail

_SELF="${BASH_SOURCE[0]}"
# Path arithmetic rather than `git rev-parse --show-toplevel`: the pre-push hook
# exports GIT_DIR, which would make that form answer the caller's cwd.
REPO_ROOT="$(cd "$(dirname "$_SELF")/../.." && pwd)"
# shellcheck source=../../lib/ui.sh
. "$REPO_ROOT/lib/ui.sh"
# shellcheck source=../../lib/gitenv.sh
. "$REPO_ROOT/lib/gitenv.sh"

PROJECT_CONTEXT_PY="$REPO_ROOT/ai/lib/core/project_context.py"

usage() {
  cat <<EOUSAGE
Usage: $(basename "$0") [--quiet] [--registered] [DIR]

Check that DIR tracks no CLAUDE.md, which would make Claude Code ignore AGENTS.md.

Arguments:
  DIR           Repository to check (default: the workbench repo root)

Options:
  --registered  Also check every repo registered with the workbench
  --quiet       Suppress output on success
  -h, --help    Show this help
EOUSAGE
}

QUIET=false
REGISTERED=false
TARGET=""
POSITIONAL=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quiet) QUIET=true ;;
    --registered) REGISTERED=true ;;
    -h|--help) usage; exit 0 ;;
    -*) err "Unknown argument: $1"; usage; exit 2 ;;
    *) TARGET="$1"; POSITIONAL=$(( POSITIONAL + 1 )) ;;
  esac
  shift
done

if (( POSITIONAL > 1 )); then
  err "Only one directory may be given"
  usage
  exit 2
fi

TARGET="${TARGET:-$REPO_ROOT}"

# The repo to read has to outrank the environment: a set GIT_DIR wins over
# `git -C`. lib/gitenv.sh owns the list of variables that means.
git_env_clear

FAILED=false

# check_repo DIR — reports DIR's CLAUDE.md files, and sets FAILED when any exist.
check_repo() {
  local dir="$1" shadows
  if ! shadows="$(python3 "$PROJECT_CONTEXT_PY" --root "$dir" --shadows)"; then
    err "Could not read $dir"
    FAILED=true
    return 0
  fi
  if [[ -z "$shadows" ]]; then
    return 0
  fi
  FAILED=true
  err "$dir tracks a CLAUDE.md, which makes Claude Code ignore AGENTS.md"
  printf '%s\n' "$shadows" | sed 's/^/    /' >&2
  echo -e "    ${DIM}AGENTS.md is the only instructions file name — fold the content" >&2
  echo -e "    into AGENTS.md and delete the CLAUDE.md (git mv when there is no AGENTS.md)${NC}" >&2
  return 0
}

check_repo "$TARGET"

if [[ "$REGISTERED" == true ]]; then
  # shellcheck source=../../lib/constants.sh
  . "$REPO_ROOT/lib/constants.sh"
  # shellcheck source=../../lib/projects.sh
  . "$REPO_ROOT/lib/projects.sh"
  # Captured first: a failing process substitution is just empty input.
  leaders="$(project_repo_leaders)"
  while IFS=$'\t' read -r _ path; do
    [[ -d "$path" ]] || continue
    check_repo "$path"
  done <<< "$leaders"
fi

if [[ "$FAILED" == true ]]; then
  exit 1
fi

$QUIET || success "no CLAUDE.md shadows an AGENTS.md"
