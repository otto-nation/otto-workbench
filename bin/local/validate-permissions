#!/usr/bin/env python3
"""Validate permission rules: every rule can match, belongs, and is in order.

Usage: bin/local/validate-permissions [--quiet] [--fix] [file...]

Claude Code classifies a permission rule before matching it, and the two forms
are not interchangeable:

    Bash(npm run:*)    prefix rule   — literal startsWith, no globbing
    Bash(npm run *)    wildcard rule — compiled to a regex

The `:*` suffix is tested first, so a `*` written inside the prefix buys
nothing: `Bash(bin/local/*:*)` asks for commands beginning with the eleven
characters `bin/local/*`, which nobody types.  The Bash matcher also never
expands `~` — the tilde helpers are reached only from path-rule handling — so
`Bash(~/.claude/skills/**:*)` matches nothing but a command someone spelled
with a literal tilde, and the absolute path that tools actually emit misses it.

Neither mistake is an error anywhere.  The rule simply never matches, and the
permission prompt it was written to prevent keeps appearing; the usual repair
is a one-off entry in settings.local.json, which hides the dead rule for good.

Registry `permission:` entries never reach a committed settings file — they are
collected at sync time and injected into ~/.claude/settings.json.  Pass that
file (or any other) as an argument to check them; tests/claude_settings.bats
does exactly that against a synced sandbox.

The second question is where a live rule is written down, and `lib/permissions`
answers it — the matcher, the coverage test, and the discovery walk all live
there so that `otto-workbench permissions sweep` can ask the same questions of
every registered repo.  Its two drift classes land here as:

    a local `allow` a tracked `allow` already makes   → --fix deletes it
    a local `allow` over a tracked `ask` rule         → a human deletes it

Both fail rather than warn.  A warning could not reach anyone here: validate-all
captures each validator's output and prints it only when the validator exits
non-zero, so on a green run the text is discarded before the pre-push hook or CI
ever renders it.  Failing is what makes the finding visible, and --fix is what
keeps that defensible — the covered class is pruned by a command, not by hand,
and the file it prunes regrows.

The third question is what order a committed `allow` bucket is written in, and
it is asked of tracked files only.  Claude Code rewrites that bucket in
codepoint order on the next grant, so a file committed any other way comes back
modified with nothing added and nothing removed — a diff that then sits in
every worktree holding it, reported as uncommitted work nobody can identify.
`deny` is exempt: the writer leaves it alone, and it is grouped here by the
command it guards.  The container mirror is exempt too — it is generated with
the managed rules deliberately in front of whatever was already there, which
sorting would undo.

This validator is scoped to this repo on purpose: validate-all runs from
git/hooks/pre-push-workbench and .github/workflows/ci.yml, and neither is a
sensible vehicle for failing on drift in somebody else's checkout.  The
machine-wide view is `otto-workbench permissions sweep`, which reports.

When no files are given, discovers every settings JSON in the repo that
declares Bash rules, plus the untracked ones in the bare-repo container above
a linked worktree, which no walk rooted in the worktree can reach.

The container's own `settings.json` is the exception: `otto-workbench
permissions mirror` generates it from the tracked file, so its rules were
reviewed where the tracked file was and it is checked for dead rules but not
for drift.  A grant reaching the container despite the mirror is drift, which
is what the finding at the end of this file says to regenerate.

Exit code: 0 if every rule is live, every grant is in the right file, and every
tracked `allow` is in the writer's order, 1 otherwise.
"""

import argparse
import dataclasses
import json
import os
import sys

_WORKBENCH_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.path.insert(0, os.path.join(_WORKBENCH_DIR, 'lib'))
from ansi import RED, GREEN, DIM, NC  # noqa: E402
from permissions import (  # noqa: E402
    BASH_RULE, TRACKED_SETTINGS, Drift, Grant,
    at_container, container_dir, discover_container_settings, discover_settings,
    drift_in, first_misordered, is_local, line_of, prune, rules_in, sort_allow,
    tracked_rules,
)

# Named in the failure message: validate-all does not pass --fix, so the human
# reading a failed pre-push has to be told exactly what to type.
FIX_COMMAND = 'bin/local/validate-permissions --fix'

# Named alongside it when the finding is at the container: pruning the grant
# only helps until the next prompt, and the mirror is what stops it recurring.
MIRROR_COMMAND = 'otto-workbench permissions mirror'

TILDE = 'the Bash matcher never expands ~, so only a literally tilde-spelled command matches'
LITERAL_STAR = ':* is prefix matching, so the * inside the prefix never globs'
EMPTY_PREFIX = 'nothing precedes :*, so the rule names no command'

NAME_THE_COMMAND = 'a rule that names the command it is for'

MISORDERED = ('Claude Code rewrites allow in codepoint order on the next grant, so this file '
              'comes back modified with no rule added and none removed')


@dataclasses.dataclass(frozen=True)
class Violation:
    """A rule that no command can ever match."""

    rule: str
    reason: str
    fix: str
    line: int = 0


@dataclasses.dataclass(frozen=True)
class Misordered:
    """The first `allow` rule written where Claude Code would not write it."""

    rule: str
    line: int = 0


def _live_form(body: str) -> str:
    """Rewrite a rule body into the closest wildcard form that can match.

    Wildcard rules are anchored at both ends, so a pattern that does not
    already end in `*` gains one — otherwise it would match the bare command
    and reject every invocation carrying an argument.

    A leading `~` becomes `/*` rather than a bare `*`: the home directory it
    stood for is an absolute path, and an unanchored pattern would also match
    the same text buried mid-command, after a pipe into a shell.
    """
    pattern = body[:-2] if body.endswith(':*') else body
    if pattern.startswith('~'):
        pattern = '/*' + pattern[1:]
    # GLOBSTAR only means anything between slashes; elsewhere ** is just *.
    pattern = pattern.replace('**', '*')
    if not pattern.endswith('*'):
        pattern += '*'
    return f'Bash({pattern})'


def _diagnose(rule: str) -> Violation | None:
    """Return a Violation if the rule can never match, else None."""
    match = BASH_RULE.match(rule)
    if not match:
        return None

    body = match.group(1)
    if not body.endswith(':*'):
        return Violation(rule, TILDE, _live_form(body)) if body.startswith('~') else None

    prefix = body[:-2]
    if not prefix:
        return Violation(rule, EMPTY_PREFIX, NAME_THE_COMMAND)
    if prefix.startswith('~'):
        return Violation(rule, TILDE, _live_form(body))
    if '*' in prefix:
        return Violation(rule, LITERAL_STAR, _live_form(body))
    return None


def check_rules(rules: list[str]) -> list[Violation]:
    """Return a Violation for every rule that can never match a command."""
    return [v for v in (_diagnose(rule) for rule in rules) if v is not None]


def check_file(filepath: str) -> list[Violation]:
    """Return every dead permission rule in a settings JSON file."""
    with open(filepath) as f:
        text = f.read()

    lines = text.splitlines()
    violations = check_rules(rules_in(json.loads(text)))
    return [dataclasses.replace(v, line=line_of(lines, v.rule)) for v in violations]


def check_order(filepath: str) -> Misordered | None:
    """Return the first `allow` rule out of the writer's order, or None."""
    with open(filepath) as f:
        text = f.read()

    allow = (json.loads(text).get('permissions') or {}).get('allow') or []
    rule = first_misordered(allow)
    return Misordered(rule, line_of(text.splitlines(), rule)) if rule else None


# ── Reporting ───────────────────────────────────────────────────────────────

def _report_violations(relpath: str, violations: list[Violation]) -> None:
    print(f'{RED}✗{NC} {relpath}: {len(violations)} permission rule(s) can never match',
          file=sys.stderr)
    for violation in violations:
        where = f'line {violation.line}: ' if violation.line else ''
        print(f'      {where}{violation.rule}', file=sys.stderr)
        print(f'        {violation.reason}', file=sys.stderr)
        print(f'        {DIM}use {violation.fix}{NC}', file=sys.stderr)


def _report_overrides(relpath: str, grants: list[Grant]) -> None:
    print(f'{RED}✗{NC} {relpath}: {len(grants)} local grant(s) re-grant a gated command',
          file=sys.stderr)
    for grant in grants:
        where = f'line {grant.line}: ' if grant.line else ''
        print(f'      {where}{grant.rule}', file=sys.stderr)
        print(f'        {grant.tracked} asks first because the script reaches credentials, '
              f'and a local allow removes the prompt', file=sys.stderr)
        print(f'        {DIM}delete the local grant{NC}', file=sys.stderr)


def _report_covered(relpath: str, grants: list[Grant], in_container: bool) -> None:
    print(f'{RED}✗{NC} {relpath}: {len(grants)} local grant(s) a tracked rule already makes',
          file=sys.stderr)
    for grant in grants:
        where = f'line {grant.line}: ' if grant.line else ''
        print(f'      {where}{grant.rule}', file=sys.stderr)
        print(f'        {TRACKED_SETTINGS} already grants this via {grant.tracked}, '
              f'and the local copy dies with the checkout', file=sys.stderr)
    print(f'        {DIM}run `{FIX_COMMAND}` to delete them{NC}', file=sys.stderr)
    if in_container:
        # The container holds no working tree, so there is no tracked file
        # there to move a grant into. The mirror is what carries the tracked
        # rules up to it, so a grant landing here anyway means the mirror is
        # missing or stale — regenerating it is the cure, not an edit by hand.
        print(f'        {DIM}the container keeps no tracked file — run `{MIRROR_COMMAND}` so '
              f'{TRACKED_SETTINGS} reaches sessions rooted there{NC}', file=sys.stderr)


def _report_misordered(relpath: str, misordered: Misordered) -> None:
    print(f'{RED}✗{NC} {relpath}: allow is not in the order Claude Code writes it',
          file=sys.stderr)
    where = f'line {misordered.line}: ' if misordered.line else ''
    print(f'      {where}{misordered.rule}', file=sys.stderr)
    print(f'        {MISORDERED}', file=sys.stderr)
    print(f'        {DIM}run `{FIX_COMMAND}` to sort it{NC}', file=sys.stderr)


def _report_sorted(relpath: str) -> None:
    print(f'  {GREEN}✓{NC} {relpath}: sorted allow into the order Claude Code writes it')


def _report_pruned(relpath: str, grants: list[Grant], quiet: bool) -> None:
    print(f'  {GREEN}✓{NC} {relpath}: pruned {len(grants)} local grant(s) a tracked rule '
          f'already makes')
    for grant in [] if quiet else grants:
        print(f'      {DIM}{grant.rule} — covered by {grant.tracked}{NC}')


def _print_summary(files_checked: int, errors: int) -> None:
    print()
    if errors == 0:
        print(f'{GREEN}✓{NC} {files_checked} files checked, every permission rule is live, '
              f'in the right file, and in the order Claude Code writes it')
    else:
        print(f'{RED}✗{NC} {errors} of {files_checked} files declare a rule that can never '
              f'match, a grant that belongs somewhere else, or an allow bucket the next '
              f'grant will reorder', file=sys.stderr)


# ── CLI ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description='Validate that every Bash permission rule can match a command, and that '
                    'no untracked settings file holds a grant a tracked rule speaks for.')
    parser.add_argument('--quiet', action='store_true', help='Only show failures and summary')
    parser.add_argument('--fix', action='store_true',
                        help='Delete local grants a tracked rule already makes, and sort a '
                             'tracked allow bucket into the order Claude Code writes it')
    parser.add_argument('files', nargs='*', help='Settings files to check (auto-discovers if omitted)')
    args = parser.parse_args()

    repo_root = _WORKBENCH_DIR
    container = container_dir(repo_root)
    tracked = tracked_rules(repo_root)
    discovered = discover_settings(repo_root) + discover_container_settings(container)
    files = args.files if args.files else discovered

    errors = 0

    for filepath in files:
        relpath = os.path.relpath(filepath, repo_root)
        violations = check_file(filepath)
        in_container = at_container(filepath, container)
        local = is_local(filepath, in_container)
        drift = drift_in(filepath, tracked) if local else Drift()
        # Order is a committed file's problem: a local one dies with the
        # checkout, and the container mirror is generated with the managed
        # rules in front of what was already there, which sorting would undo.
        misordered = None if local or in_container else check_order(filepath)

        pruned = drift.covered if args.fix else []
        if pruned:
            prune(filepath, pruned)
            _report_pruned(relpath, pruned, args.quiet)
            drift = Drift(drift.overrides)

        resorted = bool(misordered) and args.fix
        if resorted:
            sort_allow(filepath)
            _report_sorted(relpath)
            misordered = None

        errors += 1 if violations or not drift.empty or misordered else 0

        if violations:
            _report_violations(relpath, violations)
        if drift.overrides:
            _report_overrides(relpath, drift.overrides)
        if drift.covered:
            _report_covered(relpath, drift.covered, in_container)
        if misordered:
            _report_misordered(relpath, misordered)
        clean = not violations and drift.empty and not misordered
        if clean and not pruned and not resorted and not args.quiet:
            print(f'  {GREEN}✓{NC} {relpath}')

    _print_summary(len(files), errors)
    if errors:
        sys.exit(1)


if __name__ == '__main__':
    main()
