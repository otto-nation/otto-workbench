#!/usr/bin/env python3
"""Validate that every pi extension package clone can serve the installed pi.

Usage: bin/local/validate-pi-extension-clones [--quiet] [--json]

Pi resolves a `git:` package in `settings.json` by cloning it once and then
reusing whatever is on disk — `resolvePackageSources` refetches only for
`temporary` scope, so a user or project clone freezes at the SHA it had on the
first run that needed it. `pi update` with no flags updates the host binary
alone. Nothing refreshes those clones, and nothing notices when the host moves
out from under them.

The failure that prompted this is silent, which is what makes it worth a gate.
pi 0.86 replaced the provider input `Context` — carrying `systemPrompt` and
`tools` as fields — with a normalized `TranscriptContext` holding both inside
the transcript's system messages. A provider extension predating that change
reads fields that no longer exist and sends the model no system prompt and no
tool declarations. The model cannot call a tool, so it answers in prose and
often *fabricates* the result: asked to run a command and report the output, an
agent on a stale clone reported plausible output having executed nothing, and
the run exited 0. A review, a triage, or a fix pass on that clone produces
confident findings with no evidence behind them, under a green status.

Both directions of the skew are checked, because both have now happened here:

  clone older than host  — the provider predates the transcript contract, so
                           tools silently vanish (the fabrication case)
  clone newer than host  — the provider imports symbols the host's pi-ai does
                           not export, e.g. `getCurrentSystemPrompt`, and every
                           agent dies on turn 1 with a TypeError

The second direction is also checked against what each package *declares*, not
only against the one symbol pair above. A package names the pi-ai it is built
against in its own `package.json`, and a host older than that floor cannot
export everything the package imports — whichever release moved the contract.
The symbol check knows about pi 0.86 and nothing after it; the declared floor
costs nothing and covers every contract upstream moves next.

A provider carrying none of those adapter symbols is not always stale: one that
hands the context, untouched, to a transport pi-ai itself ships (imported from
`pi-ai/compat`, see TRANSPORT_SPECIFIERS) is read by the host's own code, so it
follows whatever shape the host builds. Such a provider is exempt from the
stale-clone finding, and is checked instead against the first host whose
`/compat` exports the transport (TRANSPORT_FACTORY_VERSION).

The clone on disk is what is inspected, not a version string committed
somewhere. A pinned-version test passes while the clone that actually serves
the run is stale, because the clone is gitignored and CI never sees it — so a
check reading committed text answers a question nobody asked.

Exit code: 0 when every clone found can serve the installed pi, 1 otherwise.
Absent pi, or no clones at all, is a pass: this validates what is installed and
has nothing to say about a machine that has not installed it.
"""

import argparse
import itertools
import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from enum import Enum
from pathlib import Path

_WORKBENCH_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
for _path in (os.path.join(_WORKBENCH_DIR, 'lib'), os.path.join(_WORKBENCH_DIR, 'ai', 'lib')):
    if _path not in sys.path:
        sys.path.insert(0, _path)
from ansi import RED, GREEN, YELLOW, DIM, NC  # noqa: E402
import config.workbench_projects  # noqa: E402

# The pi release that introduced TranscriptContext. A provider extension is
# expected to carry the adapter below from this version on.
TRANSCRIPT_CONTRACT_VERSION = (0, 86)

# The adapter a post-0.86 provider needs, relative to a package clone root.
# Named by the symbol it must resolve rather than by file, since the file is
# this package's own layout choice; the import is the contract with pi-ai.
TRANSCRIPT_SYMBOLS = ('getCurrentSystemPrompt', 'getCurrentTools')

# The other way a provider meets the contract: hand the context, untouched, to
# a transport pi-ai itself ships. That transport is the host's own, so it reads
# whatever shape the host builds, and the provider never names the adapter
# symbols above. pi exposes its built-in transports to extensions through this
# entrypoint (vertex-claude imports anthropicMessagesApi from it).
#
# A delegating clone has its own floor: the host must export the factory. A
# host below it fails the import, so the provider registers nothing (or, if it
# does not guard the import, fails to load) — see TRANSPORT_FACTORY_VERSION.
TRANSPORT_SPECIFIERS = tuple(f'{pkg}/compat' for pkg in (
    '@earendil-works/pi-ai', '@mariozechner/pi-ai'))

# The transport factory a delegating provider takes from that entrypoint.
TRANSPORT_FACTORY = 'anthropicMessagesApi'

# The first pi release whose `pi-ai/compat` exports TRANSPORT_FACTORY: 0.80.1,
# the first 0.80 published (read from the published packages' dist/compat —
# 0.79.10 has no `/compat`). Compared on major.minor like the contract version.
TRANSPORT_FACTORY_VERSION = (0, 80)

# An import of the entrypoint — `from "…"`, `import("…")` or `require("…")` —
# rather than the bare specifier appearing on its own. It is a text match, so
# a `from "…"` written inside a comment or string still matches; comments are
# not stripped first.
_TRANSPORT_IMPORT = re.compile(
    r'(?:\bfrom\s*|\bimport\s*\(\s*|\brequire\s*\(\s*)[\'"]('
    + '|'.join(re.escape(spec) for spec in TRANSPORT_SPECIFIERS) + r')[\'"]')

# The dependency names a package declares its pi-ai against. Both spellings
# are the same package — pi resolves the legacy `@mariozechner` specifier to
# the published `@earendil-works` one, and extension sources still import it
# under either name — so a package may declare it under either.
PI_AI_PACKAGES = ('@earendil-works/pi-ai', '@mariozechner/pi-ai')

# Where the declaration is looked for, strongest claim first.
# `peerDependencies` is the field that means "the host must supply this".
# `devDependencies` is where a package that needs pi-ai only for its types and
# its tests puts it — a weaker claim, but it still names the release the code
# was written against, and the symbols it imports have to exist on the host.
DEPENDENCY_FIELDS = ('peerDependencies', 'dependencies', 'devDependencies')

# A floor read off a pi-ai range is compared against `pi --version`, which is
# the pi-coding-agent version. The two packages are released together from one
# repo at one version — 0.87.1 and 0.99.2 are each published under both names —
# so the comparison holds. If they ever diverge this check reads the wrong
# number, which is why the floor is only ever a lower bound: see _range_floor.
#
# Anchored with fullmatch rather than search: a git specifier like
# `github:earendil-works/pi#v0.99.2` contains a version-looking substring after
# the `#`, and an unanchored search would misread that ref as a declared
# floor. Requiring the whole clause to be a bare version or comparator range
# makes a git URL fall through to "no floor" structurally, not incidentally.
#
# No `<` or `<=` alternative: a clause opening with `<` is an upper bound and
# _range_floor drops it before it reaches this pattern, so listing it here
# would be a branch nothing can take.
_VERSION_IN_RANGE = re.compile(r'(?:[~^=]|>=?)?v?(\d+)\.(\d+)(?:\.(\d+))?')

# Where pi keeps clones: one user-scope root, plus a per-project root inside any
# repo whose settings declare a package. The project form is what multiplies —
# every worktree of a repo gets its own.
USER_PACKAGE_ROOT = Path.home() / '.pi' / 'agent' / 'git'
PROJECT_PACKAGE_GLOB = '.pi/git'


def _run(cmd: list[str], cwd: str | None = None) -> str | None:
    """Stdout of a command, or None when it cannot be run or fails."""
    try:
        out = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return out.stdout.strip()


def installed_pi_version() -> tuple[int, ...] | None:
    """The version of the pi on PATH, or None when there is none to ask."""
    raw = _run(['pi', '--version'])
    if not raw:
        return None
    match = re.match(r'(\d+)\.(\d+)(?:\.(\d+))?', raw)
    if not match:
        return None
    return tuple(int(p) for p in match.groups() if p is not None)


# The cure for a host below a clone's floor, when the host is pi's own install.
PI_UPDATE_REMEDY = 'update the host with: pi update'


def pi_pin_source() -> str | None:
    """The mise config that pins the pi on PATH, or None when mise does not supply it.

    `pi update` moves pi's own install. A pi supplied by a mise pin is not that
    install — mise re-resolves the pinned version on every invocation, so the
    update either fails or is undone, and the only cure is raising the pin.
    Telling that reader to run `pi update` sends them to a command that
    cannot work, which is how a project pin read as a stale host.

    The pi actually run is the first on PATH. A mise shim there resolves
    through mise, so it is followed with `mise which`; a tool directory that
    `mise activate` put on PATH is matched against each active tool's
    install_path.
    """
    on_path = shutil.which('pi')
    if not on_path:
        return None
    resolved = os.path.realpath(on_path)
    if os.path.basename(resolved) == 'mise':
        resolved = os.path.realpath(_run(['mise', 'which', 'pi']) or resolved)
    raw = _run(['mise', 'ls', '--current', '--json'])
    if not raw:
        return None
    try:
        tools = json.loads(raw)
    except ValueError:
        return None
    if not isinstance(tools, dict):
        return None
    entries = itertools.chain.from_iterable(
        versions for versions in tools.values() if isinstance(versions, list))
    return next((source for source in (_pin_supplying(entry, resolved) for entry in entries)
                 if source), None)


def _pin_supplying(entry, resolved: str) -> str | None:
    """The config path of one `mise ls` entry, when its install holds `resolved`."""
    if not isinstance(entry, dict):
        return None
    install = entry.get('install_path')
    source = (entry.get('source') or {}).get('path')
    if install and source and resolved.startswith(os.path.realpath(install) + os.sep):
        return source
    return None


def host_remedy(pin_source: str | None) -> str:
    """How to move the host, given where the pi on PATH comes from."""
    if pin_source is None:
        return PI_UPDATE_REMEDY
    return (f'this pi is pinned by mise in {pin_source} — raise the pin there '
            f'(pi update cannot move it), or run from outside that directory '
            f'to check your own pi')


def _triple(parts) -> tuple[int, int, int]:
    """A version as three components, so two of unequal length still compare.

    `0.87` and `0.87.1` are not the same version and must not sort as though
    the shorter one were larger.
    """
    filled = tuple(int(p) for p in parts if p is not None)
    return filled + (0,) * (3 - len(filled))  # type: ignore[return-value]


def _range_floor(spec: str) -> tuple[int, int, int] | None:
    """The oldest version a semver range admits, or None when it names none.

    Only the lower bound is read, and for two reasons. An upper bound in a
    range like `^0.87.1` is a *test-time* bound: pi-ai is never installed at
    runtime — the host injects its own copy through pi's virtual module loader
    — so a package cannot bound the host it will be loaded into, and reading
    `^0.87.1` as "refuses 0.99" would fail a machine that demonstrably works.
    The lower bound is a real claim, because the symbols the package imports
    have to exist.

    An explicit upper bound is skipped rather than mistaken for a floor:
    `<0.88.0` admits everything below 0.88, so its number is a ceiling. A `||`
    union is answered by its first clause, which is the union's floor.

    Anything that is not a version range — `*`, `latest`, `workspace:*`, a git
    URL — declares no floor, and None is the honest answer rather than a guess.

    A prerelease or build suffix is not read either: `^1.0.0-beta.1` orders
    below `1.0.0`, and reading it as 1.0.0 would fail a host the range admits.
    pi has never published one, so the choice is between a miss on a version
    that does not exist and a false failure on one that might.
    """
    for clause in spec.split():
        if clause.startswith('<'):
            continue
        match = _VERSION_IN_RANGE.fullmatch(clause)
        if match:
            return _triple(match.groups())
    return None


def _declared_pi_ai_specs(manifest: dict):
    """Every pi-ai range a manifest declares, strongest claim first.

    Both dependency field and package name are varied here so the caller is a
    flat loop over candidate ranges rather than a nest of lookups.
    """
    for field, name in itertools.product(DEPENDENCY_FIELDS, PI_AI_PACKAGES):
        declared = manifest.get(field)
        if isinstance(declared, dict) and isinstance(declared.get(name), str):
            yield declared[name]


def declared_host_floor(clone: Path) -> tuple[int, int, int] | None:
    """The oldest pi this clone's own `package.json` says it was built against.

    None when the package declares no pi-ai at all, which is every package of
    plain skills or tools. Nothing declared is nothing to check — the floor is
    the package's claim about itself, and this check does not invent one for a
    package that made none.

    Reads only the clone root's `package.json`, not every manifest under the
    clone — unlike the symbol checks below, which walk every `.ts` file. A
    workspace clone with a nested `package.json` per extension would have its
    pi-ai declaration invisible here even though the symbol check would still
    see the import. Every clone this validator runs against today is a flat
    single-manifest repo, so this is an assumption rather than a demonstrated
    gap; widen the scan if a nested-manifest clone shows up.
    """
    try:
        manifest = json.loads((clone / 'package.json').read_text(errors='replace'))
    except (OSError, ValueError):
        return None
    if not isinstance(manifest, dict):
        return None

    for spec in _declared_pi_ai_specs(manifest):
        floor = _range_floor(spec)
        if floor is not None:
            return floor
    return None


def _package_clones(root: Path) -> list[Path]:
    """Every package clone under a pi `git` root: <root>/<host>/<owner>/<repo>."""
    if not root.is_dir():
        return []
    return sorted(p for p in root.glob('*/*/*') if (p / '.git').exists())


def _project_git_roots() -> list[Path]:
    """Every `.pi/git` directory under a registered project's worktree root.

    Registered projects (`workbench_projects.registered()`) are the worktree
    roots a workbench command has actually run in, at whatever depth they live
    on this machine — no guessed search root or depth limit needed to find a
    `.pi/git` sitting under one of them. See `lib/projects.sh`'s header for why
    a guessed-root scan was tried and abandoned before.
    """
    roots = []
    for project_root in config.workbench_projects.registered():
        candidate = project_root / PROJECT_PACKAGE_GLOB
        if candidate.is_dir():
            roots.append(candidate)
    return roots


def discover_clones() -> list[tuple[str, Path]]:
    """Every (scope, path) package clone this machine would load."""
    found = [('user', p) for p in _package_clones(USER_PACKAGE_ROOT)]
    for git_root in _project_git_roots():
        found.extend(('project', p) for p in _package_clones(git_root))
    return found


def _ts_files(clone: Path):
    """Every `.ts` file under a clone, with `node_modules` pruned from descent.

    A manual walk rather than `rglob` + a per-file filter: `node_modules` is
    removed from `dirnames` in place, so the subtree is never entered, instead
    of being walked and then discarded file by file.
    """
    for dirpath, dirnames, filenames in os.walk(clone):
        dirnames[:] = [d for d in dirnames if d != 'node_modules']
        yield from (Path(dirpath) / f for f in filenames if f.endswith('.ts'))


class Fact(Enum):
    """What one clone's source establishes about the transcript contract."""

    PROVIDER = 'provider'
    ADAPTER = 'adapter'
    DELEGATES = 'delegates'


def _file_facts(text: str) -> set[Fact]:
    """Which contract facts one `.ts` file's text establishes."""
    facts = set()
    if 'registerProvider' in text or 'provider:' in text:
        facts.add(Fact.PROVIDER)
    if any(symbol in text for symbol in TRANSCRIPT_SYMBOLS):
        facts.add(Fact.ADAPTER)
    # Both the import and the factory are required: importing something else
    # from `/compat` leaves a provider reading the context's fields itself.
    if TRANSPORT_FACTORY in text and _TRANSPORT_IMPORT.search(text):
        facts.add(Fact.DELEGATES)
    return facts


def _clone_facts(clone: Path) -> set[Fact]:
    """The contract facts established anywhere in a clone, in one walk.

    `node_modules` is pruned by `_ts_files`, so a vendored pi-ai defining these
    very symbols establishes nothing.
    """
    facts: set[Fact] = set()
    for path in _ts_files(clone):
        try:
            text = path.read_text(errors='replace')
        except OSError:
            continue
        facts |= _file_facts(text)
    return facts


@dataclass(frozen=True)
class Skew:
    """One clone's disagreement with the installed pi, and the cure for it.

    The cure travels with the finding because the two skew directions are
    cured at opposite ends: a stale clone is fixed by moving the clone, a host
    below a clone's floor by moving the host. One hardcoded hint would send
    half of all readers to the wrong command.
    """

    problem: str
    remedy: str


def _version_str(version: tuple[int, ...]) -> str:
    return '.'.join(str(part) for part in version)


def check_clone(clone: Path, pi_version: tuple[int, ...],
                update_remedy: str = PI_UPDATE_REMEDY) -> Skew | None:
    """Return the skew between this clone and the installed pi, or None.

    update_remedy is the cure for every finding that moving the host fixes;
    see host_remedy for why it is not always `pi update`.

    The declared floor is checked for every clone, including one that registers
    no provider: any package can import a symbol a host too old to have it
    cannot supply. The transcript checks below are the provider-only ones,
    since only a provider builds the request whose shape 0.86 changed.
    """
    floor = declared_host_floor(clone)
    if floor is not None and _triple(pi_version) < floor:
        return Skew(
            problem=(f'clone declares pi-ai {_version_str(floor)} but the installed pi '
                     f'is {_version_str(pi_version)}, so it imports symbols this host '
                     f'does not export and every agent dies on turn 1'),
            remedy=update_remedy)

    facts = _clone_facts(clone)
    if Fact.PROVIDER not in facts:
        return None

    host_has_transcript = pi_version[:2] >= TRANSCRIPT_CONTRACT_VERSION
    clone_has_adapter = Fact.ADAPTER in facts
    clone_delegates = Fact.DELEGATES in facts

    if clone_delegates and not clone_has_adapter and pi_version[:2] < TRANSPORT_FACTORY_VERSION:
        return Skew(
            problem=(f'clone streams through pi-ai/compat {TRANSPORT_FACTORY}, which the '
                     f'installed pi {_version_str(pi_version)} does not export, so the provider '
                     f'cannot load its transport and registers no model'),
            remedy=update_remedy)
    if host_has_transcript and not clone_has_adapter and not clone_delegates:
        return Skew(
            problem=('clone predates the pi 0.86 transcript contract, so this provider '
                     'sends no system prompt and no tool declarations — the model cannot '
                     'call a tool and may report results it never produced'),
            remedy='refresh the clone with: pi update --extensions')
    if not host_has_transcript and clone_has_adapter:
        return Skew(
            problem=('clone expects the pi 0.86 transcript contract but the installed pi '
                     'is older, so the provider imports symbols its pi-ai does not export '
                     'and every agent dies on turn 1'),
            remedy=update_remedy)
    return None


def _clone_sha(clone: Path) -> str:
    return _run(['git', 'rev-parse', '--short', 'HEAD'], cwd=str(clone)) or '?'


def _report(scope: str, clone: Path, sha: str, problem: str, remedy: str) -> None:
    print(f'{RED}✗{NC} {clone} ({scope} scope, {sha})', file=sys.stderr)
    print(f'      {problem}', file=sys.stderr)
    print(f'    {DIM}{remedy}{NC}', file=sys.stderr)


def main() -> None:
    parser = argparse.ArgumentParser(
        description='Validate pi extension package clones against the installed pi.')
    parser.add_argument('--quiet', action='store_true', help='Only show failures and summary')
    parser.add_argument('--json', action='store_true', help='Emit findings as JSON')
    args = parser.parse_args()

    pi_version = installed_pi_version()
    if pi_version is None:
        if args.json:
            print(json.dumps({'pi_version': None, 'clones_checked': 0, 'findings': []},
                             indent=2))
        elif not args.quiet:
            print(f'{DIM}pi is not installed — nothing to validate{NC}')
        return

    clones = discover_clones()
    if not clones:
        if args.json:
            print(json.dumps({'pi_version': _version_str(pi_version),
                             'clones_checked': 0, 'findings': []}, indent=2))
        elif not args.quiet:
            print(f'{DIM}no pi package clones on this machine{NC}')
        return

    findings = []
    update_remedy = host_remedy(pi_pin_source())
    for scope, clone in clones:
        skew = check_clone(clone, pi_version, update_remedy)
        sha = _clone_sha(clone)
        if skew is not None:
            findings.append({'scope': scope, 'path': str(clone), 'sha': sha,
                             'problem': skew.problem, 'remedy': skew.remedy})
        elif not args.quiet and not args.json:
            print(f'  {GREEN}✓{NC} {clone} ({scope}, {sha})')

    if args.json:
        print(json.dumps({'pi_version': _version_str(pi_version),
                          'clones_checked': len(clones), 'findings': findings}, indent=2))
        sys.exit(1 if findings else 0)

    for f in findings:
        _report(f['scope'], Path(f['path']), f['sha'], f['problem'], f['remedy'])

    version = _version_str(pi_version)
    print()
    if not findings:
        print(f'{GREEN}✓{NC} {len(clones)} pi package clones all serve pi {version}')
        return

    print(f'{RED}✗{NC} {len(findings)} of {len(clones)} pi package clones cannot serve '
          f'pi {version}', file=sys.stderr)
    print(f'  {YELLOW}Host and clone move together or not at all — one of these skews is '
          f'silent, and a run under it can report work it never did.{NC}', file=sys.stderr)
    sys.exit(1)


if __name__ == '__main__':
    main()
