#!/usr/bin/env bash
# Validate that the committed public surface snapshots match everything they are
# generated from — the registries, config.schema.json, install.components, and
# the shipped ai/claude artifacts.
#
# Freshness only — this does not decide whether a change is breaking. That is
# bin/local/check-surface-compat, which needs a base ref that validators do not have.
#
# Usage: bin/local/validate-public-surface [--quiet]
# Exit code: 0 if both snapshots are current, 1 otherwise.

set -e

_SELF="${BASH_SOURCE[0]}"
# Derived from this script's own location, not `git rev-parse --show-toplevel`.
# A pre-push hook exports GIT_DIR, and with GIT_DIR set, `git -C <subdir>
# rev-parse --show-toplevel` answers <subdir> rather than the repo root — so the
# git form resolved REPO_ROOT to bin/local and the source below failed. The bare
# `git rev-parse` form survives that but reads the caller's cwd, which the
# sibling scripts here cannot assume. Path arithmetic answers both.
REPO_ROOT="$(cd "$(dirname "$_SELF")/../.." && pwd)"
# shellcheck source=../../lib/ui.sh
. "$REPO_ROOT/lib/ui.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") [--quiet]

Check that the committed public surface snapshots match their sources.

Options:
  --quiet     Suppress output on success
  -h, --help  Show this help
EOF
}

QUIET=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quiet) QUIET=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) err "Unknown argument: $1"; usage; exit 1 ;;
  esac
done

if ! "$REPO_ROOT/bin/local/generate-public-surface" --check --quiet; then
  # The generator has already printed the specific reason above — a stale
  # snapshot names itself, and anything else (a broken yq, a category that
  # collected nothing) prints its own error. This message must not name
  # staleness: --check exits 1 for a stale snapshot and errexit also surfaces
  # a failing yq as 1, so asserting a cause here would put a guess underneath
  # a fact for whoever reads the last line first.
  err "Public surface snapshot check failed"
  echo "  If a snapshot is stale, run: bin/local/generate-public-surface" >&2
  exit 1
fi

# The count comes from the array in lib/constants.sh rather than a literal, so
# adding a package cannot leave this message reporting a stale number.
$QUIET || success "public surface snapshots current (${#PUBLIC_SURFACE_RELPATHS[@]} checks)"
