#!/usr/bin/env bash
# Validate that the committed public surface snapshots match the source registries.
#
# Freshness only — this does not decide whether a change is breaking. That is
# bin/local/check-surface-compat, which needs a base ref that validators do not have.
#
# Usage: bin/local/validate-public-surface [--quiet]
# Exit code: 0 if both snapshots are current, 1 otherwise.

set -e

_SELF="${BASH_SOURCE[0]}"
REPO_ROOT="$(git -C "$(dirname "$_SELF")" rev-parse --show-toplevel)"
# shellcheck source=../../lib/ui.sh
. "$REPO_ROOT/lib/ui.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") [--quiet]

Check that the committed public surface snapshots match the source registries.

Options:
  --quiet     Suppress output on success
  -h, --help  Show this help
EOF
}

QUIET=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quiet) QUIET=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) err "Unknown argument: $1"; usage; exit 1 ;;
  esac
done

if ! "$REPO_ROOT/bin/local/generate-public-surface" --check --quiet; then
  err "Public surface snapshots are stale"
  echo "  Run: bin/local/generate-public-surface" >&2
  exit 1
fi

# The count comes from the array in lib/constants.sh rather than a literal, so
# adding a package cannot leave this message reporting a stale number.
$QUIET || success "public surface snapshots current (${#PUBLIC_SURFACE_RELPATHS[@]} checks)"
