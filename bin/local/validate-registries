#!/usr/bin/env bash
# Validate tool registries against schema and cross-check with their source files.
#
# Checks performed per registry:
#   - Required fields present: name, description, permission, visibility
#     (when_to_use + usage required when visibility: full; forbidden otherwise)
#   - No unknown fields in tools[] or env[] entries (see KNOWN_TOOL_FIELDS and
#     KNOWN_ENV_FIELDS in lib/registries.sh)
#   - No duplicate tool names
#   - Any env[] `role` names a known model role, and exactly one entry across
#     every registry claims model-default
#   - Cross-file check based on meta.validation:
#       brewfile      — every tool name (or brew_name override) exists in meta.source Brewfile
#       bindir        — every tool name exists as a file in meta.source directory
#                       + every executable in meta.source is registered (reverse check)
#       zsh-comments  — every tool name has a matching header comment under meta.source
#       none          — schema-only, no cross-check
#
# Registry discovery:
#   Top-level:       <repo>/*/registry.yml
#   Nested:          <repo>/*/*/registry.yml  (e.g. ai/claude/registry.yml)
#   Optional stacks: <repo>/brew/{lang,infra,tools}/*.registry.yml
#
# Usage: bin/local/validate-registries
# Exit code: 0 if all checks pass, 1 if any fail.

REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel)}"
WORKBENCH_DIR="${WORKBENCH_DIR:-$REPO_ROOT}"

# shellcheck source=/dev/null
. "$REPO_ROOT/lib/ui.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/lib/registries.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") [--quiet]

Validate tool registries against schema and cross-check with their source files.

Options:
  --quiet     Suppress per-registry output; show only the final summary
  -h, --help  Show this help
EOF
}

# _fail MSG — records an error and prints it; does not exit immediately so all
# errors in a registry are reported before aborting.
_fail() {
  echo -e "  ${RED}✗${NC} $*" >&2
  ERRORS=$(( ERRORS + 1 ))
}

# _tool_label FILE INDEX — how an entry is named in an error message.
#
# The entry's own name, or `[INDEX]` for one that has none: an unnamed entry
# still has to be findable in the file by whoever reads the failure. This is the
# `// "[$i]"` fallback the yq reads spelled, kept in one place now that the
# accessor answers empty rather than taking a default.
_tool_label() {
  local name
  name=$(reg_get "$1" tools "$2" name)
  printf '%s' "${name:-[$2]}"
}

# _env_label FILE INDEX — how an env entry is named in an error message.
#
# The entry's own var, or `[INDEX]` for one that has none — the same shape
# _tool_label gives a tool, and the `// "[$i]"` fallback the yq read spelled.
_env_label() {
  local var
  var=$(reg_get "$1" env "$2" var)
  printf '%s' "${var:-[$2]}"
}

# _check_list_shape FILE FIELD — fails when FIELD is present but not a list.
#
# The natural first way to write a collection is a mapping of name to fields.
# Every check that reads one iterates it by index, so a mapping yields no
# entries and the file passes with nothing examined. It also has to be caught
# before those checks run rather than by them: `reg_len` refuses a non-sequence,
# and a bare `count=$(reg_len ...)` under errexit would abort the whole run with
# no output instead of reporting this file.
#
# A field with no value at all is a declared-empty collection, not a malformed
# one, and passes.
_check_list_shape() {
  local file="$1" field="$2"
  reg_has "$file" "$field" || return 0
  local tag
  tag=$(reg_type "$file" "$field")
  [[ "$tag" == "!!seq" || "$tag" == "!!null" ]] && return 0
  _fail "$(basename "$file"): $field must be a list of entries (got $tag) — each entry starts with '- '"
  return 1
}

# _tool_names FILE — every tool name in FILE, one per line.
_tool_names() {
  local count i
  count=$(reg_len "$1" tools)
  for (( i=0; i<count; i++ )); do
    printf '%s\n' "$(reg_get "$1" tools "$i" name)"
  done
}

# _command_names FILE TOOL_INDEX COUNT — a tool's command names, one per line.
_command_names() {
  local j
  for (( j=0; j<$3; j++ )); do
    printf '%s\n' "$(reg_get "$1" tools "$2" commands "$j" name)"
  done
}

# _check_required_fields FILE INDEX
_check_required_fields() {
  local file="$1" i="$2"
  local name description visibility
  name=$(reg_get "$file" tools "$i" name)
  description=$(reg_get "$file" tools "$i" description)
  visibility=$(reg_get "$file" tools "$i" visibility)

  [[ -n "$name" && "$name" != "null" ]]               || _fail "$(basename "$file") [$i]: missing required field: name"
  [[ -n "$description" && "$description" != "null" ]]  || _fail "$(basename "$file") entry '$name': missing required field: description"
  if [[ -z "$visibility" || "$visibility" == "null" ]]; then
    _fail "$(basename "$file") entry '$name': missing required field: visibility (use full, brief, or hidden)"
  elif [[ "$visibility" != "full" && "$visibility" != "brief" && "$visibility" != "hidden" ]]; then
    _fail "$(basename "$file") entry '$name': invalid visibility value '$visibility' (must be full|brief|hidden)"
  fi

  local when_to_use usage
  when_to_use=$(reg_get "$file" tools "$i" when_to_use)
  usage=$(reg_get "$file" tools "$i" usage)
  local has_wtu has_usage
  has_wtu=$(reg_has "$file" tools "$i" when_to_use && echo true || echo false)
  has_usage=$(reg_has "$file" tools "$i" usage && echo true || echo false)

  if [[ "$visibility" == "full" ]]; then
    [[ -n "$when_to_use" && "$when_to_use" != "null" ]] || _fail "$(basename "$file") entry '$name': missing required field: when_to_use (required when visibility: full)"
    [[ -n "$usage" && "$usage" != "null" ]]             || _fail "$(basename "$file") entry '$name': missing required field: usage (required when visibility: full)"
  else
    [[ "$has_wtu" != "true" ]]   || _fail "$(basename "$file") entry '$name': field 'when_to_use' is not allowed when visibility: $visibility"
    [[ "$has_usage" != "true" ]] || _fail "$(basename "$file") entry '$name': field 'usage' is not allowed when visibility: $visibility"
  fi
}

# _check_no_duplicates FILE
_check_no_duplicates() {
  local file="$1"
  local dupes
  dupes=$(_tool_names "$file" | sort | uniq -d)
  if [[ -n "$dupes" ]]; then
    while IFS= read -r name; do
      _fail "$(basename "$file"): duplicate tool name: $name"
    done <<< "$dupes"
  fi
}

# _check_permission_seq FILE INDEX NAME
_check_permission_seq() {
  local file="$1" i="$2" name="$3"
  local j arr_len entry
  arr_len=$(reg_len "$file" tools "$i" permission)
  [[ "$arr_len" -gt 0 ]] || _fail "$(basename "$file") entry '$name': permission array must not be empty"
  for (( j=0; j<arr_len; j++ )); do
    entry=$(reg_get "$file" tools "$i" permission "$j")
    [[ "$entry" =~ ^Bash\(.+\)$ ]] || _fail "$(basename "$file") entry '$name': permission array entry '$entry' must match Bash(...) pattern"
  done
}

# _check_unknown_keys FILE LABEL ALLOWED PATH_SEGMENT...
# Rejects any key at PATH that ALLOWED — a space-separated field list — does
# not name. LABEL prefixes the failure so the reader is told which entry of
# which array is at fault. The path is trailing segments rather than a leading
# argument because it is variadic: reg_keys addresses a node by its path parts.
_check_unknown_keys() {
  local file="$1" label="$2" allowed="$3"
  shift 3
  local key
  while IFS= read -r key; do
    local known=false field
    for field in $allowed; do
      if [[ "$key" == "$field" ]]; then known=true; break; fi
    done
    if ! $known; then
      _fail "$(basename "$file") $label: unknown field '$key'"
    fi
  done < <(reg_keys "$file" "$@")
}

# _check_unknown_fields FILE INDEX
_check_unknown_fields() {
  local file="$1" i="$2"
  local name
  name=$(_tool_label "$file" "$i")
  _check_unknown_keys "$file" "entry '$name'" "$KNOWN_TOOL_FIELDS" tools "$i"
}

# _check_permission_field FILE INDEX
_check_permission_field() {
  local file="$1" i="$2"
  if ! reg_has "$file" tools "$i" permission; then
    local name
    name=$(_tool_label "$file" "$i")
    _fail "$(basename "$file") entry '$name': missing required field: permission (use false for internal tools)"
    return 0
  fi

  local name perm_tag
  name=$(reg_get "$file" tools "$i" name)
  perm_tag=$(reg_type "$file" tools "$i" permission)

  case "$perm_tag" in
    '!!bool') ;;
    '!!str')
      local perm_str
      perm_str=$(reg_get "$file" tools "$i" permission)
      [[ -n "$perm_str" ]] || _fail "$(basename "$file") entry '$name': permission string must be non-empty"
      ;;
    '!!seq')
      _check_permission_seq "$file" "$i" "$name"
      ;;
    *)
      _fail "$(basename "$file") entry '$name': permission must be boolean, string, or array of strings (got $perm_tag)"
      ;;
  esac
}


# _check_known_command_field KEY FILE TOOL_NAME CMD_NAME
_check_known_command_field() {
  local key="$1" file="$2" name="$3" cmd_name="$4"
  local field
  for field in $KNOWN_COMMAND_FIELDS; do
    if [[ "$key" == "$field" ]]; then return 0; fi
  done
  _fail "$(basename "$file") entry '$name' command '$cmd_name': unknown field '$key'"
}

# _check_single_command FILE TOOL_INDEX CMD_INDEX TOOL_NAME
_check_single_command() {
  local file="$1" i="$2" j="$3" name="$4"
  local cmd_name cmd_desc
  cmd_name=$(reg_get "$file" tools "$i" commands "$j" name)
  cmd_desc=$(reg_get "$file" tools "$i" commands "$j" description)

  [[ -n "$cmd_name" && "$cmd_name" != "null" ]] || _fail "$(basename "$file") entry '$name' commands[$j]: missing required field: name"
  [[ -n "$cmd_desc" && "$cmd_desc" != "null" ]] || _fail "$(basename "$file") entry '$name' command '$cmd_name': missing required field: description"

  local key
  while IFS= read -r key; do
    _check_known_command_field "$key" "$file" "$name" "$cmd_name"
  done < <(reg_keys "$file" tools "$i" commands "$j")
}

# _check_commands_field FILE INDEX
_check_commands_field() {
  local file="$1" i="$2"
  reg_has "$file" tools "$i" commands || return 0

  local name visibility
  name=$(_tool_label "$file" "$i")
  visibility=$(reg_get "$file" tools "$i" visibility)

  if [[ "$visibility" != "full" ]]; then
    _fail "$(basename "$file") entry '$name': field 'commands' is not allowed when visibility: $visibility"
    return 0
  fi

  local cmd_count j
  cmd_count=$(reg_len "$file" tools "$i" commands)

  for (( j=0; j<cmd_count; j++ )); do
    _check_single_command "$file" "$i" "$j" "$name"
  done

  local dupes
  dupes=$(_command_names "$file" "$i" "$cmd_count" | sort | uniq -d)
  if [[ -n "$dupes" ]]; then
    while IFS= read -r dup; do
      _fail "$(basename "$file") entry '$name': duplicate command name: $dup"
    done <<< "$dupes"
  fi
}

# _validate_schema FILE
# Runs required-field, allow-field, and duplicate checks for every entry in FILE.
_validate_schema() {
  local file="$1"
  [[ -f "$file" ]] || { warn "$(basename "$file") not found — skipping"; return; }
  local count i=0
  count=$(reg_len "$file" tools)
  while [[ "$i" -lt "$count" ]]; do
    _check_required_fields "$file" "$i"
    _check_permission_field "$file" "$i"
    _check_unknown_fields "$file" "$i"
    _check_commands_field "$file" "$i"
    i=$(( i + 1 ))
  done
  _check_no_duplicates "$file"
}

# _validate_against_brewfile REGISTRY BREWFILE
# Every tool name (or brew_name override) must appear in BREWFILE.
_validate_against_brewfile() {
  local file="$1" brewfile="$2"
  [[ -f "$brewfile" ]] || { warn "$(basename "$brewfile") not found — skipping cross-check"; return; }
  local count i=0 name brew_name check_name
  count=$(reg_len "$file" tools)
  while [[ "$i" -lt "$count" ]]; do
    name=$(reg_get "$file" tools "$i" name)
    brew_name=$(reg_get "$file" tools "$i" brew_name)
    check_name="${brew_name:-$name}"
    if ! grep -qE "^(brew|cask) [\"']?${check_name}[\"']?" "$brewfile"; then
      _fail "$(basename "$file"): '$name' not found in ${brewfile#"$REPO_ROOT/"}"
    fi
    i=$(( i + 1 ))
  done
}

# _validate_against_bindir REGISTRY DIR
# Every tool name must exist as a file in DIR.
_validate_against_bindir() {
  local file="$1" dir="$2"
  local count i=0 name
  count=$(reg_len "$file" tools)
  while [[ "$i" -lt "$count" ]]; do
    name=$(reg_get "$file" tools "$i" name)
    if [[ ! -f "$dir/$name" ]]; then
      _fail "$(basename "$file"): '$name' not found in ${dir#"$REPO_ROOT/"}/"
    fi
    i=$(( i + 1 ))
  done
}

# _validate_bindir_reverse REGISTRY DIR
# Every executable file in DIR must be registered in REGISTRY.
_validate_bindir_reverse() {
  local file="$1" dir="$2"
  local -A registered=()
  local name
  while IFS= read -r name; do
    registered[$name]=1
  done < <(_tool_names "$file")

  local item basename
  for item in "$dir"/*; do
    [[ -f "$item" ]] || continue
    [[ -x "$item" ]] || continue
    basename=$(basename "$item")
    [[ "$basename" == "registry.yml" ]] && continue
    if [[ -z "${registered[$basename]+set}" ]]; then
      _fail "$(basename "$file"): '$basename' exists in ${dir#"$REPO_ROOT/"} but is not registered"
    fi
  done
}

# _validate_against_zsh REGISTRY DIR
# Every tool name must have a matching header comment somewhere under DIR.
_validate_against_zsh() {
  local file="$1" dir="$2"
  local count i=0 name keyword
  count=$(reg_len "$file" tools)
  while [[ "$i" -lt "$count" ]]; do
    name=$(reg_get "$file" tools "$i" name)
    keyword=$(echo "$name" | cut -d' ' -f1)
    if ! grep -rqi "# ${keyword}" "$dir" 2>/dev/null; then
      _fail "$(basename "$file"): '$name' — no matching comment found in ${dir#"$REPO_ROOT/"}/ for keyword '${keyword}'"
    fi
    i=$(( i + 1 ))
  done
}

# _check_unknown_env_fields FILE INDEX
# Rejects keys in an env[] entry that KNOWN_ENV_FIELDS does not name.
#
# The tools[] equivalent has existed since the schema did; env[] went without,
# and every field added to it since inherited the gap. A misspelled `target` was
# accepted in silence and the variable simply never appeared under the name its
# consumer read — the sort of failure that surfaces as a tool behaving as though
# it were unconfigured, nowhere near the file holding the typo.
_check_unknown_env_fields() {
  local file="$1" i="$2"
  local var
  var=$(_env_label "$file" "$i")
  _check_unknown_keys "$file" "env '$var'" "$KNOWN_ENV_FIELDS" env "$i"
}

# _check_env_claude_env FILE INDEX
# Validates an env[] entry's optional `claude_env` opt-out: the value must be a
# literal true or false, and the registry must already carry
# `meta.claude_env: true`.
#
# Both rules exist because collect_claude_env_vars excludes on an exact `false`
# and includes on anything else. That direction keeps a registry doing what its
# own meta flag says when a value is malformed, but it means a typo would
# publish a variable to a world-readable settings.json rather than withhold one.
# The check is what makes the lenient read safe.
#
# The field narrows a file that has opted in; it cannot opt one in. On a
# registry without the meta flag it decides nothing, and reads as though it
# does — so it is an error rather than a no-op.
_check_env_claude_env() {
  local file="$1" i="$2"
  reg_has "$file" env "$i" claude_env || return 0

  local var value
  var=$(_env_label "$file" "$i")
  value=$(reg_get "$file" env "$i" claude_env)
  if [[ "$value" != "true" && "$value" != "false" ]]; then
    _fail "$(basename "$file") env '$var': claude_env must be true or false, got '$value'"
  fi

  local flagged
  flagged=$(reg_get "$file" meta claude_env)
  if [[ "$flagged" != "true" ]]; then
    _fail "$(basename "$file") env '$var': claude_env on an entry requires meta.claude_env: true"
  fi
}

# _check_env_role FILE INDEX
# Validates an env[] entry's optional `role`: the value must be one of the ones
# MODEL_ROLES names. A model-default entry is recorded in ALL_MODEL_DEFAULTS
# for the cross-registry check below.
#
# Checked strictly, unlike claude_env's lenient read, because the two fields
# fail in opposite directions. A malformed claude_env that included would
# publish a variable; a malformed role that included would only offer a
# non-model as a model, while a malformed role that *excluded* silently drops a
# tier from every harness — which is the failure this field exists to prevent,
# and it would show up as a model quietly missing from a menu.
_check_env_role() {
  local file="$1" i="$2"
  reg_has "$file" env "$i" role || return 0

  local var value
  var=$(_env_label "$file" "$i")
  value=$(reg_get "$file" env "$i" role)
  if [[ " $MODEL_ROLES " != *" $value "* ]]; then
    _fail "$(basename "$file") env '$var': role must be one of: $MODEL_ROLES — got '$value'"
    return 0
  fi

  if [[ "$value" == "model-default" ]]; then
    ALL_MODEL_DEFAULTS+=("$var:${file#"$REPO_ROOT/"}")
  fi
}

# _validate_env_fields FILE
# Validates the optional top-level env[] array: var is present, valid format, no
# dupes, no unknown fields, and any claude_env opt-out or role is well formed.
_validate_env_fields() {
  local file="$1"
  reg_has "$file" env || return 0

  local count i=0
  count=$(reg_len "$file" env)
  local -a seen_vars=()
  while [[ "$i" -lt "$count" ]]; do
    local var
    var=$(reg_get "$file" env "$i" var)
    if [[ -z "$var" || "$var" == "null" ]]; then
      _fail "$(basename "$file") env[$i]: missing required field: var"
      i=$(( i + 1 ))
      continue
    fi
    if [[ ! "$var" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
      _fail "$(basename "$file") env '$var': invalid var name (must match ^[A-Z][A-Z0-9_]*$)"
    fi
    local v
    for v in "${seen_vars[@]}"; do
      [[ "$v" != "$var" ]] && continue
      _fail "$(basename "$file"): duplicate env var: $var"
      break
    done
    seen_vars+=("$var")
    _check_unknown_env_fields "$file" "$i"
    _check_env_claude_env "$file" "$i"
    _check_env_role "$file" "$i"
    # Track for cross-registry duplicate check (use relative path for readability)
    ALL_ENV_VARS+=("$var:${file#"$REPO_ROOT/"}")
    i=$(( i + 1 ))
  done
}

# _validate_install_check_command FILE
# When install_check: true and install_check_command is set, validates it is non-empty.
# When tools is empty and install_check: true, requires install_check_command.
_validate_install_check_command() {
  local file="$1"
  local install_check install_check_command tools_count
  install_check=$(reg_get "$file" meta install_check)
  [[ "$install_check" == "true" ]] || return 0

  install_check_command=$(reg_get "$file" meta install_check_command)
  tools_count=$(reg_len "$file" tools)

  local install_check_symlink
  install_check_symlink=$(reg_get "$file" meta install_check_symlink)

  if [[ "$tools_count" -eq 0 ]] \
     && [[ -z "$install_check_command" || "$install_check_command" == "null" ]] \
     && [[ -z "$install_check_symlink" || "$install_check_symlink" == "null" ]]; then
    _fail "$(basename "$file"): install_check: true with empty tools[] requires install_check_command or install_check_symlink"
  fi
}

# _validate_meta_scope FILE
# If meta.scope is present, validates it contains only lowercase alphanumeric characters and hyphens.
_validate_meta_scope() {
  local file="$1"
  local scope
  scope=$(reg_get "$file" meta scope)
  [[ -z "$scope" || "$scope" == "null" ]] && return 0
  if [[ "$scope" =~ [^a-z0-9-] ]]; then
    _fail "$(basename "$file"): meta.scope '$scope' must be lowercase alphanumeric with hyphens"
  fi
}

# _validate_auth_fields FILE
# If auth block is present, env_var must be non-empty. Warns if setup_url is missing.
_validate_auth_fields() {
  local file="$1"
  local count i=0
  count=$(reg_len "$file" tools)
  while [[ "$i" -lt "$count" ]]; do
    if ! reg_has "$file" tools "$i" auth; then
      i=$(( i + 1 ))
      continue
    fi
    local name env_var setup_url
    name=$(reg_get "$file" tools "$i" name)
    env_var=$(reg_get "$file" tools "$i" auth env_var)
    setup_url=$(reg_get "$file" tools "$i" auth setup_url)
    if [[ -z "$env_var" || "$env_var" == "null" ]]; then
      _fail "$(basename "$file") entry '$name': auth block missing required field: env_var"
    else
      ALL_ENV_VARS+=("$env_var:${file#"$REPO_ROOT/"}")
    fi
    if [[ -z "$setup_url" || "$setup_url" == "null" ]]; then
      warn "$(basename "$file") entry '$name': auth block missing setup_url"
    fi
    i=$(( i + 1 ))
  done
}

# _validate_registry FILE
# Dispatches cross-validation based on meta.validation and meta.source in FILE.
_validate_registry() {
  local file="$1"
  local validation source
  validation=$(reg_get "$file" meta validation)
  # Only an absent key defaults to `none`. An explicit `validation: ""` is a
  # value someone wrote, and it names no cross-check — it falls through to the
  # `*)` arm below and is reported, which is what the `// "none"` read this
  # replaced did too: yq substitutes on null, not on an empty string.
  reg_has "$file" meta validation || validation="none"
  source=$(reg_get "$file" meta source)

  case "$validation" in
    brewfile)
      [[ -n "$source" ]] && _validate_against_brewfile "$file" "$REPO_ROOT/$source"
      ;;
    bindir)
      [[ -n "$source" ]] && _validate_against_bindir "$file" "$REPO_ROOT/$source"
      [[ -n "$source" ]] && _validate_bindir_reverse "$file" "$REPO_ROOT/$source"
      ;;
    zsh-comments)
      [[ -n "$source" ]] && _validate_against_zsh "$file" "$REPO_ROOT/$source"
      ;;
    none|install-check) ;;
    *)
      warn "$(basename "$file"): unknown validation type '$validation' — skipping cross-check"
      ;;
  esac
}

# Cross-registry duplicate check: no env var name should appear in multiple registries.
_check_cross_registry_dupes() {
  local -A var_sources=()
  local entry var source
  for entry in "${ALL_ENV_VARS[@]}"; do
    var="${entry%%:*}"
    source="${entry#*:}"
    if [[ -n "${var_sources[$var]:-}" && "${var_sources[$var]}" != "$source" ]]; then
      _fail "env var '$var' defined in multiple registries: ${var_sources[$var]} and $source"
    fi
    var_sources[$var]="$source"
  done
}

# Cross-registry model-default check: exactly one env entry may claim
# model-default, since it is what a harness resolves defaultModel from.
#
# Two would make the winner depend on registry iteration order — filesystem
# order, in effect — so the machine would get a default nobody chose and the
# two files would each look correct on their own.
_check_single_model_default() {
  (( ${#ALL_MODEL_DEFAULTS[@]} > 1 )) || return 0
  _fail "more than one env var declares role: model-default — ${ALL_MODEL_DEFAULTS[*]}"
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
  set -euo pipefail

  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; return 0; }
  QUIET=false
  [[ "${1:-}" == "--quiet" ]] && QUIET=true

  ERRORS=0
  REGISTRIES_CHECKED=0
  declare -a ALL_ENV_VARS=()   # "VAR_NAME:source_file" pairs for cross-registry dupe check
  declare -a ALL_MODEL_DEFAULTS=()  # same shape, for the single-model-default check

  if ! command -v yq >/dev/null 2>&1; then
    err "yq not found — run: brew install yq"
    return 1
  fi

  # Collect all registries: top-level + nested (e.g. ai/claude/) + optional brew stacks
  local -a all_registries=()
  collect_registries all_registries "$REPO_ROOT"

  if [[ "${#all_registries[@]}" -eq 0 ]]; then
    warn "No registry files found — skipping"
    return 0
  fi

  # One read for the whole set, before any check runs. A registry yq cannot
  # parse fails here by name instead of reaching the checks as a file that
  # reads empty and therefore passes everything.
  if ! reg_load "${all_registries[@]}"; then
    err "Could not read every registry — fix the YAML above and re-run"
    return 1
  fi

  $QUIET || echo "→ Validating registries..."

  local registry
  for registry in "${all_registries[@]}"; do
    REGISTRIES_CHECKED=$(( REGISTRIES_CHECKED + 1 ))
    if ! $QUIET; then
      echo
      info "Schema: ${registry#"$REPO_ROOT/"}"
    fi
    # A `tools:` that is not a list has no entries to walk, and every check
    # that iterates them would report the file clean rather than report the
    # shape. Those are skipped when it fails; the meta-only checks below do not
    # read `tools` and still run, so one malformed collection does not hide
    # every other problem in the same file until it is fixed.
    if _check_list_shape "$registry" tools; then
      _validate_schema "$registry"
      _validate_auth_fields "$registry"
      _validate_install_check_command "$registry"
      _validate_registry "$registry"
    fi
    if _check_list_shape "$registry" env; then
      _validate_env_fields "$registry"
    fi
    _validate_meta_scope "$registry"
  done

  if [[ "${#ALL_ENV_VARS[@]}" -gt 0 ]]; then
    _check_cross_registry_dupes
  fi
  _check_single_model_default

  echo
  if [[ "$ERRORS" -gt 0 ]]; then
    err "$ERRORS error(s) found"
    return 1
  fi

  success "All registries valid ($REGISTRIES_CHECKED files)"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
