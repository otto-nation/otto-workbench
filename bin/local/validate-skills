#!/usr/bin/env bash
# Validate SKILL.md frontmatter conventions across all workbench skills.
#
# Usage: bin/local/validate-skills [--quiet]
#
# Checks:
#   - SKILL.md has YAML frontmatter (opening and closing ---)
#   - Required fields: name, description, source, trigger
#   - name matches the skill directory name
#   - source matches otto-workbench/ai/skills/<name>/SKILL.md
#   - lifecycle_cadence and lifecycle_scope must appear together
#   - lifecycle_scope is one of: per-project, global
#   - agent (optional) resolves to an ai/claude/agents/<name>.md file
#   - invocation is required unless the skill declares an agent
#   - name and description satisfy the Agent Skills standard (64 / 1024 chars)
#   - every non-programmatic agent has a matching agent-backed skill
#
# Exit code: 0 if all checks pass (or no skills found), 1 if any fail.

set -e

_SCRIPT_ROOT="$(git rev-parse --show-toplevel)"
WORKBENCH_DIR="${WORKBENCH_DIR:-$_SCRIPT_ROOT}"
# shellcheck source=/dev/null
. "$_SCRIPT_ROOT/lib/ui.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") [--quiet]

Validate SKILL.md frontmatter conventions across all workbench skills.

Options:
  --quiet     Suppress per-check output; show only the final summary
  -h, --help  Show this help
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }
QUIET=false
[[ "${1:-}" == "--quiet" ]] && QUIET=true

ERRORS=0
CHECKS=0
FOUND=0

_pass() { CHECKS=$(( CHECKS + 1 )); $QUIET || echo -e "  ${GREEN}✓${NC} $*"; }
_fail() { CHECKS=$(( CHECKS + 1 )); ERRORS=$(( ERRORS + 1 )); err "$*"; }

# Agents invoked by task automation and by the review pipeline, never by a
# situation match. A description-triggered skill for one of these would be a
# surface no human ever wants hit, so they are exempt from needing a skill.
PROGRAMMATIC_AGENTS=(changelog ci-cd explain reviewer-lite)

# _agent_is_programmatic NAME — whether NAME is dispatched by code rather than
# matched to a situation.
_agent_is_programmatic() {
  local known
  for known in "${PROGRAMMATIC_AGENTS[@]}"; do
    if [[ "$1" == "$known" ]]; then
      return 0
    fi
  done
  return 1
}

_validate_skill_name_standard() {
  local name="$1" display="$2"
  [[ -n "$name" ]] || return 0

  if (( ${#name} > 64 )); then
    _fail "$display: name is ${#name} chars — the Agent Skills standard caps it at 64"
  elif [[ ! "$name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    _fail "$display: name '$name' must be lowercase a-z, 0-9 and single hyphens"
  else
    _pass "$display: name meets the Agent Skills standard"
  fi
}

_validate_skill_description_standard() {
  local desc="$1" display="$2"
  [[ -n "$desc" ]] || return 0

  if (( ${#desc} <= 1024 )); then
    _pass "$display: description within 1024 chars"
  else
    _fail "$display: description is ${#desc} chars — the Agent Skills standard caps it at 1024"
  fi
}

# An agent-backed skill installs to Pi with this agent's protocol spliced in.
# A name resolving to nothing installs nothing, and ai/skills/steps.sh only warns.
_validate_skill_agent() {
  local agent="$1" display="$2"
  [[ -n "$agent" ]] || return 0

  if [[ -f "$WORKBENCH_DIR/ai/claude/agents/$agent.md" ]]; then
    _pass "$display: agent '$agent' resolves"
  else
    _fail "$display: agent '$agent' has no ai/claude/agents/$agent.md"
  fi
}

_validate_output_schema() {
  local skill_file="$1" display="$2"
  local has_os tool_name tool_script schema_out
  has_os=$(awk 'NR==1 && /^---$/ { in_fm=1; next } in_fm && /^---$/ { exit } in_fm && /^output_schema:/ { print "yes"; exit }' "$skill_file")
  [[ "$has_os" == "yes" ]] || return 0

  tool_name=$(awk '
    /^output_schema:/ { in_os=1; next }
    in_os && /^[^ ]/ { exit }
    in_os && /^[[:space:]]*tool:[[:space:]]/ { sub(/.*tool:[[:space:]]*/, ""); gsub(/["\047]/, ""); print; exit }
  ' "$skill_file")

  if [[ -z "$tool_name" ]]; then
    _fail "$display: output_schema present but no tool field found"
    return
  fi

  tool_script="$WORKBENCH_DIR/ai/claude/bin/$tool_name"
  if [[ ! -x "$tool_script" ]]; then
    _fail "$display: output_schema tool '$tool_name' not found in ai/claude/bin/"
    return
  fi

  if ! schema_out=$("$tool_script" --tool-schema 2>/dev/null); then
    _fail "$display: output_schema tool '$tool_name' does not support --tool-schema"
    return
  fi

  # Exit 0 alone proves nothing — a script that ignores unknown flags also exits 0.
  # Keys mirror REQUIRED_SCHEMA_KEYS in ai/claude/mcps/server.py.
  if jq -e 'has("name") and has("input_schema")' <<< "$schema_out" > /dev/null 2>&1; then
    _pass "$display: output_schema tool '$tool_name' supports --tool-schema"
  else
    _fail "$display: output_schema tool '$tool_name' emits an invalid --tool-schema document"
  fi
}

SKILLS_DIR="$SKILLS_SRC_DIR"

for skill_dir in "$SKILLS_DIR"/*/; do
  [[ -d "$skill_dir" ]] || continue
  dir_name="$(basename "$skill_dir")"
  skill_file="$skill_dir/SKILL.md"
  display="skills/$dir_name"

  # SKILL.md must exist
  if [[ ! -f "$skill_file" ]]; then
    FOUND=$(( FOUND + 1 ))
    _fail "$display: missing SKILL.md"
    continue
  fi

  FOUND=$(( FOUND + 1 ))

  # Frontmatter presence
  first_line="$(head -1 "$skill_file")"
  if [[ "$first_line" != "---" ]]; then
    _fail "$display: missing YAML frontmatter (file must start with ---)"
    continue
  fi

  closing_line="$(awk 'NR > 1 && /^---$/ { print NR; exit }' "$skill_file")"
  if [[ -z "$closing_line" ]]; then
    _fail "$display: missing closing --- in frontmatter"
    continue
  fi

  _pass "$display: frontmatter present"

  # Required fields
  local_name="$(frontmatter_field "$skill_file" "name")"
  local_desc="$(frontmatter_field "$skill_file" "description")"
  local_source="$(frontmatter_field "$skill_file" "source")"
  local_invocation="$(frontmatter_field "$skill_file" "invocation")"
  local_trigger="$(frontmatter_field "$skill_file" "trigger")"
  local_agent="$(skill_agent "$skill_file")"

  [[ -n "$local_name" ]] \
    && _pass "$display: name field present" \
    || _fail "$display: missing required field: name"

  [[ -n "$local_desc" ]] \
    && _pass "$display: description field present" \
    || _fail "$display: missing required field: description"

  if [[ -n "$local_invocation" ]]; then
    _pass "$display: invocation field present"
  elif [[ -n "$local_agent" ]]; then
    # An agent-backed skill is loaded for a dispatched agent, never typed as a
    # slash command, so it has nothing to declare here.
    _pass "$display: invocation not required for an agent-backed skill"
  else
    _fail "$display: missing required field: invocation"
  fi

  [[ -n "$local_source" ]] \
    && _pass "$display: source field present" \
    || _fail "$display: missing required field: source"

  [[ -n "$local_trigger" ]] \
    && _pass "$display: trigger field present" \
    || _fail "$display: missing required field: trigger"

  # name must match directory
  if [[ -n "$local_name" ]]; then
    [[ "$local_name" == "$dir_name" ]] \
      && _pass "$display: name matches directory" \
      || _fail "$display: name '$local_name' does not match directory '$dir_name'"
  fi

  # Agent Skills standard limits. Pi warns and loads the skill anyway, so a
  # violation is invisible until a name collides or a description is truncated.
  _validate_skill_name_standard "$local_name" "$display"
  _validate_skill_description_standard "$local_desc" "$display"

  # source must match expected path
  if [[ -n "$local_source" ]]; then
    expected_source="otto-workbench/ai/skills/$dir_name/SKILL.md"
    [[ "$local_source" == "$expected_source" ]] \
      && _pass "$display: source path valid" \
      || _fail "$display: source '$local_source' does not match expected '$expected_source'"
  fi

  _validate_skill_agent "$local_agent" "$display"

  # Lifecycle fields must appear together
  local_cadence="$(frontmatter_field "$skill_file" "lifecycle_cadence")"
  local_scope="$(frontmatter_field "$skill_file" "lifecycle_scope")"

  if [[ -n "$local_cadence" && -z "$local_scope" ]]; then
    _fail "$display: lifecycle_cadence present but lifecycle_scope missing"
  elif [[ -z "$local_cadence" && -n "$local_scope" ]]; then
    _fail "$display: lifecycle_scope present but lifecycle_cadence missing"
  elif [[ -n "$local_cadence" && -n "$local_scope" ]]; then
    _pass "$display: lifecycle fields paired"
  fi

  # Validate scope value (only when both lifecycle fields are present)
  if [[ -n "$local_cadence" && -n "$local_scope" ]]; then
    [[ "$local_scope" == "per-project" || "$local_scope" == "global" ]] \
      && _pass "$display: lifecycle_scope valid" \
      || _fail "$display: lifecycle_scope '$local_scope' must be 'per-project' or 'global'"
  fi

  _validate_output_schema "$skill_file" "$display"
done

# Every situation-matched agent must have a skill, or Pi never learns the
# protocol. Claude reads the agent file either way, which is exactly why the gap
# is invisible without this check — debugger, incident and migrate each had an
# agent file and no skill for a whole phase and nothing said so.
AGENTS_DIR="$WORKBENCH_DIR/ai/claude/agents"
for agent_file in "$AGENTS_DIR"/*.md; do
  [[ -f "$agent_file" ]] || continue
  agent_name="$(basename "$agent_file" .md)"
  if _agent_is_programmatic "$agent_name"; then
    continue
  fi
  if [[ -f "$WORKBENCH_DIR/ai/skills/$agent_name/SKILL.md" ]]; then
    _pass "agents/$agent_name: reaches Pi as a skill"
  else
    _fail "agents/$agent_name: has no ai/skills/$agent_name/SKILL.md, so its protocol never reaches Pi — add an agent-backed skill stub or list it in PROGRAMMATIC_AGENTS"
  fi
done

# Summary
echo
if (( FOUND == 0 )); then
  echo -e "  ${DIM}no skill directories found${NC}"
fi

# FOUND == 0 no longer implies a clean run: the agent-coverage loop above can
# fail with no skill directories present at all — an agent with no ai/skills/
# tree whatsoever is a finding, not an empty run.
if (( ERRORS > 0 )); then
  err "$ERRORS of $CHECKS checks failed"
  exit 1
elif (( FOUND == 0 )); then
  exit 0
else
  success "$CHECKS checks passed ($FOUND skills)"
  exit 0
fi
