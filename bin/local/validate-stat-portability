#!/usr/bin/env python3
"""Validate that scripts do not call stat with a platform-specific format flag.

Usage: bin/local/validate-stat-portability [--quiet] [file...]

GNU coreutils and BSD stat spell the same fields with different flags, and GNU
reads -f as --file-system: `stat -f %m FILE` treats %m as a filename, exits
non-zero, and still prints a filesystem report for FILE to stdout.  A
hand-rolled `$(gnu_form || bsd_form)` fallback therefore concatenates the two
outputs — that shipped a `chmod: invalid mode` CI failure once already.

lib/portable.sh owns the one correct implementation:

    file_mtime PATH    modification time, epoch seconds
    file_birth PATH    birth time, epoch seconds
    file_mode  PATH    permission bits, octal

Only lib/portable.sh may call stat directly.

When no files are given, discovers all bash scripts and .bats files in the repo.

Exit code: 0 if all files pass, 1 if any have violations.
"""

import argparse
import os
import re
import sys

_WORKBENCH_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.path.insert(0, os.path.join(_WORKBENCH_DIR, 'lib'))
from ansi import RED, GREEN, DIM, NC  # noqa: E402

# The helpers themselves must call stat — nothing else may.
ALLOWED_PATHS = frozenset({'lib/portable.sh'})

# -c/--format/--printf are GNU-only; -f is BSD's format flag and GNU's
# --file-system. Any of them makes the call specific to one platform.
#
# The lookbehind keeps the command name from matching the tail of a longer
# word or flag — `git diff --stat -c` is not a stat call, `/usr/bin/stat` is.
STAT_FORMAT_FLAG = re.compile(r'(?<![-\w])stat\s+(?:-[A-Za-z]+\s+)*(-[cf]\b|--format\b|--printf\b)')

COMMENT = re.compile(r'(^|\s)#.*')


def strip_comments(line: str) -> str:
    return COMMENT.sub(r'\1', line)


def join_continuations(lines: list[str]) -> list[tuple[int, str]]:
    """Join backslash-continued lines, returning (original_lineno, joined_line) pairs.

    `stat \\` / `  -c %Y "$f"` is the same violation wearing a line break.
    """
    result = []
    buf = ''
    start_lineno = 1

    for lineno, line in enumerate(lines, 1):
        stripped = line.rstrip('\n')
        if buf:
            buf += ' ' + stripped.lstrip()
        else:
            buf = stripped
            start_lineno = lineno

        if not stripped.endswith('\\'):
            result.append((start_lineno, buf))
            buf = ''
        else:
            buf = buf[:-1].rstrip()

    if buf:
        result.append((start_lineno, buf))

    return result


def check_file(filepath: str) -> list[tuple[int, str]]:
    """Return list of (line_number, line_content) violations."""
    with open(filepath, errors='replace') as f:
        lines = f.readlines()

    violations = []
    for lineno, joined in join_continuations(lines):
        if STAT_FORMAT_FLAG.search(strip_comments(joined)):
            violations.append((lineno, joined.strip()))

    return violations


# ── Discovery ───────────────────────────────────────────────────────────────

def _read_shebang(path: str) -> bytes | None:
    try:
        with open(path, 'rb') as f:
            return f.readline()
    except OSError:
        return None


def _has_bash_shebang(path: str, shebang_re: re.Pattern) -> bool:
    shebang = _read_shebang(path)
    return shebang is not None and shebang_re.search(shebang) is not None


def _discover_by_extension(repo_root: str, shebang_re: re.Pattern) -> set[str]:
    """Find .sh/.bash scripts with a bash shebang, plus every .bats suite.

    .bats files carry a bats shebang rather than a bash one, but they are bash
    at heart and two of the original stat call sites lived in them.
    """
    scripts: set[str] = set()

    for dirpath, dirnames, filenames in os.walk(repo_root):
        dirnames[:] = [d for d in dirnames if d not in ('.git', 'node_modules')]
        scripts.update(os.path.join(dirpath, f) for f in filenames if f.endswith('.bats'))
        paths = [os.path.join(dirpath, f) for f in filenames if f.endswith(('.sh', '.bash'))]
        scripts.update(p for p in paths if _has_bash_shebang(p, shebang_re))

    return scripts


def _extensionless_paths(search_dir: str) -> list[str]:
    """Collect extensionless file paths in search_dir (max depth 2)."""
    paths = []
    for dirpath, _, filenames in os.walk(search_dir):
        rel = os.path.relpath(dirpath, search_dir)
        if rel != '.' and rel.count(os.sep) >= 2:
            continue
        paths.extend(os.path.join(dirpath, f) for f in filenames if '.' not in f)
    return paths


def _discover_extensionless(repo_root: str, shebang_re: re.Pattern) -> set[str]:
    """Find extensionless bash scripts in known directories by shebang."""
    scripts: set[str] = set()

    for subdir in ('bin', 'ai/bin', 'ai/claude/bin', 'git/hooks', 'git/bin'):
        search_dir = os.path.join(repo_root, subdir)
        if not os.path.isdir(search_dir):
            continue
        paths = _extensionless_paths(search_dir)
        scripts.update(p for p in paths if _has_bash_shebang(p, shebang_re))

    return scripts


def discover_scripts(repo_root: str) -> list[str]:
    """Find all bash scripts and bats suites in the repo."""
    shebang_re = re.compile(rb'^#!.*(/(ba)?sh|/env (ba)?sh)')
    scripts = _discover_by_extension(repo_root, shebang_re) | _discover_extensionless(repo_root, shebang_re)
    return sorted(scripts)


# ── Reporting ───────────────────────────────────────────────────────────────

def _report_violations(relpath: str, violations: list[tuple[int, str]]) -> None:
    print(f'{RED}✗{NC} {relpath}: platform-specific stat format flag', file=sys.stderr)
    for lineno, line in violations:
        print(f'      line {lineno}: {line}', file=sys.stderr)
    print(f'    {DIM}use file_mtime / file_birth / file_mode from lib/portable.sh{NC}', file=sys.stderr)


def _print_summary(files_checked: int, errors: int) -> None:
    print()
    if errors == 0:
        print(f'{GREEN}✓{NC} {files_checked} files checked, no direct stat format flags')
    else:
        print(f'{RED}✗{NC} {errors} of {files_checked} files call stat with a platform-specific flag',
              file=sys.stderr)


# ── CLI ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description='Validate that scripts use the lib/portable.sh stat helpers.')
    parser.add_argument('--quiet', action='store_true', help='Only show failures and summary')
    parser.add_argument('files', nargs='*', help='Files to check (auto-discovers if omitted)')
    args = parser.parse_args()

    repo_root = _WORKBENCH_DIR

    files = args.files if args.files else discover_scripts(repo_root)

    errors = 0
    checked = 0

    for filepath in files:
        relpath = os.path.relpath(filepath, repo_root)
        if relpath in ALLOWED_PATHS:
            continue

        checked += 1
        violations = check_file(filepath)

        if violations:
            errors += 1
            _report_violations(relpath, violations)
        elif not args.quiet:
            print(f'  {GREEN}✓{NC} {relpath}')

    _print_summary(checked, errors)
    if errors:
        sys.exit(1)


if __name__ == '__main__':
    main()
