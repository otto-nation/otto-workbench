#!/usr/bin/env python3
"""Check the test suites under tests/ for name and size.

Usage: bin/local/validate-test-layout [--quiet] [--max-lines N] [DIR]

Two rules — the first over every `.py` file under `tests/`, the second over
every `.py` and `.bats` file there:

1. **A test module is named `<subject>_test.py`.** pytest collects
   `test_*.py` as well by default, so a prefix-named module still runs. That
   is what let the two conventions coexist for as long as they did, split
   126 to 82 with nothing saying which was right. A module that is not a
   suite is a support module, and says so in its name: `conftest.py`,
   `__init__.py`, or `<subject>_support.py`. Nothing else is allowed — in
   particular a `test_*.py`, which would be collected under the convention
   this gate retired.

2. **A module stays within the code-line cap** the source gate enforces
   (`MAX_CODE_LINES` in `lib/file_size.py`), counted the same way: blank
   lines, comments and docstrings do not count. A suite is a flat list of
   cases, so the argument for splitting it is navigability rather than
   coupling — but a 3,000-line suite is one nobody reads end to end, and
   the seam to split along is the one its subject already has.

A bats suite is counted as shell. Bats' own syntax reads as ordinary
commands to the counter — `@test "name" {` is one code line, its name a
closed quoted span — so the shell counter measures a suite the way it
measures a script. Naming stays Python-only: nothing collects a misnamed
`.bats` under a retired convention, which is the hazard rule 1 exists for.

Exit code: 0 if every name is allowed and every suite is within the cap, 1
otherwise. There are no exemptions: the suites over the line when this gate
landed were split before it became unconditional. `--quiet` suppresses the
success banner; a failure is always reported.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

_WORKBENCH_DIR = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(_WORKBENCH_DIR / "lib"))
from ansi import DIM, GREEN, NC, RED  # noqa: E402
from file_size import MAX_CODE_LINES, code_lines  # noqa: E402

TESTS_DIR = "tests"

SKIP_DIRS = {"__pycache__"}

SUITE_SUFFIX = "_test.py"
SUPPORT_SUFFIX = "_support.py"
SUPPORT_NAMES = frozenset({"conftest.py", "__init__.py"})

BATS_SUFFIX = ".bats"



def discover(root: Path, suffix: str = ".py") -> list[Path]:
    """Every file ending in *suffix* under *root*/tests, sorted.

    Recursive: `tests/test_nesting/` is a package of suites, and a flat listing
    would exempt it.
    """
    base = root / TESTS_DIR
    found: list[Path] = []
    for dirpath, dirnames, filenames in os.walk(base):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
        candidates = (Path(dirpath) / name for name in filenames if name.endswith(suffix))
        found.extend(path for path in candidates if not path.is_symlink())
    return sorted(found)


def discover_all(root: Path) -> list[Path]:
    """Every suite module under *root*/tests, Python and bats both."""
    return discover(root) + discover(root, BATS_SUFFIX)


def name_allowed(name: str) -> bool:
    """True if *name* is a suite or a declared support module."""
    if name in SUPPORT_NAMES:
        return True
    return name.endswith(SUITE_SUFFIX) or name.endswith(SUPPORT_SUFFIX)


def misnamed(root: Path, paths: list[Path] | None = None) -> list[str]:
    """Relative paths of every module whose name is neither suite nor support.

    *paths* lets a caller that already walked `tests/` (such as `main()`) reuse
    that listing instead of paying for a second `os.walk`.
    """
    return [str(p.relative_to(root)) for p in (paths if paths is not None else discover(root))
            if not name_allowed(p.name)]


def over_cap(root: Path, max_lines: int, paths: list[Path] | None = None) -> list[tuple[str, int]]:
    """(relative path, code lines) for every module over *max_lines*, worst first.

    Counts `.bats` as shell and everything else as Python. *paths* lets a
    caller that already walked `tests/` (such as `main()`) reuse that listing;
    by default both suffixes are walked.
    """
    if paths is None:
        paths = discover_all(root)
    violations = []
    for path in paths:
        language = "shell" if path.suffix == BATS_SUFFIX else "python"
        try:
            count = code_lines(path, language)
        except OSError as err:
            # Name the file rather than surfacing a traceback from the counter;
            # the first unreadable file is a broken checkout, not a finding.
            raise SystemExit(
                f"{RED}✗{NC} cannot read {path.relative_to(root)}: {err.strerror}",
            ) from err
        if count > max_lines:
            violations.append((str(path.relative_to(root)), count))
    return sorted(violations, key=lambda row: (-row[1], row[0]))


def _report_names(bad: list[str]) -> None:
    print(f"{RED}✗{NC} {len(bad)} test module(s) misnamed", file=sys.stderr)
    for relpath in bad:
        print(f"      {relpath}", file=sys.stderr)
    print(f"    {DIM}a suite is <subject>{SUITE_SUFFIX}; a module that is not one is",
          file=sys.stderr)
    print(f"    conftest.py, __init__.py, or <subject>{SUPPORT_SUFFIX}{NC}",
          file=sys.stderr)


def _report_size(over: list[tuple[str, int]], max_lines: int) -> None:
    print(f"{RED}✗{NC} {len(over)} test module(s) over {max_lines} code lines",
          file=sys.stderr)
    for relpath, count in over:
        print(f"      {relpath}: {count}", file=sys.stderr)
    print(f"    {DIM}split along the modules the suite covers, not at the line{NC}",
          file=sys.stderr)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Check the test suites under tests/ for name and size.",
    )
    parser.add_argument("--quiet", action="store_true", help="Only show failures")
    parser.add_argument("--max-lines", type=int, default=MAX_CODE_LINES,
                        help=f"Cap on code lines (default: {MAX_CODE_LINES})")
    parser.add_argument("directory", nargs="?", default=str(_WORKBENCH_DIR),
                        help="Repo root to scan (default: this repo)")
    args = parser.parse_args(argv)

    root = Path(args.directory).resolve()
    paths = discover(root)
    bad = misnamed(root, paths)
    violations = over_cap(root, args.max_lines, paths + discover(root, BATS_SUFFIX))
    over = violations

    if bad:
        _report_names(bad)
    if over:
        _report_size(over, args.max_lines)
    if bad or over:
        return 1
    if args.quiet:
        return 0
    print(f"{GREEN}✓{NC} every test module is named and within {args.max_lines} code lines")
    return 0


if __name__ == "__main__":
    sys.exit(main())
