#!/usr/bin/env python3
"""Validate that every subprocess bound under ai/ comes from the timeouts table.

Usage: bin/local/validate-timeouts [--quiet] [file...]

`ai/lib/core/timeouts.py` owns how long a subprocess is allowed to take.  A literal
written at the call site is a decision nobody can audit: 5 here and 30 there
says nothing about which operations are alike, and the two drift apart the
first time one of them is found to be too tight.  The tiers name the reason
instead — flat-cost local read, one network round trip, a transfer whose length
is the data's — so a bound is chosen once and every site that shares a reason
shares a number.

Two shapes are rejected on any argument named `timeout`, whether it is passed
at a call or defaulted in a signature:

  timeout=30     a number nobody can trace to a reason  -> timeouts.NETWORK
  timeout=None   silence, not a decision                -> timeouts.UNBOUNDED

Anything else passes.  A name (`timeout=timeout`, `timeout=opts.timeout`) is a
bound being forwarded, and the site it came from is checked on its own.

A third shape is rejected at the call sites that launch a subprocess —
`proc.run`, `subprocess.run`, `subprocess.call`, `subprocess.check_call`,
`subprocess.check_output`:

  proc.run(cmd)  no bound written down at all            -> a tier

A fourth shape is rejected on a name bound, in the same function, from a
call whose callee ends in `Popen` or is one of `core.children`'s launchers
(`spawn`, `owned`) — or `with ... Popen(...) as name`, likewise:

  proc.wait()         a reap with no bound written down  -> a tier
  proc.communicate()  same                               -> a tier

`Popen` itself takes no bound, so the launch is still unchecked; the wait
that follows is where the duration is decided, and omitting `timeout=` there
is the same silence as omitting it on `subprocess.run`.  `Event.wait` and any
other receiver not assigned from `Popen` in that function are ignored.  A bound
may be the keyword or its positional slot — `proc.wait(budget)`, or the second
argument of `proc.communicate(input, budget)` — and a literal in that slot is
flagged the same as `timeout=30`.

Reading only the bounds that were written down leaves the omission invisible,
which is the case the table exists to eliminate: a call with no `timeout=` is
indistinguishable from nobody having thought about one.  A `**kwargs` splat
counts as a bound, because this check cannot see what is in it.

Known limits: only the argument spelled `timeout` is checked, so a wrapper that
renames it — `def fetch(*, budget)` handing `budget` to `subprocess.run` — hides
its literal from this check.  And a runner is recognised by its written name, so
`from subprocess import run` escapes the omission check.  The convention is to
keep both names; a call site that does is fully covered.

The Popen-reap check sees only a plain name bound from `Popen` in the same
function.  It reads statements in source order, with no branch analysis: a
plain rebinding of the name to anything else (`p = threading.Event()`) drops it,
but a rebinding on one branch of an `if` drops it for the code after the other
branch too.  Scopes are the function bodies only: nested functions are skipped,
while lambda and class bodies written inside a function are read as part of it.  It does not see `self.proc = Popen(...)` followed by
`self.proc.wait()`, a module-level `p = Popen(...); p.wait()`, or a closure
that waits on its enclosing function's Popen.  A clean run is not coverage of
those.

Exit code: 0 if all files pass, 1 if any have violations.
"""

import argparse
import ast
import os
import sys
from dataclasses import dataclass

_WORKBENCH_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.path.insert(0, os.path.join(_WORKBENCH_DIR, 'lib'))
from ansi import RED, GREEN, DIM, NC  # noqa: E402

KEYWORD = 'timeout'
TABLE = 'timeouts'
UNBOUNDED = f'{TABLE}.UNBOUNDED'
A_TIER = f'a tier from `{TABLE}`'

# The runners that launch a subprocess and accept `timeout=`.  `Popen` is absent
# on purpose: it takes no bound.  The one its `wait` / `communicate` take is
# checked separately, on the name bound from the launch.
RUNNERS = {
    ('proc', 'run'),
    ('subprocess', 'run'),
    ('subprocess', 'call'),
    ('subprocess', 'check_call'),
    ('subprocess', 'check_output'),
}

# Where `timeout` sits positionally on a Popen reap.
REAP_TIMEOUT_SLOT = {'wait': 0, 'communicate': 1}

SEARCH_DIRS = ('ai',)
SKIP_DIRS = {'.git', '__pycache__', '.venv', 'node_modules'}

SCOPE_NODES = (ast.FunctionDef, ast.AsyncFunctionDef)


@dataclass(frozen=True)
class Violation:
    """One bound that cannot be traced to the table, and what to write instead.

    `found` is what is at the call site — `timeout=30`, or the runner that was
    called with no bound at all.  One field rather than two, because a literal
    and an omission are the same finding reported differently.
    """

    line: int
    found: str
    suggestion: str


# ── AST analysis ─────────────────────────────────────────────────────────────


def _literal(node) -> str | None:
    """The offending constant in *node*, or None if the value is acceptable.

    Walks the whole subtree so an expression built around a number —
    `timeouts.LOCAL * 3`, `30 if slow else 10` — is caught too: the point is
    that the number is written here rather than in the table.
    """
    numbers = [n for n in ast.walk(node)
               if isinstance(n, ast.Constant) and isinstance(n.value, (int, float))
               and not isinstance(n.value, bool)]
    if numbers:
        return repr(numbers[0].value)
    if isinstance(node, ast.Constant) and node.value is None:
        return 'None'
    return None


def _suggestion(literal: str) -> str:
    return UNBOUNDED if literal == 'None' else A_TIER


def _call_kwargs(tree):
    """Every `timeout=` argument passed at a call site."""
    return [kw.value for node in ast.walk(tree) if isinstance(node, ast.Call)
            for kw in node.keywords if kw.arg == KEYWORD]


def _runner(node) -> str | None:
    """The name a call spells, if it is one of the subprocess runners."""
    func = node.func
    if not isinstance(func, ast.Attribute) or not isinstance(func.value, ast.Name):
        return None
    if (func.value.id, func.attr) not in RUNNERS:
        return None
    return f'{func.value.id}.{func.attr}'


def _unbounded_launches(tree):
    """Every subprocess launch that names no bound at all.

    A `**kwargs` splat (`kw.arg is None`) is taken as a bound: the argument may
    well be in it, and reading a dict this check cannot see is not something an
    AST walk can do.
    """
    found = []
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        name = _runner(node)
        if name is None:
            continue
        if any(kw.arg in (KEYWORD, None) for kw in node.keywords):
            continue
        found.append(Violation(line=node.lineno,
                               found=f'{name}(...) with no {KEYWORD}=',
                               suggestion=A_TIER))
    return found


def _param_defaults(tree):
    """Every default on a parameter named `timeout`.

    A default is a bound too, and the one most likely to go unread — every
    caller that omits the argument inherits it.
    """
    found = []
    for node in ast.walk(tree):
        if not isinstance(node, SCOPE_NODES):
            continue
        a = node.args
        # Defaults bind to the tail of their parameter list; keyword-only
        # defaults are positional against kwonlyargs and may be None for a
        # required one.
        positional = a.posonlyargs + a.args
        pairs = list(zip(positional[len(positional) - len(a.defaults):], a.defaults))
        pairs += [(arg, d) for arg, d in zip(a.kwonlyargs, a.kw_defaults) if d is not None]
        found += [d for arg, d in pairs if arg.arg == KEYWORD]
    return found


def _iter_scope(node):
    """Direct statements in *node*'s function, skipping nested functions.

    A wait inside a nested helper is a different scope; assignments there do
    not bind the outer name, and the outer's Popen does not bind the inner's.
    """
    for child in ast.iter_child_nodes(node):
        if isinstance(child, SCOPE_NODES):
            continue
        yield child
        yield from _iter_scope(child)


# `core.children` launches through `Popen` and hands the process back, so a
# name bound from either wrapper is a Popen the caller must reap with a bound.
# Matched on the module's last segment and the function, so `children.spawn`
# and `core.children.spawn` both count and an unrelated `spawn` does not.
POPEN_WRAPPERS = {('children', 'spawn'), ('children', 'owned')}


def _ends_with_popen_call(node) -> bool:
    """True when *node* launches a Popen: `Popen(...)` or a `core.children` wrapper."""
    if not isinstance(node, ast.Call):
        return False
    func = node.func
    if isinstance(func, ast.Name):
        return func.id == 'Popen'
    if not isinstance(func, ast.Attribute):
        return False
    if func.attr == 'Popen':
        return True
    owner = func.value
    owner_name = owner.attr if isinstance(owner, ast.Attribute) else getattr(owner, 'id', None)
    return (owner_name, func.attr) in POPEN_WRAPPERS


def _name_ids(targets) -> list[str]:
    """Plain names among *targets*, ignoring attributes and tuples."""
    found = []
    for target in targets:
        if isinstance(target, ast.Name):
            found.append(target.id)
    return found


def _bind_with_popen(node, names: set[str]) -> None:
    for item in node.items:
        bound = item.optional_vars
        if not isinstance(bound, ast.Name):
            continue
        if _ends_with_popen_call(item.context_expr):
            names.add(bound.id)
        else:
            names.discard(bound.id)


def _is_popen_annassign(node) -> bool:
    """True for `name: T = Popen(...)`."""
    if not isinstance(node, ast.AnnAssign) or not isinstance(node.target, ast.Name):
        return False
    return node.value is not None and _ends_with_popen_call(node.value)


def _bind_popen_names(node, names: set[str]) -> None:
    """Add names *node* binds from a Popen launch; drop ones it rebinds to anything else."""
    if isinstance(node, ast.Assign):
        if _ends_with_popen_call(node.value):
            names.update(_name_ids(node.targets))
        else:
            names.difference_update(_name_ids(node.targets))
        return
    if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
        if _is_popen_annassign(node):
            names.add(node.target.id)
        elif node.value is not None:
            names.discard(node.target.id)
        return
    if isinstance(node, (ast.With, ast.AsyncWith)):
        _bind_with_popen(node, names)


def _popen_reap_receiver(call: ast.Call) -> str | None:
    """The plain name a `.wait()` / `.communicate()` is called on, if any."""
    func = call.func
    if not isinstance(func, ast.Attribute) or func.attr not in ('wait', 'communicate'):
        return None
    if not isinstance(func.value, ast.Name):
        return None
    return func.value.id


def _unbounded_popen_reaps(tree) -> list[Violation]:
    """`.wait()` / `.communicate()` on a name bound from `Popen` with no timeout=.

    A `**kwargs` splat counts as a bound, matching `_unbounded_launches`.
    """
    found = []
    for func in ast.walk(tree):
        if not isinstance(func, SCOPE_NODES):
            continue
        found += _reaps_in_function(func)
    return found


def _reaps_in_function(func) -> list[Violation]:
    names: set[str] = set()
    found = []
    for node in _iter_scope(func):
        _bind_popen_names(node, names)
        violation = _unbounded_reap(node, names)
        if violation is not None:
            found.append(violation)
    return found


def _unbounded_reap(node, names: set[str]) -> Violation | None:
    if not isinstance(node, ast.Call):
        return None
    receiver = _popen_reap_receiver(node)
    if receiver is None or receiver not in names:
        return None
    if any(kw.arg in (KEYWORD, None) for kw in node.keywords):
        return None
    attr = node.func.attr
    # `wait(timeout=None)`, `communicate(input=None, timeout=None)`.
    slot = REAP_TIMEOUT_SLOT[attr]
    if any(isinstance(a, ast.Starred) for a in node.args):
        return None
    if len(node.args) > slot:
        literal = _literal(node.args[slot])
        if literal is None:
            return None
        return Violation(line=node.lineno, found=f'{KEYWORD}={literal}',
                         suggestion=_suggestion(literal))
    return Violation(
        line=node.lineno,
        found=f'{receiver}.{attr}() with no {KEYWORD}=',
        suggestion=A_TIER,
    )


def check_file(filepath: str) -> list[Violation]:
    with open(filepath) as f:
        source = f.read()
    # Every file is parsed now that an *absent* bound is a violation: a file
    # with no `timeout` in it anywhere is exactly the shape being looked for.
    try:
        tree = ast.parse(source, filename=filepath)
    except SyntaxError as exc:
        # Silence here would read as "clean" for a file this check never saw.
        print(f'{RED}!{NC} {filepath}: unparseable, not checked ({exc})',
              file=sys.stderr)
        return []
    values = _call_kwargs(tree) + _param_defaults(tree)
    found = [Violation(line=v.lineno, found=f'{KEYWORD}={lit}',
                       suggestion=_suggestion(lit))
             for v in values for lit in [_literal(v)] if lit is not None]
    return sorted(found + _unbounded_launches(tree) + _unbounded_popen_reaps(tree),
                  key=lambda v: v.line)


# ── Discovery ────────────────────────────────────────────────────────────────


def _is_python(path: str) -> bool:
    if path.endswith('.py'):
        return True
    if os.path.splitext(path)[1] or not os.access(path, os.X_OK):
        return False
    try:
        with open(path, 'rb') as f:
            first = f.readline()
    except OSError:
        return False
    return first.startswith(b'#!') and b'python' in first


def discover_scripts(repo_root: str) -> list[str]:
    found = []
    roots = [os.path.join(repo_root, d) for d in SEARCH_DIRS]
    for root in roots:
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            paths = [os.path.join(dirpath, f) for f in filenames]
            found += [p for p in paths if _is_python(p)]
    return sorted(found)


# ── Reporting ────────────────────────────────────────────────────────────────


def _report_violations(relpath: str, violations: list[Violation]) -> None:
    print(f'{RED}✗{NC} {relpath}: {KEYWORD} not taken from `{TABLE}`', file=sys.stderr)
    for v in violations:
        print(f'    line {v.line}: {v.found} '
              f'{DIM}— use {v.suggestion}{NC}', file=sys.stderr)
    print(f'    {DIM}the tiers and what belongs in each are in '
          f'ai/lib/core/{TABLE}.py{NC}', file=sys.stderr)


def _print_summary(files_checked: int, errors: int) -> None:
    print()
    if errors == 0:
        print(f'{GREEN}✓{NC} {files_checked} files checked, '
              f'every {KEYWORD} comes from `{TABLE}`')
    else:
        print(f'{RED}✗{NC} {errors} of {files_checked} files leave a {KEYWORD} '
              f'unwritten or write it as a literal', file=sys.stderr)


# ── CLI ──────────────────────────────────────────────────────────────────────


def main():
    parser = argparse.ArgumentParser(
        description='Validate that every subprocess bound comes from the timeouts table.')
    parser.add_argument('--quiet', action='store_true',
                        help='Only show failures and summary')
    parser.add_argument('files', nargs='*',
                        help='Files to check (auto-discovers if omitted)')
    args = parser.parse_args()

    repo_root = _WORKBENCH_DIR
    if args.files:
        # Named files go through the same gate discovery applies. Without it a
        # non-Python path reaches the parser and is reported unparseable, which
        # reads as a finding about a file that was never in scope.
        files = [f for f in args.files if _is_python(f)]
    else:
        files = discover_scripts(repo_root)

    errors = 0
    for filepath in files:
        violations = check_file(filepath)
        relpath = os.path.relpath(filepath, repo_root)
        errors += 1 if violations else 0
        if violations:
            _report_violations(relpath, violations)
        elif not args.quiet:
            print(f'  {GREEN}✓{NC} {relpath}')

    _print_summary(len(files), errors)
    if errors:
        sys.exit(1)


if __name__ == '__main__':
    main()
