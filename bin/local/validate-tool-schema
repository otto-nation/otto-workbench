#!/usr/bin/env python3
"""Validate that every script claiming the tool-schema protocol can answer it.

Usage: bin/local/validate-tool-schema [--quiet]

The MCP server discovers a tool by reading a script's source for a protocol
marker and then running it.  A script that carries the marker but exits
non-zero, prints malformed JSON, omits `name` or `input_schema`, or outruns the
probe timeout is skipped with a warning on the server's stderr — which belongs
to whichever MCP client spawned it, not to the person who broke the script.
The tool just never appears.  This check moves that discovery to the build.

Every rule here is the server's own: `ai/claude/mcps/server.py` owns what a tool
directory is (`discover_tool_dirs`), which scripts get probed (`tool_candidates`)
and what counts as an answer (`probe_tool`).  This script only walks the result
and prints it, so the two cannot drift.

Scope is the checkout, which is also the whole of what the server scans — the
directories are derived from the component layout and no config adds to them.

`bin/local/validate-skills` keeps its own probe, which asserts the converse: the
tool a skill's `output_schema` names must implement the protocol.  A script that
never claimed the protocol carries no marker, so this sweep skips it — which is
exactly the case that check exists to catch.

Exit code: 0 if every candidate answers, 1 if any cannot.
"""

import argparse
import os
import sys

_WORKBENCH_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.path.insert(0, os.path.join(_WORKBENCH_DIR, 'lib'))
sys.path.insert(0, os.path.join(_WORKBENCH_DIR, 'ai', 'claude', 'mcps'))
from ansi import RED, GREEN, DIM, NC  # noqa: E402
from server import ProbeResult, discover_tool_dirs, probe_tool, tool_candidates  # noqa: E402


# ── Discovery ────────────────────────────────────────────────────────────────


def validator_root() -> str:
    """The tree to probe.

    Same ``VALIDATOR_ROOT`` override, and same reason, as bin/local/validate-all:
    tests point it at a fixture tree instead of writing broken scripts into the
    live checkout.  Deliberately not ``WORKBENCH_DIR``, which setup code pins to
    the main worktree and which would silently validate the wrong tree from a
    feature one.
    """
    return os.environ.get('VALIDATOR_ROOT') or _WORKBENCH_DIR


def check_root(root: str) -> list[ProbeResult]:
    """Probe every candidate under *root* and return the results in path order."""
    return [probe_tool(script)
            for d in discover_tool_dirs(root)
            for script in tool_candidates(d)]


# ── Reporting ────────────────────────────────────────────────────────────────


def _report(results: list[ProbeResult], root: str, quiet: bool) -> int:
    failures = 0
    for result in results:
        relpath = os.path.relpath(str(result.script), root)
        if not result.ok:
            failures += 1
            print(f'{RED}✗{NC} {relpath}: {result.reason}', file=sys.stderr)
        elif not quiet:
            name = result.schema['name']
            print(f'  {GREEN}✓{NC} {relpath} {DIM}→ {name}{NC}')
    return failures


def _print_summary(checked: int, failures: int) -> None:
    print()
    if checked == 0:
        print(f'  {DIM}no --tool-schema candidates found{NC}')
    elif failures == 0:
        print(f'{GREEN}✓{NC} {checked} tools answer --tool-schema')
    else:
        print(f'{RED}✗{NC} {failures} of {checked} tools claim --tool-schema '
              f'but cannot answer it', file=sys.stderr)
        print(f'    {DIM}a tool that fails here is skipped at runtime and never '
              f'reaches an MCP client{NC}', file=sys.stderr)


# ── CLI ──────────────────────────────────────────────────────────────────────


def main():
    parser = argparse.ArgumentParser(
        description='Validate that every --tool-schema script can answer the probe.')
    parser.add_argument('--quiet', action='store_true',
                        help='Only show failures and summary')
    args = parser.parse_args()

    root = validator_root()
    results = check_root(root)
    failures = _report(results, root, args.quiet)
    _print_summary(len(results), failures)
    if failures:
        sys.exit(1)


if __name__ == '__main__':
    main()
