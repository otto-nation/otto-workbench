#!/usr/bin/env bash
# Manage your workbench developer environment.
#
# Usage: otto-workbench [--workbench-dir <path>] <command>
#
# Global flags:
#   --workbench-dir <path>  Override workbench root (e.g. a worktree checkout)
#
# Commands:
#   install [--all] [COMPONENT ...]  Bootstrap the workbench (first-time setup)
#   sync                  Re-apply all workbench configuration to ~/
#   ai <subcmd>           Manage AI tools — scaffold projects, sync config, manage overrides
#   config <subcmd>       Write a workbench config key, checked against the key surface
#   discover [regenerate] Show installed components, scripts, and launchd agents
#   projects <subcmd>     The repos on this machine that use the workbench
#   permissions <subcmd>  Claude Code permission grants across the registered repos
#   maintenance <subcmd>  Scheduled pull, sync, and cleanup via launchd
#   changelog             Show recent changes from conventional commits
#
# What install does:
#   Runs first-time setup: installs Homebrew (if missing), syncs core
#   components (bin, git, task, zsh), presents a menu of optional
#   components (brew packages, docker, terminals, editors, ai, mise),
#   and runs pending migrations. Safe to re-run — idempotent.
#   Use --all to skip menus, or name specific components.
#
# What ai does:
#   ai init — scaffolds a .claude/ directory in the current git repo (if one
#   doesn't exist) with stack-detected rules and a project anatomy file.
#   Use --force to re-scaffold, --analyze to run /analyze-project after.
#   ai sync — syncs machine-level AI config (settings, rules, skills, agents, MCPs).
#   ai override <type> [name] [--add|--disable|--enable|--status] — manage user overrides.
#
# What sync does (pure config reconciliation):
#   - Re-symlinks scripts, zsh/, git/.gitconfig, Taskfile, lib/
#   - Syncs Claude settings.json, CLAUDE.md, rules/, skills/, agents/, MCPs
#   - Merges Zed/Sublime editor settings
#   - Reconciles Ghostty theme key
#
# What sync does NOT do (one-time setup via otto-workbench install):
#   - Install Homebrew packages or casks
#   - Configure Docker runtime
#   - Import iTerm themes
#   - Create Ghostty config from template
#   - Regenerate tool context (now runs during sync via sync_zsh)
#
# To run first-time setup or those components: otto-workbench install [COMPONENT ...]

set -e

# Require modern bash (4.3+ for namerefs used in lib/registries.sh).
if [[ "${BASH_VERSINFO[0]}" -lt 4 || ( "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -lt 3 ) ]]; then
  echo "✗ bash 4.3+ required (found ${BASH_VERSION}). Install: brew install bash" >&2
  exit 1
fi

# Parse global flags before sourcing libs (constants.sh respects WORKBENCH_DIR if set).
while [[ $# -gt 0 ]]; do
  case "$1" in
    --workbench-dir) export WORKBENCH_DIR="$2"; shift 2 ;;
    *) break ;;
  esac
done

_SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
WORKBENCH_DIR="${WORKBENCH_DIR:-$(git -C "$(dirname "$_SELF")" rev-parse --show-toplevel)}"
# shellcheck source=/dev/null
. "$WORKBENCH_DIR/lib/ui.sh"
# shellcheck source=/dev/null
. "$WORKBENCH_DIR/lib/migrations.sh"
# shellcheck source=/dev/null
. "$WORKBENCH_DIR/lib/install.sh"
# shellcheck source=/dev/null
. "$WORKBENCH_DIR/lib/maintenance.sh"
# shellcheck source=/dev/null
. "$WORKBENCH_DIR/lib/overrides.sh"
# shellcheck source=/dev/null
. "$WORKBENCH_DIR/lib/discover.sh"
# shellcheck source=/dev/null
. "$WORKBENCH_DIR/lib/ai_init.sh"
# _repo_key, which memory_orphans (lib/projects.sh) calls via cmd_projects_prune
# below, lives here rather than in projects.sh itself — see lib/ai/session-count.sh's
# own header for why the split.
# shellcheck source=/dev/null
. "$WORKBENCH_DIR/lib/ai/session-count.sh"

# Auto-discover and source all steps.sh files.
# Each steps.sh self-derives its own paths; no external variables need to be injected.
# Adding a new component with a steps.sh automatically makes its functions available here.
_step_files=()
discover_step_files _step_files
for _f in "${_step_files[@]}"; do
  # shellcheck source=/dev/null
  . "$_f"
done
unset _f _step_files

# shellcheck disable=SC2034  # used by commands_usage() via nameref
COMMANDS=(
  "install [--all] [COMPONENT ...]"  "Bootstrap the workbench (first-time setup)"
  "sync"                              "Re-apply all workbench configuration to ~/"
  "ai <subcmd>"                       "Manage AI tools — scaffold projects, sync config, manage overrides"
  "config <subcmd>"                   "Write a workbench config key, checked against the key surface"
  "discover [regenerate]"             "Show installed components, scripts, and launchd agents"
  "projects <subcmd>"                 "The repos on this machine that use the workbench"
  "permissions <subcmd>"              "Claude Code permission grants across the registered repos"
  "maintenance <subcmd>"              "Scheduled pull, sync, and cleanup via launchd"
  "changelog"                         "Show recent changes from conventional commits"
)

# shellcheck disable=SC2034  # used by commands_usage() via nameref
COMMANDS_PROJECTS=(
  "list"           "List the registered repos that still exist"
  "add [DIR]"      "Register DIR's repo (default: the current one)"
  "forget DIR"     "Drop DIR's entry"
  "prune"          "Delete entries whose directory is gone, and repeats"
)

# shellcheck disable=SC2034  # used by commands_usage() via nameref
COMMANDS_PERMISSIONS=(
  "sweep [--prune] [--verbose]"   "Report local permission-grant drift in every registered repo"
  "mirror [--dry-run] [--verbose]" "Copy a repo's tracked grants into its bare-repo container"
)

# shellcheck disable=SC2034  # used by commands_usage() via nameref
COMMANDS_AI=(
  "init [--force] [--analyze]"        "Scaffold .claude/ in the current git repo"
  "sync"                              "Sync machine-level AI config (settings, rules, MCPs, skills, agents)"
  "override <type> [name] [flags]"    "Manage user overrides (agents, skills, rules)"
)

# shellcheck disable=SC2034  # used by commands_usage() via nameref
COMMANDS_CONFIG=(
  "set KEY VALUE [--project|--container]"  "Write KEY — globally, into this checkout, or above its worktrees"
  "status"                                 "Show every scope, every value, and the file it came from"
  "get KEY [DIR ...]"                      "Resolve KEY for this repo, or for each named one, with the scope that answered"
)

# shellcheck disable=SC2034  # used by commands_usage() via nameref
COMMANDS_MAINTENANCE=(
  "start [SECONDS]"  "Start maintenance (default: every 12h)"
  "stop"             "Stop maintenance"
  "status"           "Show maintenance status"
  "run"              "Run maintenance now"
  "logs"             "Show recent log entries"
)

# ─── Commands ─────────────────────────────────────────────────────────────────

cmd_install() {
  # If running from Homebrew Cellar, clone the full repo and re-exec from there.
  if [[ "$WORKBENCH_DIR" == */Cellar/* ]]; then
    _clone_workbench_repo
    exec "$WORKBENCH_REPO_DIR/bin/otto-workbench" install "$@"
  fi

  # Parse flags: --all, component targets
  parse_install_flags "$@"

  # Collect warnings/errors for final summary replay.
  WORKBENCH_INSTALL_LOG="$(mktemp "${TMPDIR:-/tmp}/workbench-install.XXXXXX")"
  export WORKBENCH_INSTALL_LOG
  trap 'rm -f "$WORKBENCH_INSTALL_LOG"' EXIT
  export WORKBENCH_DIR

  # Interactive mode: install_symlink prompts before overwriting real files.
  # shellcheck disable=SC2034  # read by install_symlink in lib/ui.sh
  SYMLINK_MODE=""

  echo -e "${BOLD}${BLUE}Installing dotfiles...${NC}"
  echo -e "  ${DIM}✓${NC} installed  ${DIM}✓ up to date  ⊘ skipped  ⚠ attention needed${NC}"
  echo

  # ─── Bootstrap ──────────────────────────────────────────────────────────
  if [[ "$OSTYPE" == "darwin"* ]]; then
    step_brew_install
  else
    _check_linux_prerequisites
  fi
  echo

  # Resolve known components and validate targets (if any).
  resolve_known_components
  if [[ "$INSTALL_TARGETED" == true ]]; then
    validate_install_targets "${INSTALL_TARGETS[@]}"
  fi

  # ─── Core components ───────────────────────────────────────────────────
  local -a _core_dirs=() _core_descs=()
  discover_core_components _core_dirs _core_descs

  if [[ ${#_core_dirs[@]} -gt 0 ]]; then
    local -a _core_selected=()
    select_core_components _core_selected _core_dirs _core_descs
    local _c
    for _c in "${_core_selected[@]}"; do
      run_core_component "$_c"
    done
  fi

  update_path_in_shell_rc

  # Run pending migrations after core sync, before optional components.
  sync_header "Migrations"
  run_all_migrations

  echo -e "\n${BOLD}${GREEN}✓ Dotfiles installed!${NC}"

  # ─── Optional components ────────────────────────────────────────────────
  local registry="$INSTALL_COMPONENTS_FILE"
  validate_components "$registry"
  discover_components  "$registry"
  select_components
  run_components

  print_install_summary
}

cmd_sync() {
  # Non-interactive mode: install_symlink warns and skips real files.
  # shellcheck disable=SC2034  # read by install_symlink in lib/ui.sh
  SYMLINK_MODE=no-prompt

  # Quiet mode: suppresses per-file dim checkmarks, section headers, and
  # summary noise. Only changes, warnings, and errors surface.
  WORKBENCH_SYNC=true
  export WORKBENCH_SYNC

  # Collect warnings/errors for final summary replay.
  WORKBENCH_INSTALL_LOG="$(mktemp "${TMPDIR:-/tmp}/workbench-sync.XXXXXX")"
  export WORKBENCH_INSTALL_LOG
  trap 'rm -f "$WORKBENCH_INSTALL_LOG"' EXIT

  sync_header "Migrations"
  run_all_migrations

  # Sync components — respects installation state when a state file exists.
  # Without a state file (pre-existing installs), syncs everything (backward compat).
  # Infrastructure components (bin, task, git, zsh) always sync regardless of state.
  #
  # Before syncing, prune any orphaned state entries (renamed/removed components).
  state_prune_orphans

  local -a _step_files=()
  discover_step_files _step_files
  local _f _c _path
  local _always_sync="$CORE_COMPONENTS"
  for _f in "${_step_files[@]}"; do
    _c=$(basename "$(dirname "$_f")")
    # Derive component path relative to WORKBENCH_DIR (e.g. ai/claude from ai/claude/steps.sh)
    _path="${_f#"$WORKBENCH_DIR/"}"
    _path="${_path%/steps.sh}"

    # Gate on state: skip uninstalled components (unless no state file = backward compat)
    if state_file_exists && [[ " $_always_sync " != *" $_path "* ]] && ! state_is_installed "$_path"; then
      continue
    fi

    # Skip sub-components whose parent has a sync function — the parent
    # is responsible for dispatching to its children.
    local _parent_dir="${_path%/*}"
    local _parent_name
    _parent_name=$(basename "$_parent_dir")
    if [[ "$_parent_dir" != "$_path" ]] \
       && declare -f "sync_${_parent_name}" > /dev/null; then
      continue
    fi

    export WORKBENCH_CURRENT_COMPONENT="$_c"
    if declare -f "sync_${_c}" > /dev/null; then
      "sync_${_c}"
    fi
  done
  unset WORKBENCH_CURRENT_COMPONENT

  # shellcheck source=/dev/null
  . "$WORKBENCH_DIR/lib/summary.sh"

  # Auto-discover and call per-component summaries (brew, docker, ai, etc.)
  # Only warnings/errors surface during sync (summary_ok/summary_info are suppressed).
  run_component_summaries

  echo
  success "Workbench synced"

  print_warnings_summary
}

# ─── AI command ──────────────────────────────────────────────────────────────

_ai_usage() {
  cat <<EOF
Usage: otto-workbench ai <command>

Manage AI coding tool configuration (Claude Code, etc.).

Commands:
$(commands_usage COMMANDS_AI)

Run 'otto-workbench ai <command> -h' for command-specific help.
Run 'otto-workbench sync' to apply changes after editing overrides.
EOF
}

cmd_ai_init() { ai_init_run "$@"; }

cmd_ai_sync() {
  case "${1:-}" in
    -h|--help)
      cat <<EOF
Usage: otto-workbench ai sync

Sync machine-level AI config: settings, rules, MCPs, skills, agents,
machine profile, and memory backup. This is the AI-only subset of
'otto-workbench sync'.
EOF
      return 0
      ;;
  esac

  title "AI sync"
  echo

  # Migrations first, the same as `otto-workbench sync`. The AI syncs read
  # ~/.env.local by variable name — step_claude_settings mirrors it into
  # settings.json, step_pi_settings derives Pi's model config from it — so a
  # pending rename that has not run yet is a file this sync reads under names it
  # no longer carries. Skipping them here made this the one path that could act
  # on a half-migrated machine.
  sync_header "Migrations"
  run_all_migrations

  sync_ai
  echo
  success "AI sync complete!"
}

cmd_ai() {
  local subcmd="${1:-}"
  shift 2>/dev/null || true

  case "$subcmd" in
    init)     cmd_ai_init "$@" ;;
    sync)     cmd_ai_sync "$@" ;;
    override) cmd_ai_override "$@" ;;
    -h|--help) _ai_usage; return 0 ;;
    *)        _ai_usage >&2; return 1 ;;
  esac
}

cmd_changelog() {
  bash "$WORKBENCH_DIR/git/bin/generate-changelog" "$@"
}

# ─── Project registry ────────────────────────────────────────────────────────
#
# The list itself lives in lib/projects.sh; everything here is presentation.

_projects_usage() {
  cat <<EOF
Usage: otto-workbench projects [command]

The repos on this machine that use otto-workbench. A repo joins the list the
first time a workbench command runs in it — no directory is ever scanned for
candidates. Entries whose directory is gone are skipped on read; 'prune' is
what deletes them.

Commands:
$(commands_usage COMMANDS_PROJECTS)
EOF
}

# A registry line is a work tree, and a machine that cuts one per branch has a
# dozen of them behind a single repository. The repos are the level an operator
# reads this at, so each one is named once and its checkouts are listed under it
# by the part of the path the repo has not already said.
cmd_projects_list() {
  local line id path label under repos=0 trees=0 named=""
  while IFS= read -r line; do
    _split_repo_worktree_line "$line" id path
    label="$(project_repo_label "$id")"
    if [[ "$label" != "$named" ]]; then
      named="$label"
      repos=$(( repos + 1 ))
      printf '  %s\n' "${label/#$HOME/\~}"
    fi
    trees=$(( trees + 1 ))
    # An ordinary clone is its own repo's only work tree, and naming it a second
    # time under itself says nothing the line above did not.
    if [[ "$path" == "$label" ]]; then
      continue
    fi
    under="$(project_repo_relative "$label" "$path")"
    printf '    %s\n' "$under"
  done < <(project_repo_worktrees | sort)

  if (( trees == 0 )); then
    info "No repos registered yet — one joins the list the first time a workbench command runs in it"
    return 0
  fi
  echo
  info "$repos repo(s), $trees work tree(s) — ${PROJECTS_REGISTRY_FILE/#$HOME/\~}"
}

cmd_projects_add() {
  local dir="$1" root rc=0
  root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || root=""
  if [[ -z "$root" ]]; then
    err "Not a git work tree: $dir"
    return 1
  fi

  project_register "$root" || rc=$?
  if (( rc == 0 )); then
    success "Registered $root"
    return 0
  fi
  if (( rc == 3 )); then
    info "Already registered: $root"
    return 0
  fi
  if (( rc == 2 )); then
    err "Could not write ${PROJECTS_REGISTRY_FILE/#$HOME/\~} — $root qualifies but the registry is unwritable"
    return 1
  fi
  err "Refused $root — a temporary path, a bare repo's container, or a path holding a tab, not a project"
  return 1
}

cmd_projects_forget() {
  if [[ -z "${1:-}" ]]; then
    err "Usage: otto-workbench projects forget DIR"
    return 1
  fi
  local dir
  dir="$(_projects_abs "$1")"
  if project_forget "$dir"; then
    success "Forgot $dir"
    return 0
  fi
  err "Not in the registry: $dir"
  return 1
}

cmd_projects_prune() {
  local dropped
  dropped="$(project_prune)"
  success "Pruned $dropped entry(s)"

  # Reported, never deleted: memory is authored and has no producer to write it
  # again, and an unregistered repo may only be one nobody has opened lately.
  local key count orphans=0
  while IFS=$'\t' read -r key count; do
    [[ -n "$key" ]] || continue
    [[ "$orphans" -eq 0 ]] && warn "Memory with no registered repo:"
    info "  $key ($count topic file(s))"
    orphans=$((orphans + 1))
  done < <(memory_orphans)
  [[ "$orphans" -gt 0 ]] && info "Left in place under $WORKBENCH_MEMORY_DIR — reconcile by hand"
  return 0
}

cmd_projects() {
  local subcmd="${1:-list}"
  shift 2>/dev/null || true

  case "$subcmd" in
    list)      cmd_projects_list ;;
    add)       cmd_projects_add "${1:-$PWD}" ;;
    forget)    cmd_projects_forget "${1:-}" ;;
    prune)     cmd_projects_prune ;;
    -h|--help) _projects_usage; return 0 ;;
    *)         _projects_usage >&2; return 1 ;;
  esac
}

# ─── Permission grants ───────────────────────────────────────────────────────
#
# Both halves live in lib/, sharing their matcher and their container discovery
# with bin/local/validate-permissions through lib/permissions.py; everything
# here is dispatch.

_permissions_usage() {
  cat <<EOF
Usage: otto-workbench permissions [command]

Claude Code permission grants that accumulate where nothing reviews them — a
repo's untracked .claude/settings.local.json, and the .claude/ of a bare repo's
container, which is above every worktree and so invisible to all of them.

sweep reports three classes: a grant re-granting an ask-gated command, a grant
some other rule already makes, and a grant naming a directory that is gone. Only
the second is ever deleted, and only under --prune.

mirror is the other direction — it copies a repo's tracked grants into that
container, so the prompts sweep cleans up after are never answered in the first
place. \`otto-workbench ai sync\` runs it.

Commands:
$(commands_usage COMMANDS_PERMISSIONS)
EOF
}

cmd_permissions_sweep() {
  python3 "$WORKBENCH_DIR/lib/permission_sweep.py" "$@"
}

cmd_permissions_mirror() {
  python3 "$WORKBENCH_DIR/lib/permission_mirror.py" "$@"
}

# `sweep` is the default, so a bare flag is passed straight through —
# `permissions --prune` is what a reader who saw the usage line types, and
# rejecting it to insist on the word `sweep` teaches nothing.
cmd_permissions() {
  local subcmd="${1:-sweep}"
  shift 2>/dev/null || true

  case "$subcmd" in
    sweep)     cmd_permissions_sweep "$@" ;;
    mirror)    cmd_permissions_mirror "$@" ;;
    -h|--help) _permissions_usage; return 0 ;;
    -*)        cmd_permissions_sweep "$subcmd" "$@" ;;
    *)         _permissions_usage >&2; return 1 ;;
  esac
}

# ─── Workbench config ────────────────────────────────────────────────────────
#
# The guard is the point, not the write: lib/config_cli.py refuses a key the
# workbench does not read, and running it by its installed name is what makes
# "the workbench" mean the current one rather than whichever worktree the
# caller happens to be standing in.
#
# `status` is the read side of the same problem. A key the guard refused is one
# nobody lost; a key a hand-edit put in, or an older workbench wrote, is one
# only a report of what each file actually supplied will ever surface.

_config_usage() {
  cat <<EOF
Usage: otto-workbench config <command>

Read and write the hand-authorable config — the global $WORKBENCH_CONFIG_NAME, a
repo's $WORKBENCH_PROJECT_CONFIG_NAME, and the $WORKBENCH_PROJECT_CONFIG_NAME above a bare repo's
worktrees, which every one of them reads and wt remove cannot delete.

A key the workbench does not read is refused rather than written. Every one of
those files is shared — the global one by every repo on this machine, a project
one by everybody who clones the repo, a container one by every worktree — and
an unrecognised key is dropped on the way back in, so a write nothing checks
loses the value without saying so.

status reports the other side: each scope in precedence order, the value of
every key with the file that supplied it, and any key a file holds that
nothing reads.

get resolves one key for a script — one tab-separated record per DIR, holding
the scope that answered, the value, and the DIR — so bash reads through the
same owner instead of parsing a subset of the same files.

Commands:
$(commands_usage COMMANDS_CONFIG)
EOF
}

cmd_config_set() {
  python3 "$WORKBENCH_DIR/lib/config_cli.py" set "$@"
}

cmd_config_status() {
  python3 "$WORKBENCH_DIR/lib/config_cli.py" status "$@"
}

cmd_config_get() {
  python3 "$WORKBENCH_DIR/lib/config_cli.py" get "$@"
}

cmd_config() {
  local subcmd="${1:-}"
  shift 2>/dev/null || true
  case "$subcmd" in
    set)       cmd_config_set "$@" ;;
    status)    cmd_config_status "$@" ;;
    get)       cmd_config_get "$@" ;;
    -h|--help) _config_usage; return 0 ;;
    *)         _config_usage >&2; return 1 ;;
  esac
}

# ─── Maintenance ─────────────────────────────────────────────────────────────

cmd_maintenance_start() {
  local interval="${1:-$_MAINTENANCE_DEFAULT_INTERVAL}"
  if [[ "$OSTYPE" == "darwin"* ]]; then
    _launchd_start "$interval"
  else
    _systemd_start "$interval"
  fi
  success "Maintenance started (every $(_format_interval "$interval"))"
}

cmd_maintenance_stop() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    if _launchd_stop; then success "Maintenance stopped"; else info "Maintenance is not running"; fi
  else
    if _systemd_stop; then success "Maintenance stopped"; else info "Maintenance is not running"; fi
  fi
}

cmd_maintenance_status() {
  local running=false
  if [[ "$OSTYPE" == "darwin"* ]]; then
    if _launchd_status; then running=true; fi
  else
    if _systemd_status; then running=true; fi
  fi

  if [[ "$running" == false ]]; then
    echo -e "  ${DIM}Not running${NC}"
    echo -e "  ${DIM}Start with: otto-workbench maintenance start${NC}"
    return
  fi

  [[ -f "$MAINTENANCE_LAST_FILE" ]] || return 0
  local ts last_date
  ts=$(cat "$MAINTENANCE_LAST_FILE")
  if [[ "$OSTYPE" == "darwin"* ]]; then
    last_date=$(date -r "$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "unknown")
  else
    last_date=$(date -d "@$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "unknown")
  fi
  echo -e "  ${DIM}Last run: $last_date${NC}"
}

cmd_maintenance_run() {
  info "Running maintenance now"
  "$MAINTENANCE_SRC_DIR/bin/otto-workbench-maintenance"
}

cmd_maintenance_logs() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    local logfile="$_MAINTENANCE_LOG_DIR_MACOS/maintenance.log"
    if [[ -f "$logfile" ]]; then
      tail -50 "$logfile"
    else
      info "No log file yet"
    fi
  else
    journalctl --user -u "$_SYSTEMD_UNIT" --no-pager -n 50 2>/dev/null \
      || info "No journal entries yet"
  fi
}

_maintenance_usage() {
  cat <<EOF
Usage: otto-workbench maintenance <command>

Scheduled maintenance via $(if [[ "$OSTYPE" == "darwin"* ]]; then echo "launchd"; else echo "systemd"; fi). Pulls changes, runs sync, cleans stale worktrees, and collects stale PR artifacts.

Commands:
$(commands_usage COMMANDS_MAINTENANCE)
EOF
}

cmd_maintenance() {
  local subcmd="${1:-}"
  shift 2>/dev/null || true

  case "$subcmd" in
    start)  cmd_maintenance_start "$@" ;;
    stop)   cmd_maintenance_stop ;;
    status) cmd_maintenance_status ;;
    run)    cmd_maintenance_run ;;
    logs)   cmd_maintenance_logs ;;
    -h|--help) _maintenance_usage; exit 0 ;;
    *)
      _maintenance_usage >&2
      exit 1
      ;;
  esac
}

# ─── Override management ─────────────────────────────────────────────────────

cmd_ai_override() {
  local type name action
  _ai_override_parse_args type name action "$@" || return 1

  # No type: top-level
  if [[ -z "$type" ]]; then
    [[ "$action" == "--status" ]] && { _ai_override_status; return 0; }
    _ai_override_list
    return 0
  fi

  if ! _is_override_type "$type"; then
    err "Unknown type: $type (expected: agent, skill, rule)"
    return 1
  fi

  # Type only, no name
  if [[ -z "$name" ]]; then
    info "$type overrides"
    _list_defaults "$type"
    return 0
  fi

  # Type + name + action
  case "$action" in
    --add)     _ai_override_add "$type" "$name" ;;
    --disable) _ai_override_disable "$type" "$name" ;;
    --enable)  _ai_override_enable "$type" "$name" ;;
    --help)    _ai_override_usage ;;
    --status|"") _show_item_status "$type" "$name" ;;
  esac
}

# ─── Discover ────────────────────────────────────────────────────────────────

cmd_discover() {
  local subcmd="${1:-}"
  case "$subcmd" in
    regenerate)
      info "Regenerating installation state"
      rm -f "$INSTALL_YML_FILE" "$INSTALLED_STATE_FILE"
      state_detect_installed
      echo
      success "Installation state regenerated"
      ;;
    "")
      ;;
    *)
      echo "Usage: otto-workbench discover [regenerate]" >&2
      exit 1
      ;;
  esac

  echo -e "\n  ${BOLD}Components${NC}"
  _discover_components
  echo -e "\n  ${BOLD}Scripts${NC}"
  _discover_scripts
  echo -e "\n  ${BOLD}Agents${NC}"
  _discover_agents
  echo
}

# ─── Main ─────────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Usage: otto-workbench [--workbench-dir <path>] <command>

Global flags:
  --workbench-dir <path>  Override workbench root (e.g. a worktree checkout)

Commands:
$(commands_usage)

Run 'otto-workbench install --help' for install options.
Run a command taking <subcmd> with no arguments to list its subcommands.
EOF
}

case "${1:-}" in
  install)     shift; cmd_install "$@" ;;
  sync)        cmd_sync ;;
  ai)          shift; cmd_ai "$@" ;;
  config)      shift; cmd_config "$@" ;;
  discover)    shift; cmd_discover "$@" ;;
  projects)    shift; cmd_projects "$@" ;;
  permissions) shift; cmd_permissions "$@" ;;
  maintenance) shift; cmd_maintenance "$@" ;;
  changelog)   shift; cmd_changelog "$@" ;;
  -h|--help)   usage; exit 0 ;;
  *)
    usage >&2
    exit 1
    ;;
esac
