#!/usr/bin/env bash
# Resolve a fuzzy branch name to an exact git branch — tries exact, worktree,
# separator, then fuzzy.
#
# ```
# resolve-branch <input>
# ```
#
# | Flag | Description |
# |------|-------------|
# | `-h`, `--help` | Show help |
#
# Resolution cascade (stops at the first match):
#
# 1. Exact match against local and remote branches (`origin/<input>` included)
# 2. Worktree directory basename match (including a worktree mid-rebase)
# 3. Separator normalization (`-` → `/` for the first two segments)
# 4. Case-insensitive fuzzy search
#
# The resolved name is printed on stdout with a `remotes/origin/` prefix stripped.
# Several fuzzy hits are listed on stderr rather than guessed.
#
# | Exit | Meaning |
# |------|---------|
# | `0` | Resolved; branch name on stdout |
# | `1` | No match, several fuzzy hits, or missing `<input>` |

set -e

_SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
WORKBENCH_DIR="$(git -C "$(dirname "$_SELF")" rev-parse --show-toplevel)"
# shellcheck source=/dev/null
. "$WORKBENCH_DIR/lib/ui.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") <input>

Resolve a fuzzy branch name to an exact git branch.

Resolution cascade (stops at first match):
  1. Exact match against local and remote branches
  2. Worktree directory basename match
  3. Separator normalization (- → / for first two segments)
  4. Case-insensitive fuzzy search
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

_clean_branch() {
  local raw="$1"
  raw="${raw#\* }"
  raw="${raw#+ }"
  raw="${raw#"${raw%%[! ]*}"}"
  raw="${raw#remotes/origin/}"
  echo "$raw"
}

_exact_match() {
  local input="$1"
  local result
  result=$(git branch -a --list "$input" "origin/$input" 2>/dev/null) || true
  if [[ -n "$result" ]]; then
    _clean_branch "$(echo "$result" | head -1)"
    return 0
  fi
  return 1
}

_rebase_branch() {
  local wt_path="$1"
  local git_dir head_name branch
  git_dir=$(git -C "$wt_path" rev-parse --git-dir 2>/dev/null) || return 1
  [[ "$git_dir" = /* ]] || git_dir="$wt_path/$git_dir"
  head_name="$git_dir/rebase-merge/head-name"
  [[ -f "$head_name" ]] || return 1
  branch=$(cat "$head_name")
  echo "${branch#refs/heads/}"
}

_worktree_match() {
  local input="$1"
  local line wt_path basename branch
  while IFS= read -r line; do
    wt_path=$(echo "$line" | awk '{print $1}')
    basename="${wt_path##*/}"
    [[ "$basename" == "$input" ]] || continue
    branch=$(echo "$line" | grep -o '\[.*\]' | tr -d '[]') || true
    [[ -n "$branch" ]] || branch=$(_rebase_branch "$wt_path") || true
    [[ -n "$branch" ]] || continue
    echo "$branch"
    return 0
  done < <(git worktree list 2>/dev/null)
  return 1
}

_separator_match() {
  local input="$1"
  local normalized
  normalized=$(echo "$input" | sed 's/-/\//; s/-/\//')
  if [[ "$normalized" != "$input" ]]; then
    _exact_match "$normalized"
    return $?
  fi
  return 1
}

_fuzzy_match() {
  local input="$1"
  local matches match_count
  matches=$(git branch -a 2>/dev/null | sed 's/^[ *]*//' | grep -i "$input") || true
  if [[ -z "$matches" ]]; then
    return 1
  fi

  match_count=$(echo "$matches" | wc -l | tr -d ' ')
  if [[ "$match_count" -eq 1 ]]; then
    _clean_branch "$matches"
    return 0
  fi

  err "Multiple branches match '$input':"
  while IFS= read -r line; do
    echo "  $(_clean_branch "$line")" >&2
  done <<< "$matches"
  return 1
}

# ── Main ──────────────────────────────────────────────────────────────────────

input="${1:-}"
if [[ -z "$input" ]]; then
  err "Usage: $(basename "$0") <input>"
  exit 1
fi

_exact_match "$input" && exit 0
_worktree_match "$input" && exit 0
_separator_match "$input" && exit 0
_fuzzy_match "$input" && exit 0

err "No branch found matching '$input'"
exit 1
