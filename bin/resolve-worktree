#!/usr/bin/env bash
# Resolve the worktree a bare-repo container stands in for.
#
# A bare repo has no working tree, so anything rooted at the container sees none
# of the repo's tracked files — no CLAUDE.md, no .claude/, no source. This
# prints the worktree checked out on the repo's default branch: the tree such a
# tool should read and write instead.
#
# Usage: resolve-worktree [DIR]
#        DIR defaults to the current directory.
#
# Output: absolute worktree path on stdout
# Exit:   0  resolved
#         1  DIR is a bare repo but no worktree holds the default branch
#         2  DIR is not a bare repository — nothing to resolve
#         64 usage error
#
# The single owner of this resolution in bash, rather than each caller deriving
# the default branch and scanning the worktree list again. The zsh `claude`
# wrapper calls it directly, because redirecting a launch is the whole of what it
# wants. Everything that resolves a tree in order to *write* a project artifact
# into it goes through lib/worktree.sh's project_root instead, which asks a
# working tree to name itself first and only falls back to this.
#
# lib/permission_mirror.py answers the same question in Python, for the mirror
# it writes into the container. The two must pick the same worktree: a session
# redirected to one the mirror did not write is a session whose reviewed grants
# are missing, which is the failure the mirror exists to prevent, arriving from
# the other side. tests/container_source.bats holds them to it.

set -e

_SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
WORKBENCH_DIR="$(git -C "$(dirname "$_SELF")" rev-parse --show-toplevel)"
# shellcheck source=/dev/null
. "$WORKBENCH_DIR/lib/ui.sh"

# Exit codes callers switch on. NOT_BARE is the ordinary case — every normal
# repo, worktree, and non-repo directory lands there.
EXIT_UNRESOLVED=1
EXIT_NOT_BARE=2
EXIT_USAGE=64

usage() {
  cat <<EOF
Usage: $(basename "$0") [DIR]

Print the worktree a bare-repo container stands in for — the checkout of its
default branch. DIR defaults to the current directory.

Exit codes:
  0   resolved; the worktree path is on stdout
  1   DIR is a bare repo but no worktree holds the default branch
  2   DIR is not a bare repository — nothing to resolve
  64  usage error
EOF
}

# _default_branch — prints the branch the container's own HEAD names.
#
# A bare repository's HEAD is its default branch: git guarantees the ref exists,
# it needs no remote, and it is what `git clone` reads to pick the branch a new
# checkout lands on. refs/remotes/origin/HEAD answers the same question only
# when there is a remote and somebody ran `git remote set-head` — `git clone
# --bare` creates no remote-tracking refs at all — so reading it would mean
# guessing between master and main in the common case, and guessing is what
# lets this disagree with the other half of the rule.
#
# This is one of two spellings of that rule; lib/permission_mirror.head_branch
# is the Python one, and tests/container_source.bats fails if they diverge.
_default_branch() {
  local ref
  ref="$(git symbolic-ref --quiet HEAD 2>/dev/null)" || return 1
  [[ -n "$ref" ]] || return 1
  printf '%s' "${ref#refs/heads/}"
}

# _worktree_on BRANCH — prints the existing worktree checked out on BRANCH.
#
# Reads --porcelain rather than the human listing, which packs path, SHA and
# [branch] onto one whitespace-separated line: a path containing a space is
# truncated by a naive split, and one containing a bracket reads as a branch
# tag. A registered worktree whose directory is gone is skipped, not returned.
_worktree_on() {
  local branch="$1" line path=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*)
        path="${line#worktree }"
        ;;
      "branch refs/heads/$branch")
        [[ -d "$path" ]] || continue
        printf '%s' "$path"
        return 0
        ;;
    esac
  done < <(git worktree list --porcelain 2>/dev/null)
  return 1
}

# ── Main ──────────────────────────────────────────────────────────────────────

dir="."
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -*) err "Unknown option: $1"; usage >&2; exit "$EXIT_USAGE" ;;
    *) dir="$1"; shift ;;
  esac
done

cd "$dir" 2>/dev/null || { err "No such directory: $dir"; exit "$EXIT_USAGE"; }

[[ "$(git rev-parse --is-bare-repository 2>/dev/null)" == "true" ]] || exit "$EXIT_NOT_BARE"

default_branch="$(_default_branch)" || {
  err "$(pwd -P): bare repository with a detached HEAD, so it names no default branch"
  exit "$EXIT_UNRESOLVED"
}

worktree="$(_worktree_on "$default_branch")" || {
  err "$(pwd -P): bare repository with no worktree on '$default_branch'"
  exit "$EXIT_UNRESOLVED"
}

printf '%s\n' "$worktree"
