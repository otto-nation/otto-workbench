#!/usr/bin/env bash

_SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
WORKBENCH_DIR="${WORKBENCH_DIR:-$(git -C "$(dirname "$_SELF")" rev-parse --show-toplevel)}"
. "$WORKBENCH_DIR/lib/ui.sh"
. "$WORKBENCH_DIR/lib/branch_state.sh"

GRACE_PERIOD_SECS=600
CLEANUP_LOG_DIR="${CLEANUP_LOG_DIR:-$WORKBENCH_STATE_DIR/logs}"
CLEANUP_LOG="${CLEANUP_LOG:-$CLEANUP_LOG_DIR/wt-cleanup.log}"

usage() {
  cat <<EOF
Remove stale git worktrees managed by Worktrunk.

By default, removes worktrees whose branches are fully merged (safe to delete),
and deletes the branch with the worktree — including a squash merge, which git's
own ancestry check cannot see. With --age <days>, also removes worktrees with no
commits newer than <days> days; those branches are kept, since inactivity says
nothing about whether the work landed.

Worktrees created less than ${GRACE_PERIOD_SECS}s ago are always skipped to avoid
removing worktrees that another session is actively using.

A merged worktree holding uncommitted changes is reported rather than removed,
but two kinds of residue do not count as changes: a file the default branch
already ignores, which a worktree cut before the rule landed still reports, and
a file whose lines only moved. Both are named in the cleanup log when forgiven.

Usage: $(basename "$0") [options]

Options:
  --age <days>       Also remove worktrees inactive for <days>+ days
  --no-grace-period  Skip the ${GRACE_PERIOD_SECS}s grace period (remove immediately)
  --dry-run          Show what would be removed
  --quiet            No output (for hooks)
  -h, --help         Show this help
EOF
}

_worktree_age_secs() {
  local wt_path="$1"
  [[ -d "$wt_path" ]] || return 1
  local created
  created=$(file_birth "$wt_path") || return 1
  # file_birth reports 0 on filesystems with no birth time — treat as unknown
  [[ "$created" -gt 0 ]] || return 1
  echo $((now - created))
}

_has_uncommitted_changes() {
  local idx="$1"
  local result
  result=$(echo "$worktrees" | jq -r "
    .[$idx].working_tree | (.staged or .modified or .untracked or .renamed or .deleted)")
  [[ "$result" == "true" ]]
}

_log() {
  { [[ -d "$CLEANUP_LOG_DIR" ]] || mkdir -p "$CLEANUP_LOG_DIR"
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$CLEANUP_LOG"
  } 2>/dev/null || true
}

_describe_changes() {
  local idx="$1"
  echo "$worktrees" | jq -r "
    .[$idx].working_tree | to_entries
    | map(select(.value == true) | .key) | join(\", \")"
}

# _change_kind CODE — the word for a porcelain status CODE, from the same
# vocabulary the `wt list` flags use so both descriptions read alike.
_change_kind() {
  local code="$1"
  case "$code" in
    '??'|'!!') echo "untracked"; return 0 ;;
  esac
  case "${code:1:1}" in
    M) echo "modified"; return 0 ;;
    D) echo "deleted";  return 0 ;;
  esac
  case "${code:0:1}" in
    R|C) echo "renamed"; return 0 ;;
    D)   echo "deleted"; return 0 ;;
  esac
  echo "staged"
}

# _default_ignores PATH — whether the default branch's ignore rules cover PATH.
#
# Asked in the default branch's own work tree, so the `.gitignore` files a repo
# keeps below its root are read at the depth they apply. A worktree cut before
# an ignore rule landed does not carry the rule, which is the whole reason git
# reports the file: the branch is merged, so the default branch's copy of the
# rules is the one that decides whether the file is worth preserving. With no
# work tree for the default branch nothing is forgiven, leaving the operator the
# report they get today.
_default_ignores() {
  [[ -n "$default_wt" && -d "$default_wt" ]] || return 1
  git -C "$default_wt" check-ignore --no-index -q -- "$1" 2>/dev/null
}

# _is_reordered WT_PATH REL — whether REL holds exactly the lines its committed
# copy holds, in some other order.
#
# Claude Code rewrites `ai/claude/settings.json` with its allow list sorted, so
# a worktree that has merely been opened in a session reports a modified file no
# content changed. Only a merged worktree is asked, and there the branch is
# already in the default branch — a reordering of it is residue, not work.
_is_reordered() {
  local wt_path="$1" rel="$2" committed
  [[ -f "$wt_path/$rel" ]] || return 1
  git -C "$wt_path" cat-file -e "HEAD:$rel" 2>/dev/null || return 1
  committed=$(git -C "$wt_path" show "HEAD:$rel" 2>/dev/null | sort)
  [[ "$committed" == "$(sort "$wt_path/$rel")" ]]
}

# _live_changes WT_PATH BRANCH — the kinds of change in WT_PATH that removing the
# worktree would actually lose, comma-joined, and nothing at all when its residue
# is entirely disposable. Returns 1 when the work tree cannot be read, which
# leaves the caller on the flags `wt list` carries.
#
# Every path forgiven is named in the cleanup log with the reason, so a removal
# this widens can be audited after the fact.
_live_changes() {
  local wt_path="$1" branch="$2"
  [[ -n "$wt_path" && -d "$wt_path" ]] || return 1
  git -C "$wt_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1

  # -uall so an untracked directory arrives as the files inside it. Collapsed to
  # the directory, one file the default branch does not ignore would speak for
  # every one it does, and whether it collapsed at all would depend on where the
  # checkout happened to have a tracked sibling.
  local entry code rel kinds="" kind ordered=""
  while IFS= read -r -d '' entry; do
    code="${entry:0:2}"
    rel="${entry:3}"
    # A rename carries its old path in a second record; drop it here so the
    # codes keep landing on the field that holds one.
    case "$code" in
      R*|C*) IFS= read -r -d '' _ || true ;;
    esac
    if [[ "$code" == '??' ]] && _default_ignores "$rel"; then
      _log "DISPOSABLE-PATH branch=$branch path=$rel reason=ignored-on-$default_branch"
      continue
    fi
    if [[ "$code" == *M* ]] && _is_reordered "$wt_path" "$rel"; then
      _log "DISPOSABLE-PATH branch=$branch path=$rel reason=reordered"
      continue
    fi
    kinds+=" $(_change_kind "$code")"
  done < <(git -C "$wt_path" status --porcelain -z -uall 2>/dev/null)

  for kind in staged modified untracked renamed deleted; do
    if [[ "$kinds " == *" $kind "* ]]; then
      ordered="${ordered:+$ordered, }$kind"
    fi
  done
  echo "$ordered"
}

_pr_state() {
  local branch="$1"
  echo "${pr_states[$branch]:-}"
}

_is_merged() {
  local main_state="$1" symbols="$2" pr_state="$3"
  if [[ "$symbols" == *"⊂"* ]] || [[ "$main_state" == "integrated" ]]; then
    return 0
  elif [[ "$pr_state" == "MERGED" ]]; then
    return 0
  fi
  return 1
}

_within_grace_period() {
  local wt_path="$1"
  [[ "$grace_period" != "true" ]] && return 1
  local wt_age
  wt_age=$(_worktree_age_secs "$wt_path") || return 1
  [[ $wt_age -lt $GRACE_PERIOD_SECS ]]
}

_detect_reason() {
  local main_state="$1" symbols="$2" pr_state="$3" timestamp="$4"
  if [[ "$symbols" == *"⊂"* ]] || [[ "$main_state" == "integrated" ]]; then
    echo "merged"
  elif [[ "$pr_state" == "MERGED" ]]; then
    echo "pr merged"
  elif [[ -n "$max_age_days" ]]; then
    local age=$((now - timestamp))
    local max_age_secs=$((max_age_days * 86400))
    if [[ $age -gt $max_age_secs ]]; then
      echo "$((age / 86400))d inactive"
    fi
  fi
}

main() {
  set -e

  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; return 0; }

  command -v wt >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || { echo "jq required" >&2; return 1; }

  dry_run=false
  quiet=false
  max_age_days=""
  grace_period=true

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)          dry_run=true; shift ;;
      --quiet)            quiet=true; shift ;;
      --age)              max_age_days="$2"; shift 2 ;;
      --no-grace-period)  grace_period=false; shift ;;
      *) echo "Unknown option: $1" >&2; return 1 ;;
    esac
  done

  now=$(date +%s)
  removed=0
  dirty_merged_branches=()
  dirty_merged_changes=()
  default_branch=$(git config worktrunk.default-branch 2>/dev/null \
    || git config init.defaultBranch 2>/dev/null \
    || echo "main")

  worktrees=$(wt list --format json 2>/dev/null) || return 0
  count=$(echo "$worktrees" | jq 'length')

  # The default branch's own checkout, which is where its ignore rules are asked
  # — see _default_ignores. Empty when the machine has none, and nothing is
  # forgiven then.
  default_wt=$(echo "$worktrees" | jq -r '
    map(select(.is_main)) | .[0].path // ""')

  # One lookup for the whole repo, before the loop — asking per worktree cost a
  # sequential round trip each. Empty when no tracker is reachable, which leaves
  # every verdict to the git signals wt list already carries.
  declare -A pr_states
  if [[ $count -gt 0 ]]; then
    branch_pr_states pr_states || true
  fi

  _log "START count=$count dry_run=$dry_run quiet=$quiet max_age=$max_age_days"

  for ((i = 0; i < count; i++)); do
    is_main=$(echo "$worktrees" | jq -r ".[$i].is_main")
    is_current=$(echo "$worktrees" | jq -r ".[$i].is_current")
    branch=$(echo "$worktrees" | jq -r ".[$i].branch")
    wt_path=$(echo "$worktrees" | jq -r ".[$i].path")
    main_state=$(echo "$worktrees" | jq -r ".[$i].main_state")
    symbols=$(echo "$worktrees" | jq -r ".[$i].symbols")
    timestamp=$(echo "$worktrees" | jq -r ".[$i].commit.timestamp")

    [[ "$is_main" == "true" ]] && continue
    [[ "$branch" == "$default_branch" ]] && continue
    [[ "$is_current" == "true" ]] && continue

    pr_state=$(_pr_state "$branch") || pr_state=""

    if [[ "$pr_state" == "OPEN" ]]; then
      _log "SKIP-OPEN-PR branch=$branch main_state=$main_state symbols=$symbols"
      [[ "$quiet" != "true" && "$dry_run" == "true" ]] && \
        echo "skipping: $branch (open PR)"
      continue
    fi

    # What the worktree would actually lose, read from the work tree itself. The
    # flags `wt list` carries are the fallback for a path this cannot open: they
    # name every kind of change without asking whether any of it is still worth
    # keeping.
    changes=""
    if _has_uncommitted_changes "$i"; then
      changes="$(_live_changes "$wt_path" "$branch")" \
        || changes="$(_describe_changes "$i")"
      [[ -n "$changes" ]] || _log "DISPOSABLE-RESIDUE branch=$branch"
    fi

    if [[ -n "$changes" ]]; then
      _is_merged "$main_state" "$symbols" "$pr_state" \
        && dirty_merged_branches+=("$branch") \
        && dirty_merged_changes+=("$changes")
      continue
    fi

    if _within_grace_period "$wt_path"; then
      [[ "$quiet" != "true" && "$dry_run" == "true" ]] && \
        echo "skipping: $branch (grace period)"
      continue
    fi

    reason=$(_detect_reason "$main_state" "$symbols" "$pr_state" "$timestamp")
    [[ -z "$reason" ]] && continue

    # The two force flags cover different things: `--force` lets the worktree go
    # despite uncommitted files, `--force-delete` lets the branch go despite
    # commits `wt` reads as unmerged. Only a merge this script proved earns the
    # second — an `--age` removal keeps `wt`'s judgement and its branch.
    remove_flags=(--force -y --no-hooks)
    delete_branch=false
    if _is_merged "$main_state" "$symbols" "$pr_state"; then
      delete_branch=true
      remove_flags+=(--force-delete)
    fi

    removed=$((removed + 1))
    if [[ "$dry_run" == "true" ]]; then
      _log "DRY-REMOVE branch=$branch reason=$reason main_state=$main_state symbols=$symbols pr_state=$pr_state delete_branch=$delete_branch"
      [[ "$quiet" != "true" ]] && echo "would remove: $branch ($reason)"
    else
      _log "REMOVE branch=$branch reason=$reason main_state=$main_state symbols=$symbols pr_state=$pr_state delete_branch=$delete_branch"
      [[ "$quiet" != "true" ]] && echo "removing: $branch ($reason)"
      wt remove "$branch" "${remove_flags[@]}" 2>/dev/null || true
    fi
  done

  _log "END removed=$removed dirty_merged=${#dirty_merged_branches[@]}"

  if [[ "$quiet" != "true" && "$removed" -eq 0 && ${#dirty_merged_branches[@]} -eq 0 ]]; then
    echo "no stale worktrees"
  fi

  if [[ "$quiet" != "true" && ${#dirty_merged_branches[@]} -gt 0 ]]; then
    max_len=0
    for b in "${dirty_merged_branches[@]}"; do
      (( ${#b} > max_len )) && max_len=${#b}
    done
    [[ "$removed" -gt 0 ]] && echo ""
    warn "Merged worktrees with uncommitted changes:"
    for ((j = 0; j < ${#dirty_merged_branches[@]}; j++)); do
      printf "  %-${max_len}s  ${DIM}%s${NC}\n" "${dirty_merged_branches[$j]}" "${dirty_merged_changes[$j]}"
    done
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
