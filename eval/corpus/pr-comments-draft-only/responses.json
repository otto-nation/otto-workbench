{
  "pr": {
    "on_no_match": "fail",
    "rules": [
      {
        "match": ["comments", "--fix"],
        "stdout_file": "fix-report.json",
        "stderr": "DRAFT (not published) reply to T-1: fixed in a1b2c3d\n",
        "exit": 0
      }
    ]
  },
  "gh": {"on_no_match": "fail", "rules": []},
  "wt": {
    "on_no_match": "fail",
    "rules": [
      {"match": ["switch", "main"], "stdout": "{\"path\": \"/tmp/eval-main\"}", "exit": 0}
    ]
  },
  "git": {"on_no_match": "passthrough", "rules": [
    {"match": ["push"], "stderr": "refusing: pushes are stubbed\n", "exit": 1}
  ]}
}
