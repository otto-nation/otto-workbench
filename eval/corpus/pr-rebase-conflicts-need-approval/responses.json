{
  "pr": {
    "on_no_match": "fail",
    "rules": [
      {
        "match": ["rebase"],
        "stdout": "{\"status\": \"conflicts\", \"files\": [\"src/auth.py\", \"tests/test_auth.py\"], \"rebase_head\": \"abc1234\", \"rebase_head_subject\": \"fix: auth token refresh\", \"remaining_commits\": 3}",
        "stderr": "rebase: 2 conflicted files\n",
        "exit": 3
      }
    ]
  },
  "pr-rebase": {"on_no_match": "fail", "rules": []},
  "git": {"on_no_match": "passthrough", "rules": [
    {"match": ["push"], "stderr": "refusing: pushes are stubbed\n", "exit": 1}
  ]}
}
