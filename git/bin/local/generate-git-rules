#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
WORKBENCH_DIR="${WORKBENCH_DIR:-$REPO_ROOT}"

# shellcheck source=../../../lib/ui.sh
. "$WORKBENCH_DIR/lib/ui.sh"

usage() {
  cat <<EOF
Generate ai/guidelines/rules/git.generated.md from constants in lib/conventions.sh.

Usage: $(basename "$0") [options]

Options:
  --quiet     Suppress output on success
  -h, --help  Show this help

Environment overrides (used in tests):
  CONVENTIONS_SH      path to conventions.sh
  GIT_RULES_OUTPUT    output file path
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

QUIET=false
[[ "${1:-}" == "--quiet" ]] && QUIET=true

CONVENTIONS_SH="${CONVENTIONS_SH:-"$REPO_ROOT/lib/conventions.sh"}"
OUTPUT="${GIT_RULES_OUTPUT:-"$REPO_ROOT/$GIT_GENERATED_RELPATH"}"

# Extract constants directly from the source file, printing nothing when the
# constant is absent so the emptiness guard below is the thing that reports it.
# Under `set -o pipefail` an unguarded grep exits 1 on no match and errexit
# aborts the script at the assignment, so the guard could never fire and the
# script died with no message at all.
#
# `|| [[ $? -eq 1 ]]` is scoped to exactly that status: grep exit 1 is "no such
# constant", a valid empty result. Exit 2 — an unreadable or missing
# conventions file — still fails the pipeline and aborts, which is right,
# because that is not a missing constant but a missing source of truth.
_extract_const() {
  # shellcheck disable=SC2181  # $? is grep's status, read in its || branch
  { grep -E "^${1}=" "$CONVENTIONS_SH" || [[ $? -eq 1 ]]; } | head -1 | cut -d'=' -f2- | tr -d '"'
}

COMMIT_TYPES=$(_extract_const "COMMIT_TYPES")
COMMIT_HEADER_MAX_LEN=$(_extract_const "COMMIT_HEADER_MAX_LEN")
COMMIT_BODY_MAX_LEN=$(_extract_const "COMMIT_BODY_MAX_LEN")
BREAKING_CHANGE_FOOTER=$(_extract_const "BREAKING_CHANGE_FOOTER")
NOT_BREAKING_FOOTER=$(_extract_const "NOT_BREAKING_FOOTER")

# Conventional Commits v1.0.0 lists the hyphenated spelling as a synonym and
# release-please honours it, so bin/local/check-surface-compat accepts both.
# Derived from the constant rather than declared a second time.
BREAKING_CHANGE_FOOTER_ALT="${BREAKING_CHANGE_FOOTER/ /-}"

if [[ -z "$COMMIT_TYPES" || -z "$COMMIT_HEADER_MAX_LEN" || -z "$COMMIT_BODY_MAX_LEN" || -z "$BREAKING_CHANGE_FOOTER" || -z "$NOT_BREAKING_FOOTER" ]]; then
  err "Could not extract constants from $CONVENTIONS_SH"
  exit 1
fi

# Build comma-separated and bullet-list type displays
TYPES_DISPLAY=$(echo "$COMMIT_TYPES" | tr ' ' ', ')
# shellcheck disable=SC2016  # & is a sed back-reference, not a shell variable

# Build one header budget example line
_budget_line() {
  local prefix="$1"
  local prefix_len=${#prefix}
  local budget=$(( COMMIT_HEADER_MAX_LEN - prefix_len ))
  printf '%s\n' "- \`${prefix}\` is ${prefix_len} chars → subject ≤ ${budget} chars"
}

{
  printf '%s\n' \
    "# Git — Commits & Pull Requests" \
    "<!-- AUTO-GENERATED — do not edit directly -->" \
    "<!-- Source: lib/conventions.sh -->" \
    "<!-- Regenerate: git/bin/generate-git-rules -->" \
    "" \
    "## Conventional Commits" \
    "" \
    "- Format: \`type(scope): subject\`" \
    "- Scope is optional"
  printf '%s\n' "- Allowed types: ${TYPES_DISPLAY}"
  printf '%s\n' "- Header (type + scope + subject) must be ≤ ${COMMIT_HEADER_MAX_LEN} characters total"
  printf '%s\n' \
    "- No period at the end of the subject" \
    "- Use a semicolon (\`;\`) to separate multiple changes in the header"
  printf '%s\n' "- Each body line must be ≤ ${COMMIT_BODY_MAX_LEN} characters — wrap long lines"
  printf '%s\n' \
    "- Use bullet points for multiple changes in the body" \
    "- Subject should be concise and focus on *what* changed, not *how*" \
    "- Never add a co-author trailer (e.g. \`Co-Authored-By:\`)"
  printf '%s\n' \
    "" \
    "### Breaking Changes" \
    "" \
    "- A change that removes or renames anything on a package's public surface must carry a \`${BREAKING_CHANGE_FOOTER}: <what broke>\` footer in the commit body" \
    "- \`${BREAKING_CHANGE_FOOTER_ALT}:\` is accepted as an equivalent spelling — Conventional Commits lists it as a synonym and release-please honours it" \
    "- The \`!\` marker (e.g. \`feat!:\`) is encouraged for readability but never replaces the footer — this repo squash-merges, and on a multi-commit PR the PR title replaces your subject, so a header-only marker is silently lost" \
    "- A removal that is deliberately not breaking takes a \`${NOT_BREAKING_FOOTER}: <entry> — <reason>\` footer instead, one per removed entry" \
    "- The reason after \`${NOT_BREAKING_FOOTER}:\` is required, and an em dash, an en dash, or a plain \`-\` all separate the entry from it — a footer with no reason declares nothing" \
    "- \`bin/local/check-surface-compat\` enforces both footers by comparing the public surface snapshots in your working tree *and* at \`HEAD\` against the ones committed at the merge base — it runs in pre-push and CI"
  printf '%s\n' \
    "" \
    "## Pull Requests" \
    "" \
    "### Title" \
    ""
  printf '%s\n' "- Must follow conventional commit format (same as commit header)"
  printf '%s\n' "- ≤ ${COMMIT_HEADER_MAX_LEN} characters"
  printf '%s\n' \
    "" \
    "### Description template" \
    "" \
    "- Always create PRs via \`task pr:create\` — see \`git-operations.md\` § PR Creation for the full invocation and flags." \
    "- When a repo has a PR template, its section headers are required — do not substitute or invent sections. The fallback template below is ONLY for repos with no project template:" \
    "" \
    '```markdown' \
    "## Summary" \
    "" \
    "## Changes" \
    "" \
    "## Testing" \
    '```' \
    "" \
    "### Single-commit PRs" \
    "" \
    "- Use the commit subject as the PR title" \
    "- Use the commit body as the description when present" \
    "" \
    "### Issue linking" \
    "" \
    "- Extract issue number from branch name (e.g. \`feature/PROJ-123-description\`)" \
    "- Add \`Closes #<number>\` at the top of the description only for numeric GitHub issues" \
    "- Omit issue linking for Jira-style keys (\`PROJ-123\`) — they do not auto-close on GitHub merge" \
    "" \
    "### Assignee" \
    "" \
    "- Always assign PRs to the person opening them (\`--assignee @me\`)" \
    "" \
    "### Footer" \
    "" \
    "- Never append an AI-generated footer (e.g. 'Generated with Claude Code') — use only the PR template content" \
    "" \
    "## Branch Naming" \
    "" \
    "- Always branch from \`origin/main\`, never local \`main\` — local main may be stale" \
    "- Format: \`username/<ISSUE or type if no ISSUE>/description_in_snake_case\`" \
    "- Examples: \`carlos/PROJ-42/oauth_login\`, \`sofia/PROJ-7/fix_cache_race\`, javier/feat/add_metrics" \
    "- Use the git user name (first name, lowercase) as the username prefix"
} > "$OUTPUT"

$QUIET || success "Generated $(basename "$OUTPUT")"
