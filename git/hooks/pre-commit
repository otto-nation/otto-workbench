#!/usr/bin/env bash
# Pre-commit hook: rejects placeholder commit identities and signing that would
# hang on a passphrase prompt nobody can see, then scans staged changes for
# secrets before they enter history.
# Installed globally by git/steps.sh → ~/.git-hooks/pre-commit
#
# For global protection (all repos), the workbench install configures
# a global hooks dir at ~/.git-hooks/ — see git/steps.sh.

set -euo pipefail

# _is_placeholder VALUE PATTERN... — true when VALUE matches any PATTERN.
_is_placeholder() {
  local value="$1"
  shift
  local pattern
  for pattern in "$@"; do
    # shellcheck disable=SC2053  # unquoted RHS is the point — these are globs
    if [[ "$value" == $pattern ]]; then
      return 0
    fi
  done
  return 1
}

# _assert_real_identity — refuses to commit under a test-suite identity.
#
# A test that writes git config into the wrong repo leaves user.name and
# user.email behind permanently, and every later commit inherits them silently.
# Branch names derive from user.name too, so the damage reaches refs. Only
# enforced on repos with a forge remote: throwaway repos created by tests
# legitimately commit as "Test <test@test.com>".
#
# Reads GIT_AUTHOR_IDENT rather than user.name/user.email, so the check also
# sees identities coming from GIT_AUTHOR_NAME/GIT_AUTHOR_EMAIL — the form git
# itself exports to hooks, and the one a test harness is most likely to leak.
# _is_forge_remote URL — true when URL names a repo on a remote host.
#
# Structural rather than a list of forge hostnames. The list named github.com,
# gitlab.com and bitbucket.org, so a GitHub Enterprise or self-hosted GitLab
# remote skipped the identity check entirely and could commit as
# "Test <test@test.com>" — the check was absent on exactly the remotes a
# company runs. Anything with a host and an owner/repo path qualifies; a local
# path or a bare directory does not, which is what keeps the throwaway repos a
# test suite creates exempt.
_is_forge_remote() {
  local url="$1"
  case "$url" in
    # A local clone is not a forge, whatever its path looks like.
    file://*|/*|./*|../*|"") return 1 ;;
    # scheme://[user@]host[:port]/owner/repo
    *://*/*/*) return 0 ;;
    # scp-style [user@]host:owner/repo, including an ssh alias
    *:*/*) return 0 ;;
  esac
  return 1
}

_assert_real_identity() {
  local origin
  origin="$(git remote get-url origin 2>/dev/null || true)"
  _is_forge_remote "$origin" || return 0

  local ident
  ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)"
  [[ -n "$ident" ]] || return 0

  # "Name <email> <timestamp> <tz>"
  local name email
  name="${ident%% <*}"
  email="${ident#*<}"
  email="${email%%>*}"

  # bash 3.2 (macOS system bash) has no ${var,,}
  local name_lower
  name_lower="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"

  local bad=""
  _is_placeholder "$email" 'test@*' '*@test.com' '*@example.com' '*@example.org' '*@localhost' \
    && bad="email=$email"
  _is_placeholder "$name_lower" 'test' 'your name' 'unknown' \
    && bad="${bad:+$bad, }name=$name"
  [[ -n "$bad" ]] || return 0

  echo "✗ refusing to commit with a placeholder identity — $bad"
  git config --show-origin --get-regexp '^user\.(name|email)$' 2>/dev/null | sed 's/^/  /'
  echo "  a test suite most likely wrote this — check the files above, and"
  echo "  GIT_AUTHOR_NAME / GIT_AUTHOR_EMAIL if it is not there. Then verify:"
  echo "    git var GIT_AUTHOR_IDENT"
  exit 1
}

_assert_real_identity

# _can_prompt — true when a pinentry could reach a person: a macOS GUI session,
# an X11 or Wayland display, or a controlling terminal.
#
# WORKBENCH_UNAME and WORKBENCH_TTY_DEVICE stand in for `uname -s` and
# /dev/tty so a test can choose the answer; nothing else sets them.
_can_prompt() {
  [[ "${WORKBENCH_UNAME:-$(uname -s)}" == Darwin ]] && return 0
  [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && return 0
  { : < "${WORKBENCH_TTY_DEVICE:-/dev/tty}"; } 2>/dev/null
}

# _assert_signing_ready — refuses a commit whose OpenPGP signature would wait on
# a passphrase prompt nobody can see.
#
# With commit.gpgsign on and the key's passphrase not cached, gpg asks pinentry
# for it. From a shell with no terminal and no display — an agent's, a job
# runner's — pinentry-curses draws on whatever GPG_TTY names, or nowhere, and
# `git commit` hangs with no output. A non-interactive signature probe settles
# whether a prompt is needed; only when gpg fails for want of one, and no prompt
# could be shown, is the commit refused, with the commands that fix it.
#
# The hook cannot see `git commit --no-gpg-sign`, so the refusal names
# `git -c commit.gpgsign=false commit`, which it can.
_assert_signing_ready() {
  [[ "$(git config --type=bool commit.gpgsign 2>/dev/null || true)" == true ]] || return 0
  [[ "$(git config gpg.format 2>/dev/null || echo openpgp)" == openpgp ]] || return 0

  local gpg key err
  gpg="$(git config gpg.openpgp.program 2>/dev/null || git config gpg.program 2>/dev/null || echo gpg)"
  key="$(git config user.signingkey 2>/dev/null || true)"
  local args=(--batch --no-tty --pinentry-mode error --clearsign)
  [[ -z "$key" ]] || args+=(--local-user "$key")
  if err="$(printf 'probe\n' | "$gpg" "${args[@]}" 2>&1 >/dev/null)"; then
    return 0
  fi
  # Only a failure for want of a prompt would hang. An expired, revoked or
  # missing key fails just as fast when git signs, and gpg's own message there
  # is the accurate one, so the commit is left to report it.
  printf '%s' "$err" | grep -qiE 'pinentry|passphrase' || return 0
  _can_prompt && return 0

  echo "✗ commit signing cannot finish here — gpg needs a passphrase prompt and this"
  echo "  shell has no terminal or display to show one, so git would wait forever."
  [[ -z "$err" ]] || printf '%s\n' "$err" | sed 's/^/  gpg: /'
  echo "  Unlock the key from a real terminal, then retry:"
  echo "    echo test | $gpg --clearsign ${key:+-u $key }>/dev/null"
  echo "  For a key used only on this machine, removing its passphrase ends the"
  echo "  prompt for good: $gpg --passwd${key:+ $key}"
  echo "  To commit unsigned once: git -c commit.gpgsign=false commit ..."
  exit 1
}

_assert_signing_ready

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✗ gitleaks not found — run: brew install gitleaks"
  exit 1
fi

_repo_root="$(git rev-parse --show-toplevel)"
_config_flag=""
[[ -f "$_repo_root/.gitleaks.toml" ]] && _config_flag="--config $_repo_root/.gitleaks.toml"

# A scanner that could not run must not be reported as a scanner that found
# something. gitleaks exits 1 for BOTH "leaks found" and "operational error",
# so a bare `|| echo "found potential secrets"` prints a false positive for an
# unreadable config, a missing repo, or — the case that prompted this — a mise
# shim refusing to exec because some .mise.toml upstack does not parse. That
# reads as a leak nobody can find, and the commit is refused for a reason that
# does not exist.
#
# --exit-code moves the leaks verdict off 1 and onto a code nothing else uses,
# which makes the two outcomes structurally distinguishable instead of
# guessable from message text:
#   0 → clean        7 → leaks found        anything else → scanner failed
_GITLEAKS_LEAK_EXIT=7

# Captured through if/else, the same shape pre-push-workbench uses. That file
# needs it — a bare assignment fires its ERR trap — and this one does not, but
# two spellings of one problem means a reader has to know which script traps
# ERR before either reads correctly.
# shellcheck disable=SC2086  # word splitting intentional for optional flag
if _gitleaks_output=$(gitleaks protect --staged --verbose --no-color --no-banner \
  --exit-code "$_GITLEAKS_LEAK_EXIT" $_config_flag 2>&1); then
  _gitleaks_status=0
else
  _gitleaks_status=$?
fi

if (( _gitleaks_status == _GITLEAKS_LEAK_EXIT )); then
  # stdout, where the old hook's findings went. The operational branch below
  # uses stderr: a scan that did not happen is a hook problem, not a result.
  echo "$_gitleaks_output"
  echo "✗ gitleaks found potential secrets — review the output above before committing"
  exit 1
elif (( _gitleaks_status != 0 )); then
  echo "$_gitleaks_output" >&2
  echo "✗ gitleaks could not run (exit $_gitleaks_status) — this is NOT a secret finding" >&2
  echo "  The scan never happened, so the commit is refused rather than waved through." >&2
  echo "  Common cause: gitleaks on PATH is a mise shim and some .mise.toml does not" >&2
  echo "  parse or is untrusted. Compare:" >&2
  echo "    command -v gitleaks" >&2
  echo "    mise doctor" >&2
  exit 1
fi
# _gitleaks_status == 0 falls through to here: a clean scan's --verbose
# progress output in $_gitleaks_output is intentionally discarded — there is
# nothing in it worth showing when there is nothing to act on.

# Delegate to the repo-local hook if present (bypassed when core.hooksPath is set globally).
#
# --git-common-dir so delegation works from worktrees, where .git is a file and
# the hooks live in the directory every worktree shares. Asked with the git
# environment git exported to this hook rather than through lib/git_layout.sh's
# git_shared_dir — see that module's header for why a hook is the one caller
# that must not clear it.
_local_hook="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [[ -x "$_local_hook" ]]; then
  exec "$_local_hook" "$@"
fi
