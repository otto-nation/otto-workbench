#!/usr/bin/env bash
# Pre-push hook for otto-workbench: validation, linting, and tests before push.
# Dispatched from .git/hooks/pre-push via `task dev:setup`.
# Called via delegation from the global pre-push hook (~/.git-hooks/pre-push).

set -euo pipefail

# Print the failing command on unexpected exits so errors are never silent.
trap 'echo "✗ pre-push hook failed (exit $?) at line $LINENO" >&2' ERR

REPO_ROOT="$(git rev-parse --show-toplevel)"
WORKBENCH_DIR="$REPO_ROOT"

# shellcheck source=../../lib/ui.sh
. "$WORKBENCH_DIR/lib/ui.sh"
# shellcheck source=../../lib/git_remote.sh
. "$WORKBENCH_DIR/lib/git_remote.sh"

# Directories every `find` sweep below skips. Kept in one place because a
# missed exclusion here means the hook walks vendored trees that no linter in
# it can parse — node_modules alone was already patched in once after being
# added to only some of the sweeps.
_FIND_SKIP=(-not -path '*/.git/*' -not -path '*/node_modules/*')

# ── Output helpers ───────────────────────────────────────────────────────────

# _step LABEL — prints "→ LABEL..." without a newline. Follow with _pass or _fail.
_step() { printf "${BLUE}→${NC} %s... " "$*"; }

# _pass [DETAIL] — completes the current step line with ✓ and optional detail.
_pass() {
  if [[ -n "${1:-}" ]]; then
    printf "${GREEN}✓${NC} ${DIM}(%s)${NC}\n" "$*"
  else
    printf "${GREEN}✓${NC}\n"
  fi
}

# _fail MSG — completes the current step line with ✗, prints captured output, and exits.
_fail() {
  printf "${RED}✗${NC}\n" >&2
  echo "$1" >&2
  exit 1
}

# _run_step LABEL COMMAND [ARGS...] — runs a command silently; prints compact pass/fail.
# On success, extracts a parenthesized detail from stdout (e.g. "(16 files)") for display.
_run_step() {
  local label="$1"; shift
  _step "$label"
  local output
  if output=$("$@" 2>&1); then
    # Extract detail from success output for compact display.
    # Matches "(N files)" or "N checks passed" patterns.
    local detail=""
    local _paren_re='\(([^)]+)\)'
    local _checks_re='([0-9]+ checks)'
    if [[ "$output" =~ $_paren_re ]]; then
      detail="${BASH_REMATCH[1]}"
    elif [[ "$output" =~ $_checks_re ]]; then
      detail="${BASH_REMATCH[1]}"
    fi
    _pass "$detail"
  else
    _fail "$output"
  fi
}

# ── Secret scan ──────────────────────────────────────────────────────────────

if ! command -v gitleaks >/dev/null 2>&1; then
  err "gitleaks not found — run: brew install gitleaks"
  exit 1
fi

_step "Scanning for secrets"
_config_flag=""
[[ -f "$REPO_ROOT/.gitleaks.toml" ]] && _config_flag="--config $REPO_ROOT/.gitleaks.toml"
# shellcheck disable=SC2086  # word splitting intentional for optional flag
if _gitleaks_output=$(gitleaks protect --staged $_config_flag 2>&1); then
  _pass
else
  _fail "$_gitleaks_output"
fi

# ── Validation ───────────────────────────────────────────────────────────────

if ! command -v yq >/dev/null 2>&1; then
  err "yq not found — run: brew install yq"
  exit 1
fi

_run_step "Validating conventions"     "$REPO_ROOT/bin/local/validate-all" --quiet

# Not part of validate-all: this one needs a base ref to diff the public
# surface snapshots against, which the working-tree validators do not have.
#
# The gate defaults to the default branch, and its remote-tracking ref only
# moves when something fetches it. On a branch cut days ago that ref still
# points at the trunk the branch forked from, so the merge base is the fork
# point either way and the gate compares against snapshots that no longer
# describe trunk — an entry trunk itself removed reads as removed by this push.
# Refresh the ref first so the comparison is against what CI will use.
#
# The branch is resolved rather than spelled `main`, so this fetches whatever
# check-surface-compat is about to compare against. Two literals that agree
# today is how a `master` repository ends up refreshing one ref and gating on
# another — lib/git_remote.sh answers for both.
#
# Best-effort: pushing offline or against an unreachable remote is going to
# fail at the push itself a moment later, and it is not this step's job to be
# the one that says so. A failed fetch leaves the previous ref in place, which
# is what the gate would have used anyway.
#
# GIT_TERMINAL_PROMPT=0: an expired HTTPS credential turns "fails a moment
# later" into "hangs on a prompt" — the flag makes git fail the same way a
# clean network error would instead of blocking on input nothing will answer.
_default_branch="$(resolve_default_branch "$REPO_ROOT")"
GIT_TERMINAL_PROMPT=0 git -C "$REPO_ROOT" fetch --quiet "$GIT_REMOTE" "$_default_branch" 2>/dev/null || true

_run_step "Checking surface compatibility" "$REPO_ROOT/bin/local/check-surface-compat" --quiet

# ── Open PR notice ───────────────────────────────────────────────────────────
#
# A branch with an open PR is one somebody may be reading, may have marked
# ready, or may be merging right now. Pushing to it is not wrong, but it is a
# different act from pushing to a branch nobody has seen, and the difference is
# invisible at the terminal — which is how a push comes to lose a race with a
# merge and strand a commit on a deleted branch.
#
# A notice, never a block: the legitimate cases (review findings, CI fixes, a
# reviewer's request) are common, and a gate here would be answered with
# --no-verify rather than thought. Entirely best-effort — no gh, no auth, no
# network, or a repo with no PR all leave the push exactly as it was.
#
# Called at the end of the hook rather than here, so it is the last thing on
# screen when the push begins. Defined beside the other checks; run where it
# will be read.
# _run_briefly SECONDS CMD... — CMD's stdout, or nothing if it outlives SECONDS.
#
# `timeout` is GNU and this is a BSD userland, so the deadline is kept by hand:
# run the command writing to a temp file, poll for it to finish, kill it if it
# does not. Only worth it for a call whose whole contract is that it cannot
# delay the push — a hung TLS handshake is not a network error `gh` returns
# from promptly, it is one it waits on.
_run_briefly() {
  local deadline="$1"
  shift
  local out pid waited=0
  out="$(mktemp)" || return 1

  "$@" > "$out" 2> /dev/null &
  pid=$!

  while kill -0 "$pid" 2> /dev/null; do
    if [[ "$waited" -ge "$deadline" ]]; then
      kill -TERM "$pid" 2> /dev/null
      wait "$pid" 2> /dev/null
      rm -f "$out"
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done

  wait "$pid" 2> /dev/null || {
    rm -f "$out"
    return 1
  }
  cat "$out"
  rm -f "$out"
  return 0
}

_warn_if_pr_is_open() {
  command -v gh > /dev/null 2>&1 || return 0
  local branch line is_draft url
  branch="$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD 2> /dev/null)" || return 0
  [[ -n "$branch" ]] || return 0

  # `gh pr list --head`, not `gh pr view $branch`: view reads an all-digit
  # argument as a PR number, so a branch named `1180` would report PR #1180 —
  # somebody else's, almost certainly. --head resolves by branch and nothing
  # else, and --state open makes the filter the server's job.
  #
  # Tab-separated so each field is read as a field; the URL is the one that can
  # contain characters worth not splitting on.
  line="$(_run_briefly 5 gh pr list --head "$branch" --state open --limit 1 \
    --json isDraft,url --jq '.[0] | [(.isDraft|tostring), .url] | @tsv')" || return 0
  IFS=$'\t' read -r is_draft url <<< "$line"
  [[ -n "$url" ]] || return 0

  warn "This branch has an open PR: $url"
  if [[ "$is_draft" == "false" ]]; then
    warn "  Marked ready for review — say on the PR what this push changes."
  fi
  return 0
}


# ── Generation ───────────────────────────────────────────────────────────────

# The composed docs are not checked here. bin/local/validate-docs-composed runs
# above as part of validate-all and covers every docs/*.src.md, so a stale
# artifact has already failed the push by this point — with one command to fix
# it, rather than a list of filenames kept in step by hand.
_step "Regenerating tool context"
"$REPO_ROOT/bin/local/generate-tool-context" --quiet
"$REPO_ROOT/git/bin/local/generate-git-rules" --quiet
_pass

# ── ShellCheck ───────────────────────────────────────────────────────────────

if ! command -v shellcheck >/dev/null 2>&1; then
  err "shellcheck not found — run: brew install shellcheck"
  exit 1
fi

_step "Running ShellCheck"
if _sc_output=$(list_shell_scripts "$REPO_ROOT" | xargs shellcheck --severity=warning 2>&1); then
  _pass
else
  _fail "$_sc_output"
fi

# ── YAML lint ────────────────────────────────────────────────────────────────

if command -v yamllint >/dev/null 2>&1; then
  _step "Linting YAML"
  if _yl_output=$(yamllint "$REPO_ROOT" 2>&1); then
    _yl_count=$(find "$REPO_ROOT" \( -name '*.yml' -o -name '*.yaml' \) "${_FIND_SKIP[@]}" | wc -l | tr -d ' ')
    _pass "${_yl_count} files"
  else
    _fail "$_yl_output"
  fi
fi

# ── ZSH syntax ───────────────────────────────────────────────────────────────

if command -v zsh >/dev/null 2>&1; then
  _step "Checking ZSH syntax"
  _zsh_files=()
  while IFS= read -r -d '' f; do
    _zsh_files+=("$f")
  done < <(find "$REPO_ROOT" -name '*.zsh' "${_FIND_SKIP[@]}" -print0)
  if [[ ${#_zsh_files[@]} -gt 0 ]]; then
    if _zsh_output=$(zsh -n "${_zsh_files[@]}" 2>&1); then
      _pass "${#_zsh_files[@]} files"
    else
      _fail "$_zsh_output"
    fi
  else
    _pass "0 files"
  fi
fi

# ── JSON validation ──────────────────────────────────────────────────────────

_step "Validating JSON"
_json_errors=""
_json_count=0
while IFS= read -r -d '' f; do
  _json_count=$((_json_count + 1))
  if ! jq -e '.' "$f" > /dev/null 2>&1; then
    _json_errors+="  Invalid JSON: $f"$'\n'
  fi
done < <(find "$REPO_ROOT" -name '*.json' "${_FIND_SKIP[@]}" -not -path '*/.claude/*' -print0)
if [[ -n "$_json_errors" ]]; then
  _fail "$_json_errors"
else
  _pass "${_json_count} files"
fi

# ── Bats tests ───────────────────────────────────────────────────────────────

if ! command -v bats >/dev/null 2>&1; then
  err "bats not found — run: brew install bats-core"
  exit 1
fi

# Change-based test selection: only run bats tests affected by the diff.
# Falls back to the full suite when the selector is unavailable or when
# shared infra (test_helper.bash, run-tests, workflows) changed.
_bats_selected=""
_bats_label="tests"
if [[ -x "$REPO_ROOT/bin/local/select-tests" ]]; then
  _bats_selected=$("$REPO_ROOT/bin/local/select-tests" --base "$GIT_REMOTE/$_default_branch" 2>/dev/null) || _bats_selected=""
  if [[ -n "$_bats_selected" ]]; then
    _bats_file_count=$(echo "$_bats_selected" | wc -l | tr -d ' ')
    _bats_total=$(find "$REPO_ROOT/tests" -maxdepth 1 -name '*.bats' | wc -l | tr -d ' ')
    _bats_label="tests ($_bats_file_count/$_bats_total files)"
  fi
fi

_step "Running $_bats_label"
_bats_start=$SECONDS
if [[ -n "$_bats_selected" ]]; then
  _bats_output=$("$REPO_ROOT/bin/local/run-tests" --bats --files "$_bats_selected" 2>&1) || {
    printf "${RED}✗${NC}\n" >&2
    echo "$_bats_output" | grep -E '^(not ok |# )'
    err "Tests failed"
    exit 1
  }
else
  _bats_output=$("$REPO_ROOT/bin/local/run-tests" --bats 2>&1) || {
    printf "${RED}✗${NC}\n" >&2
    echo "$_bats_output" | grep -E '^(not ok |# )'
    err "Tests failed"
    exit 1
  }
fi
_bats_elapsed=$(( SECONDS - _bats_start ))

# Extract test count from TAP plan line (1..N)
_test_count=$(echo "$_bats_output" | grep -oE '^1\.\.[0-9]+' | head -1)
_test_count="${_test_count#1..}"
_pass "${_test_count:-?} tests, ${_bats_elapsed}s"

# Warn about slow tests (>2s) — surfaces performance regressions
_slow_threshold_ms=2000
_slow_tests=$(echo "$_bats_output" \
  | grep -E '^ok .+ in [0-9]+ms$' \
  | while IFS= read -r line; do
      _ms="${line##* in }"
      _ms="${_ms%ms}"
      if [[ "$_ms" -gt "$_slow_threshold_ms" ]]; then
        # Strip "ok N " prefix (N can be multi-digit) and " in Nms" suffix
        _name="${line% in *}"
        _name="${_name#ok }"
        _name="${_name#* }"
        printf '  %s (%ss)\n' "$_name" "$(( _ms / 1000 ))"
      fi
    done)
if [[ -n "$_slow_tests" ]]; then
  warn "Slow tests (>${_slow_threshold_ms}ms):"
  echo "$_slow_tests"
fi

# ── Pytest ──────────────────────────────────────────────────────────────────

if ! command -v pytest >/dev/null 2>&1; then
  warn "pytest not found — skipping Python tests (pip install pytest)"
else
  _step "Running pytest"
  _pytest_start=$SECONDS
  _pytest_output=$("$REPO_ROOT/bin/local/run-tests" --pytest -- --tb=short -q 2>&1) || {
    printf "${RED}✗${NC}\n" >&2
    echo "$_pytest_output"
    err "Pytest failed"
    exit 1
  }
  _pytest_elapsed=$(( SECONDS - _pytest_start ))
  _pytest_count=$(echo "$_pytest_output" | awk '/passed/{print $1}')
  _pass "${_pytest_count:-?} tests, ${_pytest_elapsed}s"
fi

# ── Open PR notice ───────────────────────────────────────────────────────────

# Last, deliberately: this is the line that should still be on screen when the
# push starts, not one buried above shellcheck and two test suites.
_warn_if_pr_is_open
