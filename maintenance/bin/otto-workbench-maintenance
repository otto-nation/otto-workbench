#!/usr/bin/env bash
# Scheduled maintenance for otto-workbench.
# Called by launchd (macOS) or systemd timer (Linux) — pulls latest changes,
# runs sync, cleans stale worktrees, and collects stale PR artifacts.
#
# Exit codes:
#   0  Success (updated or already up-to-date)
#   1  Error (fetch/pull/sync failed)

set -e

WORKBENCH_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

# Sourced rather than re-derived: constants.sh owns MAINTENANCE_LAST_FILE, and
# the state root it hangs off comes from lib/roots.sh underneath. Not lib/ui.sh:
# this runs under launchd/systemd with no terminal, and ui.sh pulls in the whole
# interactive framework.
# shellcheck source=../../lib/constants.sh
. "$WORKBENCH_DIR/lib/constants.sh"

mkdir -p "$WORKBENCH_STATE_DIR"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

cd "$WORKBENCH_DIR"

# Find the main worktree — in a bare repo with worktrees, main is checked out
# in its own directory. Fall back to WORKBENCH_DIR if no worktree layout.
MAIN_WORKTREE="$WORKBENCH_DIR"
if [[ -d "$WORKBENCH_DIR/main/.git" || -f "$WORKBENCH_DIR/main/.git" ]]; then
  MAIN_WORKTREE="$WORKBENCH_DIR/main"
fi

log "Fetching origin/main"
if ! git -C "$MAIN_WORKTREE" fetch origin main 2>&1; then
  log "ERROR: git fetch failed"
  exit 1
fi

# Compare local main to origin/main
local_main=$(git -C "$MAIN_WORKTREE" rev-parse HEAD)
remote_main=$(git -C "$MAIN_WORKTREE" rev-parse origin/main)

if [[ "$local_main" == "$remote_main" ]]; then
  log "Already up-to-date (${local_main:0:7})"
else
  log "Updating ${local_main:0:7} -> ${remote_main:0:7}"

  # Fast-forward main to fetched origin/main (no second network call)
  if ! git -C "$MAIN_WORKTREE" merge --ff-only origin/main 2>&1; then
    log "ERROR: fast-forward of main failed (may have diverged)"
    exit 1
  fi
fi

log "Running sync"
if "$MAIN_WORKTREE/bin/otto-workbench" sync 2>&1; then
  log "Sync complete"
else
  log "ERROR: sync failed (exit $?)"
  exit 1
fi

log "Cleaning stale worktrees"
if "$MAIN_WORKTREE/bin/wt-cleanup" --quiet 2>&1; then
  log "Worktree cleanup complete"
else
  log "WARNING: worktree cleanup failed (non-fatal)"
fi

# Unlike the two blocks above, which run scripts out of the repo itself, `pr`
# is a symlink the ai/claude component installs. Components install
# independently, so its absence is a machine that never asked for it — a skip,
# not a warning to repeat on every cycle for the life of the install.
# 75 is `pr`'s EXIT_BUDGET_EXHAUSTED: the sweep stopped because the account's
# hourly GitHub quota is spent. Distinguished from a real failure because it is
# neither broken nor actionable — the budget refills on its own and the next
# cycle collects what this one could not ask about. Calling it a failure sent
# someone looking for an expired token.
if [[ -x "$LOCAL_BIN_DIR/pr" ]]; then
  log "Collecting stale PR artifacts"
  gc_status=0
  "$LOCAL_BIN_DIR/pr" gc 2>&1 || gc_status=$?
  if [[ $gc_status -eq 0 ]]; then
    log "PR artifact collection complete"
  elif [[ $gc_status -eq 75 ]]; then  # pr EXIT_BUDGET_EXHAUSTED (EX_TEMPFAIL)
    log "PR artifact collection skipped — GitHub API budget exhausted, will retry next cycle"
  else
    log "WARNING: pr gc failed (non-fatal, exit $gc_status)"
  fi
fi

date '+%s' > "$MAINTENANCE_LAST_FILE"
log "Maintenance complete"
