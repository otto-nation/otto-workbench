#!/usr/bin/env bash
# Scheduled maintenance for otto-workbench.
# Triggered by launchd (macOS) or a systemd timer (Linux), which only submit it to otto-queue; the queue's worker runs the body as a job.
# Pulls latest changes, runs sync, cleans stale worktrees, and collects stale PR artifacts.
#
# Exit codes:
#   0  Success (updated or already up-to-date)
#   1  Error (fetch/pull/sync failed)
#   75 Deferred (EX_TEMPFAIL): a pr batch run is live; the queue retries it with backoff

set -e

WORKBENCH_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

# Sourced rather than re-derived: constants.sh owns MAINTENANCE_LAST_FILE, and
# the state root it hangs off comes from lib/roots.sh underneath. Not lib/ui.sh:
# this runs under launchd/systemd with no terminal, and ui.sh pulls in the whole
# interactive framework.
# shellcheck source=../../lib/constants.sh
. "$WORKBENCH_DIR/lib/constants.sh"
# shellcheck source=../../lib/config.sh
. "$WORKBENCH_DIR/lib/config.sh"

# launchd and systemd both hand this script a system PATH and none of
# ~/.env.local. What this script calls, it calls by absolute path; this is for
# what its children look up by name and read from the environment —
# should-wiki-capture.sh resolves `wiki`, and a 127 there is swallowed by its
# `|| exit 1` and reads as "this repo has no knowledge base", so the gate never
# fires and looks right; the auto-task agents run `pr` and `wt` (a mise shim on
# Linux) and need GOOGLE_CLOUD_PROJECT for Pi's Vertex provider. env.sh is the
# environment an interactive shell has, from the repo's copy so a sync that has
# not deployed it yet still gets it. It lifts this script's errexit around
# ~/.env.local, so a command there returning non-zero cannot end the run.
# Ordering matters beyond the symlinks: lib/roots.sh uses `declare -g`, so the
# Homebrew bash ahead of /bin on the plist PATH is load-bearing too.
# shellcheck source=../../zsh/env.sh
. "$ZSH_ENV_SRC"
workbench_env

mkdir -p "$WORKBENCH_STATE_DIR"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

# Scheduled maintenance runs as an otto-queue job: inside workbench.slice on
# Linux, counted against the machine's heavy budget, and never two at once —
# the `maintenance` key joins a run already queued or running, and --no-reuse
# lets the next cycle run again once one has finished. So the timer or launchd
# agent only submits. `otto-workbench maintenance run` passes --ticket to run it
# here, in the terminal, under the same key. OTTO_QUEUE_ENTRY marks a run the
# queue started; _WB_MAINTENANCE_QUEUED marks one the queue ran unqueued (its
# ledger could not be opened), which would otherwise submit itself again.
OTTO_QUEUE_BIN="${OTTO_QUEUE_BIN:-$WORKBENCH_DIR/ai/bin/otto-queue}"
if [[ -z "${OTTO_QUEUE_ENTRY:-}" && -z "${_WB_MAINTENANCE_QUEUED:-}" && -x "$OTTO_QUEUE_BIN" ]]; then
  queue_command=(submit)
  if [[ "${1:-}" == "--ticket" ]]; then
    queue_command=(run --ticket)
  fi
  export _WB_MAINTENANCE_QUEUED=1
  exec "$OTTO_QUEUE_BIN" "${queue_command[@]}" --class heavy --key maintenance --no-reuse \
    --label maintenance -- "$WORKBENCH_DIR/maintenance/bin/otto-workbench-maintenance"
fi

# _batch_running — true when `pr batch status --list` reports an active run.
# No `pr` (the ai component is not installed) means no batch can be running.
_batch_running() {
  [[ -x "$LOCAL_BIN_DIR/pr" ]] || return 1
  local listing
  listing=$("$LOCAL_BIN_DIR/pr" batch status --list 2>/dev/null) || return 1
  python3 -c 'import json, sys; sys.exit(0 if any(r.get("active") for r in json.load(sys.stdin).get("runs", [])) else 1)' \
    <<<"$listing"
}

# A live `pr batch` run checks out, rebases and pushes with the code this run is
# about to pull and sync over. 75 (EX_TEMPFAIL) is a busy resource, not a
# failure: the queue runs this job again with backoff.
if _batch_running; then
  log "A pr batch run is live; deferring maintenance so it does not sync code under it"
  exit 75
fi

cd "$WORKBENCH_DIR"

# Find the main worktree — in a bare repo with worktrees, main is checked out
# in its own directory. Fall back to WORKBENCH_DIR if no worktree layout.
MAIN_WORKTREE="$WORKBENCH_DIR"
if [[ -d "$WORKBENCH_DIR/main/.git" || -f "$WORKBENCH_DIR/main/.git" ]]; then
  MAIN_WORKTREE="$WORKBENCH_DIR/main"
fi

log "Fetching origin/main"
# Bounded by tier, not by a unit timeout: the bound has to SIGTERM the fetch
# itself so git drops its lockfiles; the systemd unit runs with KillMode=process,
# which signals only this script and would leave a hung child running.
if ! wb_run_bounded --tier TRANSFER --relay -- git -C "$MAIN_WORKTREE" fetch origin main 2>&1; then
  log "ERROR: git fetch failed"
  exit 1
fi

# Compare local main to origin/main
local_main=$(git -C "$MAIN_WORKTREE" rev-parse HEAD)
remote_main=$(git -C "$MAIN_WORKTREE" rev-parse origin/main)

if [[ "$local_main" == "$remote_main" ]]; then
  log "Already up-to-date (${local_main:0:7})"
else
  log "Updating ${local_main:0:7} -> ${remote_main:0:7}"

  # Fast-forward main to fetched origin/main (no second network call)
  if ! git -C "$MAIN_WORKTREE" merge --ff-only origin/main 2>&1; then
    log "ERROR: fast-forward of main failed (may have diverged)"
    exit 1
  fi
fi

log "Running sync"
# The warnings sync prints are the only record of why a run degraded, so its
# output is relayed to this log rather than discarded.
if wb_run_bounded --tier SYNC --relay -- "$MAIN_WORKTREE/bin/otto-workbench" sync 2>&1; then
  log "Sync complete"
else
  log "ERROR: sync failed or exceeded its bound (see the relayed reason above)"
  exit 1
fi

# The steps below stay unbounded here on purpose. `pr gc` must keep its exit
# code 75, which run-bounded would collapse to 1, and run-due-auto-tasks spawns
# detached agents where no worker can take them as queue jobs, which a
# process-group kill would take down with it.
log "Cleaning stale worktrees"
if "$MAIN_WORKTREE/bin/wt-cleanup" --quiet 2>&1; then
  log "Worktree cleanup complete"
else
  log "WARNING: worktree cleanup failed (non-fatal)"
fi

# Unlike the two blocks above, which run scripts out of the repo itself, `pr`
# is a symlink the ai/claude component installs. Components install
# independently, so its absence is a machine that never asked for it — a skip,
# not a warning to repeat on every cycle for the life of the install.
# `pr` exits 75 both for EXIT_BUDGET_EXHAUSTED and for a busy run lock
# (`core.run_lock.EXIT_BUSY`). Neither becomes this script's status, so a gc
# skip never re-queues pull and sync. Distinguished from a real failure because
# it is neither broken nor actionable — the budget refills on its own, a busy
# lock clears, and the next cycle collects what this one could not.
if [[ -x "$LOCAL_BIN_DIR/pr" ]]; then
  log "Collecting stale PR artifacts"
  gc_status=0
  "$LOCAL_BIN_DIR/pr" gc 2>&1 || gc_status=$?
  if [[ $gc_status -eq 0 ]]; then
    log "PR artifact collection complete"
  elif [[ $gc_status -eq 75 ]]; then
    log "PR artifact collection skipped — GitHub API budget exhausted or its target is busy, will retry next cycle"
  else
    log "WARNING: pr gc failed (non-fatal, exit $gc_status)"
  fi
fi

# The four AI maintenance cooldowns. Exit 69 (EX_UNAVAILABLE) means the
# executor is absent, which is a machine that never asked for the ai/claude
# component rather than a failure — the same silent skip the `pr` block above
# makes, and for the same reason. The gate logic and the one-spawn-per-cycle
# cap live in that script; see its header for why they are not inline here.
# Any other exit code is a genuine regression (the script runs under `set -e`,
# so a failed source or an unhandled command surfaces here as exit 1) and is
# logged rather than swallowed — mirroring the `pr gc` block's branch on
# `gc_status` above. 69 rather than 1 is deliberate: 1 is bash's default
# failure code for an unhandled command, so a broken install would otherwise
# be indistinguishable from the ordinary "executor absent" skip.
auto_task_status=0
"$MAIN_WORKTREE/maintenance/bin/run-due-auto-tasks" || auto_task_status=$?
if [[ $auto_task_status -ne 0 && $auto_task_status -ne 69 ]]; then
  log "WARNING: run-due-auto-tasks failed (non-fatal, exit $auto_task_status)"
fi

date '+%s' > "$MAINTENANCE_LAST_FILE"
log "Maintenance complete"
