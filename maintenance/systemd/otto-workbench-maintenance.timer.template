[Unit]
Description=otto-workbench maintenance timer

[Timer]
# A wall-clock schedule is not re-armed by daemon-reload or restart (the
# monotonic OnActiveSec it replaces was: any reload started a maintenance run
# five minutes later). Persistent=true runs a slot missed while the machine was
# off at the next start. FixedRandomDelay keeps the jitter stable across reloads.
OnCalendar=__CALENDAR__
RandomizedDelaySec=__DELAY__
FixedRandomDelay=true
Persistent=true

[Install]
WantedBy=timers.target
