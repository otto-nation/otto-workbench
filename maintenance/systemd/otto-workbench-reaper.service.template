[Unit]
Description=otto-workbench reaper — terminates heavy processes past their runtime limit

[Service]
Type=oneshot
# workbench_env gives the reaper the PATH an interactive shell has (zsh/env.sh),
# which it needs to find the config reader. Paths are substituted at render
# time, so systemd has no variables to expand here.
ExecStart=/bin/sh -c '. "__WORKBENCH_DIR__/zsh/env.sh" && workbench_env && exec "__WORKBENCH_DIR__/maintenance/bin/reap-hung"'
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Only reap-hung's own process is the unit's: whatever it signals is not ours to
# take down with it when the unit ends.
KillMode=process
# The run sleeps reaper.grace_s (up to 300s) between SIGTERM and SIGKILL; a
# start timeout that cut it off would leave what it TERMed without the follow-up.
TimeoutStartSec=infinity
