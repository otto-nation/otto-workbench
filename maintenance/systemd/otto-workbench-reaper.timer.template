[Unit]
Description=otto-workbench reaper timer

[Timer]
# Wall-clock, like the maintenance timer: a reload does not re-arm it. No
# Persistent=: a slot missed while the machine was off has nothing to reap.
OnCalendar=*:0/5
RandomizedDelaySec=30
FixedRandomDelay=true

[Install]
WantedBy=timers.target
