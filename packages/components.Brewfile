# Lookup table for component-installed tools. Never offered in the stack menu
# nor run by brew bundle — package_lookup reads it so those tools have the
# same linux-install identity as every other formula.
brew "rtk"  # mise: rtk
brew "node"  # mise: node@lts
brew "pytest"  # mise: pipx:pytest[uvx_args=--with pytest-xdist]
