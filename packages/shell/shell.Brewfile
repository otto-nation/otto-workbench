# Shell experience — opinionated prompt, navigation, and zsh plugins.
# Install: brew bundle --file=packages/shell/shell.Brewfile

brew "fzf"  # mise: fzf
brew "starship"  # mise: starship
cask "font-fira-code-nerd-font"
brew "zoxide"  # mise: zoxide
brew "zsh-history-substring-search"  # git: https://github.com/zsh-users/zsh-history-substring-search
brew "zsh-completions"  # git: https://github.com/zsh-users/zsh-completions
brew "zsh-syntax-highlighting"  # git: https://github.com/zsh-users/zsh-syntax-highlighting
