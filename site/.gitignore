node_modules/
.next/
out/
.source/

# Written by `next dev` on startup, not by the build. Committing them would put
# agent instructions inside site/ that shadow the repo's own CLAUDE.md.
AGENTS.md
CLAUDE.md

# Regenerated by both `next dev` and `next build`, and they disagree: dev writes
# `./.next/dev/types/...`, build writes `./.next/types/...`. Tracking it means
# whichever command ran last leaves a dirty tree. tsconfig.json includes both
# directories directly, so nothing depends on which form is on disk.
next-env.d.ts

# Incremental-build cache written by `tsc`. Machine-specific and ~270KB, so it
# only ever lands in a diff as noise.
tsconfig.tsbuildinfo
